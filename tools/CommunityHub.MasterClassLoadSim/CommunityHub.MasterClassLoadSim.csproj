<Project Sdk="Microsoft.NET.Sdk">

  <!-- ======================================================================
       CommunityHub.MasterClassLoadSim - REQUIREMENTS §221 concurrency harness.
       Drives ~400 GENUINELY CONCURRENT master-class signup / waitlist /
       cancellation attempts (each its own DbContext + SQL connection) against a
       REAL relational SQL Server to prove the §218 OPTIMISTIC seat allocation:
       never oversells the last seat, confirmed/waitlist counts stay exact,
       cancellation frees a seat a waitlisted user is promoted into (exactly
       once), no double-count, no deadlock storm.

       This is a STANDALONE console exe (NOT part of the xUnit test project), so
       'dotnet test' never runs it and the normal suite is unaffected. It needs a
       real SQL Server target; when none is reachable it prints a SKIP + caveat
       and exits 0 (does not fail a pipeline). Rerunnable via
       'dotnet run -c Release' on this project.
       Target override: env CEH_LOADSIM_SQL = an ADMIN/master connection string
       (defaults to the local SQLEXPRESS instance with Integrated Security).
       ====================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommunityHub.MasterClassLoadSim</RootNamespace>
    <AssemblyName>communityhub-masterclass-loadsim</AssemblyName>
    <!-- No native apphost .exe; invoke via 'dotnet run'. Avoids Windows
         Defender / sandbox blocking the .exe wrapper (mirrors OneShot). -->
    <UseAppHost>false</UseAppHost>
  </PropertyGroup>

  <ItemGroup>
    <!-- UseSqlServer + EnsureCreated; the version flows from Core but pin it
         explicitly so the harness builds standalone. -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\CommunityHub.Core\CommunityHub.Core.csproj" />
  </ItemGroup>

</Project>
