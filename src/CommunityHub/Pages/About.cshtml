@page "/About"
@model CommunityHub.Pages.AboutModel
@{
    ViewData["Title"] = "Community Event Hub — how it is built";
    // §327g: a PUBLIC page — shareable with people who have no hub account.
    ViewData["MetaDescription"] =
        "Community Event Hub (CEH): an open-source, one-hub-per-role event platform on Azure — "
        + "architecture, integrations, how it is built and what each role gets.";
}

@* §348 — the content-page styling is ONE shared partial, not a copy. This page used to carry its
   own, and it had silently fallen behind: thin-underline tables, no header background, no zebra,
   no heading spacing — on the PUBLIC copy, which is the one shared outside the event. *@
<partial name="_ContentPageStyles" />
<style>
    .ab-scroll { overflow-x: auto; }
</style>

<div class="card content-page">
    @if (Model.ContentMissing)
    {
        <h1>Community Event Hub</h1>
        <p class="info">This page is not available right now. Please check back soon.</p>
    }
    else
    {
        <div class="ab-scroll">@Model.BodyHtml</div>
    }
    <hr style="margin:24px 0;border:0;border-top:1px solid #e6e8ee;" />
    <p style="color:#6b7280;font-size:13px;">
        Are you a speaker, sponsor, volunteer or attendee at the event?
        <a asp-page="/Login">Sign in to your hub</a> to see your own tasks and bookings.
    </p>
</div>
