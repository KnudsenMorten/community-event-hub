@page
@model CommunityHub.Pages.Organizer.CalendarSettingsModel
@{
    ViewData["Title"] = "Calendar invitation settings";
}

<div class="card">
    <h1>&#128197; Calendar invitation settings</h1>

    @if (Model.AccessDenied)
    {
        <p class="error" role="alert">This area is for organizers only.</p>
    }
    else
    {
        <p>When calendar invitations are on, participants can e-mail themselves a
           <strong>calendar invitation</strong> (an &ldquo;Add Reminder&rdquo; / &ldquo;Email me a
           calendar invite&rdquo; action) for their task due dates, sessions and other items, so each
           lands straight in their calendar.</p>

        @if (Model.SavedMessage is not null)
        {
            <p class="info" role="status"
               style="background:#f0fdf4;border:1px solid #16a34a;padding:8px 12px;border-radius:6px;">
                @Model.SavedMessage
            </p>
        }

        <form method="post">
            <fieldset style="border:1px solid #e5e7eb;border-radius:8px;padding:12px 14px;max-width:100%;">
                <legend style="font-weight:600;">Calendar invitations for this edition</legend>
                <label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer;">
                    <input type="checkbox" asp-for="Enabled" style="margin-top:3px;" />
                    <span>
                        <strong>Enable the manual calendar option</strong>
                        <span style="display:block;color:#6b7280;font-size:13px;margin-top:2px;">
                            The &ldquo;Add Reminder&rdquo; / &ldquo;Email me a calendar invite&rdquo; actions
                            and the &ldquo;Add to calendar&rdquo; links people click themselves. When off,
                            those actions send nothing &mdash; for the whole edition.
                        </span>
                    </span>
                </label>
                <label style="display:flex;gap:10px;align-items:flex-start;cursor:pointer;margin-top:12px;">
                    <input type="checkbox" asp-for="AutoInvitesEnabled" style="margin-top:3px;" />
                    <span>
                        <strong>Auto-send calendar invites on submit</strong>
                        <span style="display:block;color:#6b7280;font-size:13px;margin-top:2px;">
                            When ON, the hub automatically pushes a calendar invitation into the recipient's
                            inbox for the four automatic flows (Appreciation Dinner RSVP, Hotel booking,
                            organizer hotel placement, Master-Class seat). When <strong>OFF (default)</strong>,
                            no invite is pushed &mdash; the confirmation e-mail instead carries an
                            &ldquo;Add to calendar&rdquo; link the person can click to add it themselves.
                        </span>
                    </span>
                </label>
                <div style="margin-top:14px;">
                    <button type="submit">Save</button>
                </div>
            </fieldset>
        </form>
    }
    <p style="margin-top:16px;"><a asp-page="/Organizer/Index">Back to organizer area</a></p>
</div>
