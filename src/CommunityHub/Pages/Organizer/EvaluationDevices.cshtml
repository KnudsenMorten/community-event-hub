@page
@model CommunityHub.Pages.Organizer.EvaluationDevicesModel
@using CommunityHub.Core.Evaluation
@{
    ViewData["Title"] = "Evaluation Devices";
}

@* §784.7(A) — ONE page. "Feedback devices" and "Device onboarding" were the same job (get the fleet
   working) at two different moments, so approving a unit and then checking whether it ever arrived
   meant two pages. Onboarding is the sections at the bottom now. *@
<style>
    .ob-warn { background:#fff4e5; border-left:4px solid #d97706; padding:12px 14px; border-radius:4px; margin:0 0 16px; }
    .ob-stop { background:#fdecea; border-left:4px solid #c8322a; padding:12px 14px; border-radius:4px; margin:0 0 16px; }
    .ob-ok   { background:#eef7ee; border-left:4px solid #1E7A3C; padding:12px 14px; border-radius:4px; margin:0 0 16px; }
    .ob-table { width:100%; border-collapse:collapse; }
    .ob-table th { text-align:left; font-size:12px; text-transform:uppercase; letter-spacing:.04em; color:#6b7280; padding:6px 8px; border-bottom:1px solid #e5e7eb; }
    .ob-table td { padding:10px 8px; border-bottom:1px solid #f0f1f3; vertical-align:top; }
    .ob-serial { font-weight:700; font-size:15px; }
    .ob-id { font-family:ui-monospace,Consolas,monospace; font-size:12px; color:#6b7280; word-break:break-all; }
    .ob-muted { color:#6b7280; font-size:13px; }
    .ob-pill { display:inline-block; padding:2px 9px; border-radius:999px; font-size:12px; font-weight:600; }
    .ob-on  { background:#eef7ee; color:#1E7A3C; }
    .ob-off { background:#fdecea; color:#c8322a; }
    .ob-actions form { display:inline-block; margin-right:6px; }
    @@media (max-width: 600px) {
        .ob-table, .ob-table tbody, .ob-table tr, .ob-table td { display:block; width:100%; box-sizing:border-box; }
        .ob-table thead { display:none; }
        .ob-table td { border:none; padding:4px 8px; }
        .ob-table tr { border:1px solid #e5e7eb; border-radius:10px; margin:10px 0; padding:8px; }
    }
</style>

<div class="card">
    <h1>Evaluation Devices</h1>
    <p>The four-button units in each room &mdash; register them, approve the ones asking to join, and
       watch their health. A device must be known here <strong>before</strong> it is used &mdash; the
       ingest API refuses any identifier it does not already know.</p>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
    }
    else
    {
        @if (!string.IsNullOrWhiteSpace(Model.Message))
        {
            <p class="notice">@Model.Message</p>
        }

        @* §1259 — the web-kiosk pairing code. Shown ONCE, like a key, and for the same reason:
           only its hash is stored. Big and monospaced because it is read off this screen and typed
           on an iPad by someone standing up. *@
        @if (Model.PairingCode is not null)
        {
            <div class="card" style="border:2px solid #1d4ed8;background:#eff6ff;">
                <h2 style="margin-top:0;">Pair a kiosk device &mdash; @Model.PairingCodeFor</h2>
                <p style="font-family:ui-monospace,Menlo,monospace;font-size:44px;font-weight:700;
                          letter-spacing:.12em;user-select:all;margin:10px 0;">@Model.PairingCode</p>
                <ol style="margin:0 0 6px 18px;">
                    <li>On the kiosk device, open <code>/eval</code> on this site.</li>
                    <li>Tap the <strong>top-left corner five times</strong> to open setup.</li>
                    <li>Type the code above and press <strong>Pair with code</strong>.</li>
                </ol>
                <p class="set-deps">
                    Single use, expires @(Model.PairingCodeExpiresAt?.ToLocalTime().ToString("HH:mm") ?? "shortly").
                    Pairing issues a fresh device key, so pairing a replacement device revokes the old one.
                    Link the device to a room first, or the kiosk cannot name the session on screen.
                </p>
            </div>
        }

        @* §1259d — how a screen gets onto the kiosk page at all: scan, or type. Shown always, at
           the top, because it is the first thing anyone setting up a stand needs. *@
        <div class="card" style="display:flex;gap:18px;align-items:center;flex-wrap:wrap;">
            @if (Model.KioskQrDataUri is not null)
            {
                <img src="@Model.KioskQrDataUri" alt="QR code for the kiosk page" width="150" height="150"
                     style="image-rendering:pixelated;border:6px solid #fff;border-radius:6px;" />
            }
            <div style="flex:1 1 320px;">
                <h2 style="margin-top:0;">Set up a screen</h2>
                <p style="margin:.2em 0;">
                    <strong>Scan the code</strong> with the tablet's camera, or open
                    <code style="user-select:all;">@Model.KioskUrl</code> in any browser &mdash; a
                    Windows laptop works exactly the same for testing.
                </p>
                <p class="set-deps" style="margin:.4em 0 0;">
                    On the page: tap the <strong>top-left corner five times</strong> &rarr;
                    <strong>Enroll this device</strong> &rarr; name it. It appears below under
                    <strong>pending approvals</strong>; approve it and the screen starts working by
                    itself. Link it to a room so it can name the session.
                </p>
            </div>
        </div>

        @* §1259c — the enrolment link. Shown once; only its hash is stored. This is the one an
           iPad keeps on its Home Screen, and the reason a kiosk never needs a daily login. *@
        @if (Model.EnrolmentLink is not null)
        {
            <div class="card" style="border:2px solid #047857;background:#ecfdf5;">
                <h2 style="margin-top:0;">Enrollment link &mdash; @Model.EnrolmentLinkFor</h2>
                <p><code style="user-select:all;word-break:break-all;font-size:15px;">@Model.EnrolmentLink</code></p>
                <ol style="margin:0 0 6px 18px;">
                    <li>Open this once on that kiosk device (scan it, or type it).</li>
                    <li>Run it full screen
                        so there is no address bar.</li>
                    <li>Lock the device to it (Intune kiosk mode, or the device's app pinning).</li>
                </ol>
                <p class="set-deps">
                    The kiosk re-connects itself from this link whenever its browser storage is cleared
                    or the device is replaced &mdash; no code to type, no daily login. Issuing a new
                    link revokes this one. <strong>Treat it like a key</strong>: it can add ratings for
                    this room and nothing else.
                </p>
            </div>
        }

        @* 🔒 The ONLY moment a key is ever visible. We store a PBKDF2 hash, so nobody — including
           us — can read one back afterwards. Say that here rather than let it be discovered. *@
        @if (Model.IssuedKeys.Count > 0)
        {
            <div class="card" style="border:2px solid #b45309;background:#fffbeb;">
                <h2 style="margin-top:0;">Copy these keys now</h2>
                <p><strong>They cannot be shown again.</strong> Only a hash is stored, so if a key is
                   lost the only way forward is to rotate it and re-flash the unit.</p>
                <table class="grid">
                    <thead><tr><th>Device</th><th>Key</th></tr></thead>
                    <tbody>
                    @foreach (var (serialNumber, key) in Model.IssuedKeys)
                    {
                        <tr>
                            <td><code>@serialNumber</code></td>
                            <td><code style="user-select:all;word-break:break-all;">@key</code></td>
                        </tr>
                    }
                    </tbody>
                </table>
                <p class="set-deps">Hand these to the vendor with the matching identifiers. The unit
                   sends its key in the <code>X-Device-Key</code> header over HTTPS.</p>
            </div>
        }

        <h2>Register devices</h2>
        <form method="post" asp-page-handler="Add">
            <p>
                <label for="identifiers">Device identifiers &mdash; <strong>one per line</strong></label><br />
                <textarea id="identifiers" name="identifiers" rows="6" style="width:100%;max-width:520px;"
                          placeholder="A1:B2:C3:D4:E5:F6&#10;A1:B2:C3:D4:E5:F7"></textarea>
            </p>
            <p class="set-deps">
                Paste all 25 at once. The identifier is whatever is printed on the enclosure &mdash;
                MAC address or serial number. It is stored exactly as entered and never interpreted,
                so either is fine.
            </p>
            <p>
                <label for="label">Label (optional, applied to all)</label><br />
                <input id="label" name="label" type="text" maxlength="200" style="width:100%;max-width:320px;"
                       placeholder="e.g. Batch 1" />
            </p>
            <button type="submit" class="set-btn">Register</button>
        </form>

        var revokedCount = Model.Devices.Count(x => !x.IsActive);
        <h2 style="margin-top:24px;">Registered (@(Model.Devices.Count - revokedCount))</h2>
        @if (revokedCount > 0)
        {
            @* §1277 — revoked devices are hidden by default; one click shows them (to Restore one). *@
            <label style="font-size:13px;display:inline-flex;gap:6px;align-items:center;cursor:pointer;">
                <input type="checkbox" onchange="document.querySelectorAll('tr.dev-revoked').forEach(function (r) { r.hidden = !this.checked; }, this);" />
                Show revoked (@revokedCount)
            </label>
        }
        @if (Model.Devices.Count == 0)
        {
            <p>No devices registered yet. Until at least one is, every upload will be refused.</p>
        }
        else
        {
            @* §1266 — operator 2026-09-21: *"relevans and errors, looks cramped"*. One row per device,
               NAME first; only the health figures that kind of device actually reports (an iPad has
               no battery or signal reading, a box has both); times in Danish wall time (Last seen was
               printed in UTC); rare and destructive actions folded under "More". *@
            <style>
                .dev-grid td { vertical-align: top; padding: 10px 12px; }
                .dev-grid .dev-name { font-size: 15px; font-weight: 700; color: #1e293b; }
                .dev-grid .dev-sub { font-size: 12px; color: #64748b; }
                .dev-grid .dev-room select { width: 100%; max-width: 360px; }
                /* §1354 — wide enough for "Default — Rating + 2 questions (3 pages)" in full (operator:
                   "extend the length of this so i can see the whole length"); phones keep the fluid cell. */
                @@media (min-width: 700px) { .dev-grid .dev-room { min-width: 340px; } }
                .dev-grid .dev-state { font-weight: 600; }
                .dev-grid .dev-state.online { color: #15803d; }
                .dev-grid .dev-state.late { color: #b45309; }
                .dev-grid .dev-state.silent, .dev-grid .dev-state.never { color: #64748b; }
                .dev-grid .dev-actions { display: flex; flex-wrap: wrap; gap: 6px; align-items: flex-start; }
                .dev-grid .dev-actions form { margin: 0; }
                .dev-grid details > summary { cursor: pointer; font-size: 13px; color: #1d4ed8; }
                .dev-grid details[open] > summary { margin-bottom: 6px; }
                .dev-grid .dev-more { display: flex; flex-wrap: wrap; gap: 6px; }
                .dev-grid .dev-rename { display: flex; gap: 6px; margin-top: 6px; }
                .dev-grid .dev-rename input[name=label] { min-width: 0; flex: 1; max-width: 220px; }
                .dev-grid .dev-alert { color: #b91c1c; font-weight: 600; }
            </style>
            <div style="overflow-x:auto;">
            <table class="grid dev-grid">
                <thead>
                    <tr>
                        <th>Device</th>
                        <th>Room</th>
                        <th>Status</th>
                        <th>Health</th>
                        <th>Responses</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var d in Model.Devices)
                {
                    var status = Model.StatusOf(d);
                    var contact = CommunityHub.Pages.Organizer.EvaluationDevicesModel.LastContact(d);
                    var lowBattery = d.LastBatteryPercent is int b && b < CommunityHub.Pages.Organizer.EvaluationDevicesModel.LowBatteryPercent;
                    var stuckCache = d.CachedRecordCount is int c && c >= CommunityHub.Pages.Organizer.EvaluationDevicesModel.CachedRecordAlert;
                    var name = CommunityHub.Pages.Organizer.EvaluationDevicesModel.DisplayName(d);
                    var customName = CommunityHub.Pages.Organizer.EvaluationDevicesModel.HasCustomName(d);
                    <tr class="@(d.IsActive ? "" : "dev-revoked")" hidden="@(!d.IsActive)" style="@(d.IsActive ? "" : "opacity:.55;")">
                        <td>
                            <div class="dev-name">@name</div>
                            <div class="dev-sub">
                                @if (customName) { <code>@d.SerialNumber</code><text> · </text> }
                                @(d.IsKiosk ? "Kiosk" : "Kiosk (box)")@(d.FirmwareVersion is null || d.IsKiosk ? "" : " · " + d.FirmwareVersion)
                            </div>
                            @if (!d.IsActive) { <div><strong style="color:#b91c1c;">revoked</strong></div> }
                            @if (d.PreviousKeyHash is not null) { <div class="dev-sub">old key still accepted</div> }
                            @* §1265 — the name is editable in place; presentation only, never matched on. *@
                            <details>
                                <summary>Rename</summary>
                                <form method="post" asp-page-handler="Rename" class="dev-rename">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <input name="label" value="@(customName ? d.Label : "")" maxlength="200"
                                           placeholder="e.g. Room 16 stand" aria-label="Name for @name" />
                                    <button type="submit" class="set-btn">Save</button>
                                </form>
                            </details>
                        </td>
                        @* 🔑 §1350 — device → PHYSICAL room → schedule rooms → session is the whole
                           attribution chain. An unlinked unit collects presses that reach no session. *@
                        <td class="dev-room">
                            <form method="post" asp-page-handler="SetPhysicalRoom" style="display:inline;">
                                <input type="hidden" name="id" value="@d.Id" />
                                <select name="physicalRoomId" onchange="this.form.submit()"
                                        aria-label="Physical room for @name">
                                    <option value="">— not linked —</option>
                                    @foreach (var pr in Model.PhysicalRooms)
                                    {
                                        <option value="@pr.Id" selected="@(pr.Id == d.PhysicalRoomId)">@pr.Name</option>
                                    }
                                </select>
                            </form>
                            @if (d.PhysicalRoomId is null && (d.RoomId is not null || d.MasterClassRoomId is not null))
                            {
                                @* §1349 direct links still count until a physical room is chosen. *@
                                <div class="dev-sub">direct link: @string.Join(" + ", Model.Rooms.Where(r => r.Id == d.RoomId || r.Id == d.MasterClassRoomId).Select(r => r.Name))</div>
                            }
                            else if (d.PhysicalRoomId is null)
                            {
                                <div class="set-deps" style="color:#b45309;">presses cannot be attributed</div>
                            }
                            @* §1354 — this tablet's own capture policy, to compare policies side by side. *@
                            @if (d.IsKiosk)
                            {
                                <form method="post" asp-page-handler="SetDevicePolicy" style="margin-top:6px;">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <label class="dev-sub" style="display:block;">Asks</label>
                                    <select name="policy" onchange="this.form.submit()" aria-label="Capture policy for @name">
                                        <option value="">Default — @FeedbackCapturePolicies.Label(Model.DefaultKioskPolicy)</option>
                                        @foreach (var pol in FeedbackCapturePolicies.KioskChoices)
                                        {
                                            <option value="@((int)pol)" selected="@(d.CapturePolicy == pol)">@FeedbackCapturePolicies.Label(pol)</option>
                                        }
                                    </select>
                                </form>
                                @* §1355 — this tablet's own symbols. *@
                                <form method="post" asp-page-handler="SetDeviceSymbols" style="margin-top:6px;">
                                    <input type="hidden" name="id" value="@d.Id" />
                                    <label class="dev-sub" style="display:block;">Shows</label>
                                    <select name="symbols" onchange="this.form.submit()" aria-label="Symbols for @name">
                                        <option value="">Default — @RatingSymbolChoices.Label(Model.DefaultKioskSymbols)</option>
                                        @foreach (var s in RatingSymbolChoices.All)
                                        {
                                            <option value="@((int)s)" selected="@(d.RatingSymbols == s)">@RatingSymbolChoices.Label(s)</option>
                                        }
                                    </select>
                                </form>
                            }
                        </td>
                        <td>
                            <span class="dev-state @(status == "never seen" ? "never" : status)">@status</span>
                            <div class="dev-sub">@(contact is DateTimeOffset seen ? Model.ShortLocal(seen) : "—")</div>
                        </td>
                        @* 🔑 Health shows what THIS kind of device reports. The figure that catches
                           SILENT failure on both is the unsent count: online and reporting but not
                           draining its queue means presses are being lost. *@
                        <td>
                            @if (d.IsKiosk)
                            {
                                <div class="@(stuckCache ? "dev-alert" : "")">Unsent votes: @(d.CachedRecordCount?.ToString() ?? "—")</div>
                                @* §1358 — a tablet reports its battery when its browser can tell (Chrome on Android). *@
                                @if (d.LastBatteryPercent is int kb)
                                {
                                    <div class="@(lowBattery ? "dev-alert" : "")">Battery: @(kb)%</div>
                                }
                            }
                            else
                            {
                                <div class="@(lowBattery ? "dev-alert" : "")">Battery: @(d.LastBatteryPercent is null ? "—" : d.LastBatteryPercent + "%")</div>
                                <div>Signal: @(d.LastSignalQuality?.ToString() ?? "—")</div>
                                <div class="@(stuckCache ? "dev-alert" : "")">Unsent: @(d.CachedRecordCount?.ToString() ?? "—")</div>
                            }
                        </td>
                        <td>
                            @(Model.ResponseCounts.TryGetValue(d.SerialNumber, out var n) ? n : 0)
                            @if (Model.UnattributedCounts.TryGetValue(d.SerialNumber, out var un) && un > 0)
                            {
                                @* Neutral, not a warning: a press outside every session window is
                                   normal between sessions and while testing. It still counts toward
                                   the event figure. *@
                                <div class="dev-sub" title="Pressed when no session was running in this room — still counted in the event total; if it keeps rising during sessions, check the device's room and clock.">
                                    @un outside any session
                                </div>
                            }
                        </td>
                        <td>
                            <div class="dev-actions">
                                @if (d.IsKiosk)
                                {
                                    @* §1259c — the self-healing route: one link, kept on the Home Screen. *@
                                    <form method="post" asp-page-handler="EnrolLink">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="set-btn" title="Issue the URL this kiosk keeps; it re-connects itself from it">
                                            @(d.KioskEnrolmentTokenHash is null ? "Enrollment link" : "New enrollment link")
                                        </button>
                                    </form>
                                    <form method="post" asp-page-handler="Pair">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="set-btn" title="Issue a one-time code so a kiosk device running /eval becomes this device">Re-pair</button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="Rotate">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <button type="submit" class="set-btn">New key</button>
                                    </form>
                                    @if (d.PreviousKeyHash is not null)
                                    {
                                        <form method="post" asp-page-handler="RetirePrevious">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="set-btn">Retire old key</button>
                                        </form>
                                    }
                                }
                            </div>
                            <details style="margin-top:6px;">
                                <summary>More</summary>
                                <div class="dev-more">
                                    @if (d.IsKiosk && d.KioskEnrolmentTokenHash is not null)
                                    {
                                        <form method="post" asp-page-handler="RevokeEnrol">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="set-btn" title="Stop this kiosk re-connecting (lost or stolen)">Revoke link</button>
                                        </form>
                                    }
                                    @if (d.IsKiosk && d.PreviousKeyHash is not null)
                                    {
                                        <form method="post" asp-page-handler="RetirePrevious">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="set-btn">Retire old key</button>
                                        </form>
                                    }
                                    @if (!d.IsKiosk)
                                    {
                                        @* §1259 — a box's identity can be taken over by an iPad (spare). *@
                                        <form method="post" asp-page-handler="Pair">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="set-btn" title="Issue a one-time code so a kiosk device running /eval becomes this device">Pair kiosk</button>
                                        </form>
                                    }
                                    <form method="post" asp-page-handler="SetActive">
                                        <input type="hidden" name="id" value="@d.Id" />
                                        <input type="hidden" name="active" value="@((!d.IsActive).ToString().ToLowerInvariant())" />
                                        <button type="submit" class="set-btn @(d.IsActive ? "off" : "")">
                                            @(d.IsActive ? "Revoke" : "Restore")
                                        </button>
                                    </form>
                                    @* §1277 — Delete is offered only where it will WORK. A device that has
                                       collected feedback is refused (its responses would point at a unit
                                       nobody can identify), and the refusal used to appear at the top of
                                       the page where it was missed (operator 2026-09-21: "i pressed delete
                                       but they doont remove from page"). Revoke retires it instead, and a
                                       revoked device drops out of this list. *@
                                    @if (Model.ResponseCounts.TryGetValue(d.SerialNumber, out var held) && held > 0)
                                    {
                                        <span class="dev-sub" style="flex-basis:100%;">
                                            Has @held response(s), so it cannot be deleted &mdash; <strong>Revoke</strong>
                                            retires it and hides it from this list, keeping its feedback.
                                        </span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Delete">
                                            <input type="hidden" name="id" value="@d.Id" />
                                            <button type="submit" class="set-btn off">Delete</button>
                                        </form>
                                    }
                                </div>
                            </details>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>

            <p class="set-deps" style="margin-top:10px;">
                <strong>Status is the last sign of life, not a live connection</strong> (Danish time).
                Boxes are battery powered and sleep between uploads, and a tablet kiosk stops reporting while
                its screen is off, so &ldquo;silent&rdquo; overnight is normal. Battery turns red below
                @CommunityHub.Pages.Organizer.EvaluationDevicesModel.LowBatteryPercent%, and
                <em>Unsent</em> turns red at @CommunityHub.Pages.Organizer.EvaluationDevicesModel.CachedRecordAlert
                &mdash; a device that is reporting but not sending its votes is losing presses.
            </p>
        }
    }
</div>

@* ================================================================================
   §1350 — PHYSICAL ROOMS. Operator 2026-10-19: *"define rooms and link virtual rooms linked to
   sessions and link them to physical rooms where the device is"*. A tablet stands in ONE physical
   room; a physical room holds one or more schedule rooms (pre-day "-MC" + main day), and a combined
   pre-day room may sit under several physical rooms (5-7-MC under Room 5 AND Room 6-7).
   ================================================================================ *@
@* §1353 — one switch: rating + follow-ups, or rating only when people queue up. *@
@if (!Model.AccessDenied)
{
    <style>
        .kq-toggle { display: flex; flex-wrap: wrap; gap: 0; border: 2px solid #1d4ed8; border-radius: 10px; overflow: hidden; max-width: 640px; }
        .kq-toggle form { flex: 1 1 240px; margin: 0; }
        .kq-toggle button { width: 100%; height: 100%; border: 0; padding: 12px 14px; text-align: left; cursor: pointer;
                            background: #fff; color: #1e293b; font: inherit; }
        .kq-toggle button strong { display: block; font-size: 15px; }
        .kq-toggle button span { display: block; font-size: 12px; color: #64748b; margin-top: 2px; }
        .kq-toggle button[aria-pressed=true] { background: #1d4ed8; color: #fff; cursor: default; }
        .kq-toggle button[aria-pressed=true] span { color: #dbeafe; }
        .kq-toggle button:disabled { opacity: 1; }
    </style>
    <div class="card">
        <h2 style="margin-top:0;">Feedback capture policies</h2>
        <p class="set-deps">What attendees are asked. The defaults below apply everywhere; a tablet (in its row) and a
            physical room's QR codes (under Physical rooms) can run their own policy, so policies can be compared.
            Every response records the policy it was captured under.</p>

        <h3 style="margin:14px 0 6px;">Default for kiosk tablets</h3>
        <div class="kq-toggle" role="group" aria-label="Default kiosk policy">
            @foreach (var (pol, hint) in new[]
            {
                (FeedbackCapturePolicy.RatingFollowUps, "More context for the speaker · about 10–20 s per person"),
                (FeedbackCapturePolicy.RatingOnly, "One tap — fastest when people queue up"),
            })
            {
                var on = Model.DefaultKioskPolicy == pol;
                <form method="post" asp-page-handler="SetDefaultPolicy">
                    <input type="hidden" name="channel" value="kiosk" />
                    <input type="hidden" name="policy" value="@((int)pol)" />
                    <button type="submit" aria-pressed="@(on ? "true" : "false")" disabled="@on">
                        <strong>@FeedbackCapturePolicies.Label(pol)</strong><span>@hint</span>
                    </button>
                </form>
            }
        </div>
        <p class="set-deps" style="margin-top:6px;">Tablets switch within a minute — nothing to do on the devices.</p>

        <h3 style="margin:16px 0 6px;">Default for QR codes</h3>
        <div class="kq-toggle" role="group" aria-label="Default QR policy">
            @foreach (var pol in FeedbackCapturePolicies.QrChoices)
            {
                var on = Model.DefaultQrPolicy == pol;
                <form method="post" asp-page-handler="SetDefaultPolicy">
                    <input type="hidden" name="channel" value="qr" />
                    <input type="hidden" name="policy" value="@((int)pol)" />
                    <button type="submit" aria-pressed="@(on ? "true" : "false")" disabled="@on">
                        <strong>@FeedbackCapturePolicies.Label(pol)</strong>
                    </button>
                </form>
            }
        </div>
        <p class="set-deps" style="margin-top:6px;">Applies from the next scan.</p>

        @* §1355 — the symbols on the four rating buttons, one or two at once. *@
        <h3 style="margin:16px 0 6px;">Symbols on the rating buttons</h3>
        <div style="display:flex;flex-wrap:wrap;gap:12px 24px;">
            @foreach (var (channel, label, current) in new[] { ("kiosk", "Kiosk tablets", Model.DefaultKioskSymbols), ("qr", "QR codes", Model.DefaultQrSymbols) })
            {
                <form method="post" asp-page-handler="SetDefaultSymbols">
                    <input type="hidden" name="channel" value="@channel" />
                    <label class="dev-sub" style="display:block;">@label</label>
                    <select name="symbols" onchange="this.form.submit()" aria-label="Default symbols for @label" style="min-width:220px;">
                        @foreach (var s in RatingSymbolChoices.All)
                        {
                            <option value="@((int)s)" selected="@(current == s)">@RatingSymbolChoices.Label(s)</option>
                        }
                    </select>
                </form>
            }
        </div>
        <p class="set-deps" style="margin-top:6px;">Faces, stars (1–4) and points (1–4) — one or two together. The colour and the
            word stay on every button; the stored rating is the same whatever is shown.</p>
    </div>
}

@if (!Model.AccessDenied)
{
    <style>
        .pr-grid td { vertical-align: top; padding: 10px 12px; }
        .pr-grid .pr-rooms { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 2px 12px; }
        .pr-grid .pr-rooms label { font-size: 13px; display: flex; gap: 6px; align-items: flex-start; }
        .pr-grid .pr-name { width: 100%; max-width: 200px; }
        @@media (min-width: 700px) { .pr-grid td:first-child { min-width: 340px; } }
        .pr-warn { color: #b45309; margin: 4px 0; }
        @@media (max-width: 600px) {
            .pr-grid .pr-rooms { grid-template-columns: 1fr; }
        }
    </style>
    <div class="card">
        <h2 style="margin-top:0;">Physical rooms (@Model.PhysicalRooms.Count)</h2>
        <p class="set-deps">
            A tablet is linked to the <strong>physical room</strong> it stands in. Tick every schedule room held
            in that space &mdash; e.g. the pre-day <em>-MC</em> room and the main-day room. A combined pre-day room
            goes under each physical room it spans. The tablet shows, counts down to and collects for whichever
            ticked room has a session at that date and time.
        </p>
        @if (Model.MapWarnings.Count > 0)
        {
            <div style="margin:10px 0;">
                @foreach (var w in Model.MapWarnings)
                {
                    <div class="pr-warn">⚠ @w.Text</div>
                }
            </div>
        }
        @if (Model.PhysicalRooms.Count > 0)
        {
            <div style="overflow-x:auto;">
            <table class="grid pr-grid">
                <thead><tr><th>Physical room</th><th>Schedule rooms held here</th><th></th></tr></thead>
                <tbody>
                @foreach (var pr in Model.PhysicalRooms)
                {
                    var mapped = pr.Placements.Select(p => p.EvaluationRoomId).ToHashSet();
                    var tablets = Model.Devices.Count(d => d.IsActive && d.PhysicalRoomId == pr.Id);
                    <tr>
                        <td>
                            <form method="post" asp-page-handler="SavePhysicalRoom" id="pr-@pr.Id">
                                <input type="hidden" name="id" value="@pr.Id" />
                                <input class="pr-name" name="name" value="@pr.Name" maxlength="200" aria-label="Name of @pr.Name" />
                            </form>
                            <div class="dev-sub">@tablets tablet(s)</div>
                            @* §1354 — the QR policy for every session held here. *@
                            <form method="post" asp-page-handler="SetRoomQrPolicy" style="margin-top:6px;">
                                <input type="hidden" name="id" value="@pr.Id" />
                                <label class="dev-sub" style="display:block;">QR asks</label>
                                <select name="policy" onchange="this.form.submit()" aria-label="QR policy for @pr.Name" style="width:100%;max-width:360px;">
                                    <option value="">Default — @FeedbackCapturePolicies.Label(Model.DefaultQrPolicy)</option>
                                    @foreach (var pol in FeedbackCapturePolicies.QrChoices)
                                    {
                                        <option value="@((int)pol)" selected="@(pr.QrCapturePolicy == pol)">@FeedbackCapturePolicies.Label(pol)</option>
                                    }
                                </select>
                            </form>
                            @* §1355 — the QR page's symbols for sessions held here. *@
                            <form method="post" asp-page-handler="SetRoomQrSymbols" style="margin-top:6px;">
                                <input type="hidden" name="id" value="@pr.Id" />
                                <label class="dev-sub" style="display:block;">QR shows</label>
                                <select name="symbols" onchange="this.form.submit()" aria-label="QR symbols for @pr.Name" style="width:100%;max-width:360px;">
                                    <option value="">Default — @RatingSymbolChoices.Label(Model.DefaultQrSymbols)</option>
                                    @foreach (var s in RatingSymbolChoices.All)
                                    {
                                        <option value="@((int)s)" selected="@(pr.QrRatingSymbols == s)">@RatingSymbolChoices.Label(s)</option>
                                    }
                                </select>
                            </form>
                        </td>
                        <td>
                            <div class="pr-rooms">
                                @foreach (var room in Model.Rooms)
                                {
                                    <label>
                                        <input type="checkbox" form="pr-@pr.Id" name="roomIds" value="@room.Id" checked="@mapped.Contains(room.Id)" />
                                        <span>@room.Name</span>
                                    </label>
                                }
                            </div>
                        </td>
                        <td>
                            <button type="submit" form="pr-@pr.Id" class="btn btn-primary">Save</button>
                            @if (tablets == 0)
                            {
                                <form method="post" asp-page-handler="DeletePhysicalRoom" style="margin-top:6px;"
                                      onsubmit="return confirm('Delete physical room @pr.Name?');">
                                    <input type="hidden" name="id" value="@pr.Id" />
                                    <button type="submit" class="btn">Delete</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
        <form method="post" asp-page-handler="AddPhysicalRoom" style="display:flex;gap:6px;flex-wrap:wrap;margin-top:12px;">
            <input name="name" placeholder="New physical room, e.g. Room 16" maxlength="200" style="flex:1;min-width:0;max-width:280px;" />
            <button type="submit" class="btn">Add physical room</button>
        </form>
    </div>
}

@* ================================================================================
   §784.7(A) — ONBOARDING, merged in from the retired /Organizer/EvaluationOnboarding.

   🔴 THIS SECTION IS THE SECURITY CONTROL, and moving it did not weaken it. The provisioning
   endpoint is the only one in the system that accepts an UNAUTHENTICATED write, and it is safe
   precisely because everything it can do is put a row in the queue below. A unit there has no key,
   no upload URL, and cannot post a single response until somebody approves it here.
   ================================================================================ *@
@if (!Model.AccessDenied)
{
    <div class="card">
        <h2 style="margin-top:0;">
            Waiting for approval @if (Model.Pending.Count > 0) { <text>(@Model.Pending.Count)</text> }
        </h2>
        <p class="ob-muted" style="margin-top:0;">
            Units ask to join by calling the provisioning endpoint with the number printed on their
            enclosure. They can do nothing at all until you approve them &mdash; no key, no upload
            URL, no responses.
        </p>

        @if (Model.ProvisioningUnconfigured)
        {
            @* 🔒 The endpoint fails CLOSED without its secret. Say so here, because from the
               device's side this is indistinguishable from the server being down. *@
            <div class="ob-stop">
                <strong>Provisioning is switched off.</strong> The fleet bootstrap secret
                (<code>Evaluation:ProvisionSecret</code>) is not configured on this host, so the
                endpoint refuses every request with <code>503</code> and no device can onboard. This
                is the safe state, not a fault &mdash; but nothing will appear here until it is set.
            </div>
        }

        @if (Model.Pending.Count == 0)
        {
            <p class="ob-muted">
                Nothing waiting. A unit appears here within minutes of being powered on with the
                provisioning URL and bootstrap secret configured.
            </p>
        }
        else
        {
            <table class="ob-table">
                <thead>
                    <tr>
                        <th>Name / serial</th>
                        <th>Firmware</th>
                        <th>Asking since</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Pending)
                {
                    <tr>
                        @* 🔑 Serial FIRST and largest: the organizer doing this is holding the box,
                           and the printed number is the only one they can read off it. *@
                        @* §1266 — the name typed at enrollment, shown BEFORE approval: it is how an
                           organizer tells which iPad is asking (operator 2026-09-21, reported twice:
                           §1261 carried it onto the approved device but the queue never showed it). *@
                        <td data-label="Device">
                            @if (!string.IsNullOrWhiteSpace(r.Note))
                            {
                                <span class="ob-serial">@r.Note</span><br />
                                <code style="font-size:12px;color:#64748b;">@r.SerialNumber</code>
                            }
                            else
                            {
                                <span class="ob-serial">@r.SerialNumber</span>
                            }
                        </td>
                        <td data-label="Firmware" class="ob-muted">@(r.FirmwareVersion ?? "—")</td>
                        <td data-label="Asking since" class="ob-muted">
                            @Model.Local(r.RequestedAt)<br>
                            <span style="font-size:12px;">
                                asked @r.RequestCount&times;, last @Model.Local(r.LastRequestedAt)
                            </span>
                        </td>
                        <td class="ob-actions">
                            <form method="post" asp-page-handler="Approve">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn btn-primary">Approve</button>
                            </form>
                            <form method="post" asp-page-handler="Reject">
                                <input type="hidden" name="id" value="@r.Id" />
                                <button type="submit" class="btn">Refuse</button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="ob-muted" style="margin-top:12px;">
                After approval the unit collects its key on its next check-in &mdash; up to an hour
                away &mdash; and appears in the device list above once it has.
            </p>
        }
    </div>

    <div class="card">
        <h2 style="margin-top:0;">Health telemetry schedule</h2>

        @if (Model.TelemetryOffNow)
        {
            @* ⚠️ The consequence the operator accepted, said out loud. Silent telemetry also means
               no battery level and no cached-record count — the two numbers that catch a failing
               unit. *@
            <div class="ob-warn">
                <strong>Telemetry is OFF right now.</strong> No window covers this moment, so devices
                are not reporting battery level, signal or unflushed cache &mdash; the figures that
                catch a unit failing quietly.
                @if (Model.TelemetryNextOn is not null)
                {
                    <text> It comes back on <strong>@Model.Local(Model.TelemetryNextOn.Value)</strong>.</text>
                }
                else
                {
                    <text> No future window is scheduled.</text>
                }
            </div>
        }
        else
        {
            <div class="ob-ok"><strong>Telemetry is ON right now.</strong></div>
        }

        <p class="ob-muted">
            Times are <strong>Copenhagen time</strong>. Devices send health data only inside an
            active window; outside every window they stay quiet, which is what keeps the SIM data
            plan and the battery intact.
        </p>

        <table class="ob-table">
            <thead><tr><th>From</th><th>To</th><th>What for</th><th>Scope</th><th></th></tr></thead>
            <tbody>
            @foreach (var w in Model.Windows)
            {
                var live = w.IsActive && w.FromUtc <= Model.Now && Model.Now < w.ToUtc;
                <tr style="@(w.IsActive ? "" : "opacity:.55;")">
                    <td data-label="From">@Model.Local(w.FromUtc)</td>
                    <td data-label="To">@Model.Local(w.ToUtc)</td>
                    <td data-label="What for">
                        @(w.Label ?? "—")
                        @if (live) { <span class="ob-pill ob-on" style="margin-left:6px;">active now</span> }
                    </td>
                    <td data-label="Scope" class="ob-muted">
                        @(w.EvaluationDeviceId is null ? "all devices" : $"device #{w.EvaluationDeviceId}")
                    </td>
                    <td>
                        <form method="post" asp-page-handler="ToggleWindow">
                            <input type="hidden" name="id" value="@w.Id" />
                            <button type="submit" class="btn">@(w.IsActive ? "Park" : "Enable")</button>
                        </form>
                    </td>
                </tr>
            }
            @if (Model.Windows.Count == 0)
            {
                <tr><td colspan="5" class="ob-muted">
                    No windows yet &mdash; telemetry is off permanently until you add one.
                </td></tr>
            }
            </tbody>
        </table>

        <form method="post" asp-page-handler="AddWindow"
              style="margin-top:16px;display:flex;gap:10px;flex-wrap:wrap;align-items:flex-end;">
            <div>
                <label class="ob-muted" for="from">From (Copenhagen)</label><br>
                <input type="datetime-local" id="from" name="from" required />
            </div>
            <div>
                <label class="ob-muted" for="to">To (Copenhagen)</label><br>
                <input type="datetime-local" id="to" name="to" required />
            </div>
            <div>
                <label class="ob-muted" for="label">What for</label><br>
                <input type="text" id="label" name="label" placeholder="install week" maxlength="200" />
            </div>
            <button type="submit" class="btn btn-primary">Add window</button>
        </form>

        @if (Model.TelemetryRows.Count > 0)
        {
            <h3>Per-unit telemetry</h3>
            <table class="ob-table">
                <thead><tr><th>Serial</th><th>Telemetry</th><th>Hard switch</th></tr></thead>
                <tbody>
                @foreach (var row in Model.TelemetryRows)
                {
                    <tr>
                        <td data-label="Serial">
                            <span class="ob-serial">@CommunityHub.Pages.Organizer.EvaluationDevicesModel.DisplayName(row.Device)</span>
                            @if (CommunityHub.Pages.Organizer.EvaluationDevicesModel.HasCustomName(row.Device))
                            {
                                <br /><code style="font-size:12px;color:#64748b;">@row.Device.SerialNumber</code>
                            }
                        </td>
                        <td data-label="Telemetry">
                            <span class="ob-pill @(row.EffectivelyOn ? "ob-on" : "ob-off")">
                                @(row.EffectivelyOn ? "sending" : "silent")
                            </span>
                            <span class="ob-muted" style="margin-left:6px;">@row.Why</span>
                        </td>
                        <td>
                            <form method="post" asp-page-handler="ToggleDeviceHealth">
                                <input type="hidden" name="id" value="@row.Device.Id" />
                                <button type="submit" class="btn">
                                    @(row.Device.HealthTelemetryEnabled ? "Hard-disable" : "Allow")
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
            <p class="ob-muted" style="margin-top:12px;">
                The hard switch always wins: a unit hard-disabled here stays silent no matter what
                the schedule says.
            </p>
        }
    </div>
}
