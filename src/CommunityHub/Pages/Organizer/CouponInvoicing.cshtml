@page
@model CommunityHub.Pages.Organizer.CouponInvoicingModel
@using CommunityHub.Core.Domain
@{
    ViewData["Title"] = "Coupon invoicing";
}

@* 🔒 §787.2 — mobile-first (~360px). One CARD per coupon, not a five-column grid: the edit form
   has to be usable on a phone, and a table with an inline form in every row is not. *@
<style>
    .ci-card { border:1px solid #e5e7eb; border-radius:10px; padding:12px 14px; margin:10px 0; }
    .ci-card.attention { border-left:4px solid #c8322a; background:#fdf6f5; }
    .ci-name { font-weight:700; font-size:16px; overflow-wrap:anywhere; }
    .ci-meta { color:#6b7280; font-size:13px; }
    .ci-chip { display:inline-block; border-radius:999px; padding:2px 9px; font-size:12px; font-weight:700; }
    .ci-chip.warn { background:#fdecea; color:#c8322a; }
    .ci-chip.ok { background:#eef7ee; color:#1E7A3C; }
    .ci-chip.muted { background:#eef2f7; color:#475569; }
    .ci-grid { display:flex; flex-wrap:wrap; gap:10px; align-items:flex-end; margin-top:10px; }
    .ci-grid label { display:block; font-size:12px; color:#6b7280; }
    .ci-grid input, .ci-grid select { min-width:0; max-width:100%; }
    .ci-actions { display:flex; flex-wrap:wrap; gap:8px; margin-top:8px; }

    /* 🔴 §1100 — A FORM MUST LOOK LIKE ONE FORM. Two adjacent form elements with no boundary is how
       "Save" silently discarded the ticket class and quantity typed just above it: those fields
       belong to the allocation form, Save posts the settings form, and nothing on screen said so
       (operator 2026-08-20: *"bug when i click save it forgets the ticket class + amount"* ·
       *"i also find that it is very confusing to do this"*). Each block is now a titled panel
       ending in its own button. */
    .ci-block { border:1px solid #e3e7ee; border-radius:10px; padding:10px 12px; margin:12px 0; background:#fcfdff; }
    .ci-block > h4 { margin:0 0 2px; font-size:13.5px; }
    .ci-block > .ci-meta { margin:0 0 6px; }
    .ci-block.buy { background:#f7fbf8; border-color:#cfe6d6; }
</style>

<div class="card">
    <h1>Coupon invoicing</h1>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
        <p><a asp-page="/Index">Back to hub</a></p>
        return;
    }

    <p>
        Which Backstage coupon is billed to which e-conomic customer. This replaces the
        <code>ZohoBackstageCoupons_Invoicing.csv</code> file &mdash; edit it here and it takes effect
        without a deploy.
    </p>
    @* §787.12 — BEFORE TICKET SALE there is nothing to discover, so the page must not read as
       "nothing to do". Configuring the list up front is the whole job at this point. *@
    @if (Model.TotalClaims == 0)
    {
        <p class="ci-meta">
            <strong>No coupon tickets have been claimed yet</strong> &mdash; ticket sale has not
            started. That is expected: set up the full promo-code list now, and every claim is
            billable the moment it arrives instead of waiting for someone to map it.
        </p>
    }
    else
    {
        <p class="ci-meta">
            Claims are read from the orders CEH already mirrors, so this page needs no Zoho call.
            <strong>@Model.TotalClaims claimed coupon ticket(s)</strong> found in this edition.
        </p>
    }
    <p class="ci-meta">
        Editing a rule here never invoices anything &mdash; the hourly job does that, and only when
        its feature switch is on and dry-run is off.
    </p>

    @* 🔴 §787.14 — Zoho exposes NO create-coupon API, so this page cannot make a coupon exist in
       Backstage. Saying so here is not pedantry: adding a row and assuming the code is now live is
       exactly the mistake that ends with a partner given a code that nothing accepts. *@
    <p style="background:#fff4e5;border-left:4px solid #d97706;padding:10px 12px;border-radius:4px;">
        <strong>This page does not create coupons in Zoho.</strong> Backstage has no API for that,
        so the promo code itself must be created in <strong>Zoho Backstage</strong>. What you set
        here is only <em>who gets invoiced</em> when that code is claimed &mdash; the two lists have
        to be kept in step by hand, and a code mapped here that does not exist in Backstage simply
        never gets claimed.
    </p>
    <p><a asp-page="/Organizer/Setup">&larr; Back to setup</a></p>
</div>

@if (Model.Message is not null)
{
    <div class="card"><p role="status" style="color:#0a6;margin:0;">@Model.Message</p></div>
}
@if (Model.Error is not null)
{
    <div class="card"><p role="alert" class="error" style="margin:0;">@Model.Error</p></div>
}


@* §798.2 — THE ADD FORM IS AT THE TOP. Operator 2026-08-04: *"can the add a single coupn be added
   to top instead of bottom to avoid scrolling"*. With a real list of coupons it sat below every
   row, so adding one meant scrolling past all of them. Mapping a code BEFORE it is used is also the
   good case — no claim ever waits for a decision. *@
<div class="card">
    <h2 style="margin-top:0;">Add a single coupon</h2>
    <p class="ci-meta">
        Mapping a code before it is used means no claim ever waits for a decision.
    </p>
    <form method="post" asp-page-handler="Save">
        <input type="hidden" name="SettingId" value="0" />
        <div class="ci-grid">
            @* §1108 — WIDE ENOUGH FOR A REAL CODE (operator 2026-08-21: *"double the width of the
               coupon name - this cannot fit there ELDK27-Arrow-Denmark-pool2"*). The names in use
               are ~28 characters, and the default input width showed about half of one — so the
               field he types most, and the one that must match Backstage EXACTLY, was the one he
               could not read back. *@
            <div style="flex:0 1 340px;">
                <label for="new-name">Coupon name</label>
                @* §797.3 — the redirect loses posted fields, so a refused name comes back here
                   rather than having to be typed again. *@
                <input id="new-name" type="text" name="CouponName" required maxlength="200"
                       value="@(Model.DraftCouponName ?? "")" style="width:100%;" />
            </div>
            <div>
                <label for="new-bt">Billing type</label>
                <select id="new-bt" name="BillingType">
                    @foreach (var t in Enum.GetValues<CouponBillingType>())
                    {
                        <option value="@t">@CommunityHub.Pages.Organizer.CouponInvoicingModel.DisplayName(t)</option>
                    }
                </select>
            </div>
            <div>
                <label for="new-cust">e-conomic customer</label>
                @if (Model.CustomerPickerAvailable)
                {
                    <select id="new-cust" name="ErpCustomerNumber" style="max-width:260px;">
                        <option value="">— none —</option>
                        @foreach (var c in Model.Customers)
                        {
                            <option value="@c.CustomerNumber">@c.Name (@c.CustomerNumber)</option>
                        }
                    </select>
                }
                else
                {
                    <input id="new-cust" type="number" name="ErpCustomerNumber" min="1" style="width:150px;" />
                }
            </div>
            <div style="flex:1 1 200px;">
                <label for="new-note">Notes</label>
                <input id="new-note" type="text" name="Notes" maxlength="400" style="width:100%;" />
            </div>
            <button type="submit" class="btn">Add</button>
        </div>
    </form>
    @* ⚠️ The requester is picked on the SAVED row, not here: its dropdown is the contact list of
       the customer this coupon is billed to, and that customer does not exist until it is saved. *@
    <p class="ci-meta" style="margin-bottom:0;">
        Pick the <strong>requester</strong> (the invoice&rsquo;s Att person) on the coupon once it is
        added &mdash; the list comes from that customer&rsquo;s own e-conomic contacts.
    </p>
</div>

@* 🔴 THE POINT OF THE PAGE. A claimed-but-unmapped coupon is a ticket nobody can bill — lost
   revenue with a clock on it, not a tidy-up task. It goes at the top and it is loud. *@
@if (Model.AttentionCount > 0)
{
    <div class="card" style="border-left:4px solid #c8322a;">
        <h2 style="margin-top:0;color:#c8322a;">
            @Model.AttentionCount coupon(s) need a decision
        </h2>
        <p style="margin:0;">
            Either someone has claimed a ticket with these codes and CEH cannot invoice anyone for it
            &mdash; set the billing type and the e-conomic customer below and the next hourly run
            picks them up &mdash; or a <strong>prepaid pool</strong> is out of tickets or has no
            e-conomic invoice number recorded against it (§795.2), which means nothing here says the
            customer was ever billed for what they bought.
        </p>
    </div>
}

@foreach (var r in Model.Rows)
{
    <div class="ci-card @(r.NeedsAttention ? "attention" : "")">
        <div class="ci-name">@r.CouponName</div>
        <div class="ci-meta">
            @if (r.ClaimCount > 0)
            {
                <text><strong>@r.ClaimCount claim(s)</strong> &middot; @r.ClaimedValueDkk.ToString("N2") DKK</text>
            }
            else
            {
                <text>no claims yet</text>
            }
            @if (r.Setting?.FirstSeenClaimedAt is { } seen)
            {
                <text> &middot; first claimed @seen.UtcDateTime.ToString("dd MMM yyyy")</text>
            }
        </div>

        <div style="margin-top:6px;">
            @if (r.NeedsAttention)
            {
                <span class="ci-chip warn">needs a decision</span>
            }
            @* 🔴 §1099 — THESE TWO BADGES USED THE SAME THREE WORDS FOR TWO DIFFERENT THINGS.
               Both said "never invoiced": on a free coupon that means nobody is ever billed, and on
               a prepaid one it means no PER-CLAIM invoice — while the pool purchase itself is
               invoiced, booked and shown a few lines below as "invoice 170 (booked)" beside "all
               purchases billed". Read together they contradicted each other (operator 2026-08-20:
               *"wording seems conflicting, is it invoiced or not"*).

               🔑 The fix is to name the SUBJECT of the sentence. "Never invoiced" is only safe when
               there is nothing else on the page that IS invoiced. *@
            else if (r.BillingType == CouponBillingType.NoInvoicing)
            {
                <span class="ci-chip muted">free &mdash; nobody is billed</span>
            }
            else if (r.Setting?.IsPrepaid == true)
            {
                @* §794 — the partner already paid for the allocation, so billing them per claim
                   would charge them twice for tickets they own. *@
                <span class="ci-chip ok">prepaid &mdash; paid up front; claims are not invoiced</span>
            }
            else if (r.Setting?.IsInvoiceable == true)
            {
                <span class="ci-chip ok">billable &rarr; customer @r.ErpCustomerNumber</span>
            }
            else
            {
                <span class="ci-chip muted">not mapped</span>
            }
            <span class="ci-meta"> @CommunityHub.Pages.Organizer.CouponInvoicingModel.Describe(r.BillingType)</span>
        </div>

        @* 🔴 §794 — THE PREPAID POOL. This is the number the partner plans against, so it is shown
           before the editing controls, not below them. Remaining is deliberately allowed to go
           NEGATIVE: "0 left" reads as "fully used, fine", where "-3" says three people have tickets
           nobody paid for. *@
        @if (r.Pools.Count > 0)
        {
            <div style="margin-top:10px;padding:8px 10px;border-radius:8px;background:#f8fafc;">
                <div class="ci-meta" style="margin-bottom:4px;"><strong>Prepaid allocation</strong></div>
                @foreach (var view in r.Pools)
                {
                    var p = view.Balance;
                    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin:3px 0;">
                        <span style="min-width:90px;">@Model.TicketClassDisplay(p.TicketClassId, p.Label)</span>
                        <span>
                            <strong style="font-size:17px;color:@(p.IsOversubscribed ? "#c8322a" : p.IsLow ? "#b45309" : "#1E7A3C");">
                                @p.Remaining
                            </strong>
                            <span class="ci-meta"> left of @p.Purchased &middot; @p.Claimed claimed</span>
                            @if (view.Purchases.Count > 1)
                            {
                                @* §798.4 — say the total is a SUM. "75" alone hides that it was two
                                   agreements, which is the thing he needs when an invoice is queried. *@
                                <span class="ci-meta"> (@view.Purchases.Count purchases)</span>
                            }
                        </span>
                        @* §795.1 — the STATE. "closed" is a decision somebody made; "used in full"
                           is arithmetic and un-closes itself the moment a ticket is cancelled. *@
                        @if (p.ClosedByHand)
                        {
                            <span class="ci-chip muted">closed &mdash; agreement ended</span>
                        }
                        else if (p.IsOversubscribed)
                        {
                            <span class="ci-chip warn">
                                @(-p.Remaining) ticket(s) beyond what was paid for
                            </span>
                        }
                        else if (p.IsExhausted)
                        {
                            <span class="ci-chip warn">used in full</span>
                        }
                        else if (p.IsLow)
                        {
                            <span class="ci-chip warn">running low</span>
                        }
                        else
                        {
                            <span class="ci-chip ok">open</span>
                        }

                        @* 🔴 §795.2/§798.4 — per PURCHASE. A pool topped up after being invoiced
                           once is NOT billed, and one flag on the pool would have said it was. *@
                        @if (p.IsBilled)
                        {
                            <span class="ci-chip ok">all purchases billed</span>
                        }
                        else
                        {
                            <span class="ci-chip warn">
                                @p.UnbilledPurchases purchase(s) with no invoice number
                            </span>
                        }
                    </div>

                    @* 🔴 §798.4 — THE PURCHASE HISTORY. "50 in January on invoice 20147, 25 more in
                       March on 20233" — same coupon code, separate agreements, separate invoices.
                       Each row carries its own number because each one was billed on its own. *@
                    <div style="margin:2px 0 8px 0;padding-left:8px;border-left:2px solid #e5e7eb;">
                        @foreach (var buy in view.Purchases)
                        {
                            <form method="post" asp-page-handler="SetPoolInvoice" class="ci-grid"
                                  style="margin:2px 0;gap:8px;">
                                <input type="hidden" name="PoolPurchaseId" value="@buy.Id" />
                                <span style="min-width:150px;">
                                    <strong>@buy.Quantity</strong> ticket(s)
                                    <span class="ci-meta">&middot; @buy.CreatedAt.UtcDateTime.ToString("dd MMM yyyy")</span>
                                    @* §992 — what this purchase was WORTH. Null on anything bought
                                       before the price was captured, and on a hand-raised invoice. *@
                                    @if (buy.AgreedValueDkk is { } v)
                                    {
                                        <span class="ci-meta">
                                            &middot; @buy.Quantity &times; @buy.UnitPriceDkk?.ToString("0.##") =
                                            <strong>@v.ToString("N2") DKK</strong>
                                        </span>
                                    }
                                </span>
                                <div>
                                    <label for="pin-@buy.Id">e-conomic invoice no.</label>
                                    <input id="pin-@buy.Id" type="text" name="PoolErpInvoiceNumber"
                                           value="@(buy.ErpInvoiceNumber ?? "")" maxlength="60"
                                           placeholder="not billed yet" style="width:150px;" />
                                </div>
                                <button type="submit" class="btn">Save invoice no.</button>
                                @if (!buy.IsBilled)
                                {
                                    <span class="ci-chip warn">not billed</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(buy.Notes))
                                {
                                    <span class="ci-meta">@buy.Notes</span>
                                }
                            </form>
                        }
                    </div>

                    @* 🔑 §992 — THE RECONCILE LINE. Operator 2026-08-09: *"the amount must now reflect
                       a max of 30"* / *"so the counter matches the max number inside zoho"*. This is
                       the number he types into Backstage as the code's limit, said once, in one
                       place, so the two systems cannot drift through arithmetic done twice. *@
                    var purchasedTotal = view.Purchases.Sum(x => x.Quantity);
                    var valued = view.Purchases.Where(x => x.AgreedValueDkk is not null).ToList();
                    var valueTotal = valued.Sum(x => x.AgreedValueDkk!.Value);
                    var unpriced = view.Purchases.Count - valued.Count;
                    <div style="margin:0 0 8px 0;padding:8px 10px;border-radius:8px;background:#eff6ff;">
                        <span>Set the promo code&rsquo;s max in Backstage to
                            <strong>@purchasedTotal</strong> ticket(s)</span>
                        <span class="ci-meta">
                            &middot; @view.Purchases.Count purchase(s)
                            @if (valued.Count > 0)
                            {
                                <text>&middot; agreed value <strong>@valueTotal.ToString("N2") DKK</strong></text>
                            }
                            @* ⚠️ A total that silently under-counts is worse than one that admits a
                               gap — purchases from before the price was captured have none. *@
                            @if (unpriced > 0)
                            {
                                <text>&middot; @unpriced purchase(s) have no price recorded, so they
                                are NOT in that total</text>
                            }
                        </span>
                    </div>

                    <div class="ci-actions" style="margin:0 0 8px 0;">
                        <form method="post" asp-page-handler="SetPoolThreshold" class="ci-grid" style="margin:0;">
                            <input type="hidden" name="PoolAllocationId" value="@p.AllocationId" />
                            <div>
                                <label for="pt-@p.AllocationId">Warn at</label>
                                <input id="pt-@p.AllocationId" type="number" name="PoolThreshold" min="0"
                                       value="@p.LowBalanceThreshold" style="width:80px;" />
                            </div>
                            <button type="submit" class="btn">Set</button>
                        </form>

                        <form method="post" asp-page-handler="RemovePool" style="margin:0;">
                            <input type="hidden" name="PoolAllocationId" value="@p.AllocationId" />
                            <button type="submit" style="background:none;border:1px solid #d1d5db;color:#374151;
                                                         padding:4px 10px;border-radius:6px;font-size:13px;cursor:pointer;">
                                Remove allocation
                            </button>
                        </form>

                        @* §795.1 — closing EARLY is the case no derivation can express. *@
                        <form method="post" asp-page-handler="ClosePool" style="margin:0;">
                            <input type="hidden" name="PoolAllocationId" value="@p.AllocationId" />
                            <input type="hidden" name="reopen" value="@(p.ClosedByHand ? "true" : "false")" />
                            <button type="submit" style="background:none;border:1px solid #d1d5db;color:#374151;
                                                         padding:4px 10px;border-radius:6px;font-size:13px;cursor:pointer;">
                                @(p.ClosedByHand ? "Re-open allocation" : "Close allocation")
                            </button>
                        </form>
                    </div>

                    @* 🔴 §1103 — THE EXTEND SITS AT THE BOTTOM, AFTER THE POOL'S OWN FACTS (operator
                       2026-08-20: *"move also the extend below the other info so it is kept
                       together"*). It used to be wedged between the purchase line and the Warn /
                       Remove / Close row, which split the pool's STATUS across the one control that
                       changes it and put a money-spending form in the middle of read-only facts.
                       Status first, then the actions on it.

                       🔒 §992 — he types the same number he will set in Backstage; CEH derives the
                       delta and invoices only that. It still adds a PURCHASE ROW rather than editing
                       a total, so "which invoice covers which tickets" stays answerable (§798.4). *@
                    <div class="ci-block buy" style="margin:8px 0 0;">
                        <h4>Increase this pool &mdash; this raises an invoice for the difference</h4>
                        <p class="ci-meta">
                            Same ticket class (<strong>@Model.TicketClassDisplay(p.TicketClassId, p.Label)</strong>).
                            A different class is a new coupon.
                        </p>
                        <form method="post" asp-page-handler="AddTickets" class="ci-grid" style="margin-top:0;">
                            <input type="hidden" name="SettingId" value="@r.Setting!.Id" />
                            <input type="hidden" name="PoolTicketClassId" value="@p.TicketClassId" />
                            <div>
                                <label for="top-@p.AllocationId">Increase to (new total)</label>
                                <input id="top-@p.AllocationId" type="number" name="PoolTargetTotal"
                                       min="@(purchasedTotal + 1)" placeholder="@(purchasedTotal + 10)"
                                       style="width:110px;" />
                            </div>
                            <div>
                                <label for="toppr-@p.AllocationId">Unit price (DKK)</label>
                                <input id="toppr-@p.AllocationId" type="number" name="PoolUnitPriceDkk"
                                       min="0" step="0.01" value="@Model.DefaultUnitPriceDkk" placeholder="@Model.DefaultUnitPriceDkk" style="width:120px;" />
                            </div>
                            <div>
                                <label for="topinv-@p.AllocationId">Invoice no. (optional)</label>
                                <input id="topinv-@p.AllocationId" type="text" name="PoolErpInvoiceNumber"
                                       maxlength="60" style="width:140px;" />
                            </div>
                            <button type="submit" class="btn">Increase &amp; invoice</button>
                        </form>
                        <p class="ci-meta" style="margin:6px 0 0;">
                            Enter the <strong>new total</strong>, not how many to add &mdash; the same
                            number you then set as the code&rsquo;s max in Backstage. This pool covers
                            <strong>@purchasedTotal</strong> today, so entering @(purchasedTotal + 10)
                            invoices the 10 extra. <strong>The code itself never changes</strong>, so
                            order links already sent out keep working.
                        </p>
                    </div>
                }
                <div class="ci-meta" style="margin-top:4px;">
                    Cancelled tickets return to the pool automatically &mdash; the balance is worked
                    out from live claims, so nothing needs crediting back. A pool that runs out
                    re-opens by itself when a ticket is cancelled; one you <strong>close</strong>
                    stays closed until you re-open it.
                </div>
            </div>
        }

        @* 🔑 §795.4 — "ability to see invoice number of sent invoices for coupon invoices". The
           numbers are READ BACK from e-conomic on every load and never stored: they live there, and
           a copy in CEH would go stale the moment one is booked, credited or deleted.
           ⚠️ A DRAFT number is provisional and is replaced when a human books it — so it is labelled
           as a draft, because a draft number quoted to a partner is not one they will recognise. *@
        @if (r.Invoices.Count > 0)
        {
            <div style="margin-top:10px;padding:8px 10px;border-radius:8px;background:#f8fafc;">
                @* §1100 — SAY WHAT THE LIST IS. Operator 2026-08-20, seeing two of them: *"i have 2
                   invoice - is the second for top-up"*. Yes — one per PURCHASE, so the original
                   allocation and each later increase each have their own. The reference beside each
                   (CouponPrepaid-1, -2, …) is what distinguishes them, and it was already on screen
                   without anything saying it was the answer to that question. *@
                <div class="ci-meta" style="margin-bottom:4px;">
                    <strong>e-conomic invoices for this coupon</strong> &mdash; one per purchase:
                    the first allocation, then one for each increase.
                </div>
                @foreach (var inv in r.Invoices)
                {
                    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin:2px 0;">
                        <span class="ci-chip @(inv.IsBooked ? "ok" : "muted")">@inv.Display</span>
                        <span class="ci-meta">@inv.Reference</span>
                    </div>
                }
                @if (r.Invoices.Any(i => !i.IsBooked))
                {
                    <div class="ci-meta" style="margin-top:4px;">
                        A <strong>draft</strong> reaches nobody until it is booked in e-conomic, and
                        its number changes when it is. Until then the customer has no invoice.
                    </div>
                }
            </div>
        }
        else if (r.ClaimCount > 0 && r.Setting?.IsInvoiceable == true)
        {
            <div class="ci-meta" style="margin-top:8px;">
                @if (Model.EconomicReachable)
                {
                    <text>No e-conomic invoice carries this coupon&rsquo;s reference yet.</text>
                }
                else
                {
                    @* ⚠️ Not the same statement, and the difference is the whole point: one means
                       uninvoiced, the other means we could not ask. *@
                    <text>e-conomic could not be read, so invoice numbers are unknown for now.</text>
                }
            </div>
        }

        @* 🔴 §799 — A POOL FROM A PREVIOUS BILLING TYPE. Operator 2026-08-04: *"i chaned type of
           coupon from claimed to prepaid and back to claimed. then count was still showing"*. The
           allocation is KEPT because it records money — what was bought and which invoice covered it
           — but it counts nowhere while the coupon is not prepaid: no balance, no chips, no
           attention, no alerts. Removing it is his decision, with the number in front of him. *@
        @if (r.DormantPools.Count > 0)
        {
            <div style="margin-top:10px;padding:8px 10px;border-radius:8px;background:#f3f4f6;color:#4b5563;">
                <div class="ci-meta" style="margin-bottom:4px;">
                    <strong>Prepaid allocation kept, but not in use</strong> &mdash; this coupon is
                    billed <em>@CommunityHub.Pages.Organizer.CouponInvoicingModel.DisplayName(r.BillingType)</em>,
                    so nothing is drawn from a pool. Switch it back to prepaid and this returns exactly
                    as it was.
                </div>
                @foreach (var view in r.DormantPools)
                {
                    <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:baseline;margin:3px 0;">
                        <span style="min-width:90px;">@Model.TicketClassDisplay(view.Balance.TicketClassId, view.Balance.Label)</span>
                        <span class="ci-meta">
                            @view.Balance.Purchased bought in @view.Purchases.Count purchase(s)
                            @{
                                var numbers = view.Purchases
                                    .Where(x => !string.IsNullOrWhiteSpace(x.ErpInvoiceNumber))
                                    .Select(x => x.ErpInvoiceNumber);
                            }
                            @if (numbers.Any())
                            {
                                <text>&middot; invoice @string.Join(", ", numbers)</text>
                            }
                        </span>
                        <form method="post" asp-page-handler="RemovePool" style="margin:0;">
                            <input type="hidden" name="PoolAllocationId" value="@view.Balance.AllocationId" />
                            <button type="submit" style="background:none;border:1px solid #d1d5db;color:#374151;
                                                         padding:3px 9px;border-radius:6px;font-size:12px;cursor:pointer;">
                                Remove it
                            </button>
                        </form>
                    </div>
                }
            </div>
        }

        @* §798.4 — buy tickets into a NEW pool (a class this coupon has no allocation for yet).
           Topping up an existing pool is the "Buy more" form on the pool itself, because that is
           where the balance and the earlier invoices are. *@
        @if (r.Setting is not null && r.Setting.IsPrepaid)
        {
            <div class="ci-block buy">
            <h4>Buy tickets into a new pool &mdash; this raises an invoice</h4>
            <p class="ci-meta">
                A separate action from the coupon settings below: it ends at
                <strong>Create Invoice</strong>. Pressing <em>Save</em> further down will <strong>not</strong>
                record what you type here.
            </p>
            <form method="post" asp-page-handler="AddTickets" class="ci-grid" style="margin-top:0;">
                <input type="hidden" name="SettingId" value="@r.Setting.Id" />
                @* 🔴 §1103 — DEFAULT TO THE CLASS THIS COUPON ALREADY SELLS (operator 2026-08-20:
                   *"the extend should default to the ticket class that was already bought"*). The
                   list is ordered by the edition's classes, so the browser preselected the FIRST one
                   — 1-day — on a coupon whose pool is 2-day. One slip and the coupon carries two
                   pools of different classes, which is not how he sells: *"if customer wants to buy
                   ither ticket classes we add a new coupon"*.

                   🔒 The other classes stay SELECTABLE, as he asked. This is a default, not a
                   restriction — the hub should make the usual thing effortless and the unusual thing
                   possible, not forbid it. *@
                @{
                    var existingClassId = r.Pools.FirstOrDefault()?.Balance.TicketClassId;
                }
                <div>
                    <label for="pc-@r.Setting.Id">Ticket class</label>
                    <select id="pc-@r.Setting.Id" name="PoolTicketClassId">
                        @foreach (var kv in Model.TicketClassLabels)
                        {
                            <option value="@kv.Key" selected="@(kv.Key == existingClassId)">@kv.Value</option>
                        }
                        @foreach (var pv in r.Pools.Where(pv => !Model.TicketClassLabels.ContainsKey(pv.Balance.TicketClassId)))
                        {
                            <option value="@pv.Balance.TicketClassId" selected="@(pv.Balance.TicketClassId == existingClassId)">@Model.TicketClassDisplay(pv.Balance.TicketClassId, pv.Balance.Label)</option>
                        }
                    </select>
                    @if (existingClassId is not null)
                    {
                        <span style="display:block;font-size:11.5px;color:#6b7280;max-width:230px;">
                            This coupon already sells
                            <strong>@Model.TicketClassDisplay(existingClassId, r.Pools.First().Balance.Label)</strong>.
                            A different class is normally a <em>new coupon</em> — to add more of the
                            same, use <em>Increase to new total</em> above.
                        </span>
                    }
                </div>
                <div>
                    <label for="pq-@r.Setting.Id">Tickets bought</label>
                    <input id="pq-@r.Setting.Id" type="number" name="PoolQuantity" min="1" placeholder="50" style="width:110px;" />
                </div>
                @* §990 — the price the hub cannot know. A prepaid pool exists BEFORE anybody
                   claims, so there is no claim to read a price off. *@
                <div>
                    <label for="pp-@r.Setting.Id">Unit price (DKK)</label>
                    <input id="pp-@r.Setting.Id" type="number" name="PoolUnitPriceDkk" min="0" step="0.01"
                           value="@Model.DefaultUnitPriceDkk" placeholder="@Model.DefaultUnitPriceDkk"
                           style="width:120px;" />
                </div>
                <div>
                    <label for="pinv-@r.Setting.Id">Invoice no. (optional)</label>
                    <input id="pinv-@r.Setting.Id" type="text" name="PoolErpInvoiceNumber" maxlength="60" style="width:140px;" />
                </div>
                <div>
                    <label for="pt-@r.Setting.Id">Warn at</label>
                    <input id="pt-@r.Setting.Id" type="number" name="PoolThreshold" min="0" placeholder="5" style="width:90px;" />
                </div>
                <button type="submit" class="btn">Create Invoice</button>
            </form>
            @* ⚠️ Says what the button DOES, because it now writes to a finance system. Filling in
               "Invoice no." deliberately suppresses the draft — that invoice already exists. *@
            <p class="ci-meta" style="margin:4px 0 0;">
                Records the tickets, creates the e-conomic draft invoice and fills in its number.
                Enter an <strong>Invoice no.</strong> instead if you already raised it by hand.
                You will also get an e-mail to create the promo code in Backstage &mdash; there is no
                coupon API, so that step stays manual.
            </p>
            </div>
        }

        <div class="ci-block">
        <h4>Coupon settings</h4>
        <p class="ci-meta">Who is billed, how the split works, and what the customer receives. Ends at <strong>Save</strong>.</p>
        <form method="post" asp-page-handler="Save">
            <input type="hidden" name="SettingId" value="@(r.Setting?.Id ?? 0)" />
            <input type="hidden" name="CouponName" value="@r.CouponName" />
            <div class="ci-grid">
                <div>
                    <label for="bt-@r.CouponName">Billing type</label>
                    @* §798.3 — his words, not the enum's. The stored value is unchanged. *@
                    <select id="bt-@r.CouponName" name="BillingType">
                        @foreach (var t in Enum.GetValues<CouponBillingType>())
                        {
                            <option value="@t" selected="@(t == r.BillingType)">
                                @CommunityHub.Pages.Organizer.CouponInvoicingModel.DisplayName(t)
                            </option>
                        }
                    </select>
                </div>
                <div>
                    <label for="cust-@r.CouponName">e-conomic customer</label>
                    @* §787.13 — pick by NAME from the live API. The CSV's 111111111 for CBS was a
                       number that does not exist in e-conomic at all; a picked name cannot be
                       wrong that way. Falls back to the number box when e-conomic is unreachable,
                       so the page never becomes unusable because a third party is down. *@
                    @if (Model.CustomerPickerAvailable)
                    {
                        <select id="cust-@r.CouponName" name="ErpCustomerNumber" style="max-width:260px;">
                            <option value="">— none —</option>
                            @foreach (var c in Model.Customers)
                            {
                                <option value="@c.CustomerNumber" selected="@(c.CustomerNumber == r.ErpCustomerNumber)">
                                    @c.Name (@c.CustomerNumber)
                                </option>
                            }
                        </select>
                    }
                    else
                    {
                        <input id="cust-@r.CouponName" type="number" name="ErpCustomerNumber"
                               value="@(r.ErpCustomerNumber?.ToString() ?? "")" min="1" style="width:150px;" />
                    }
                </div>
                @* 🔑 §798.1 — THE REQUESTER = the invoice's Att person. The list is this coupon's own
                   customer's e-conomic contacts; a contact from another customer is one e-conomic
                   rejects, or worse accepts against the wrong account. Changing the customer clears
                   it, which is why it is saved by the same button. *@
                <div>
                    <label for="req-@r.CouponName">Requester (Att on invoice)</label>
                    @{
                        var contacts = r.ErpCustomerNumber is { } cn
                            && Model.ContactsByCustomer.TryGetValue(cn, out var list)
                            ? list : null;
                    }
                    @if (contacts is { Count: > 0 })
                    {
                        <select id="req-@r.CouponName" name="RequesterContactNumber" style="max-width:240px;">
                            <option value="">— customer default —</option>
                            @foreach (var c in contacts)
                            {
                                <option value="@c.ContactNumber"
                                        selected="@(c.ContactNumber == r.Setting?.RequesterContactNumber)">
                                    @c.Name
                                </option>
                            }
                        </select>
                    }
                    else if (r.ErpCustomerNumber is null)
                    {
                        <span class="ci-meta">pick a customer first</span>
                    }
                    else
                    {
                        @* ⚠️ Says WHY it is empty. "No contacts" and "e-conomic could not be read"
                           are different problems and only one of them is fixable here. *@
                        @* §991 — a PER-CUSTOMER read failure used to fall through to "no contacts
                           on this customer", because the flag consulted was the page-wide one set
                           by the CUSTOMER-LIST call. That stated as fact something the page did
                           not know, and sent him to fix data that may be perfectly fine. *@
                        <span class="ci-meta">
                            @(Model.EconomicReachable
                              && !Model.ContactLoadFailedFor.Contains(r.ErpCustomerNumber!.Value)
                                ? "no contacts on this customer"
                                : "e-conomic could not be read")
                            @if (r.Setting?.RequesterName is { Length: > 0 } who)
                            {
                                <text> &mdash; currently @who</text>
                            }
                        </span>
                    }
                </div>
                <div style="flex:1 1 200px;">
                    <label for="note-@r.CouponName">Notes</label>
                    <input id="note-@r.CouponName" type="text" name="Notes"
                           value="@(r.Setting?.Notes ?? "")" maxlength="400" style="width:100%;" />
                </div>
                @* 🔴 §1107 — THE NEXT FOUR FIELDS ARE AD-HOC ONLY (operator 2026-08-21: *"it makes no
                   sense to show invoice every 14 days for a prepaid coupon"*). He is right, and it
                   applies to all four rather than just the cadence:

                     • Invoice every (days) — batches CLAIMS into an invoice. A prepaid claim is
                       never invoiced (§794): it draws on a pool that was paid for up front.
                     • Agreed price / ticket and the invoiced % — the §1091 split, which only exists
                       where the claim itself is billed.
                     • Max tickets (cap) — a prepaid pool's ceiling IS its purchased quantity, shown
                       on the allocation above. A second cap here would be a number that could
                       disagree with it.

                   ⚠️ Keyed on the SAVED billing type, not the dropdown's current value — the page
                   does not re-render as he changes it. So switching prepaid → ad-hoc shows the
                   fields after the first Save, which the note below says. *@
                @if (r.BillingType == CouponBillingType.ClaimableAdHocPaymentByCustomer)
                {
                <div style="flex:0 1 150px;">
                    <label for="ivl-@r.CouponName">Invoice every (days)</label>
                    <input id="ivl-@r.CouponName" type="number" name="InvoiceIntervalDays" min="0" step="1"
                           value="@(r.Setting?.InvoiceIntervalDays?.ToString() ?? "")"
                           placeholder="@Model.DefaultInvoiceIntervalDays" style="width:100%;" />
                    <span style="display:block;font-size:11.5px;color:#6b7280;">
                        Claims are batched into one invoice. Blank = @Model.DefaultInvoiceIntervalDays;
                        0 = invoice each claim.
                        @if (r.Setting?.LastInvoicedAt is { } li)
                        {
                            <text>Last invoiced @li.ToString("d MMM yyyy").</text>
                        }
                    </span>
                </div>
                @* 🔴 §1091 — THE SPLIT. Two fields, and the labels carry the whole meaning:
                   the percentage is the share the LINKED COMPANY is invoiced, not the attendee's
                   discount. At 50/50 both readings give the same number, so the ambiguity only
                   shows up the first time somebody types 30 — which is exactly why the operator
                   asked for "clear notice that this is the percentage the linked company will be
                   invoiced of". *@
                <div style="flex:0 1 170px;">
                    <label for="price-@r.CouponName">Agreed price / ticket (DKK)</label>
                    <input id="price-@r.CouponName" type="number" name="AgreedUnitPriceDkk"
                           min="0" step="0.01"
                           value="@(r.Setting?.AgreedUnitPriceDkk?.ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) ?? "")"
                           placeholder="Zoho price" style="width:100%;" />
                    <span style="display:block;font-size:11.5px;color:#6b7280;">
                        Blank = the price the ticket actually sold for in Zoho.
                    </span>
                </div>
                <div style="flex:0 1 190px;">
                    <label for="share-@r.CouponName">Linked company is invoiced</label>
                    <div style="display:flex;align-items:center;gap:6px;">
                        <input id="share-@r.CouponName" type="number" name="InvoicedSharePercent"
                               min="1" max="100" step="1"
                               value="@(r.Setting?.InvoicedSharePercent?.ToString() ?? "")"
                               placeholder="100" style="width:100%;" />
                        <span style="font-weight:600;">%</span>
                    </div>
                    <span style="display:block;font-size:11.5px;color:#6b7280;">
                        <strong>Of the price above — this is what @(string.IsNullOrWhiteSpace(r.Setting?.ErpCustomerNumber?.ToString()) ? "the linked company" : "customer " + r.Setting!.ErpCustomerNumber) is billed.</strong>
                        Blank = 100%. The attendee pays the rest by card, so set the matching
                        discount on the promo code in Backstage yourself — CEH cannot.
                    </span>
                </div>
                @* §1094 — the agreed ceiling for a capped ad-hoc coupon. 🔴 CEH cannot ENFORCE it:
                   the limit that stops a claim is the one on the promo code in Backstage, which has
                   no API. This is what the hub reports and invoices against, and raising it re-sends
                   the Backstage instruction so the two stay in step. *@
                <div style="flex:0 1 165px;">
                    <label for="cap-@r.CouponName">Max tickets (cap)</label>
                    <input id="cap-@r.CouponName" type="number" name="ClaimCapTickets" min="1" step="1"
                           value="@(r.Setting?.ClaimCapTickets?.ToString() ?? "")"
                           placeholder="no limit" style="width:100%;" />
                    <span style="display:block;font-size:11.5px;color:#6b7280;">
                        Blank = uncapped. Must match the limit on the code in Backstage —
                        the hub reports against it but cannot enforce it.
                    </span>
                </div>
                }
                else if (r.BillingType == CouponBillingType.AllocatedPrepaymentByCustomer)
                {
                    <div style="flex:1 1 100%;">
                        <span class="ci-meta">
                            Prepaid: the quantity, price and ceiling live on the
                            <strong>allocation above</strong> — claims draw on what was paid for, so
                            there is no billing period, no split and no separate cap.
                        </span>
                    </div>
                }
                else if (r.Setting is not null)
                {
                    <div style="flex:1 1 100%;">
                        <span class="ci-meta">
                            Pick <strong>Ad-hoc invoicing when claimed</strong> and Save to set a
                            billing period, an agreed price, a split or a cap.
                        </span>
                    </div>
                }
                @* 🔴 §1098 — WHAT THIS CUSTOMER RECEIVES ON A SCHEDULE. Both OFF by default and ticked
                   by hand (operator 2026-08-20: *"i prefer i set the tick on manually, so it isnt on
                   by default"*). Off is the safe direction: the failure mode of ON is a customer
                   contacted who should not have been, and that cannot be taken back.

                   🔴 §1111 — THE CLAIM-MAIL TICK IS GONE (operator 2026-08-21: *"i dont get the point
                   of having this tick … if there is also a button"*). He was right and it was a
                   defect, not a preference: the tick's ONLY effect was to make "Send the claim link
                   now" refuse. Two consents for one act, and the second one is invisible from where
                   the button is. These two remain because they gate things that happen WITHOUT him —
                   a link he has not issued, a mail on a timer. The claim invite has a button, and
                   pressing it is the decision.

                   🔑 The "one-off sale" category is these two left unticked, the claim button never
                   pressed, and an invoice interval of 7 — a configuration, not a new billing type,
                   because it collects money exactly like any other ad-hoc coupon. *@
                <div style="flex:1 1 100%;border-top:1px solid #eef0f4;margin-top:8px;padding-top:8px;">
                    <div style="font-size:12px;color:#6b7280;margin-bottom:4px;">
                        <strong>What this customer gets automatically</strong> — both off unless you
                        tick them. (The claim link is not here: it goes when you press
                        <em>Send the claim link now</em> below.)
                    </div>
                    <label style="display:inline-flex;align-items:center;gap:6px;margin-right:16px;font-weight:400;">
                        <input type="checkbox" name="IssueUsageLink" value="true"
                               @(r.Setting?.IssueUsageLink == true ? "checked" : "") />
                        Include in their secure usage link
                    </label>
                    <label style="display:inline-flex;align-items:center;gap:6px;font-weight:400;">
                        <input type="checkbox" name="SendUsageStatusMail" value="true"
                               @(r.Setting?.SendUsageStatusMail == true ? "checked" : "") />
                        Send the status mail every 2 weeks
                    </label>
                    <span style="display:block;font-size:11.5px;color:#6b7280;margin-top:4px;">
                        A one-off invoice sale wants neither — leave them unticked, don't send the
                        claim link, and set <em>Invoice every</em> to 7 days.
                    </span>
                </div>
                <button type="submit" class="btn primary">Save coupon settings</button>
            </div>
        </form>
        </div>

        @* 🔴 §1094b — AN OUTSTANDING REQUEST FROM THE PARTNER, shown where he can act on it. The
           ad-hoc cap box and the prepaid "increase to new total" box are both on this row; a
           request that lives only in an e-mail gets read once and then forgotten. *@
        @if (Model.CapRequestByCoupon.TryGetValue(r.CouponName, out var req))
        {
            <div style="margin-top:8px;padding:10px 12px;background:#fff7ed;border-left:4px solid #ea580c;border-radius:6px;font-size:13px;">
                <strong>This customer has asked for @req.Requested ticket(s) in total</strong>
                <span class="muted">— requested @req.At.ToString("d MMM yyyy HH:mm")</span>
                <div style="margin-top:6px;color:#6b7280;">
                    Raise the limit on the promo code in Backstage first — CEH cannot, and its number
                    must not promise a ceiling Zoho will refuse.
                </div>
                @if (r.BillingType == CouponBillingType.ClaimableAdHocPaymentByCustomer)
                {
                    <form method="post" asp-page-handler="ApplyCapRequest" style="margin-top:8px;">
                        <input type="hidden" name="SettingId" value="@(r.Setting?.Id ?? 0)" />
                        <button type="submit" class="btn">Set cap to @req.Requested</button>
                        <span class="muted" style="font-size:11.5px;">
                            No invoice — an ad-hoc coupon is billed as tickets are claimed.
                        </span>
                    </form>
                }
                else
                {
                    <div style="margin-top:6px;">
                        <strong>Prepaid:</strong> use <em>Increase to new total</em> on the pool below
                        and enter <strong>@req.Requested</strong> — that invoices only the difference.
                    </div>
                }
            </div>
        }

        @* 🔴 §1093 — THE PARTNER'S OWN VIEW OF THEIR USAGE. One link per BILLING CUSTOMER, not per
           coupon: Arrow sees every code billed to them through this single URL, and a code added
           next month appears in it automatically. Created by the coupon sweep; shown here because
           this is the page an organizer is on when a partner asks to see their sign-ups. *@
        @if (r.ErpCustomerNumber is { } cust && Model.MonitorLinkByCustomer.TryGetValue(cust, out var monitorUrl))
        {
            <div style="margin-top:8px;padding:8px 10px;background:#f6f8fa;border-radius:6px;font-size:12.5px;">
                <strong>Usage link for this customer</strong> — read-only, no login, safe to send:
                <br />
                <a href="@monitorUrl" target="_blank" rel="noopener" style="word-break:break-all;">@monitorUrl</a>
                <span style="display:block;color:#6b7280;margin-top:4px;">
                    @* §1116 — the name, with the number in brackets; a bare 9-digit id tells nobody
                       which customer this link belongs to. *@
                    Shows everyone who used <em>any</em> coupon billed to @Model.CustomerLabel(cust) — including
                    codes added later. Revoke it on
                    <a asp-page="/Organizer/AttendeeMonitors">Attendee monitors</a>.
                </span>
            </div>
        }
        @* 🔴 §1016c — TELL THE REQUESTER. The only coupon mail that leaves the building: every
           other one goes to info@ and asks an organizer to do something. Preview first, always —
           it reaches a paying partner and there is no undo. *@
        <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-top:6px;">
            @* 🔴 §1095 — THE ONE-CLICK PATH (operator: *"i prefer to have you send this
               automatically"*). Confirming the Backstage code exists is the only fact CEH cannot
               discover, and it is exactly what must be true before an invite saying "you can now
               start claiming" is honest. Pressing it sends the mail, usage link included. The
               preview button beside it stays for reading first, and for re-sending. *@
            @* 🔴 §1106 — ONE BUTTON LOOKS LIKE THE ANSWER (operator 2026-08-21: *"i dont know what to
               click to send the info"*). Two buttons of identical blue weight sat side by side and
               neither label said which one SENDS: "Code is live in Backstage → notify customer" reads
               as a status change, and "Notify requester…" reads as the send. It is the other way
               round. Now the sending one is the only primary and says "Send", and the other is a
               plain secondary that says it only shows you the mail. *@
            @if (r.Setting is not null && r.Setting.ClaimInviteSentAt is null)
            {
                <form method="post" asp-page-handler="ConfirmCodeLive" style="display:inline;">
                    <input type="hidden" name="InviteSettingId" value="@r.Setting.Id" />
                    <button type="submit" class="btn primary">
                        &#9993; Send the claim link now
                    </button>
                </form>
                <span style="font-size:11.5px;color:#6b7280;">
                    (confirms the code is live in Backstage, then e-mails the customer)
                </span>
            }
            <form method="post" asp-page-handler="PreviewInvite" style="display:inline;">
                <input type="hidden" name="InviteSettingId" value="@(r.Setting?.Id ?? 0)" />
                @* §1093 — "again" when it has already gone: the stamp never blocked a re-send, but a
                   button reading the same as the first-time one beside "Sent 12 Aug" looks like it
                   would duplicate, so it was not pressed. *@
                <button type="submit" style="background:none;border:1px solid #d1d5db;color:#374151;
                                             padding:4px 10px;border-radius:6px;font-size:13px;cursor:pointer;"
                        @(r.Setting is null ? "disabled" : "")>
                    @(r.Setting?.ClaimInviteSentAt is null
                        ? "Show me the mail first…"
                        : "Send again…")
                </button>
            </form>
            @if (r.Setting?.ClaimInviteSentAt is { } sent)
            {
                <span style="font-size:11.5px;color:#6b7280;">
                    Sent @sent.ToString("d MMM yyyy HH:mm")
                    @(string.IsNullOrWhiteSpace(r.Setting.ClaimInviteSentToEmail)
                        ? "" : $"to {r.Setting.ClaimInviteSentToEmail}")
                    @if (r.ErpCustomerNumber is { } mc && Model.MonitorLinkByCustomer.ContainsKey(mc))
                    {
                        <text>— re-send to include their usage link (you preview it first).</text>
                    }
                </span>
            }
            else
            {
                <span style="font-size:11.5px;color:#6b7280;">Not yet notified.</span>
            }
        </div>

        @* 🔴 §1026 — THE PREVIEW RENDERS HERE, UNDER THE BUTTON THAT PRODUCED IT (operator
           2026-08-10: *"put the message near the button//action, not at top"*). It used to render at
           the top of the page: on a page with many coupons that put the answer a screen away from
           the question, and gave no clue WHICH coupon it belonged to.
           🔒 Matched on SettingId, so only the row he pressed shows it. *@
        @if (Model.Invite is { } preview && r.Setting is not null && preview.SettingId == r.Setting.Id)
        {
            <div style="border:2px solid #1565c0;border-radius:8px;padding:12px;margin-top:10px;">
                <strong style="font-size:14px;">
                    Claim invite &mdash; @preview.CouponName
                    <span style="font-weight:normal;color:#6b7280;font-size:12.5px;">
                        (@(preview.IsPrepaid ? "prepaid" : "ad-hoc") wording)
                    </span>
                </strong>
                @if (preview.Blocker is { } blocked)
                {
                    <p role="alert" class="error" style="margin:8px 0;">@blocked</p>
                }
                else
                {
                    <p style="margin:8px 0;font-size:14px;">
                        <strong>To:</strong> @preview.ToName &lt;@preview.ToEmail&gt;<br />
                        <strong>Subject:</strong> @preview.Subject
                    </p>
                    <div style="border:1px solid #e5e7eb;border-radius:6px;padding:12px;background:#fff;
                                max-height:420px;overflow:auto;">
                        @Html.Raw(preview.Html)
                    </div>
                    <form method="post" asp-page-handler="SendInvite" style="margin-top:12px;">
                        <input type="hidden" name="InviteSettingId" value="@preview.SettingId" />
                        <button type="submit" class="btn">Send this email to @preview.ToEmail</button>
                        <span style="font-size:12px;color:#6b7280;margin-left:8px;">
                            This goes to the customer. There is no undo.
                        </span>
                    </form>
                }
            </div>
        }

        @if (r.Setting is not null)
        {
            <div class="ci-actions">
                <form method="post" asp-page-handler="Delete">
                    <input type="hidden" name="SettingId" value="@r.Setting.Id" />
                    <button type="submit" style="background:none;border:1px solid #d1d5db;color:#374151;
                                                 padding:4px 10px;border-radius:6px;font-size:13px;cursor:pointer;">
                        Delete rule
                    </button>
                </form>
                @if (r.Setting.LastUpdatedByEmail is { Length: > 0 } who)
                {
                    <span class="ci-meta">last changed by @who</span>
                }
            </div>
        }
    </div>
}

