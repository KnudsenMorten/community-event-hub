@page
@using CommunityHub.Core.Integrations.Sessions
@model CommunityHub.Pages.Organizer.SessionSourceModel
@{
    ViewData["Title"] = "Session source";
}

@if (Model.AccessDenied)
{
    <div class="card">
        <h2>@ViewData["Title"]</h2>
        <p class="error" role="alert">@Localizer["Common.OrganizersOnly"]</p>
        <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    </div>
    return;
}

<style>
    .ss-opt { border:1px solid #dfe3e8; border-radius:8px; padding:12px 14px; margin:10px 0; }
    .ss-opt.active { border-color:#1c6b35; background:#f3fbf5; }
    .ss-opt h3 { margin:0 0 4px; font-size:15px; }
    .ss-note { color:#6b7280; font-size:13px; margin:4px 0 0; }
    .ss-tag { display:inline-block; font-size:11px; font-weight:700; border-radius:999px; padding:1px 8px; margin-left:6px; vertical-align:middle; }
    .ss-on  { background:#e7f6ec; color:#1c6b35; }
    .ss-off { background:#fef6e7; color:#8a5a00; }
    /* §551 — the "nobody ever chose this" warning and the audited history line. */
    .ss-unset { border:1px solid #fcd34d; background:#fffbeb; border-left:4px solid #d97706;
                border-radius:8px; padding:10px 12px; margin:0 0 10px; font-size:13.5px; line-height:1.55; }
    .ss-hist { color:#6b7280; font-size:12.5px; margin:0 0 10px; }
</style>

@* §551 — one block, used for BOTH stage cards. It answers the question the operator could not
   answer during a live incident: is this stage a decision, and who made it? *@
@{
    Func<CommunityHub.Core.Integrations.Sessions.SyncStageState, string,
         Microsoft.AspNetCore.Html.IHtmlContent> StageProvenance = (state, what) =>
    {
        var sb = new System.Text.StringBuilder();
        if (!state.IsConfigured)
        {
            sb.Append("<div class=\"ss-unset\"><strong>Not configured for this edition.</strong> ")
              .Append("Nothing has ever set a ").Append(what).Append(" stage for edition <strong>#")
              .Append(Model.EventId)
              .Append("</strong>, so the jobs fall back to stage&nbsp;1 &mdash; which looks identical to ")
              .Append("choosing stage&nbsp;1 on purpose. <strong>If you expected stage&nbsp;2, this is why ")
              .Append("it stopped.</strong> Activate the stage you want below and it becomes a stored ")
              .Append("decision.</div>");
        }
        if (state.LastChangeAt is not null)
        {
            sb.Append("<p class=\"ss-hist\">Last change: ")
              .Append(System.Net.WebUtility.HtmlEncode(state.LastChangeSummary ?? string.Empty))
              .Append(" &mdash; by <strong>")
              .Append(System.Net.WebUtility.HtmlEncode(state.LastChangeBy ?? "unknown"))
              .Append("</strong> on ")
              .Append(state.LastChangeAt.Value.UtcDateTime.ToString("yyyy-MM-dd HH:mm"))
              .Append(" UTC.</p>");
        }
        else
        {
            sb.Append("<p class=\"ss-hist\">No ").Append(what)
              .Append(" stage change has been recorded for this edition yet. Every change from now on ")
              .Append("is written to the audit trail with who made it, when, and from which stage.</p>");
        }
        return new Microsoft.AspNetCore.Html.HtmlString(sb.ToString());
    };
}

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="card"><p role="status" style="color:#0a6;margin:0;">@Model.Message</p></div>
}

<div class="card">
    <h1 style="margin-top:0;">@ViewData["Title"]</h1>
    <p>Where this edition's <strong>sessions</strong> (the agenda — titles, rooms, times, speaker links) are
       pulled from. Speakers are always imported from Sessionize; this setting governs only sessions.</p>
    <p><a asp-page="/Organizer/Index">&larr; @Localizer["Common.BackToOrganizerArea"]</a></p>

    @foreach (var o in Model.Options)
    {
        var isActive = o.Key == Model.ActiveKey;
        <div class="ss-opt @(isActive ? "active" : "")">
            <h3>
                @o.Label
                @if (isActive) { <span class="ss-tag ss-on">Active</span> }
                @if (!o.Available) { <span class="ss-tag ss-off">Not available yet</span> }
            </h3>
            <p class="ss-note">@o.Note</p>
            @if (!isActive && o.Available)
            {
                <form method="post" asp-page-handler="Set" style="margin-top:8px;">
                    <input type="hidden" name="source" value="@o.Key" />
                    <button type="submit">Use @o.Label</button>
                </form>
            }
        </div>
    }
</div>

<div class="card">
    <h2 style="margin-top:0;">Session sync direction</h2>
    <p>Choose the <strong>active sync stage</strong> for this edition. Only one stage is active at a time —
       you import one way, then later flip the direction. Stage&nbsp;1 is the default; stage&nbsp;2 pushes CEH
       sessions up to Zoho&nbsp;Backstage; stage&nbsp;3 activates the Zoho&nbsp;Backstage&nbsp;&rarr;&nbsp;CEH
       change-detection engine. Whichever stage is Active is the one the hourly jobs obey.</p>

    @StageProvenance(Model.SessionStage, "session")

    @* §326bm: "Active" now tracks the EFFECTIVE stage — a stage with no implementation can
       never be shown as Active (it used to be able to be both Active and "Not implemented
       yet" at once, which claimed a push that does not exist). *@
    @if (Model.DirectionIsStale)
    {
        <p class="ss-note" style="color:#92400e;">
            A stage with no implementation was previously selected and is being <strong>ignored</strong>.
            Sessionize&nbsp;&rarr;&nbsp;CEH (stage&nbsp;1) is what actually runs.
        </p>
    }
    @foreach (var d in Model.DirectionOptions)
    {
        var isActive = d.Direction == Model.EffectiveDirection;
        <div class="ss-opt @(isActive ? "active" : "")">
            <h3>
                Stage @d.Stage — @d.Label
                @if (isActive) { <span class="ss-tag ss-on">Active</span> }
                @if (!d.Implemented) { <span class="ss-tag ss-off">Not implemented yet</span> }
                @if (d.Implemented && d.Blocker is not null) { <span class="ss-tag ss-off">Needs setup</span> }
            </h3>
            <p class="ss-note">@d.Note</p>
            @* §333: a stage can be fully built and still do nothing today because an upstream
               scope is missing. Say which — "not implemented" would be a lie, and silence
               would be worse. *@
            @if (d.Blocker is not null)
            {
                <p class="ss-note" style="color:#92400e;">@d.Blocker</p>
            }
            @if (!isActive && d.Implemented)
            {
                <form method="post" asp-page-handler="SetDirection" style="margin-top:8px;">
                    <input type="hidden" name="stage" value="@d.Stage" />
                    <button type="submit">Activate stage @d.Stage</button>
                </form>
            }
        </div>
    }
</div>

<div class="card">
    <h2 style="margin-top:0;">Speaker sync direction</h2>
    <p>Choose the <strong>active sync stage</strong> for this edition's <strong>speakers</strong> — separate from the
       session direction above. Only one stage is active at a time. All three stages have an engine behind them;
       stage&nbsp;3 additionally needs a Zoho&nbsp;Backstage scope before it can read anything (see the card).</p>

    @StageProvenance(Model.SpeakerStage, "speaker")

    @if (Model.SpeakerDirectionIsStale)
    {
        <p class="ss-note" style="color:#92400e;">
            A stage with no implementation was previously selected and is being <strong>ignored</strong>.
            Speakers are imported Sessionize&nbsp;&rarr;&nbsp;CEH (stage&nbsp;1).
        </p>
    }
    @foreach (var d in Model.SpeakerDirectionOptions)
    {
        var isActive = d.Direction == Model.EffectiveSpeakerDirection;
        <div class="ss-opt @(isActive ? "active" : "")">
            <h3>
                Stage @d.Stage — @d.Label
                @if (isActive) { <span class="ss-tag ss-on">Active</span> }
                @if (!d.Implemented) { <span class="ss-tag ss-off">Not implemented yet</span> }
                @if (d.Implemented && d.Blocker is not null) { <span class="ss-tag ss-off">Needs setup</span> }
            </h3>
            <p class="ss-note">@d.Note</p>
            @* §333: a stage can be fully built and still do nothing today because an upstream
               scope is missing. Say which — "not implemented" would be a lie, and silence
               would be worse. *@
            @if (d.Blocker is not null)
            {
                <p class="ss-note" style="color:#92400e;">@d.Blocker</p>
            }
            @if (!isActive && d.Implemented)
            {
                <form method="post" asp-page-handler="SetSpeakerDirection" style="margin-top:8px;">
                    <input type="hidden" name="stage" value="@d.Stage" />
                    <button type="submit">Activate stage @d.Stage</button>
                </form>
            }
        </div>
    }
</div>

@* 🔴 §1001 — THE SPEAKER QUIET PERIOD. Operator 2026-08-09: "we make lots of schedule changes
   and we dont want to make unnessary noice to speakers." The change is still APPLIED before this
   date — only the e-mail is withheld — so nobody is ever looking at a stale schedule. *@
<h2 style="margin-top:28px;">Speaker notices about room &amp; time changes</h2>
<div class="ss-card">
    <p class="ss-note">
        When a session&rsquo;s <strong>room or time</strong> changes, the speakers on it are e-mailed.
        Before the date below, <strong>no notice is sent</strong> &mdash; the change still applies
        everywhere (the hub, the public agenda, calendar files), it is just not announced. That keeps
        the notice worth reading while the agenda is still being built.
    </p>
    <form method="post" asp-page-handler="SetNoticeFrom" class="ss-grid" style="margin-top:8px;">
        <div>
            <label for="noticeFrom">Notices start on</label>
            <input id="noticeFrom" type="date" name="NoticeFrom"
                   value="@(Model.SpeakerNoticeFrom?.ToString("yyyy-MM-dd"))" />
        </div>
        <button type="submit">Save</button>
    </form>
    <p class="ss-note" style="margin-top:6px;">
        @if (Model.SpeakerNoticeFrom is { } from)
        {
            <text>
                Defaults to <strong>60 days before the event</strong>. Speakers
                @(DateOnly.FromDateTime(DateTime.UtcNow) >= from
                    ? "ARE being notified of room/time changes now."
                    : $"are NOT being notified yet — notices begin {from:d MMM yyyy}.")
            </text>
        }
        else
        {
            @* Blank is a real setting, not a missing one, so it says what it does. *@
            <text><strong>Notices are OFF.</strong> Room and time changes apply silently until a
            date is set here.</text>
        }
    </p>
</div>
