@page
@model CommunityHub.Pages.Organizer.SessionFeedbackModel
@using CommunityHub.Core.Domain
@using CommunityHub.Core.Evaluation
@{
    ViewData["Title"] = "Session feedback";
}

@* 🔒 §784.7 — MOBILE-FIRST (~360px). One EXPANDING row per session, never a five-column grid:
   five columns do not fit at 360px, and the merge would just move the confusion. The summary
   line carries what you scan for (score, can it collect, has it a code, is its report out) and
   <details> holds the rest. No JavaScript, so it works everywhere and survives a refresh. *@
<style>
    .sf-row { border:1px solid #e5e7eb; border-radius:10px; margin:10px 0; padding:10px 12px; }
    .sf-sum { cursor:pointer; list-style:none; display:flex; flex-wrap:wrap; gap:8px; align-items:baseline; }
    .sf-sum::-webkit-details-marker { display:none; }
    .sf-title { font-weight:600; flex:1 1 200px; min-width:0; overflow-wrap:anywhere; }
    .sf-chip { display:inline-block; border-radius:999px; padding:2px 9px; font-size:12px; font-weight:700; white-space:nowrap; }
    .sf-chip.ok { background:#0a6; color:#fff; }
    .sf-chip.warn { background:#fff3cd; color:#856404; }
    .sf-chip.muted { background:#eef2f7; color:#475569; }
    .sf-score { font-size:22px; font-weight:700; }
    .sf-meta { color:#6b7280; font-size:13px; }
    .sf-body { margin-top:10px; padding-top:10px; border-top:1px dashed #e5e7eb; }
    .sf-actions { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin-top:8px; }
    .sf-actions form { display:inline; margin:0; }
</style>

<div class="card">
    <h1>Session feedback</h1>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
        <p><a asp-page="/Index">Back to hub</a></p>
        return;
    }

    <p>
        Everything about one session in one row: its <strong>QR code</strong>, whether it can
        <strong>collect</strong> feedback, its <strong>score</strong>, and whether its
        <strong>report</strong> has been released. Open a row for the detail.
    </p>
    <p class="sf-meta">
        This page replaced <em>Evaluation sessions</em>, <em>Evaluation results</em>,
        <em>Session QR codes</em> and the old session-evaluations list &mdash; the same facts,
        gathered per session. The feedback <strong>devices</strong> are still set up under
        <a asp-page="/Organizer/EvaluationDevices">Evaluation Devices</a>.
    </p>
    @* §1265 — everything about session evaluation, one click from here. *@
    <p style="display:flex;flex-wrap:wrap;gap:8px 16px;">
        <a asp-page="/Organizer/EvaluationDevices"><strong>Devices &amp; kiosks</strong></a>
        <a href="/eval" target="_blank" rel="noopener">Open the kiosk page</a>
        <a asp-page="/Organizer/Sessions">Sessions (times &amp; rooms)</a>
        <a asp-page="/Organizer/Content">&larr; Back to speakers &amp; sessions</a>
    </p>
</div>

@if (Model.Message is not null)
{
    <div class="card"><p role="status" style="color:#0a6;margin:0;">@Model.Message</p></div>
}

@if (Model.Changes.Count > 0 || Model.Warnings.Count > 0)
{
    <div class="card">
        @if (Model.Changes.Count > 0)
        {
            <h3 style="margin-top:0;">What the sync changed</h3>
            <ul>@foreach (var c in Model.Changes) { <li>@c</li> }</ul>
        }
        @if (Model.Warnings.Count > 0)
        {
            <h3>Worth a look</h3>
            <ul>@foreach (var w in Model.Warnings) { <li style="color:#b45309;">@w</li> }</ul>
        }
    </div>
}

@* --- the event roll-up. §6: the two figures are DIFFERENT and must never share a label. --- *@
<div class="card" style="background:#f8fafc;">
    <h2 style="margin-top:0;">Event so far</h2>
    @if (Model.Pooled is { } p && p.Score is { } score)
    {
        <p style="margin:0;">
            <strong style="font-size:32px;">@score.ToString("0.0")</strong>
            <span> index &middot; <strong>@p.Band</strong></span><br />
            <span class="sf-meta">from @p.Responses response(s) &mdash; <em>pooled</em>: every
            response counted once, so a packed session weighs more than a small one. This is the
            figure for the event headline.</span>
        </p>
        @if (Model.MeanSession is { } mean)
        {
            <p style="margin:10px 0 0;">
                <strong>@mean.ToString("0.0")</strong> index &mdash; <em>average per session</em><br />
                <span class="sf-meta">each session's own score, averaged — every session weighted equally, sessions under
                @Model.Threshold responses excluded. This is the figure for comparing tracks or
                years, where a change in room sizes should not move the number.</span>
            </p>
        }
    }
    else
    {
        <p style="margin:0;">
            <strong>Not enough responses yet</strong> &mdash;
            @(Model.Pooled?.Responses ?? 0) of @Model.Threshold needed.
        </p>
    }

    @if (Model.Unattributed > 0)
    {
        <p class="sf-meta" style="margin:10px 0 0;color:#b45309;">
            @Model.Unattributed response(s) belong to no session. They still count toward the event
            figure above &mdash; they are real feedback, only the attribution is missing &mdash; but
            not toward any session below.
        </p>
    }

    @* §1357 — set test/demo votes aside before the event: kept, counted nowhere, reversible. *@
    <div style="margin:16px 0;padding:12px 14px;border:1px solid #cbd5e1;border-radius:10px;">
        <strong>Responses that count:</strong> @Model.ActivationCounts.Active
        @if (Model.ActivationCounts.Inactive > 0)
        {
            <span class="set-deps"> · @Model.ActivationCounts.Inactive inactive (counted nowhere)</span>
        }
        <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
            <form method="post" asp-page-handler="SetAllInactive"
                  onsubmit="return confirm('Set all @Model.ActivationCounts.Active current responses INACTIVE? They are kept but no longer count in any score, statistic or report. You can reactivate them.');">
                <button type="submit" class="btn" @(Model.ActivationCounts.Active == 0 ? "disabled" : "")>Set all current responses inactive</button>
            </form>
            @if (Model.ActivationCounts.Inactive > 0)
            {
                <form method="post" asp-page-handler="ReactivateAll"
                      onsubmit="return confirm('Make all @Model.ActivationCounts.Inactive inactive responses count again?');">
                    <button type="submit" class="btn">Reactivate all</button>
                </form>
            }
        </div>
        <p class="set-deps" style="margin:6px 0 0;">Use it to clear test and demo votes before the event. Nothing is deleted.</p>
    </div>

    @* §1354 — the same responses per channel and capture policy, to see what each policy yields. *@
    @if (Model.ByPolicy.Count > 0)
    {
        <h3 style="margin:16px 0 6px;">By capture policy</h3>
        <div style="overflow-x:auto;">
        <table class="grid">
            <thead>
                <tr><th>Channel</th><th>Policy</th><th>Symbols</th><th>Responses</th><th>Avg rating</th><th>Answered a follow-up</th><th>Wrote a comment</th></tr>
            </thead>
            <tbody>
            @foreach (var r in Model.ByPolicy)
            {
                <tr>
                    <td>@r.Channel</td>
                    <td>@r.PolicyLabel</td>
                    <td>@r.SymbolsLabel</td>
                    <td>@r.Responses</td>
                    <td>@r.AverageRating.ToString("0.00")</td>
                    <td>@(r.FollowUpRate is double f ? f.ToString("P0") : "—")</td>
                    <td>@(r.FreeTextRate is double t ? t.ToString("P0") : "—")</td>
                </tr>
            }
            </tbody>
        </table>
        </div>
        <p class="set-deps">"—" = the policy did not ask it. Rating scale 1–4.</p>
    }

    @* §1273 — the breakdown: per day, per session type, per track, responses by channel, and when
       it was calculated. Pooled within each group, like the headline above. *@
    @if (Model.Statistics is { } st)
    {
        <style>
            .st-line { margin: 12px 0 4px; font-size: 14px; }
            /* §1293 — FIXED layout with the same column widths in all three tables, so the columns line
               up under each other and the channel columns stay on screen (operator: "layout should be
               under the others"). */
            .st-grid { width: 100%; min-width: 640px; table-layout: fixed; border-collapse: collapse; margin: 6px 0 14px; font-size: 13.5px; }
            .st-grid td:first-child { overflow-wrap: anywhere; }
            .st-bar { max-width: 100%; }
            .st-grid th { text-align: left; font-weight: 600; color: #475569; border-bottom: 2px solid #e2e8f0; padding: 5px 8px; white-space: nowrap; }
            .st-grid td { border-bottom: 1px solid #f1f5f9; padding: 6px 8px; vertical-align: middle; }
            .st-grid td.n { text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
            .st-bar { display: flex; height: 10px; width: 120px; border-radius: 5px; overflow: hidden; background: #f1f5f9; }
            .st-wrap { overflow-x: auto; }
            .st-h { margin: 16px 0 2px; font-size: 15px; }
        </style>
        <p class="st-line">
            <strong>@st.Event.Total</strong> response(s) in total &middot;
            @* §1303 — two channels only: kiosk (any kiosk device, incl. the built boxes) and QR code. *@
            @(st.Event.Box + st.Event.Kiosk) from kiosks &middot; @st.Event.Qr by QR code
        </p>
        <p class="sf-meta" style="margin:0;">Calculated @CommunityHub.Pages.Organizer.SessionFeedbackModel.DanishTime(st.CalculatedAt) (Danish time) &mdash; reload the page to recalculate.</p>

        foreach (var (heading, rows) in new[] { ("Per day", st.ByDay), ("Per session type", st.ByType), ("Per track", st.ByTrack) })
        {
            <h3 class="st-h">@heading</h3>
            @if (rows.Count == 0)
            {
                <p class="sf-meta" style="margin:0 0 10px;">No responses attributed to a session yet.</p>
                continue;
            }
            <div class="st-wrap">
            <table class="st-grid">
                <colgroup>
                    <col style="width:26%" /><col style="width:15%" /><col style="width:19%" />
                    <col style="width:9%" /><col style="width:11%" />
                    <col style="width:10%" /><col style="width:10%" />
                </colgroup>
                <thead>
                    <tr>
                        <th></th><th>Score</th><th>Answers</th>
                        <th class="n">Sessions</th><th class="n">Responses</th>
                        <th class="n">Kiosk</th><th class="n">QR</th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var row in rows)
                {
                    var d = row.Score.Distribution;
                    var tot = Math.Max(1, d.Total);
                    <tr>
                        <td><strong>@row.Label</strong></td>
                        <td style="white-space:nowrap;">
                            @if (row.Score.Score is double sc)
                            {
                                <strong>@sc.ToString("0.0")</strong> <span class="sf-meta">@row.Score.Band</span>
                            }
                            else { <span class="sf-meta">—</span> }
                        </td>
                        <td>
                            <div class="st-bar" title="@d.Four very happy · @d.Three happy · @d.Two somewhat unhappy · @d.One unhappy">
                                @foreach (var (n, rating) in new[] { (d.Four, 4), (d.Three, 3), (d.Two, 2), (d.One, 1) })
                                {
                                    if (n > 0)
                                    {
                                        <span style="width:@((100d * n / tot).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture))%;background:@CommunityHub.Core.Evaluation.EvaluationRatingLabels.Colour(rating);"></span>
                                    }
                                }
                            </div>
                        </td>
                        <td class="n">@row.Sessions</td>
                        <td class="n"><strong>@row.Channels.Total</strong></td>
                        <td class="n">@(row.Channels.Box + row.Channels.Kiosk)</td>
                        <td class="n">@row.Channels.Qr</td>
                    </tr>
                }
                </tbody>
            </table>
            </div>
        }
    }
</div>

@* --- the three WRITE actions. §784.7: kept SEPARATE on purpose — different privileges, different
       moments. Each is its own POST; none of them is a "do everything" control. --- *@
<div class="card">
    <h2 style="margin-top:0;">Actions</h2>
    @* §1292 — operator 2026-09-21: *"why have a button for run report publish. is it not running as
       job"*. It is — all three are scheduled jobs; the buttons only skip the wait. Said on the page. *@
    <p style="margin:0 0 4px;"><strong>Download</strong></p>
    <div class="sf-actions">
        @* A real button (an <a class="btn"> rendered as a plain link). GET, so the handler travels as a field. *@
        <form method="get">
            <input type="hidden" name="handler" value="DownloadAllQr" />
            <button type="submit" class="btn">&#11015; Download all QR codes (ZIP)</button>
        </form>
    </div>
    <p style="margin:14px 0 4px;"><strong>These run automatically</strong>
        <span class="sf-meta">&mdash; use a button only to run one now instead of waiting.</span></p>
    <div class="sf-actions">
        <form method="post" asp-page-handler="Sync">
            <button type="submit" class="btn">Sync sessions from CEH now</button>
        </form>
        <span class="sf-meta">every 10 min</span>
        <form method="post" asp-page-handler="GenerateCodes">
            <button type="submit" class="btn">Generate missing QR codes now</button>
        </form>
        <span class="sf-meta">every 10 min</span>
        <form method="post" asp-page-handler="RunPublish">
            <button type="submit" class="btn">Publish reports now</button>
        </form>
        <span class="sf-meta">every 10 min</span>
    </div>
    <p class="sf-meta" style="margin-top:10px;">
        Sync reads the schedule from CEH (CEH is master &mdash; nothing here is edited).
        Codes are <strong>permanent</strong>: a session that changes room or time keeps the code
        already printed, which is why there is no regenerate.
        Feedback for a session is open from its start until 30 minutes after it ends. Its report is
        released once feedback has <strong>closed</strong> and nothing new has arrived for
        @Model.QuietMinutes minutes; a device uploading late afterwards releases one updated report.
        <em>Publish reports now</em> runs that same pass rather than forcing past it. The intervals
        are the defaults; they can be changed on the <a asp-page="/Organizer/Jobs">Jobs</a> page.
        QR codes are made whatever the switches say; publishing and mailing reports also needs the
        <strong>session-eval-email</strong> switch on in Settings.
    </p>
    @if (!Model.PdfFolderConfigured)
    {
        <p style="color:#b45309;margin:0;">
            ⚠️ No document folder is configured for evaluation reports, so nothing can be published
            yet. Set it under <a asp-page="/Organizer/DocLibraryPaths">Document library paths</a>.
        </p>
    }
    @if (Model.BaseUrlMissing)
    {
        <p style="color:#b45309;margin:8px 0 0;">
            ⚠️ The public hub URL is not configured, so QR codes cannot be rendered.
        </p>
    }
</div>

@if (Model.PublishResult is { } pr)
{
    <div class="card">
        <h3 style="margin-top:0;">What the publish pass decided</h3>
        <p class="sf-meta">@pr</p>
    </div>
}

<div class="card">
    <h2 style="margin-top:0;">By session</h2>
    <p class="sf-meta">
        @Model.Rows.Count session(s) &middot; @Model.WithQrCode with a QR code
        @if (Model.MissingQrCode > 0)
        {
            <text>&middot; <strong>@Model.MissingQrCode still without one</strong></text>
        }
    </p>

    @if (Model.Rows.Count == 0)
    {
        <p>No sessions yet. Use <strong>Sync sessions from CEH</strong> above.</p>
    }
    else
    {
        foreach (var r in Model.Rows)
        {
            <details class="sf-row">
                <summary class="sf-sum">
                    <span class="sf-title">
                        @r.Title
                        <div class="sf-meta">
                            @if (r.ScheduledStart is { } start)
                            {
                                @* §1289 — Danish time; this printed UTC. *@
                                <text>@TimeZoneInfo.ConvertTime(start, CommunityHub.Core.Integrations.EventTimezone.Tz).ToString("ddd dd MMM HH:mm")</text>
                            }
                            else
                            {
                                <text>no scheduled time</text>
                            }
                            @if (r.Room is not null) { <text> &middot; @r.Room</text> }
                            @if (r.SpeakerNames.Count > 0)
                            {
                                <text> &middot; @string.Join(", ", r.SpeakerNames)</text>
                            }
                        </div>
                    </span>

                    @* The score, with its BAND — §11: the band always accompanies the number, and
                       the index NEVER carries a % sign (an all-light-green session scores 66.7 and
                       would read as a failing grade). Below the threshold we show progress toward
                       it rather than a number volatile enough to mislead. *@
                    @if (r.Score is { } sc && sc.Score is { } value)
                    {
                        <span><span class="sf-score">@value.ToString("0.0")</span>
                            <span class="sf-meta">index &middot; @sc.Band</span></span>
                    }
                    else if (r.Responses > 0)
                    {
                        <span class="sf-meta">@r.Responses of @Model.Threshold responses</span>
                    }

                    @if (!r.CanCollect)
                    {
                        <span class="sf-chip warn">not collecting</span>
                    }
                    @if (r.SessionId is not null && !r.HasQrCode)
                    {
                        <span class="sf-chip warn">no QR code</span>
                    }
                    @if (r.ReportReleased)
                    {
                        <span class="sf-chip ok">report released</span>
                    }
                    else
                    {
                        <span class="sf-chip muted">report not released</span>
                    }
                </summary>

                <div class="sf-body">
                    @* Each defect is named in WORDS, because "not collecting" alone sends the
                       reader back to the pages this merge removed. *@
                    @if (r.NotMirrored)
                    {
                        <p style="color:#b45309;margin:0 0 8px;">
                            This session has not been mirrored into the feedback system, so it can
                            collect nothing &mdash; a printed code for it scans to
                            <em>&ldquo;not open yet&rdquo;</em>. Run <strong>Sync sessions from
                            CEH</strong> above.
                        </p>
                    }
                    else if (r.Room is null)
                    {
                        <p style="color:#b45309;margin:0 0 8px;">
                            No room, so no feedback device can be placed for it. The room comes from
                            CEH &mdash; set it there, then sync.
                        </p>
                    }
                    @if (r.OrphanedFromCeh)
                    {
                        <p style="color:#b45309;margin:0 0 8px;">
                            The feedback system holds this session but CEH does not, so it has no QR
                            code and no report. Its responses still count toward the event figure.
                        </p>
                    }

                    @if (r.Score is { } s2)
                    {
                        @* The four-way distribution, in the order the buttons sit on the unit. *@
                        @* §1289 — the BUTTON words (one vocabulary everywhere, §750.8), with shares.
                           This read "fantastic / good / not great / poor" — four words no attendee saw. *@
                        var pct = (int n) => s2.Responses == 0 ? "0" : Math.Round(100d * n / s2.Responses).ToString("0");
                        <p class="sf-meta" style="margin:0 0 8px;">
                            @s2.Responses response(s) &middot;
                            @s2.Distribution.Four @CommunityHub.Core.Evaluation.EvaluationRatingLabels.Label(4).ToLowerInvariant() (@pct(s2.Distribution.Four)%) &middot;
                            @s2.Distribution.Three @CommunityHub.Core.Evaluation.EvaluationRatingLabels.Label(3).ToLowerInvariant() (@pct(s2.Distribution.Three)%) &middot;
                            @s2.Distribution.Two @CommunityHub.Core.Evaluation.EvaluationRatingLabels.Label(2).ToLowerInvariant() (@pct(s2.Distribution.Two)%) &middot;
                            @s2.Distribution.One @CommunityHub.Core.Evaluation.EvaluationRatingLabels.Label(1).ToLowerInvariant() (@pct(s2.Distribution.One)%)
                        </p>
                    }

                    <div class="sf-actions">
                        @if (r.SessionId is int sid && r.HasQrCode && !Model.BaseUrlMissing)
                        {
                            <a class="btn" asp-page-handler="Qr" asp-route-sessionId="@sid">
                                Download this QR code
                            </a>
                        }
                        @if (r.EvaluationSessionId is int eid && r.Responses > 0)
                        {
                            @* §1291 — on the page first; the PDF stays one click away. *@
                            <a class="btn" asp-page="/Organizer/SessionFeedbackView" asp-route-evaluationSessionId="@eid">
                                &#128065; View all feedback
                            </a>
                            <a class="btn" target="_blank" rel="noopener"
                               asp-page-handler="Report" asp-route-evaluationSessionId="@eid">
                                &#128196; PDF
                            </a>
                        }
                        @* §783.9 — the PUBLISHED files, served through the hub proxy (never a
                           SharePoint link). These are what "released" means on this row; the button
                           above renders a fresh report on request, which is a different thing and
                           is why both are here. *@
                        @if (r.SessionId is int psid && r.HasScorePdf)
                        {
                            <a class="btn" target="_blank" rel="noopener"
                               href="@CommunityHub.Core.Integrations.Graphics.SessionEvalPdfService.ProxyUrlFor(psid, EvaluationPdfKind.Score)">
                                &#128202; Published score
                            </a>
                        }
                        @if (r.SessionId is int osid && r.HasOpenPdf)
                        {
                            <a class="btn" target="_blank" rel="noopener"
                               href="@CommunityHub.Core.Integrations.Graphics.SessionEvalPdfService.ProxyUrlFor(osid, EvaluationPdfKind.Open)">
                                &#128221; Published open feedback
                            </a>
                        }
                    </div>
                </div>
            </details>
        }
    }
</div>
