@page
@model CommunityHub.Pages.Organizer.SoMeSettingsModel
@{
    ViewData["Title"] = "SoMe settings";
}

@if (Model.AccessDenied)
{
    <div class="card">
        <h1>SoMe settings</h1>
        <p class="error" role="alert">This page is for organizers.</p>
        <p><a asp-page="/Index">Back to hub</a></p>
    </div>
    return;
}

<style>
    .btn { background:#008BD2; color:#fff; border:0; border-radius:6px;
           padding:8px 14px; font-size:14px; cursor:pointer; text-decoration:none; }
    .btn:hover { background:#0079b8; }
    .som-grid { display:grid; grid-template-columns:1fr; gap:10px; max-width:640px; }
    .som-grid label { font-weight:600; }
    .som-grid input[type=text], .som-grid input[type=url], .som-grid input[type=email], .som-grid textarea {
        width:100%; box-sizing:border-box; }
    .som-hint { color:#4b5563; font-size:13px; margin:2px 0 6px; }
    .som-check { display:flex; align-items:center; gap:8px; }

    /* 🔴 §1191 — the announcement rules. One panel per category, laid out by GRID so nothing can
       overlap the way the hand-built summary table did at narrow widths. */
    .rule-sep { border:none; border-top:1px solid #e5e7eb; margin:30px 0 22px; }
    .rule-h2 { margin:0 0 4px; font-size:19px; }
    .rules { display:flex; flex-direction:column; gap:10px; margin:16px 0 8px; max-width:860px; }
    .rule { border:1px solid #e5e7eb; border-radius:8px; background:#fff; padding:14px 16px; }
    /* 🔴 §1196 — EVERY colour set explicitly, on a class the site cannot reach. The previous version
       used a bare <header>, inherited the page chrome's dark navy fill, and rendered dark text on
       it — unreadable. Background included: without one it is whatever an ancestor decides. */
    .rule-head {
        display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin:0 0 12px;
        padding:0 0 10px; border-bottom:1px solid #eef0f3; background:transparent;
    }
    .rule-head h3 { margin:0; font-size:15px; font-weight:600; color:#111827; background:transparent; }
    .rule-no {
        font:600 11px/1.6 ui-monospace,Consolas,monospace; letter-spacing:.04em;
        color:#1d4ed8; background:#eef6ff; border-radius:4px; padding:1px 7px; white-space:nowrap;
    }
    /* Fixed-width tracks, so a long label wraps INSIDE its own column instead of pushing a
       neighbour out of the panel — the overlap he reported. */
    .rule-dates { display:grid; grid-template-columns:repeat(auto-fit,minmax(210px,1fr)); gap:14px; }
    .rule-dates > div { display:flex; flex-direction:column; gap:3px; min-width:0; }
    .rule-dates label { font-size:13px; font-weight:600; color:#374151; }
    .rule-dates input[type=date] {
        width:100%; box-sizing:border-box; padding:6px 8px; font-size:14px;
        border:1px solid #d1d5db; border-radius:6px; background:#fff; color:#111827;
    }
    .rule-dates input[type=date]:focus { outline:2px solid #008BD2; outline-offset:1px; border-color:#008BD2; }
    .rule-fallback { font-size:12px; color:#6b7280; }
    .rule-warn {
        margin:10px 0 0; font-size:12.5px; color:#92400e;
        background:#fffbeb; border:1px solid #fde68a; border-radius:6px; padding:6px 9px;
    }
    .rule-on { margin-left:auto; display:flex; align-items:center; gap:6px; font-size:12.5px;
               font-weight:600; color:#374151; }
    .rule-on input { margin:0; }
    .rule-rounds { display:flex; align-items:center; gap:10px; flex-wrap:wrap; margin-top:12px;
                   padding-top:10px; border-top:1px dashed #e5e7eb; }
    .rule-count { font-size:12.5px; color:#374151; }
    /* §1202 — live state, set explicitly so no site rule can make it unreadable (§1196). */
    .aa-state { margin:6px 0 12px; padding:8px 12px; border-radius:6px; font-size:13px;
                max-width:760px; line-height:1.55; }
    .aa-on  { background:#e6f2eb; border:1px solid #a7d3bb; color:#1d5b41; }
    .aa-off { background:#f3f4f6; border:1px solid #d1d5db; color:#374151; }
    .aa-blockers { margin:0 0 14px; max-width:760px; font-size:13px; }
    .aa-blockers summary { cursor:pointer; font-weight:600; color:#374151; }
    .aa-blockers ul { margin:8px 0 0 18px; padding:0; color:#374151; line-height:1.6; }
    .rule-rounds .btn-secondary { font-size:12px; padding:4px 10px; }
    @@media (max-width:420px) { .rule-dates { grid-template-columns:1fr; } }
</style>

@if (Model.Message is not null)
{
    <div class="card"><p role="status" style="color:#0a6;">@Model.Message</p></div>
}

<div class="card">
    <h1>LinkedIn company-page SoMe queue — settings</h1>
    <p>
        Configure the scheduled posting to your event's LinkedIn <strong>company page</strong>.
        Nothing is ever posted until posting is enabled, a company page is set, and a live
        LinkedIn publisher is wired.
    </p>
    @if (!Model.PublisherWired)
    {
        <p role="status" style="color:#b45309;">
            A live LinkedIn publisher is not wired yet, so the queue runs in a safe, no-post
            mode: due posts stay queued and nothing is sent to LinkedIn. The schedule,
            tagging, previews, pre-alerts and notifications all work — only the actual post
            is inert until the publisher is connected.
        </p>
    }
</div>

<div class="card">
    <form method="post" class="som-grid">
        <div class="som-check">
            <input type="checkbox" id="enabled" name="Enabled" value="true" @(Model.Enabled ? "checked" : "") />
            <label for="enabled">Enable SoMe posting</label>
        </div>
        <p class="som-hint">When off, the dispatcher publishes nothing even if the publisher is wired.</p>

        <label for="page">LinkedIn company page URL or organization id</label>
        <input id="page" name="CompanyPageUrlOrOrgId" type="text"
               value="@Model.CompanyPageUrlOrOrgId"
               placeholder="REPLACE_WITH_YOUR_LINKEDIN_ORG_ID_OR_PAGE_URL" />
        <p class="som-hint">
            Operator config (not a secret). The LinkedIn OAuth <strong>access token is a secret</strong>
            and is read from Key Vault by the publisher — never entered or stored here.
        </p>

        <label for="prealert">Speaker pre-alert organizer email</label>
        <input id="prealert" name="SpeakerPreAlertOrganizerEmail" type="email"
               value="@Model.SpeakerPreAlertOrganizerEmail"
               placeholder="organizer@example.org" />
        <p class="som-hint">
            Gets an email ~5 minutes before each speaker post publishes, to manually insert the
            speaker's real LinkedIn handle (the API can't tag external speakers). Blank disables it.
        </p>

        <div class="som-check">
            <input type="checkbox" id="notify" name="NotifyOnPublish" value="true" @(Model.NotifyOnPublish ? "checked" : "") />
            <label for="notify">Email the notification list when a post publishes</label>
        </div>

        @* 🔴 §918 — the two knobs, with the rules stated NEXT TO THEM. Operator 2026-08-06:
           *"document the auto-approval process in the menu for us to understand"*. The full
           explanation lives on the Post planner page; this is the short version at the switch,
           because that is where someone decides. *@
        <h3 style="margin-top:18px;">Auto-approval</h3>

        @* 🔴 §1202 — WHAT IT IS DOING, not just what it is set to. Operator 2026-09-12: *"i dont
           belive we use this anymore"* about a control that was ticked, running every ten minutes,
           and had approved the very posts he complained about that morning — then, an hour later,
           *"do we use it ?"*.
           🔑 A checkbox states what is CONFIGURED and never what is HAPPENING. Answering his question
           needed the job logs, which is not a trip an operator should have to make. *@
        <p class="aa-state @(Model.AutoApproveEnabled ? "aa-on" : "aa-off")" role="status">
            @if (Model.AutoApproveEnabled)
            {
                <strong>On.</strong>
                @if (Model.AutoApproveLastRunAt is { } ran)
                {
                    <text>
                        Last ran @CommunityHub.Core.Integrations.SoMeDisplayTime.DateTime(ran).
                    </text>
                }
                else
                {
                    <text>It has not run yet in this edition.</text>
                }
                <text>
                    Right now <strong>@Model.AutoApproveEligible</strong> post(s) would be approved and
                    <strong>@Model.AutoApproveBlocked</strong> are held back by something missing.
                </text>
                @if (Model.AutoApproveEligible == 0 && Model.AutoApproveBlocked > 0)
                {
                    <text>
                        Nothing is being approved at the moment — every candidate is waiting on
                        something.
                    </text>
                }
            }
            else
            {
                <strong>Off.</strong>
                <text>
                    Every post waits for you. @Model.AutoApproveEligible post(s) would be approved if
                    you switched it on.
                </text>
            }
        </p>

        @* 🔴 §1204 — WHAT the held-back posts are waiting on. Operator 2026-09-12: *"what are these
           19 hold back ?"* — a question the system could not answer: §918 logs "19 waiting on a
           missing dependency", which is a count of a problem rather than the problem. §854 settled
           that: he has to chase these people, and "19 posts" is not chaseable.
           🔑 Grouped, because twelve posts blocked on one sponsor's logo is ONE thing to do. *@
        @if (Model.AutoApproveBlockers.Count > 0)
        {
            <details class="aa-blockers">
                <summary>What the @Model.AutoApproveBlocked held-back post(s) are waiting on</summary>
                <ul>
                    @foreach (var (reason, count) in Model.AutoApproveBlockers)
                    {
                        <li><strong>@count ×</strong> @reason</li>
                    }
                </ul>
                <p class="som-hint" style="margin:6px 0 0;">
                    Each post shows its own reason in the
                    <a asp-page="/Organizer/SoMeQueue">queue</a>. Clear the dependency and the post
                    becomes approvable on the next tick — nothing needs re-planning.
                </p>
            </details>
        }

        <div class="som-check">
            <input type="checkbox" id="autoapprove" name="AutoApproveEnabled" value="true" @(Model.AutoApproveEnabled ? "checked" : "") />
            <label for="autoapprove">Approve template-built posts automatically</label>
        </div>
        <p class="muted">
            Types 1–4 only, and only posts that are far enough ahead and have nothing missing.
            Anything you wrote or edited yourself — including every event post — still waits for you.
            <a asp-page="/Organizer/SoMeScheduler">How auto-approval works</a>.
        </p>

        <label for="autolead">Approve only posts at least this many days ahead</label>
        <input id="autolead" name="AutoApproveLeadDays" type="number" min="1" max="365"
               value="@Model.AutoApproveLeadDays" />
        <p class="muted">
            Doubles as your review window: an auto-approved post cannot publish for at least this
            long, so there is always time to change or un-approve it. Posts sooner than this — and
            any whose time has already passed — are always left for you.
        </p>

        @* §927 — his own exclusion list, with the matches shown next to it. A filter you cannot
           see the effect of is a filter you have to test in production. *@
        <label for="excltitles">Never announce sessions whose title matches</label>
        <textarea id="excltitles" name="ExcludedSessionTitlePatterns" rows="3"
                  placeholder="ask the experts*">@Model.ExcludedSessionTitlePatterns</textarea>
        <p class="som-hint">
            One pattern per line. <code>*</code> matches anything, so <code>ask the experts*</code>
            covers every Ask-the-Experts session. Case does not matter. Empty = nothing excluded.
            These sessions get no automatic post at all — write your own if you want one.
        </p>
        @if (Model.ExcludedSessionTitles.Count > 0)
        {
            <p class="muted" style="margin-top:-4px;">
                Currently matching <strong>@Model.ExcludedSessionTitles.Count</strong> session(s):
                @string.Join(" · ", Model.ExcludedSessionTitles)
            </p>
        }
        else if (!string.IsNullOrWhiteSpace(Model.ExcludedSessionTitlePatterns))
        {
            <p class="muted" style="margin-top:-4px;">
                No session titles match these patterns right now.
            </p>
        }

        @* 🔴 §1195 — THE RULES, DRIVEN BY THE CATEGORY TABLE.
           Operator 2026-09-12: *"where is the button to add a round if needed"* · *"when a some post
           has more rounds, it should be added into the planner and planned"* · *"basically we define
           the rules like start date, end date, cadence inside the some settings and the some planner
           must recalculate if they are changed"*.

           🔑 Rendered from the RULES, not from a hand-written panel per category — which is why
           "add a round" can exist at all: the round count is data, the planner reads the same data,
           and a round added here is planned on the next run with nothing else to change. *@
        <hr class="rule-sep" />
        <h2 class="rule-h2">Announcement rules</h2>
        <p class="som-hint" style="margin-top:0;max-width:64ch;">
            Rounds, start dates and an end date per category. A blank round date spreads that round;
            a blank end date means the event. A date only ever <strong>delays</strong> a post —
            readiness rules still apply on top.
        </p>

        <div class="rules">
            @for (var i = 0; i < Model.Rules.Count; i++)
            {
                var rule = Model.Rules[i];
                var isEventPosts = rule.Category == SoMeAnnouncementCategory.EventPosts;

                <section class="rule" data-rule="@i">
                    <input type="hidden" name="Rules[@i].Category" value="@((int)rule.Category)" />

                    @* 🔴 §1196 — a DIV, not a <header>. Operator 2026-09-12: *"noboddy can ead this"* —
                       the site stylesheet paints bare <header> elements dark navy for the page
                       chrome, so this panel's dark text landed on a dark ground and the category
                       name and "Announce" were invisible. Styling by element name means inheriting
                       whatever the rest of the site does to that element; the class cannot collide. *@
                    <div class="rule-head">
                        <span class="rule-no">@rule.Label.Split(" — ")[0]</span>
                        <h3>@rule.Label.Split(" — ").Last()</h3>
                        <label class="rule-on">
                            <input type="checkbox" name="Rules[@i].Enabled" value="true"
                                   @(rule.Enabled ? "checked" : "") />
                            <span>Announce</span>
                        </label>
                        <input type="hidden" name="Rules[@i].Enabled" value="false" />
                    </div>

                    @if (isEventPosts)
                    {
                        @* ⚠️ Type 5's dates come from the deck (§834.4) and are used as written, so a
                           round count and start dates would be controls that decide nothing. Only the
                           cut-off is real. *@
                        <input type="hidden" name="Rules[@i].Rounds" value="1" />
                        <div class="rule-dates">
                            <div>
                                <label for="end-@i">Last day one may run</label>
                                <input type="date" id="end-@i" name="Rules[@i].EndsOn"
                                       lang="da-DK" value="@(rule.EndsOn?.ToString("yyyy-MM-dd"))" />
                                <span class="rule-fallback">Empty = 8 days before the event</span>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="rule-dates" data-rounds>
                            @for (var r = 0; r < rule.RoundStarts.Count; r++)
                            {
                                <div data-round>
                                    <label for="r-@i-@r">Round @(r + 1) from</label>
                                    <input type="date" id="r-@i-@r" name="Rules[@i].RoundStarts[@r]"
                                           lang="da-DK" value="@(rule.RoundStarts[r]?.ToString("yyyy-MM-dd"))" />
                                    <span class="rule-fallback">
                                        @(r == 0 ? "Empty = when each is ready" : "Empty = spread")
                                    </span>
                                </div>
                            }
                            <div>
                                <label for="end-@i">Last round no later than</label>
                                <input type="date" id="end-@i" name="Rules[@i].EndsOn"
                                       lang="da-DK" value="@(rule.EndsOn?.ToString("yyyy-MM-dd"))" />
                                <span class="rule-fallback">Empty = the event</span>
                            </div>
                        </div>

                        @* ⚠️ §1198 — NO SUMMARY LINE HERE. I added one to make a missing date visible
                           and it restated the boxes directly above it, down to printing the round
                           count a second time — operator: *"why show it twice"*. The boxes already
                           show the dates; a second rendering of the same facts is noise, and noise is
                           what made this page unreadable in the first place. *@
                        <div class="rule-rounds">
                            <input type="hidden" name="Rules[@i].Rounds" value="@rule.Rounds" data-count />
                            <span class="rule-count"><strong data-countlabel>@rule.Rounds</strong> round(s)</span>
                            <button type="button" class="btn-secondary rule-add"
                                    data-add="@i" data-next="@rule.RoundStarts.Count">+ Add a round</button>
                            @if (rule.Rounds > 1)
                            {
                                <button type="button" class="btn-secondary rule-del" data-del="@i">Remove last</button>
                            }
                            <span class="rule-fallback">Saving plans the new round on the next run.</span>
                        </div>
                    }
                </section>
            }
        </div>

        @* 🔑 §1195 — "add a round" adds a DATE BOX and raises the count in the same click. It has to
           do both: the count is what the planner reads, and the box is the only way to date it.
           ⚠️ Plain DOM, no framework — the page posts a normal form, and a round added here is a
           real input that arrives with it. *@
        <script>
            (function () {
                document.querySelectorAll('.rule').forEach(function (section) {
                    var count = section.querySelector('[data-count]');
                    var label = section.querySelector('[data-countlabel]');
                    var list = section.querySelector('[data-rounds]');
                    var add = section.querySelector('.rule-add');
                    var del = section.querySelector('.rule-del');
                    if (!count || !list || !add) return;

                    var index = section.getAttribute('data-rule');

                    function sync() {
                        var n = list.querySelectorAll('[data-round]').length;
                        count.value = n;
                        if (label) { label.textContent = n; }
                        if (del) { del.hidden = n <= 1; }
                    }

                    add.addEventListener('click', function () {
                        var n = list.querySelectorAll('[data-round]').length;
                        var wrap = document.createElement('div');
                        wrap.setAttribute('data-round', '');
                        var id = 'r-' + index + '-' + n;

                        var lbl = document.createElement('label');
                        lbl.setAttribute('for', id);
                        lbl.textContent = 'Round ' + (n + 1) + ' from';

                        var input = document.createElement('input');
                        input.type = 'date';
                        input.id = id;
                        input.name = 'Rules[' + index + '].RoundStarts[' + n + ']';

                        var hint = document.createElement('span');
                        hint.className = 'rule-fallback';
                        hint.textContent = 'Empty = spread';

                        wrap.appendChild(lbl); wrap.appendChild(input); wrap.appendChild(hint);
                        // Before the end-date box, so the rounds stay in order and the end stays last.
                        list.insertBefore(wrap, list.lastElementChild);
                        sync();
                        input.focus();
                    });

                    if (del) {
                        del.addEventListener('click', function () {
                            var rounds = list.querySelectorAll('[data-round]');
                            if (rounds.length <= 1) return;
                            rounds[rounds.length - 1].remove();
                            sync();
                        });
                    }

                    sync();
                });
            })();
        </script>

        <label for="notifylist">Publish notification email list</label>
        <textarea id="notifylist" name="NotificationEmails" rows="3"
                  placeholder="one@example.org, two@example.org">@Model.NotificationEmails</textarea>
        <p class="som-hint">Comma / semicolon / newline separated. Empty = no publish notifications.</p>

        @* §824.19 — the three values that close every automatic post. They belong on this page
           because it is already "how this edition posts to LinkedIn"; a separate page for three
           fields is one more place to have to look. *@
        <hr style="border:none;border-top:1px solid #e5e7eb;margin:26px 0;" />
        <h2 style="margin-bottom:4px;">Post footer</h2>
        <p class="som-hint" style="margin-top:0;">
            These three fill <code>{EventSystemUrl}</code>, <code>{EventTags}</code> and
            <code>{OrganizerLinkedInUrls}</code> in every automatic post. Change the wording of the
            posts themselves on <a asp-page="/Organizer/SoMeTemplates">SoMe post templates</a>.
        </p>

        @if (Model.PostCopyIncomplete)
        {
            @* ⚠️ Said out loud precisely BECAUSE the templates cope with a blank: the gap closes and
               the post still reads well, just without its hashtags or its credit line. Nothing else
               would ever tell him. *@
            <p class="error" role="alert" style="font-size:13.5px;">
                Incomplete — automatic posts will publish <strong>without part of their footer</strong>.
                The templates close the gap silently, so nothing else will warn you.
            </p>
        }

        <label for="eventurl">Event link (<code>{EventSystemUrl}</code>)</label>
        <input type="url" id="eventurl" name="EventSystemUrl" value="@Model.EventSystemUrl"
               placeholder="https://eldk27.expertslive.dk" />
        <p class="som-hint">The real URL, not a shortener — LinkedIn shortens links itself.</p>

        <label for="eventtags">Hashtags (<code>{EventTags}</code>)</label>
        <textarea id="eventtags" name="EventTags" rows="3"
                  placeholder="#ELDK27 #ExpertsLiveDK #Community #Microsoft …">@Model.EventTags</textarea>
        <p class="som-hint">One line, exactly as it should appear at the end of a post.</p>

        <label for="orgcredits">Organizer credit (<code>{OrganizerLinkedInUrls}</code>)</label>
        <textarea id="orgcredits" name="OrganizerCredits" rows="2"
                  placeholder="Morten Waltorp Knudsen [MVP] | Martin Byskov | Kent Agerlund | Morten Leth Hedegaard">@Model.OrganizerCredits</textarea>
        <p class="som-hint">
            Names as they should read, in plain text. Real <strong>@@-mentions</strong> of people are
            handled separately by <code>{Speakers}</code>, <code>{SponsorSigner}</code> and
            <code>{SponsorEventCoordinators}</code> — those tag anyone who <strong>follows the
            page</strong> and fall back to a plain name for everyone else.
        </p>

        <label for="venuecitycountry">City &amp; country (<code>{EventVenueCityCountry}</code>)</label>
        <input id="venuecitycountry" name="EventVenueCityCountry" type="text"
               value="@Model.EventVenueCityCountry" placeholder="Bella Center, Copenhagen, Denmark" />
        <p class="som-hint">
            As a post should read it. Typed rather than derived: the venue is stored as one name
            ("Bella Center Copenhagen"), and splitting a city out of that would be a guess printed
            on a live post.
        </p>

        <label for="actioncatalog">Action phrases (<code>{Action_catalog_random}</code>)</label>
        <textarea id="actioncatalog" name="ActionCatalog" rows="6"
                  placeholder="See you there! &#127881;&#10;Grab your ticket now &#127915;&#10;Don't miss it &#9889;">@Model.ActionCatalog</textarea>
        <p class="som-hint">
            <strong>One phrase per line</strong>, emoji welcome. Each post draws one at random when it
            is created, so a long campaign does not close the same way every time.
            @if (Model.ActionPhraseCount > 0)
            {
                <strong>@Model.ActionPhraseCount phrase(s) in the catalog.</strong>
            }
            <br />
            A post <strong>keeps</strong> the phrase it drew, so editing this list changes
            <strong>future</strong> posts — it never rewrites one you have already approved.
            Avoid <code>@@ [ ] ( )</code>: LinkedIn treats them as formatting and the post would
            publish with backslashes through it (saving will tell you which phrase is at fault).
        </p>

        <div><button type="submit" class="btn">Save settings</button></div>
    </form>
</div>

<p><a asp-page="/Organizer/SoMeTemplates">SoMe post templates</a> ·
   <a asp-page="/Organizer/SoMeQueue">Go to the Calendar for LinkedIn Posts</a> ·
   <a asp-page="/Index">Back to hub</a></p>
