@page
@model CommunityHub.Pages.Organizer.VolunteerWorkerRosterModel
@{
    ViewData["Title"] = "Full-day workers";
}

<div class="card">
    <h1>Full-day workers</h1>
    @if (Model.AccessDenied)
    {
        <p class="error">@Localizer["Common.OrganizersOnly"]</p>
        <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    }
    else
    {
        @* §1380 — was "Worker roster"; renamed and re-explained after Leth's mail (2026-11-02): the
           old text described a scope ("who the planner draws from") that no longer exists. *@
        <p>
            <strong>Auto-assign plans every active volunteer.</strong> This list says how much each person
            can be given:
        </p>
        <ul style="margin:0 0 10px 18px;">
            <li><strong>Full-day workers</strong> (marked here) are here to work, not to attend sessions —
                they can be scheduled for <strong>all</strong> the hours they said they can work.</li>
            <li><strong>Everyone else</strong> also wants to attend sessions, so they are planned for at most
                <strong>50%</strong> of the hours they said they can work each day.</li>
        </ul>
        <p style="font-size:13px;color:#4b5563;">
            Marking someone does <strong>not</strong> change what they answered on the availability form —
            the planner still only uses the hours they gave. You can always place anyone by hand.
        </p>
        <p><a asp-page="/Organizer/Volunteers">&larr; Back to Volunteers</a></p>
    }
</div>

@if (!Model.AccessDenied)
{
    @if (Model.Message is not null)
    {
        <div class="card vol-ok" role="status">@Model.Message</div>
    }

    <div class="card">
        <p style="margin:0 0 12px;">
            <strong>@Model.InScope</strong> of @Model.Total active volunteers are marked as full-day workers.
            @if (Model.InScope == 0)
            {
                <span style="color:#7a5b00;">
                    Nobody is marked yet, so auto-assign plans everyone at up to 50% of their hours.
                </span>
            }
        </p>

        @* Mobile-first: the table scrolls sideways rather than squashing the availability column,
           which is the column somebody actually reads before deciding. *@
        <style>
            .roster-grid td, .roster-grid th { padding: 10px 14px; vertical-align: top; }
            .roster-grid th { white-space: nowrap; }
            .roster-days { display: block; font-size: 12px; color: #4b5563; margin-top: 2px; }
            .roster-off { color: #b91c1c; }
            .roster-in { background: #f0fdf4; }
            @@media (max-width: 480px) {
                .roster-grid td, .roster-grid th { padding: 8px 10px; }
            }
        </style>

        <div style="overflow-x:auto;">
            <table class="grid roster-grid">
                <thead>
                    <tr>
                        <th scope="col">Volunteer</th>
                        <th scope="col">What they answered</th>
                        <th scope="col">Assigned</th>
                        <th scope="col"></th>
                    </tr>
                </thead>
                <tbody>
                @foreach (var r in Model.Rows)
                {
                    <tr class="@(r.InRoster ? "roster-in" : null)">
                        <td>
                            <strong>@r.Name</strong>
                            <span class="roster-days">@r.Email</span>
                            @if (r.InRoster && !string.IsNullOrWhiteSpace(r.Note))
                            {
                                <span class="roster-days">@r.Note</span>
                            }
                        </td>
                        <td>
                            @if (r.Availability.Count == 0)
                            {
                                @* ⚠️ Worth stating rather than leaving blank: somebody with no
                                   answer can never be auto-assigned, roster or not. *@
                                <span class="roster-off">No availability submitted — cannot be auto-assigned.</span>
                            }
                            else
                            {
                                foreach (var d in r.Availability)
                                {
                                    <span class="roster-days @(d.Working ? null : "roster-off")">
                                        @d.Day.ToString("ddd dd MMM"): @d.Label
                                    </span>
                                }
                            }
                        </td>
                        <td>@(r.AssignedTasks == 0 ? "—" : r.AssignedTasks.ToString())</td>
                        <td>
                            @if (r.InRoster)
                            {
                                <form method="post" asp-page-handler="Remove">
                                    <input type="hidden" name="participantId" value="@r.ParticipantId" />
                                    <button type="submit">Not a full-day worker</button>
                                </form>
                            }
                            else
                            {
                                <form method="post" asp-page-handler="Add">
                                    <input type="hidden" name="participantId" value="@r.ParticipantId" />
                                    <button type="submit">Mark as full-day worker</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>

        @if (Model.Total == 0)
        {
            <p>No active volunteers in this edition yet.</p>
        }
    </div>
}
