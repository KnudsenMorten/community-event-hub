@page
@using CommunityHub.Core.Domain
@using CommunityHub.Pages.Shared
@using Microsoft.AspNetCore.Mvc.Localization
@inject IHtmlLocalizer<CommunityHub.Core.Resources.SharedResource> Localizer
@model CommunityHub.Pages.Organizer.BucketAllocationModel
@{
    ViewData["Title"] = "Buckets & allocation";
}

<style>
    /* Mobile-first (~360px): cards stack, forms go full-width and wrap. */
    .ba-bucket { border:1px solid #d7dbe4; border-radius:10px; margin:0 0 16px 0; overflow:hidden; }
    .ba-head { background:var(--el-darkblue,#1D3380); color:#fff; padding:12px 14px; }
    .ba-head h3 { margin:0; font-size:17px; }
    .ba-head .lead { font-size:12.5px; opacity:.92; margin-top:4px; }
    .ba-body { padding:10px 12px; }
    .ba-task { background:#f6f8fb; border-radius:8px; padding:10px 12px; margin:8px 0; font-size:13.5px; }
    .ba-task .title { font-weight:600; }
    .ba-task .meta { color:#6e7681; font-size:12px; margin-top:2px; }
    .gap { display:inline-block; border-radius:10px; padding:2px 9px; font-size:12px; font-weight:700; }
    .gap.green { background:#dcfce7; color:#166534; }
    .gap.red { background:#fee2e2; color:#991b1b; }
    .gap.sim { background:#fef9c3; color:#854d0e; }
    .ba-form { display:flex; flex-wrap:wrap; gap:6px; align-items:center; margin-top:8px; }
    .ba-form select, .ba-form input[type=file] {
        flex:1 1 160px; min-width:0; box-sizing:border-box; padding:7px 9px;
        font-size:13.5px; border:1px solid #c4c8d4; border-radius:6px; }
    .ba-form button { background:#008BD2; color:#fff; border:0; border-radius:6px;
        padding:8px 14px; font-size:13px; font-weight:600; cursor:pointer; white-space:nowrap; }
    .ba-form button.green { background:#16a34a; }
    .ba-form button.danger { background:#c0392b; }
    .ba-form button.ghost { background:#fff; color:#1D3380; border:1px solid #c4c8d4; }
    .ba-form button:hover { filter:brightness(.95); }
    .ba-note { background:#f0fdf4; border-left:4px solid #16a34a; padding:10px 12px;
        border-radius:6px; margin-bottom:14px; font-size:13.5px; color:#166534; }
    .ba-tray { position:sticky; top:8px; z-index:5; background:#fffbe6; border:1px solid #fde68a;
        border-radius:10px; padding:12px 14px; margin-bottom:16px; }
    .ba-tray h3 { margin:0 0 6px 0; font-size:15px; }
    .ba-chip { display:inline-block; background:#fff; border:1px solid #e5d28a; border-radius:10px;
        padding:3px 8px; font-size:12px; margin:3px 4px 3px 0; }
    .ba-src { display:inline-block; border-radius:8px; padding:1px 6px; font-size:10.5px;
        font-weight:700; margin-right:4px; text-transform:uppercase; letter-spacing:.02em; }
    .ba-src.proposed { background:#ede9fe; color:#5b21b6; }
    .ba-src.queued { background:#dbeafe; color:#1e40af; }
    .ba-engine { background:#eef2ff; border-left:4px solid #4f46e5; padding:10px 12px;
        border-radius:6px; margin:12px 0 0; font-size:13.5px; color:#3730a3; }
    @@media (max-width: 600px) {
        .ba-form select, .ba-form input[type=file], .ba-form button { flex:1 1 100%; }
    }
</style>

<div class="card">
    <h1>Buckets &amp; allocation</h1>
    <p>Group volunteer tasks into <strong>buckets</strong>, see each task&rsquo;s resource
       gap (green = enough people, red = short), and map people&rarr;tasks. Mapping queues a
       <strong>draft</strong> you can simulate and tweak &mdash; nothing is assigned until you
       <strong>commit</strong>.</p>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
        return;
    }

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        <div class="ba-note">@Model.Notice</div>
    }

    @* ---- Import plan ---- *@
    <form method="post" asp-page-handler="Import" enctype="multipart/form-data" class="ba-form" aria-label="Import plan">
        <label for="planFile" style="flex:1 1 100%;font-weight:600;">Import plan (CSV)</label>
        <input type="file" id="planFile" name="planFile" accept=".csv,text/csv" aria-label="Plan CSV file" />
        <button type="submit">Import plan</button>
    </form>
    <p class="meta" style="color:#6e7681;font-size:12px;margin-top:4px;">
        Buckets are derived from the plan&rsquo;s Responsible Team column. AI guidance:
        <strong>@(Model.AiEnabled ? "enabled (LLM)" : "heuristic fallback")</strong>.
    </p>

    @* ---- §150 step 2: availability auto-assign (seeds the draft queue with proposals) ---- *@
    <div class="ba-engine">
        <form method="post" asp-page-handler="RunAutoAssign" class="ba-form" aria-label="Run availability auto-assign">
            <strong style="flex:1 1 100%;">@Localizer["Alloc.AutoAssignHeading"]</strong>
            <span style="flex:1 1 100%;color:#3730a3;">@Localizer["Alloc.AutoAssignVolunteerHelp"]</span>
            @* §1297 — the SCOPE choice, stated rather than assumed. The default is the worker
               roster; "everyone" stays one click away because a run against the whole pool is
               still the right thing when you are sanity-checking coverage. *@
            <label style="flex:1 1 100%;font-size:13px;color:#3730a3;display:flex;gap:6px;align-items:flex-start;">
                <input type="checkbox" name="everyone" value="true" style="margin-top:3px;" />
                <span>
                    Plan for <strong>every</strong> active volunteer, not just the
                    <a asp-page="/Organizer/VolunteerWorkerRoster">worker roster</a>
                    (@Model.RosterCount in scope).
                    @if (Model.RosterCount == 0)
                    {
                        <em>The roster is empty, so this run uses everyone either way.</em>
                    }
                </span>
            </label>
            <button type="submit">@Localizer["Alloc.RunAutoAssign"]</button>
        </form>
    </div>
</div>

@* ====================================================================================
   §1297 — WHAT THE LAST RUN COULD NOT FILL.
   🔑 The planner reports its shortfall instead of returning a quietly partial plan. On the
   real numbers the setup and main days run at ~85% / ~81% utilisation before any break or
   travel, and a quarter of the slots fall outside the hours volunteers were ever asked
   about — so "proposed N assignments" on its own would read as "done".
   The REASON is the actionable part: "outside stated hours" is not fixed by recruiting.
   ==================================================================================== *@
@if (!Model.AccessDenied && Model.Shortfall.Count > 0)
{
    <div class="card" style="border-left:4px solid #b91c1c;">
        <h3 style="margin-top:0;">The last run could not fill these</h3>
        <ul style="margin:6px 0 0;padding-left:18px;font-size:13px;line-height:1.5;">
            @foreach (var line in Model.Shortfall)
            {
                <li>@line</li>
            }
        </ul>
    </div>
}

@* ---- Draft tray (sticky): the pending allocation queue ---- *@
<div class="ba-tray" aria-live="polite">
    <h3>Queue — not published (@Model.DraftCount)</h3>
    <p style="margin:0 0 8px;font-size:12.5px;color:#6e7681;">One shared queue for all organizers — includes everything assigned from the work structure. Volunteers see nothing here until it is published, and publishing only reaches volunteers inside the released ring of <em>Volunteer task assignment</em> (Settings → Features → Volunteers); the rest stay queued.</p>
    @if (Model.DraftCount == 0)
    {
        <p style="margin:0;font-size:13px;color:#6e7681;">Nothing queued. Assign people from the work structure or below, then publish.</p>
    }
    else
    {
        <div>
            @foreach (var d in Model.Draft)
            {
                <span class="ba-chip">
                    @if (d.Source == DraftSource.EngineProposed)
                    {
                        <span class="ba-src proposed" title="@Localizer["Alloc.SourceProposedTitle"]">@Localizer["Alloc.SourceProposed"]</span>
                    }
                    else
                    {
                        <span class="ba-src queued" title="@Localizer["Alloc.SourceQueuedTitle"]">@Localizer["Alloc.SourceQueued"]</span>
                    }
                    @(string.IsNullOrWhiteSpace(d.Participant.FullName) ? d.Participant.Email : d.Participant.FullName)
                    &rarr; @d.Task.Title
                    @if (d.OwnerParticipant is not null) { <span style="color:#6e7681;font-size:11.5px;">(by @(string.IsNullOrWhiteSpace(d.OwnerParticipant.FullName) ? d.OwnerParticipant.Email : d.OwnerParticipant.FullName))</span> }
                    <form method="post" asp-page-handler="RemoveDraft" style="display:inline">
                        <input type="hidden" name="taskId" value="@d.TaskId" />
                        <input type="hidden" name="volunteerId" value="@d.ParticipantId" />
                        <button type="submit" title="Remove from draft"
                                style="background:none;border:0;color:#c0392b;cursor:pointer;font-weight:700;">&times;</button>
                    </form>
                </span>
            }
        </div>
        <div class="ba-form" style="margin-top:10px;">
            <form method="post" asp-page-handler="Commit" style="display:inline">
                <button type="submit" class="green"
                        data-ceh-confirm="confirmCommitAlloc" data-ceh-count="@Model.DraftCount">Publish to volunteers</button>
            </form>
            <form method="post" asp-page-handler="Discard" style="display:inline">
                <button type="submit" class="danger">Discard queue</button>
            </form>
        </div>
        @* Second confirmation before the real commit (REQUIREMENTS §23a, category 3
           Queue safety): states the consequence + count, and that impact is RING-SCOPED. *@
        <partial name="_ConfirmModal" model='new ConfirmModalModel(
            Id: "confirmCommitAlloc",
            Title: "Publish volunteer assignments?",
            Body: "This publishes {count} queued assignment(s): the volunteers see them and get one summary mail each. Only volunteers inside the released ring are published — the rest stay queued, unseen, until the ring is widened and you publish again. This affects real people — are you sure?",
            ConfirmLabel: "Yes, publish",
            CancelLabel: "Cancel",
            Danger: false,
            DefaultCount: Model.DraftCount.ToString())' />
    }

    @* ---- Drop-out re-plan: free a leaver's slots + queue backfill candidates ---- *@
    <div style="margin-top:14px;border-top:1px solid #e6e8ee;padding-top:10px;">
        <h3 style="font-size:14px;margin:0 0 4px;">Someone dropped out?</h3>
        <p style="margin:0 0 8px;font-size:13px;color:#6e7681;">
            Free their shifts and auto-queue backfill candidates (available volunteers preferred)
            as drafts — review the red/green simulation below, then Commit.
        </p>
        <form method="post" asp-page-handler="ReplanDropout" class="ba-form">
            <select name="volunteerId" aria-label="Volunteer who dropped out" asp-items="Model.VolunteerOptions">
                <option value="">— who dropped out? —</option>
            </select>
            <button type="submit" class="danger">Free slots &amp; queue backfill</button>
        </form>
    </div>
</div>

@* ---- Buckets with gap indicators + the task-mapper ---- *@
@foreach (var bucket in Model.Buckets)
{
    <div class="ba-bucket">
        <div class="ba-head">
            <h3>@bucket.Name</h3>
            @if (!string.IsNullOrWhiteSpace(bucket.EldkLeadName))
            {
                <div class="lead">ELDK lead: @bucket.EldkLeadName</div>
            }
        </div>
        <div class="ba-body">
            @foreach (var t in bucket.Tasks)
            {
                var cov = t.Coverage;
                var simClass = cov.IsCovered ? "green" : "red";
                <div class="ba-task">
                    <div class="title">@t.Title</div>
                    <div class="meta">
                        @if (!string.IsNullOrWhiteSpace(t.ResponsibleTeam)) { <text>@t.ResponsibleTeam &middot; </text> }
                        Status: @t.Status
                        @if (!string.IsNullOrWhiteSpace(t.EldkLeadName)) { <text> &middot; Lead: @t.EldkLeadName</text> }
                    </div>
                    <div style="margin-top:6px;">
                        <span class="gap @simClass" title="Needed vs committed+queued">
                            @cov.AssignedCount + @cov.DraftCount / @cov.ResourcesNeeded
                            @(cov.IsCovered ? "✓ covered" : $"short {cov.SimulatedShortfall}")
                        </span>
                        @if (cov.DraftCount > 0)
                        {
                            <span class="gap sim" title="Includes draft (simulation)">simulated</span>
                        }
                    </div>

                    @* Map a person into the DRAFT for this task. *@
                    <form method="post" asp-page-handler="AddDraft" class="ba-form" aria-label="Add to draft">
                        <input type="hidden" name="taskId" value="@t.Id" />
                        <select name="volunteerId" aria-label="Volunteer" asp-items="Model.VolunteerOptions">
                            <option value="">Add person to draft&hellip;</option>
                        </select>
                        <button type="submit" class="ghost">Queue</button>
                    </form>

                    <div class="ba-form">
                        @if (t.Status != VolunteerTaskStatus.Done)
                        {
                            <form method="post" asp-page-handler="Complete" style="display:inline">
                                <input type="hidden" name="taskId" value="@t.Id" />
                                <button type="submit" class="green">Mark completed (lead)</button>
                            </form>
                        }
                        <form method="post" asp-page-handler="RegenerateGuidance" style="display:inline">
                            <input type="hidden" name="taskId" value="@t.Id" />
                            <button type="submit" class="ghost">@(Model.AiEnabled ? "Regenerate guidance (AI)" : "Suggest guidance")</button>
                        </form>
                    </div>
                </div>
            }
            @if (bucket.Tasks.Count == 0)
            {
                <p style="font-size:13px;color:#6e7681;">No tasks in this bucket yet.</p>
            }
        </div>
    </div>
}

@if (Model.Buckets.Count == 0)
{
    <div class="card"><p>No buckets yet. Import the plan CSV above, or create buckets on the
        <a asp-page="/Organizer/VolunteerStructure">Volunteer structure</a> page.</p></div>
}
