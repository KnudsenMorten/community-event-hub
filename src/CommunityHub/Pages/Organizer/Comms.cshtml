                new("/Organizer/SpeakerReminders", Localizer["Nav.OrgSpeakerReminders"].Value, "Remind speakers about pending tasks and deadlines.", "reminder-jobs"),
                new("/Organizer/SoMeQueue", Localizer["Nav.OrgSoMeQueue"].Value, "The queue of social posts ready to publish across channels."),
                @* §824.2C — reachable from the same place as the e-mail templates it mirrors. A page
                   nobody can navigate to is a page nobody edits. *@
                new("/Organizer/SoMeTemplates", "SoMe post templates", "The wording of the five automatic LinkedIn post types — edit per edition, with a preview."),
                new("/Organizer/Feed", "Community feed", "Bug reports, feature ideas and questions participants sent through the AiHelper assistant."),
