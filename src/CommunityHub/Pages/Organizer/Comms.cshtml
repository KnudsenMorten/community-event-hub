@page
@using CommunityHub.Core.Organizer
@model CommunityHub.Pages.Organizer.CommsModel
@{
    ViewData["Title"] = Localizer["OrgComms.Title"].Value;

    string OutcomeLabel(CommsOutcome o) => o switch
    {
        CommsOutcome.Sent => Localizer["Comms.Sent"].Value,
        CommsOutcome.Failed => Localizer["Comms.Failed"].Value,
        CommsOutcome.Dropped => Localizer["Comms.Dropped"].Value,
        _ => Localizer["Comms.Scheduled"].Value,
    };
    string OutcomeColor(CommsOutcome o) => o switch
    {
        CommsOutcome.Sent => "#137333",
        CommsOutcome.Failed => "#a50e0e",
        CommsOutcome.Dropped => "#9a6700",
        _ => "#1a73e8",
    };
    string ChannelLabel(CommsChannel c) =>
        c == CommsChannel.SoMe ? Localizer["Comms.ChannelSoMe"].Value : Localizer["Comms.ChannelEmail"].Value;
}

<div class="card">
    <h1>@Localizer["OrgComms.Title"]</h1>
    @if (Model.AccessDenied)
    {
        <p class="error" role="alert">@Localizer["Common.OrganizersOnly"]</p>
        <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    }
    else
    {
        <p>@Localizer["Comms.CockpitIntro"]</p>
        <p><a asp-page="/Organizer/Index">&larr; @Localizer["Common.BackToOrganizerArea"]</a></p>
    }
</div>

@if (!Model.AccessDenied && Model.Snapshot is { } snap)
{
    @if (!string.IsNullOrWhiteSpace(Model.Msg))
    {
        <div class="card" role="status" aria-live="polite"
             style="border-left:4px solid #137333;">
            <p style="margin:0;">@Model.Msg</p>
        </div>
    }

    <!-- Headline counters: real outcomes only, never optimistic. -->
    <div class="card">
        <h2>@Localizer["Comms.AtAGlance"]</h2>
        <div role="status" aria-live="polite"
             style="display:flex;flex-wrap:wrap;gap:12px;">
            <div style="flex:1 1 140px;min-width:140px;">
                <div style="font-size:28px;font-weight:700;">@snap.EmailsSent</div>
                <div style="color:#6b7280;font-size:13px;">@Localizer["Comms.EmailsSent"]</div>
            </div>
            <div style="flex:1 1 140px;min-width:140px;">
                <div style="font-size:28px;font-weight:700;color:@(snap.EmailsDropped > 0 ? "#9a6700" : "inherit");">@snap.EmailsDropped</div>
                <div style="color:#6b7280;font-size:13px;">@Localizer["Comms.EmailsDropped"]</div>
            </div>
            <div style="flex:1 1 140px;min-width:140px;">
                <div style="font-size:28px;font-weight:700;color:@(snap.EmailsFailed > 0 ? "#a50e0e" : "inherit");">@snap.EmailsFailed</div>
                <div style="color:#6b7280;font-size:13px;">@Localizer["Comms.EmailsFailed"]</div>
            </div>
            <div style="flex:1 1 140px;min-width:140px;">
                <div style="font-size:28px;font-weight:700;">@snap.SoMeScheduled</div>
                <div style="color:#6b7280;font-size:13px;">@Localizer["Comms.SoMeScheduled"]</div>
            </div>
            <div style="flex:1 1 140px;min-width:140px;">
                <div style="font-size:28px;font-weight:700;">@snap.SoMePublished</div>
                <div style="color:#6b7280;font-size:13px;">@Localizer["Comms.SoMePublished"]</div>
            </div>
        </div>
        @if (snap.AllDelivered)
        {
            <p class="info" role="status" style="margin-top:10px;">@Localizer["Comms.AllDelivered"]</p>
        }
        @* §818 — the ops count is stated UP HERE, next to the participant numbers, because the
           section itself is far down the page and the operator's complaint was that this mail was
           invisible. The counters stay separate (§815.1) — this is a pointer, not a merge. *@
        @if (snap.OpsMailTotal > 0)
        {
            <p style="margin:10px 0 0;font-size:13.5px;color:#6b7280;">
                Plus <strong>@snap.OpsMailTotal</strong> engine / ops mail to a mailbox
                @if (snap.OpsMailFailed > 0)
                {
                    <span style="color:#a50e0e;">(@snap.OpsMailFailed did not arrive)</span>
                }
                &mdash; <a href="#ops-mail">see below</a>. Not counted above: it reaches no participant.
            </p>
        }
    </div>

    <!-- Resend: undelivered participant mail, one click to send again. -->
    <div class="card">
        <h2>@Localizer["Comms.ResendHeading"]</h2>
        <p>@Localizer["Comms.ResendIntro"]</p>
        @* §650 — RING-DROPPED MAIL IS HIDDEN BY DEFAULT. A ring drop is the system obeying the
           operator, not a fault; 1,242 of them buried the 2 real failures. The toggle is here
           because "show me everything" is occasionally the right question — just not the default
           one when you are troubleshooting. *@
        <p style="margin:-6px 0 14px;font-size:13.5px;">
            @if (Model.ShowDropped)
            {
                <a asp-page="/Organizer/Comms" asp-route-showDropped="false">
                    &#10003; Showing everything &mdash; hide the non-problems again
                </a>
                <span style="color:#6b7280;">
                    &middot; including mail that was ring-dropped, and failures that were
                    <strong>delivered on a later attempt</strong>.
                </span>
            }
            else
            {
                <a asp-page="/Organizer/Comms" asp-route-showDropped="true">
                    Also show ring-dropped and already-delivered mail
                </a>
                <span style="color:#6b7280;">
                    &middot; hidden by default: ring drops were not sent <em>on purpose</em>, and a
                    failure that succeeded on the next attempt <em>did reach the person</em>. Neither
                    is a problem to chase.
                </span>
            }
        </p>
        @if (snap.ResendCandidates.Count == 0)
        {
            <p class="info" role="status">@Localizer["Comms.NoResend"]</p>
        }
        else
        {
            <div style="overflow-x:auto;position:relative;">
                <table style="width:100%;border-collapse:collapse;min-width:560px;">
                    <caption class="sr-only">@Localizer["Comms.ResendHeading"]</caption>
                    <thead>
                        <tr style="text-align:left;border-bottom:2px solid #ddd;">
                            <th scope="col">@Localizer["Comms.ColRecipient"]</th>
                            <th scope="col">@Localizer["Comms.ColSubject"]</th>
                            <th scope="col">@Localizer["Comms.ColOutcome"]</th>
                            <th scope="col">@Localizer["Comms.ColAction"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in snap.ResendCandidates)
                        {
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="word-break:break-all;">
                                    <div>@r.Name</div>
                                    <div style="color:#6b7280;font-size:13px;">@r.Email</div>
                                    @* §644 — SAY WHERE IT WILL ACTUALLY GO. The logged address can be
                                       historical; the resend targets the person's CURRENT one, which
                                       is right, but looked wrong when the confirmation named an
                                       address the operator had never seen on this page. *@
                                    @if (r.GoesToADifferentAddress)
                                    {
                                        <div style="color:#b45309;font-size:12px;margin-top:2px;">
                                            now <strong>@r.CurrentEmail</strong> &mdash; the resend goes here
                                        </div>
                                    }
                                </td>
                                <td style="word-break:break-word;">
                                    <div>@r.Subject</div>
                                    <div style="color:#6b7280;font-size:12px;">@r.Category</div>
                                </td>
                                <td>
                                    <span style="color:@OutcomeColor(r.Outcome);" title="@r.Error">@OutcomeLabel(r.Outcome)</span>
                                    @* §650 — WHY it failed, in words. Operator: "i still dont
                                       understand WHY an email failed … i need a way to understand
                                       WHY it failed like unknown recipient or similar". Classified
                                       from the stored error on READ, so every row already in the
                                       log gains its reason without a migration or a backfill. *@
                                    @{
                                        var why = CommunityHub.Core.Email.EmailFailureReason.Classify(r.Error);
                                    }
                                    @* §656 — only visible when the toggle is on. Without this the
                                       row reads as a real failure, which is exactly the confusion
                                       that made a delivered hotel invite look lost. *@
                                    @if (r.WasSuperseded)
                                    {
                                        <div style="font-size:12.5px;color:#1f6d3a;margin-top:3px;font-weight:600;">
                                            ✓ Delivered on a later attempt &mdash; this row is the
                                            failed try, not a lost message.
                                        </div>
                                    }
                                    else if (why.Kind != CommunityHub.Core.Email.EmailFailureKind.None)
                                    {
                                        <div style="font-size:12.5px;color:#374151;margin-top:3px;max-width:340px;">
                                            @why.Summary
                                        </div>
                                        <div style="font-size:12px;color:#6b7280;margin-top:2px;max-width:340px;">
                                            @why.WhatToDo
                                        </div>
                                    }
                                </td>
                                <td>
                                    @* 🔒 §644 — RESEND THE MAIL THAT FAILED. This was a hard-coded
                                       two-option dropdown (onboarding-getting-started / invitation)
                                       regardless of what had actually failed — so a failed
                                       calendar-invite could not be resent at all, and one click sent
                                       a real speaker an unrelated onboarding mail. *@
                                    @if (string.IsNullOrWhiteSpace(r.ResendTemplate))
                                    {
                                        <span style="color:#6b7280;font-size:13px;">
                                            No template recorded for this mail, so it cannot be resent
                                            safely. Use Email Center to pick one deliberately.
                                        </span>
                                    }
                                    else
                                    {
                                        <form method="post" asp-page-handler="Resend"
                                              style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;">
                                            <input type="hidden" name="participantId" value="@r.ParticipantId" />
                                            <input type="hidden" name="template" value="@r.ResendTemplate" />
                                            <button type="submit">@Localizer["Comms.Resend"]</button>
                                            <span style="color:#6b7280;font-size:12px;">@r.ResendTemplate</span>
                                        </form>
                                    }
                                    @* 🔒 §784.1 — THE WAY OUT. A row with no template could not be
                                       resent AND could not be cleared, so it sat here for 30 days
                                       until the age rule dropped it. Dismiss is deliberately
                                       available on EVERY row, including that one — it is the case
                                       that has no other exit. It hides the row and nothing else:
                                       the mail stays undelivered in the Email Log, because these
                                       rows are ATTEMPTS and this button must never become a second
                                       answer to "did it arrive". *@
                                    <form method="post" asp-page-handler="Dismiss"
                                          style="display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:6px;">
                                        <input type="hidden" name="participantId" value="@r.ParticipantId" />
                                        <button type="submit" title="@Localizer["Comms.DismissTitle"]"
                                                style="background:none;border:1px solid #d1d5db;color:#374151;
                                                       padding:4px 10px;border-radius:6px;font-size:13px;
                                                       cursor:pointer;">
                                            @Localizer["Comms.Dismiss"]
                                        </button>
                                        <span style="color:#6b7280;font-size:12px;">
                                            takes it off this list only
                                        </span>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <p style="color:#6b7280;font-size:13px;margin-top:8px;">@Localizer["Comms.ResendHint"]</p>
        }
    </div>

    <!-- Upcoming: the next things going out (scheduled SoMe posts). -->
    <div class="card">
        <h2>@Localizer["Comms.UpcomingHeading"]</h2>
        @if (snap.UpcomingScheduled.Count == 0)
        {
            <p class="info" role="status">@Localizer["Comms.NoUpcoming"]</p>
        }
        else
        {
            <ul style="padding-left:18px;">
                @foreach (var u in snap.UpcomingScheduled)
                {
                    <li style="margin-bottom:6px;">
                        <strong>@u.When.UtcDateTime.ToString("dd MMM HH:mm")</strong> &middot;
                        <span style="color:#6b7280;">@ChannelLabel(u.Channel)</span> &middot;
                        @u.Title
                    </li>
                }
            </ul>
        }
    </div>

    <!-- Who-got-what: per recipient, the real EmailLog outcome. -->
    <div class="card">
        <h2>@Localizer["Comms.WhoGotWhat"]</h2>
        <p>@Localizer["Comms.WhoGotWhatIntro"]</p>
        @if (snap.WhoGotWhat.Count == 0)
        {
            <p class="info" role="status">@Localizer["Comms.NoEmails"]</p>
        }
        else
        {
            @* 🔒 §784.2 — THE DROPPED COLUMN IS GONE BY DEFAULT. Operator 2026-08-03: "remove the
               dropped column also by default, as it is filtered out". It is the SAME switch that
               governs the resend list above, deliberately: two independent "show the ring drops"
               toggles on one page is how one gets flipped and the other forgotten, and the column
               was a column of zeroes precisely because the rest of the page already filters them. *@
            <div style="overflow-x:auto;position:relative;">
                <table style="width:100%;border-collapse:collapse;min-width:600px;">
                    <caption class="sr-only">@Localizer["Comms.WhoGotWhat"]</caption>
                    <thead>
                        <tr style="text-align:left;border-bottom:2px solid #ddd;">
                            <th scope="col">@Localizer["Comms.ColRecipient"]</th>
                            <th scope="col">@Localizer["Comms.Sent"]</th>
                            @if (Model.ShowDropped)
                            {
                                <th scope="col">@Localizer["Comms.Dropped"]</th>
                            }
                            <th scope="col">@Localizer["Comms.Failed"]</th>
                            <th scope="col">@Localizer["Comms.ColLast"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var w in snap.WhoGotWhat)
                        {
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="word-break:break-all;">
                                    @if (!string.IsNullOrWhiteSpace(w.Name)) { <div>@w.Name</div> }
                                    <div style="color:#6b7280;font-size:13px;">@w.Email</div>
                                    @* §784.2 — THE BUTTON HE ASKED FOR: "i only see count. I need to
                                       see subject,date,time". <details> so it works with no
                                       JavaScript, keeps its own state per row, and collapses back
                                       out of the way — the page still has to be readable with 200
                                       people on it. *@
                                    @if (w.Messages.Count > 0)
                                    {
                                        <details style="margin-top:6px;">
                                            <summary style="cursor:pointer;font-size:13px;color:#008BD2;">
                                                Show the @w.Messages.Count
                                                @(w.Messages.Count == 1 ? "message" : "messages")
                                            </summary>
                                            <table style="width:100%;border-collapse:collapse;margin-top:6px;">
                                                <caption class="sr-only">
                                                    Messages to @(w.Name ?? w.Email)
                                                </caption>
                                                <thead>
                                                    <tr style="text-align:left;">
                                                        <th scope="col" style="font-size:12px;color:#6b7280;">Subject</th>
                                                        <th scope="col" style="font-size:12px;color:#6b7280;">When</th>
                                                        <th scope="col" style="font-size:12px;color:#6b7280;">Outcome</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    @foreach (var m in w.Messages)
                                                    {
                                                        <tr>
                                                            <td style="font-size:13px;word-break:break-word;padding:2px 6px 2px 0;">
                                                                @(string.IsNullOrWhiteSpace(m.Subject) ? "(no subject)" : m.Subject)
                                                                <div style="color:#6b7280;font-size:11.5px;">@m.Category</div>
                                                            </td>
                                                            <td style="font-size:13px;white-space:nowrap;padding:2px 6px 2px 0;">
                                                                @m.SentAt.UtcDateTime.ToString("dd MMM yyyy HH:mm")
                                                            </td>
                                                            <td style="font-size:13px;color:@OutcomeColor(m.Outcome);padding:2px 0;">
                                                                @OutcomeLabel(m.Outcome)
                                                            </td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                            @if (w.Messages.Count >= CommunityHub.Core.Organizer.CommsCockpitService.MessagesPerPersonCap)
                                            {
                                                <p style="font-size:12px;color:#6b7280;margin:4px 0 0;">
                                                    Showing the most recent
                                                    @CommunityHub.Core.Organizer.CommsCockpitService.MessagesPerPersonCap
                                                    only — the Email Log has the rest.
                                                </p>
                                            }
                                            <p style="font-size:12px;color:#6b7280;margin:4px 0 0;">
                                                These are send <strong>attempts</strong>. &ldquo;Sent&rdquo;
                                                means the mail was accepted for delivery, not that it was read.
                                            </p>
                                        </details>
                                    }
                                </td>
                                <td>@w.Sent</td>
                                @if (Model.ShowDropped)
                                {
                                    <td style="color:@(w.Dropped > 0 ? "#9a6700" : "inherit");">@w.Dropped</td>
                                }
                                <td style="color:@(w.Failed > 0 ? "#a50e0e" : "inherit");">@w.Failed</td>
                                <td style="white-space:nowrap;color:#6b7280;font-size:13px;">@w.LastAt.UtcDateTime.ToString("dd MMM HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Per-campaign delivery view. -->
    <div class="card">
        <h2>@Localizer["Comms.Campaigns"]</h2>
        @if (snap.Campaigns.Count == 0)
        {
            <p class="info" role="status">@Localizer["Comms.NoEmails"]</p>
        }
        else
        {
            <div style="overflow-x:auto;position:relative;">
                <table style="width:100%;border-collapse:collapse;min-width:520px;">
                    <caption class="sr-only">@Localizer["Comms.Campaigns"]</caption>
                    <thead>
                        <tr style="text-align:left;border-bottom:2px solid #ddd;">
                            <th scope="col">@Localizer["Comms.ColCampaign"]</th>
                            <th scope="col">@Localizer["Comms.Sent"]</th>
                            <th scope="col">@Localizer["Comms.Dropped"]</th>
                            <th scope="col">@Localizer["Comms.Failed"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var c in snap.Campaigns)
                        {
                            <tr style="border-bottom:1px solid #eee;">
                                <td>@c.Category</td>
                                <td>@c.Sent</td>
                                <td style="color:@(c.Dropped > 0 ? "#9a6700" : "inherit");">@c.Dropped</td>
                                <td style="color:@(c.Failed > 0 ? "#a50e0e" : "inherit");">@c.Failed</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    @* §818 — ENGINE & OPS MAIL. Operator 2026-08-04 (§815): *"why can I not see the emails sent
       here in a logged form"*. He could not because this mail carries no edition stamp and every
       view above is edition-scoped — 375 rows over six weeks rendered nowhere.

       🔒 Its OWN section, never folded into the tables above (§815.1): a participant's welcome and
       a job-failure alert answer different questions, and 252 engine alerts dropped into the
       timeline would bury the participant mail this page exists to track. *@
    <div class="card" id="ops-mail">
        <h2>Engine &amp; ops mail</h2>
        <p>
            What the machine sent to a <strong>mailbox</strong> rather than to a person &mdash; job
            failures, hand-entry lists, invoice notices and ERP refusals. These reach no participant,
            so they are counted separately and are never offered for re-send.
        </p>
        @if (snap.OpsMail.Count == 0)
        {
            <p class="info" role="status">No engine or ops mail in the last 30 days.</p>
        }
        else
        {
            <p style="margin:-6px 0 14px;font-size:13.5px;color:#6b7280;">
                <strong>@snap.OpsMailSent</strong> delivered
                @if (snap.OpsMailFailed > 0)
                {
                    <span>&middot; <strong style="color:#a50e0e;">@snap.OpsMailFailed did not arrive</strong></span>
                }
                @if (snap.OpsMailTotal > snap.OpsMail.Count)
                {
                    <span>
                        &middot; showing the newest @snap.OpsMail.Count of @snap.OpsMailTotal &mdash;
                        the full list is on the <a asp-page="/Organizer/EmailLog">Email log</a>.
                    </span>
                }
            </p>
            <div style="overflow-x:auto;position:relative;">
                <table style="width:100%;border-collapse:collapse;min-width:640px;">
                    <caption class="sr-only">Engine and ops mail</caption>
                    <thead>
                        <tr style="text-align:left;border-bottom:2px solid #ddd;">
                            <th scope="col">@Localizer["Comms.ColWhen"]</th>
                            <th scope="col">@Localizer["Comms.ColSubject"]</th>
                            <th scope="col">@Localizer["Comms.ColRecipient"]</th>
                            <th scope="col">@Localizer["Comms.ColOutcome"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in snap.OpsMail)
                        {
                            <tr style="border-bottom:1px solid #eee;">
                                <td style="white-space:nowrap;">@i.When.UtcDateTime.ToString("dd MMM HH:mm")</td>
                                <td style="word-break:break-word;">
                                    <div>@i.Title</div>
                                    <div style="color:#6b7280;font-size:12px;">@i.Category</div>
                                </td>
                                <td style="word-break:break-all;color:#6b7280;font-size:13px;">@i.Recipient</td>
                                <td><span style="color:@OutcomeColor(i.Outcome);" title="@i.Error">@OutcomeLabel(i.Outcome)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- Unified timeline: email + SoMe, one chronological feed. -->
    <div class="card">
        <h2>@Localizer["Comms.Timeline"]</h2>
        <p>@Localizer["Comms.TimelineIntro"]</p>
        @if (snap.Timeline.Count == 0)
        {
            <p class="info" role="status">@Localizer["Comms.NoTimeline"]</p>
        }
        else
        {
            <div style="overflow-x:auto;position:relative;">
                <table style="width:100%;border-collapse:collapse;min-width:640px;">
                    <caption class="sr-only">@Localizer["Comms.Timeline"]</caption>
                    <thead>
                        <tr style="text-align:left;border-bottom:2px solid #ddd;">
                            <th scope="col">@Localizer["Comms.ColWhen"]</th>
                            <th scope="col">@Localizer["Comms.ColChannel"]</th>
                            <th scope="col">@Localizer["Comms.ColSubject"]</th>
                            <th scope="col">@Localizer["Comms.ColRecipient"]</th>
                            <th scope="col">@Localizer["Comms.ColOutcome"]</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var i in snap.Timeline)
                        {
                            <tr style="border-bottom:1px solid #eee;@(i.IsFuture ? "background:#f5f9ff;" : "")">
                                <td style="white-space:nowrap;">@i.When.UtcDateTime.ToString("dd MMM HH:mm")</td>
                                <td>@ChannelLabel(i.Channel)</td>
                                <td style="word-break:break-word;">
                                    <div>@i.Title</div>
                                    <div style="color:#6b7280;font-size:12px;">@i.Category</div>
                                </td>
                                <td style="word-break:break-all;color:#6b7280;font-size:13px;">@i.Recipient</td>
                                <td><span style="color:@OutcomeColor(i.Outcome);" title="@i.Error">@OutcomeLabel(i.Outcome)</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>

    <!-- The existing comms tools this cockpit consolidates (fan-out, not duplication). -->
    <div class="card">
        <h2>@Localizer["Comms.ToolsHeading"]</h2>
        @{
            var tiles = new List<CommunityHub.Pages.Shared.HubTile>
            {
                @* 🗑 §705.12 — the Broadcast and Send-Invitations tiles are GONE with their pages.
                   Leaving a tile pointing at a deleted page is a 404 an organizer finds by clicking.

                   EmailCenter's "broadcast-email" gate key is REMOVED, not replaced. It is organizer
                   tooling on an organizer-only page, so its gate is the ROLE — the same reasoning
                   §569 used to take rings off organizer surfaces. Every neighbour here (EmailLog,
                   EmailTemplates, SoMeQueue, Feed) already carries no key; EmailCenter was the odd
                   one out. A switch nobody needs is one more thing to reason about. *@
                new("/Organizer/EmailCenter", Localizer["Nav.OrgEmailCenter"].Value, "Preview, test-send and re-send templated email."),
                new("/Organizer/EmailLog", Localizer["Nav.OrgEmailLog"].Value, "The full delivery log of every email sent."),
