@page
@using CommunityHub.Core.Domain
@model CommunityHub.Pages.Organizer.AttendeesModel
@{
    ViewData["Title"] = "Attendees";
}

@* data-ceh-grid: animated loading skeleton while a filter/sort/page navigation
   is in flight (REQUIREMENTS §21). Pure progressive enhancement. *@
<div class="card ceh-grid" data-ceh-grid data-ceh-grid-loading="@Localizer["OrgGrid.Loading"]">
    <h1>Attendees</h1>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
    }
    else
    {
        @* §355: outcome of the last onboarding reset. *@
        @if (!string.IsNullOrWhiteSpace(Model.ResetMessage))
        {
            <p role="status" class="@(Model.ResetIsError ? "error" : "success")"
               style="padding:10px 12px;border-radius:8px;background:@(Model.ResetIsError ? "#fef2f2" : "#ecfdf5");border:1px solid @(Model.ResetIsError ? "#fecaca" : "#a7f3d0");">
                @Model.ResetMessage
            </p>
        }

        <p>Reconciled hourly from Zoho Backstage (tickets) and Zoho Bookings
           (Master Class seats). Read-only here &mdash; fix issues at the
           source; the next sync picks them up.
           @if (Model.LastSyncedAt is not null)
           {
               <br /><span style="color:#6b7280;">Last sync:
               @Model.LastSyncedAt.Value.UtcDateTime.ToString("ddd d MMM yyyy HH:mm") UTC</span>
           }
        </p>

        <!-- Summary tiles: wrap on phones (min 140px each) -->
        <div style="display:flex;flex-wrap:wrap;gap:10px;margin:0 0 16px;">
            <div style="flex:1 1 140px;background:#f8f9fb;border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:26px;font-weight:700;">@Model.TotalCount</div>
                <div style="font-size:13px;color:#6b7280;">attendees</div>
            </div>
            <div style="flex:1 1 140px;background:#f8f9fb;border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:26px;font-weight:700;">@Model.TwoDayCount</div>
                <div style="font-size:13px;color:#6b7280;">2-day tickets</div>
            </div>
            @* §707.36 (operator 2026-07-30: "i need a field so i can see 1-day tickets also as
               counter") — without it the tiles did not add up: "2 attendees / 1 2-day ticket" left
               the second attendee unaccounted for, so the reader had to subtract and assume. *@
            <div style="flex:1 1 140px;background:#f8f9fb;border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:26px;font-weight:700;">@Model.OneDayCount</div>
                <div style="font-size:13px;color:#6b7280;">1-day tickets</div>
            </div>
            <div style="flex:1 1 140px;background:#f8f9fb;border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:26px;font-weight:700;">@Model.BookedCount</div>
                <div style="font-size:13px;color:#6b7280;">Master Class booked</div>
            </div>
            @* §326bp (operator 2026-07-25: "what does mismatch mean?") — it never meant the two
               systems disagree. The flag is literally `!hasSelection`: a live 2-day ticket whose
               holder has not picked a Master Class yet. That is a normal CHASE LIST — and the job
               already e-mails those people — so it is named for what it is and loses the
               alert-red treatment, which made routine work look like a data fault. The
               HasReconciliationMismatch COLUMN and the MismatchOnly route key are unchanged
               (a rename there is a migration and would break saved links for no gain). *@
            <div style="flex:1 1 140px;background:@(Model.MismatchCount > 0 ? "#fff8e1" : "#f8f9fb");border-radius:8px;padding:12px;text-align:center;">
                <div style="font-size:26px;font-weight:700;color:@(Model.MismatchCount > 0 ? "#7a5b00" : "inherit");">@Model.MismatchCount</div>
                <div style="font-size:13px;color:#6b7280;">Master Class not chosen</div>
            </div>
        </div>

        <form method="get" style="margin-bottom:16px;">
            <label for="Search">Search (name, email, Master Class)</label>
            <input type="text" id="Search" name="Search" value="@Model.Search" />

            <label for="Ticket">Ticket</label>
            <select id="Ticket" name="Ticket">
                <option value="">All</option>
                @* §1077 (operator 2026-08-11: "shows 1-day tickets as 'other'" / "prints the raw
                   enum names") — the OPTION TEXT is the label ("2-day" / "1-day" / "No ticket");
                   the VALUE stays the enum name so the `Ticket=` query key and saved links are
                   unchanged. Picking "1-day" here filters on `Other`, as it always did. *@
                @foreach (var t in Enum.GetValues<TicketStatus>())
                {
                    <option value="@t" selected="@(Model.Ticket == t.ToString())">@t.Label()</option>
                }
            </select>

            <label for="Booking">Master Class booking</label>
            <select id="Booking" name="Booking">
                <option value="">All</option>
                @* §1077 — option TEXT is the label, VALUE stays the enum name so saved
                   `?Booking=NotBooked` links keep working (the same rule as the ticket filter). *@
                @foreach (var b in Enum.GetValues<MasterClassBookingStatus>())
                {
                    <option value="@b" selected="@(Model.Booking == b.ToString())">@b.Label()</option>
                }
            </select>

            <label style="display:flex;align-items:center;gap:8px;margin:10px 0 14px;">
                <input type="checkbox" name="MismatchOnly" value="true"
                       checked="@Model.MismatchOnly" style="width:auto;margin:0;" />
                Only those who have not chosen a Master Class
            </label>

            <button type="submit">Apply</button>
            @* data-ceh-grid-skip: this is a CSV download, not a page replace, so
               it must NOT trigger the grid loading skeleton. *@
            <a asp-page="/Organizer/Attendees" asp-page-handler="Export"
               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
               data-ceh-grid-skip download
               style="margin-left:10px;">Export CSV (current filter)</a>
            @* data-ceh-grid-skip: this is an Excel download, not a page replace, so
               it must NOT trigger the grid loading skeleton. *@
            <a asp-page="/Organizer/Attendees" asp-page-handler="ExportXlsx"
               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
               data-ceh-grid-skip download
               style="margin-left:10px;">Excel (.xlsx)</a>
        </form>

        @if (Model.Attendees.Count == 0)
        {
            <p class="info">@Localizer["OrgGrid.NoMatch"]</p>
        }
        else
        {
            <p role="status">
                @Localizer["OrgGrid.ShowingRange", Model.Paging.FirstRowNumber, Model.Paging.LastRowNumber, Model.Paging.TotalItems]
            </p>
            <!-- overflow-x so the table scrolls sideways on phones instead of
                 blowing the 360px layout -->
            <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;min-width:640px;">
                    <caption class="sr-only">@Localizer["OrgAttendees.Title"]</caption>
                    <tr style="text-align:left;border-bottom:2px solid #ddd;">
                        <th scope="col" aria-sort="@Model.AriaSort("name")">
                            <a asp-page="/Organizer/Attendees"
                               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                               asp-route-Sort="name" asp-route-Desc="@Model.NextDescFor("name")" asp-route-PageNo="1">@Localizer["OrgGrid.Col.Name"]@Model.SortIndicator("name")</a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort("email")">
                            <a asp-page="/Organizer/Attendees"
                               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                               asp-route-Sort="email" asp-route-Desc="@Model.NextDescFor("email")" asp-route-PageNo="1">@Localizer["OrgGrid.Col.Email"]@Model.SortIndicator("email")</a>
                        </th>
                        @* §1065 — COMPANY, next to the person it belongs to. Operator 2026-08-11:
                           *"this page must include company name for attendees"*. Placed after Email
                           because "who is this and where are they from" is one thought, and it is
                           what an organizer is holding when a sponsor asks about their people. *@
                        <th scope="col" aria-sort="@Model.AriaSort("company")">
                            <a asp-page="/Organizer/Attendees"
                               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                               asp-route-Sort="company" asp-route-Desc="@Model.NextDescFor("company")" asp-route-PageNo="1">Company@Model.SortIndicator("company")</a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort("ticket")">
                            <a asp-page="/Organizer/Attendees"
                               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                               asp-route-Sort="ticket" asp-route-Desc="@Model.NextDescFor("ticket")" asp-route-PageNo="1">@Localizer["OrgAttendees.Col.Ticket"]@Model.SortIndicator("ticket")</a>
                        </th>
                        <th scope="col" aria-sort="@Model.AriaSort("booking")">
                            <a asp-page="/Organizer/Attendees"
                               asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                               asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                               asp-route-Sort="booking" asp-route-Desc="@Model.NextDescFor("booking")" asp-route-PageNo="1">@Localizer["OrgAttendees.Col.Booking"]@Model.SortIndicator("booking")</a>
                        </th>
                        <th scope="col">@Localizer["OrgAttendees.Col.MasterClass"]</th><th scope="col"></th>
                    </tr>
                    @foreach (var a in Model.Attendees)
                    {
                        <tr style="border-bottom:1px solid #eee;@(a.HasReconciliationMismatch ? "background:#fffdf3;" : "")">
                            <td>@a.FirstName @a.LastName</td>
                            <td style="word-break:break-all;">@a.Email</td>
                            @* §1065 — an em dash rather than an empty cell: blank reads as a
                               rendering fault, "—" reads as "Zoho sent no company for this one". *@
                            <td>@(string.IsNullOrWhiteSpace(a.CompanyName) ? "—" : a.CompanyName)</td>
                            @* §380 (operator 2026-07-26: "remove the word TwoDay - just show the
                               ticket in no parantes"). The cell read "TwoDay (2-day ticket incl.
                               Master Class)" — the raw enum name followed by the real ticket name in
                               brackets, i.e. the same fact twice, once in developer spelling. Show
                               the ticket's OWN name; fall back to the enum only when Zoho sent no
                               class name, so the column is never blank. *@
                            @* §1077: the fallback is the LABEL, not the enum name — "1-day"
                               rather than "Other", matching the 1-day summary tile above. *@
                            <td>@(string.IsNullOrWhiteSpace(a.TicketClassName) ? a.TicketStatus.Label() : a.TicketClassName)</td>
                            @* §1077 — the label, for the same reason as the ticket column beside it. *@
                            <td>@a.BookingStatus.Label()</td>
                            <td>@a.MasterClassName</td>
                            <td>
                                @if (a.HasReconciliationMismatch)
                                {
                                    <span style="font-size:13px;font-weight:600;color:#7a5b00;">Master Class not chosen</span>
                                }

                                @* §355 (operator 2026-07-26): "an organizer can do this reset, which
                                   resets the welcome, master class + party sign-up — he selects the
                                   attendee and have option to flip the 3 values so it forces attendee
                                   to setup again". A two-step <details> disclosure (the §334 shape):
                                   needs NO JavaScript, so it behaves identically with scripting off,
                                   and the three checkboxes ARE the deliberate act. *@
                                @* 🔒 §707.40 (operator 2026-07-30: "this reset onboarding + resend
                                   invite is not relevant for 1-day ticket holders (by design)") —
                                   BOTH actions are Master-Class/onboarding actions, and a 1-day
                                   holder has no Master Class, no selection invite and no hub login
                                   (§707.38). Offering them was the §326bx defect: controls that
                                   govern nothing, on the row where they look most authoritative.
                                   The row SAYS SO rather than falling silently blank, so an empty
                                   actions cell never reads as a rendering fault. *@
                                @if (a.TicketStatus != TicketStatus.TwoDay)
                                {
                                    <p class="set-deps" style="margin:6px 0 0;font-size:12.5px;color:#6b7280;">
                                        <em>No onboarding actions</em> &mdash; a 1-day ticket has no
                                        Master&nbsp;Class and no hub login, by design.
                                    </p>
                                }
                                else
                                {
                                <details style="margin-top:6px;">
                                    <summary style="cursor:pointer;font-size:12.5px;color:#1565c0;">Reset onboarding&hellip;</summary>
                                    <form method="post" asp-page-handler="ResetOnboarding" style="margin:8px 0 2px;padding:10px;background:#fff8e1;border:1px solid #f5d98a;border-radius:8px;">
                                        <input type="hidden" name="attendeeId" value="@a.Id" />
                                        <p style="margin:0 0 6px;font-size:12.5px;color:#7c4a03;">
                                            Forces this attendee to onboard again. Tick what to reset:
                                        </p>
                                        <label style="display:block;font-size:12.5px;margin:3px 0;">
                                            <input type="checkbox" name="resetWelcome" value="true" /> Welcome / selection invite (will be re-sent)
                                        </label>
                                        <label style="display:block;font-size:12.5px;margin:3px 0;">
                                            <input type="checkbox" name="resetMasterClass" value="true" /> Master Class seat &amp; waitlist place
                                        </label>
                                        <label style="display:block;font-size:12.5px;margin:3px 0;">
                                            <input type="checkbox" name="resetParty" value="true" /> Party sign-up (RSVP)
                                        </label>
                                        <button type="submit" style="margin-top:8px;padding:6px 12px;border-radius:6px;background:#b45309;color:#fff;border:none;font-size:12.5px;font-weight:600;cursor:pointer;">
                                            Reset selected
                                        </button>
                                    </form>
                                </details>
                                @* 🔒 §707.14 — RE-SEND THE SELECTION INVITE. Operator 2026-07-30: the
                                   "welcome mail" button is NOT the equivalent for attendees — it sends
                                   the GENERIC welcome and is idempotent, and the reset-welcome path
                                   calls the RETIRED 1-day service. A 2-day attendee's real welcome is
                                   masterclass-selection-invite, and until now the only way to re-send
                                   it was a database edit. Deliberately SEPARATE from "Reset
                                   onboarding": this re-sends the mail without destroying their Master
                                   Class seat or party RSVP. *@
                                <form method="post" asp-page-handler="ResendSelectionInvite" style="margin-top:6px;">
                                    <input type="hidden" name="attendeeId" value="@a.Id" />
                                    <button type="submit" style="padding:5px 11px;border-radius:6px;background:#0f766e;color:#fff;border:none;font-size:12.5px;font-weight:600;cursor:pointer;">
                                        Re-send selection invite
                                    </button>
                                </form>
                                } @* §707.40 — end of the 2-day-only actions *@
                            </td>
                        </tr>
                    }
                </table>
            </div>

            @if (Model.Paging.TotalPages > 1)
            {
                <nav aria-label="Pagination" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px;">
                    @if (Model.Paging.HasPrevious)
                    {
                        <a asp-page="/Organizer/Attendees"
                           asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                           asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                           asp-route-Sort="@Model.Sort" asp-route-Desc="@Model.Desc"
                           asp-route-PageNo="@(Model.Paging.Page - 1)" rel="prev"
                           style="padding:6px 12px;border:1px solid #c4c8d4;border-radius:6px;text-decoration:none;">@Localizer["OrgGrid.Prev"]</a>
                    }
                    <span>@Localizer["OrgGrid.PageOf", Model.Paging.Page, Model.Paging.TotalPages]</span>
                    @if (Model.Paging.HasNext)
                    {
                        <a asp-page="/Organizer/Attendees"
                           asp-route-Ticket="@Model.Ticket" asp-route-Booking="@Model.Booking"
                           asp-route-MismatchOnly="@Model.MismatchOnly" asp-route-Search="@Model.Search"
                           asp-route-Sort="@Model.Sort" asp-route-Desc="@Model.Desc"
                           asp-route-PageNo="@(Model.Paging.Page + 1)" rel="next"
                           style="padding:6px 12px;border:1px solid #c4c8d4;border-radius:6px;text-decoration:none;">@Localizer["OrgGrid.Next"]</a>
                    }
                </nav>
            }
        }
    }
    <p><a asp-page="/Organizer/Index">Back to organizer area</a></p>
</div>
