@page "{id:int?}"
@model CommunityHub.Pages.Organizer.EditParticipantModel
@{
    ViewData["Title"] = Model.IsNew ? "Add participant" : "Edit participant";
}

<div class="card">
    @*
        §592 — NAME THE PERSON, NOT THE ROW ID. This read "Edit participant #4", which is the raw
        database key: it tells the organizer nothing about WHO is being edited and it is the same
        machine-output-in-a-human-surface defect that cost trust in the Settings page (§563/§564).
        Falls back name → e-mail → "#id", so the heading is never empty even for a half-filled row.
    *@
    <h1>
        @(Model.IsNew
            ? "Add participant"
            : "Edit " + (!string.IsNullOrWhiteSpace(Model.FullName) ? Model.FullName
                : !string.IsNullOrWhiteSpace(Model.Email) ? Model.Email
                : $"participant #{Model.Id}"))
    </h1>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
    }
    else
    {
        if (!string.IsNullOrEmpty(Model.Error))
        {
            <p class="error">@Model.Error</p>
        }
        if (!string.IsNullOrEmpty(Model.Message))
        {
            <p class="info">@Model.Message</p>
        }

        @* Unsaved-changes guard (data-ceh-dirty) + submit loading state
           (data-ceh-loading): an organizer who edits a field then navigates away
           without saving is warned, and a double-click cannot fire two posts.
           Saving clears the guard; the Cancel link opts out via
           data-ceh-allow-leave so leaving via Cancel never trips the prompt. *@
        <form method="post" data-ceh-dirty data-ceh-loading>
            <label for="Email">Email (unique within this edition)</label>
            <input type="email" asp-for="Email" required autocomplete="email" />

            @* §941 — first + last on the PRE-STAGE form, one Full name box when editing. An
               existing row stores a single string, and guessing where to cut it breaks every
               "van der Berg" in the database (see EditParticipantModel.FirstName). *@
            @if (Model.IsNew)
            {
                <label for="FirstName">First name</label>
                <input type="text" asp-for="FirstName" required autocomplete="given-name" />

                <label for="LastName">Last name</label>
                <input type="text" asp-for="LastName" required autocomplete="family-name" />
            }
            else
            {
                <label for="FullName">Full name</label>
                <input type="text" asp-for="FullName" required />
            }

            <label for="Phone">Phone (optional)</label>
            <input type="text" asp-for="Phone" />

            <label for="Role">Role</label>
            <select asp-for="Role">
                @foreach (var r in Enum.GetValues<CommunityHub.Core.Domain.ParticipantRole>())
                {
                    <option value="@((int)r)">@r</option>
                }
            </select>

            <label for="SponsorCompanyId">Sponsor company id (optional)</label>
            <input type="text" asp-for="SponsorCompanyId"
                   placeholder="Company Manager / WooCommerce company id" inputmode="numeric" />
            <p style="margin:-4px 0 10px;font-size:12px;color:#6b7280;">
                Links a Sponsor-role contact to their company so they see that company's
                tasks. Leave blank for non-sponsor people. Clear it to unlink.
            </p>

            <label style="font-weight:normal; display:flex; align-items:center; gap:8px;">
                <input type="checkbox" asp-for="IsActive" style="width:auto;margin:0;" />
                Active (can sign in)
            </label>

            @if (Model.IsNew)
            {
                <label style="font-weight:normal; display:flex; align-items:center; gap:8px; margin-top:8px;">
                    <input type="checkbox" asp-for="SendWelcome" style="width:auto;margin:0;" />
                    Send the welcome email now
                </label>
            }

            <div style="display:flex; flex-wrap:wrap; gap:10px; margin-top:14px;">
                <button type="submit" data-ceh-loading-text="@Localizer["Common.Saving"]">@(Model.IsNew ? "Create participant" : "Save changes")</button>
                <a asp-page="/Organizer/Participants" class="secondary" data-ceh-allow-leave
                   style="background:var(--el-grey);color:var(--el-darkblue);padding:9px 16px;border-radius:7px;text-decoration:none;font-size:15px;">
                    Cancel
                </a>
            </div>
        </form>

        @if (!Model.IsNew)
        {
            <form method="post" asp-page-handler="SendWelcome" style="margin-top:14px;">
                <input type="hidden" asp-for="Id" />
                <button type="submit"
                        style="background:var(--el-grey);color:var(--el-darkblue);padding:9px 16px;border-radius:7px;border:none;font-size:15px;cursor:pointer;">
                    @(Model.WelcomeAlreadySent ? "Resend welcome email" : "Send welcome email")
                </button>
                <span style="font-size:12px;color:#6b7280;display:block;margin-top:4px;">
                    @(Model.WelcomeAlreadySent
                        ? "A welcome was already sent — this will not send again (idempotent)."
                        : "No welcome has been sent to this person yet.")
                </span>
            </form>

            @* 🔒 §707.14 — a 2-day ATTENDEE's real welcome is the Master Class selection invite
               (§241), NOT the generic welcome above. The button above is idempotent and sends the
               wrong mail for this role, and the reset path calls the retired 1-day service — so
               without this there was no way to re-send it except a database edit. Shown only for
               attendees, because it means nothing for any other role. *@
            @if (Model.Role == CommunityHub.Core.Domain.ParticipantRole.Attendee)
            {
                <form method="post" asp-page-handler="ResendSelectionInvite" style="margin-top:10px;">
                    <input type="hidden" asp-for="Id" />
                    <button type="submit"
                            style="background:#0f766e;color:#fff;padding:9px 16px;border-radius:7px;border:none;font-size:15px;cursor:pointer;">
                        Re-send Master Class selection invite
                    </button>
                    <span style="font-size:12px;color:#6b7280;display:block;margin-top:4px;">
                        This IS the 2-day attendee's welcome mail — it carries the magic-link button.
                        Re-sends even if it went out before. Their Master Class seat and party RSVP
                        are left untouched.
                    </span>
                </form>
            }

            @* §236 — RESET so the welcome sends AGAIN (role-simulation testing): clears the
               once-ever ledger + the sent-stamp, then re-sends the role's welcome now. *@
            <form method="post" asp-page-handler="ResetWelcome" style="margin-top:10px;"
                  onsubmit="return confirm('Reset the welcome for this person and send a fresh welcome email now?');">
                <input type="hidden" asp-for="Id" />
                <button type="submit"
                        style="background:#fff;color:#b45309;border:1px solid #f0d878;padding:9px 16px;border-radius:7px;font-size:15px;cursor:pointer;">
                    🔄 Reset welcome — send again
                </button>
                <span style="font-size:12px;color:#6b7280;display:block;margin-top:4px;">
                    Clears the "already sent" state and immediately sends a fresh welcome (with a
                    new Get-Started link). Ring gating still applies — handy for re-testing a role's
                    first-contact flow on your own accounts.
                </span>
            </form>
        }

        @if (!Model.IsNew)
        {
            @* §355 (operator 2026-07-26: "should we have a similar organizer interface for this
               reset functionality, so i can reset both per step + full reset") — the speaker /
               volunteer / media counterpart of the attendee reset on /Organizer/Attendees.

               A <details> disclosure so it needs no JavaScript (the §334 shape) and cannot be hit
               by accident: this deletes another person's answers.

               The step list is rendered from ParticipantOnboardingResetService.Steps, so a step
               added to the service appears here without touching this view. *@
            <details style="margin-top:20px;border:1px solid #f0d878;border-radius:8px;background:#fffdf3;padding:10px 14px;">
                <summary style="cursor:pointer;font-weight:600;color:#7a5b00;">
                    🔄 Reset Get Started (per step, or all)
                </summary>

                <p style="font-size:13px;color:#4b5563;margin:10px 0 4px;">
                    Puts the selected steps back to <em>not done</em> so this person is asked again.
                    Their role, login, ring and sessions are untouched — and a speaker's biography
                    text is never deleted, only the "the speaker edited it" marker.
                </p>
                <p style="font-size:12.5px;color:#7a5b00;margin:0 0 10px;">
                    Get Started reads each step from the underlying DATA, not from the task — so
                    this clears the answer as well as re-opening the task. Re-opening the task alone
                    would leave the wizard still showing the step as complete.
                </p>

                <form method="post" asp-page-handler="ResetOnboarding"
                      onsubmit="return confirm('Reset the ticked Get Started steps for this person? Their saved answers for those steps are deleted.');">
                    <input type="hidden" asp-for="Id" />

                    @* §395 (operator 2026-07-26: "where is the select all button"). The help text
                       said "tick every box for a full reset" — with nine boxes, that instruction
                       was the feature request. Progressive enhancement: with JS off the individual
                       boxes still work exactly as before, so nothing depends on this. *@
                    <label id="reset-all-wrap" style="display:none;gap:9px;align-items:center;margin:10px 0 2px;font-weight:700;">
                        <input type="checkbox" id="reset-all" style="width:auto;margin:0;" />
                        <span>Select all steps (full reset)</span>
                    </label>

                    <div id="reset-steps" style="display:flex;flex-direction:column;gap:8px;margin:8px 0 14px;">
                        @foreach (var step in CommunityHub.Core.Organizer.ParticipantOnboardingResetService.Steps)
                        {
                            <label style="display:flex;gap:9px;align-items:flex-start;font-weight:500;">
                                <input type="checkbox" name="ResetSteps" value="@step.Key"
                                       style="width:auto;margin:3px 0 0;" />
                                <span>
                                    @step.Label
                                    <span style="display:block;font-weight:400;font-size:12.5px;color:#6b7280;">
                                        @step.What
                                    </span>
                                </span>
                            </label>
                        }
                    </div>
                    <button type="submit"
                            style="background:#fff;color:#b45309;border:1px solid #f0d878;padding:9px 16px;border-radius:7px;font-size:15px;cursor:pointer;">
                        Reset the ticked steps
                    </button>
                    <span style="font-size:12px;color:#6b7280;display:block;margin-top:6px;">
                        Recorded in the audit trail with exactly what it cleared.
                    </span>
                </form>

                <script>
                    (function () {
                        var wrap = document.getElementById('reset-all-wrap');
                        var all = document.getElementById('reset-all');
                        var list = document.getElementById('reset-steps');
                        if (!wrap || !all || !list) return;
                        var boxes = list.querySelectorAll('input[name="ResetSteps"]');
                        if (!boxes.length) return;
                        wrap.style.display = 'flex';   // only shown when JS can actually drive it
                        all.addEventListener('change', function () {
                            boxes.forEach(function (b) { b.checked = all.checked; });
                        });
                        // Keep the master box honest when the individual ones are edited.
                        boxes.forEach(function (b) {
                            b.addEventListener('change', function () {
                                var checked = 0;
                                boxes.forEach(function (x) { if (x.checked) checked++; });
                                all.checked = checked === boxes.length;
                                all.indeterminate = checked > 0 && checked < boxes.length;
                            });
                        });
                    })();
                </script>
            </details>

            @* §761 — the speaker's own details, READ-ONLY and copy/paste ready. The Backstage
               speakers API is create-only, so when the gap mail reports a field missing over there,
               this is where the value is copied from instead of hunting on another page.
               🔒 Values render BARE — no quotes (§760): quotes get caught by a drag-selection, and a
               pasted "https://…" is a broken link. *@
            @if (Model.Speaker is { } spk)
            {
                <details open class="spk-box">
                    <summary>Speaker details (copy/paste)</summary>
                    <p class="spk-intro">
                        Read-only. The speaker edits these on their <strong>Speaker details</strong>
                        onboarding step; they are shown here so you can copy a value straight into
                        Zoho Backstage, whose speakers API CEH cannot update.
                    </p>
                    <dl class="spk-detail">
                        @{
                            var rows = new (string Label, string? Value, string? Note)[]
                            {
                                ("Company", spk.CompanyName, null),
                                ("Tagline", spk.Tagline, null),
                                ("Biography", spk.Biography, null),
                                ("Skills (comma separated)", Model.SpeakerSkills,
                                    "derived from the Microsoft accreditation + MVP categories"),
                                ("LinkedIn", spk.LinkedIn, null),
                                ("X / Twitter", spk.Twitter, null),
                                ("Blog / website", spk.Blog, null),
                                ("Photo URL", spk.PhotoUrl, null),
                                // 🔒 §623 — Backstage NEVER returns country on any read, so CEH can
                                // never tell whether it is set over there. Say so, rather than let a
                                // blank imply "already fine".
                                ("Country", spk.Country, Model.CountryConfirmed
                                    ? $"confirmed set in Backstage by {spk.CountryConfirmedBy} "
                                      + $"on {spk.CountryConfirmedAt:dd MMM yyyy}"
                                    : "Backstage never reports this field back — confirm it visually"),
                            };
                        }
                        @foreach (var (label, value, note) in rows)
                        {
                            <dt>@label</dt>
                            <dd>
                                @if (string.IsNullOrWhiteSpace(value))
                                {
                                    <span class="spk-empty">— not set in CEH</span>
                                }
                                else
                                {
                                    <span class="spk-value">@value</span>
                                }
                                @if (!string.IsNullOrWhiteSpace(note))
                                {
                                    <span class="spk-note">@note</span>
                                }
                            </dd>
                        }
                    </dl>

                    @* §762 — the only way this mail can ever go quiet about country. Backstage never
                       reports the field back, so CEH cannot verify it; an organizer acknowledges it
                       instead. The confirmation stores the VALUE, so changing the country in CEH
                       re-asks rather than staying silently suppressed. *@
                    @if (!string.IsNullOrWhiteSpace(spk.Country))
                    {
                        <form method="post" style="margin-top:14px;">
                            <input type="hidden" name="Id" value="@Model.Id" />
                            @if (Model.CountryConfirmed)
                            {
                                <button type="submit" asp-page-handler="UnconfirmCountry">
                                    Country is NOT set in Backstage after all
                                </button>
                                <span class="spk-note">
                                    Confirmed — the missing-details mail no longer asks about this
                                    speaker's country. Change the country in CEH and it will ask again.
                                </span>
                            }
                            else
                            {
                                <button type="submit" asp-page-handler="ConfirmCountry">
                                    I have set the country in Backstage
                                </button>
                                <span class="spk-note">
                                    Ticking this stops the "details missing in Backstage" mail asking
                                    about this speaker's country. CEH cannot check it — Backstage
                                    never reports the field back — so this is your confirmation.
                                </span>
                            }
                        </form>
                    }
                </details>
            }

            <p style="margin-top:18px;font-size:13px;color:#6b7280;">
                Tip: to edit hotel dates / dinner / swag answers on behalf of this person,
                use <a asp-page="/Organizer/DataGrid">the participant data grid</a>.
            </p>
        }
    }
    <p><a asp-page="/Organizer/Participants">Back to participants</a></p>
</div>

<style>
    /* §761 — the speaker copy/paste block. Mobile-first: the two-column grid collapses at 640px. */
    .spk-box { margin-top:18px; border:1px solid #e5e7eb; border-radius:8px; padding:12px 14px; }
    .spk-box > summary { cursor:pointer; font-weight:600; }
    .spk-intro { font-size:13px; color:#6b7280; margin:8px 0 12px; }
    .spk-detail { display:grid; grid-template-columns:210px 1fr; gap:8px 14px; margin:0; }
    .spk-detail dt { font-weight:600; color:#374151; font-size:13.5px; }
    .spk-detail dd { margin:0; font-size:13.5px; }
    /* user-select:all — ONE click selects the whole value. With no quotes around it (§760) that
       selection is exactly what goes into Backstage. */
    .spk-value { user-select:all; white-space:pre-wrap; word-break:break-word; }
    .spk-empty { color:#9ca3af; font-style:italic; }
    .spk-note { display:block; color:#6b7280; font-size:12px; margin-top:2px; }
    @@media (max-width:640px) { .spk-detail { grid-template-columns:1fr; } .spk-detail dd { margin-bottom:6px; } }
</style>
