@page
@using CommunityHub.Core.Integrations
@model CommunityHub.Pages.Organizer.ContentStudioModel
@{
    // §832 (operator 2026-08-05): "this must be renamd to WordPress BlogPost Content".
    // The title is also the breadcrumb LEAF (the shared partial reuses ViewData["Title"]),
    // so this one line renames the page and the trail together. Route unchanged by design.
    ViewData["Title"] = "WordPress BlogPost Content";
}

<h1>WordPress BlogPost Content</h1>
<p class="muted">Generate marketing content from live hub data, then create a <strong>WordPress draft</strong> to validate before publishing. Nothing is published automatically.</p>

@if (Model.AccessDenied)
{
    <p class="error">Organizers only.</p>
}
else
{
    <div class="card" style="margin-bottom:16px;">
        <form method="get" style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
            <label for="Kind"><strong>Content type:</strong></label>
            <select id="Kind" name="Kind" onchange="this.form.submit()">
                <option value="@((int)ContentKind.TicketSales)" selected="@(Model.Kind == ContentKind.TicketSales)">Ticket sales update</option>
                <option value="@((int)ContentKind.MasterClasses)" selected="@(Model.Kind == ContentKind.MasterClasses)">Master classes announcement</option>
            </select>
            <noscript><button type="submit">Preview</button></noscript>
        </form>
    </div>

    @if (Model.Message is not null)
    {
        <p class="@(Model.MessageIsError ? "error" : "success")">
            @Model.Message
            @if (Model.DraftEditUrl is not null)
            {
                <a href="@Model.DraftEditUrl" target="_blank" rel="noopener">Open the draft in WordPress →</a>
            }
        </p>
    }

    @if (Model.Preview is null)
    {
        <div class="card"><p class="info">No data available to generate this post yet. (Ticket sales needs the Zoho telemetry; master classes need at least one master-class session.)</p></div>
    }
    else
    {
        <div class="card" style="margin-bottom:16px;">
            <h2 style="margin-top:0;">WordPress draft preview</h2>
            <p><strong>Title:</strong> @Model.Preview.Title</p>
            <div style="border:1px solid #e6eaf2;border-radius:8px;padding:14px;background:#fff;">
                @Html.Raw(Model.Preview.BodyHtml)
            </div>

            <form method="post" asp-page-handler="CreateDraft" style="margin-top:14px;">
                <input type="hidden" name="Kind" value="@((int)Model.Kind)" />
                @if (Model.WordPressReady)
                {
                    <button type="submit" class="btn-primary">Create WordPress draft</button>
                    <span class="muted" style="margin-left:8px;">Creates a draft (status = draft). You validate &amp; publish in WordPress.</span>
                }
                else
                {
                    <button type="submit" class="btn-primary" disabled>Create WordPress draft</button>
                    <span class="muted" style="margin-left:8px;">WordPress connector is not configured yet — set <code>WordPress__SiteUrl</code> / <code>WordPress__Username</code> / <code>WordPress__AppPassword</code> and enable the <em>WordPress BlogPost Content</em> feature.</span>
                }
            </form>
        </div>

        <div class="card">
            <h2 style="margin-top:0;">LinkedIn post text</h2>
            <p class="muted">Copy this into a LinkedIn company-page post (held for validation — nothing auto-posts).</p>
            <textarea readonly rows="10" style="width:100%;font-family:inherit;">@Model.Preview.ShortText</textarea>
            @if (Model.Preview.Tags.Count > 0)
            {
                <p style="margin-top:8px;"><strong>Suggested tags:</strong> @string.Join(" ", Model.Preview.Tags)</p>
            }
        </div>
    }

    @* §1379.8 — linked WordPress posts that CEH re-renders from live data and updates in place. *@
    <div class="card wp-refresh" id="refresh-weekly" style="margin-top:16px;">
        <h2 style="margin-top:0;">Linked posts — Refresh weekly</h2>
        <p class="muted">Link an existing WordPress post by its id, write its body with tokens, and tick <strong>Refresh weekly</strong>:
            once a week CEH re-renders the body from live hub data and updates that post <strong>in place</strong> (same URL), even when it is published.
            Only ticked posts are ever updated; everything else stays draft-only.</p>
        <details style="margin-bottom:12px;">
            <summary>Tokens you can use</summary>
            <p style="word-break:break-word;">@foreach (var t in Model.SupportedTokens) { <code style="margin-right:6px;">{{@t}}</code> }</p>
            <p class="muted">Counts are computed at render time (never typed). <code>{{SpeakerCountRounded}}</code> shows e.g. "90+".
                <code>{{SpeakersByTrack}}</code>, <code>{{SponsorList}}</code> and <code>{{ExhibitorList}}</code> insert HTML lists. An unknown token is left as typed and listed in the preview.</p>
        </details>

        @if (Model.LinkMessage is not null)
        {
            <p class="@(Model.LinkMessageIsError ? "error" : "success")" role="status">@Model.LinkMessage</p>
        }

        @foreach (var post in Model.LinkedPosts)
        {
            var open = Model.PreviewLinkId == post.Id;
            <details class="wp-refresh-row" style="border-top:1px solid #e6eaf2;padding:10px 0;" open="@open">
                <summary style="cursor:pointer;">
                    <strong>@post.Label</strong> <span class="muted">(post @post.WordPressPostId)</span>
                    @if (post.RefreshWeekly) { <span class="badge">Refresh weekly</span> }
                    <br /><span class="muted" style="font-size:0.9em;">@(post.LastRefreshResult ?? "Not refreshed yet.")</span>
                </summary>
                <form method="post" style="margin-top:10px;">
                    <input type="hidden" name="LinkId" value="@post.Id" />
                    <label>WordPress post id<br /><input type="number" name="LinkPostId" value="@post.WordPressPostId" min="1" required style="max-width:100%;" /></label><br />
                    <label>Label<br /><input type="text" name="LinkLabel" value="@post.Label" maxlength="300" style="width:100%;" /></label><br />
                    <label>Body template (HTML with tokens)<br />
                        <textarea name="LinkTemplate" rows="10" style="width:100%;font-family:monospace;">@(open && Model.LinkTemplate is not null ? Model.LinkTemplate : post.BodyTemplate)</textarea></label><br />
                    <label><input type="checkbox" name="LinkRefreshWeekly" value="true" checked="@post.RefreshWeekly" /> Refresh weekly (updates the live post in place)</label>
                    <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
                        <button type="submit" asp-page-handler="SaveLink" class="btn-primary">Save</button>
                        <button type="submit" asp-page-handler="PreviewLink">Preview render</button>
                        <button type="submit" asp-page-handler="RefreshNow" disabled="@(!post.RefreshWeekly)"
                                onclick="return confirm('Update WordPress post @post.WordPressPostId now with the SAVED template?');">Refresh now</button>
                        <button type="submit" asp-page-handler="Unlink" formnovalidate
                                onclick="return confirm('Unlink this post? The WordPress post itself is not changed.');">Unlink</button>
                    </div>
                </form>
                @if (open && Model.LinkPreview is not null)
                {
                    <partial name="_WordPressRenderPreview" model="Model.LinkPreview" />
                }
            </details>
        }

        <details style="border-top:1px solid #e6eaf2;padding:10px 0;" open="@(Model.PreviewLinkId == 0)">
            <summary style="cursor:pointer;"><strong>+ Link a WordPress post</strong></summary>
            <form method="post" style="margin-top:10px;">
                <label>WordPress post id<br /><input type="number" name="LinkPostId" value="@(Model.PreviewLinkId == 0 && Model.LinkPostId > 0 ? (long?)Model.LinkPostId : null)" min="1" style="max-width:100%;" /></label><br />
                <label>Label<br /><input type="text" name="LinkLabel" value="@(Model.PreviewLinkId == 0 ? Model.LinkLabel : null)" maxlength="300" style="width:100%;" /></label><br />
                <label>Body template (HTML with tokens)<br />
                    <textarea name="LinkTemplate" rows="10" style="width:100%;font-family:monospace;">@(Model.PreviewLinkId == 0 ? Model.LinkTemplate : null)</textarea></label><br />
                <label><input type="checkbox" name="LinkRefreshWeekly" value="true" /> Refresh weekly (updates the live post in place)</label>
                <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:8px;">
                    <button type="submit" asp-page-handler="SaveLink" class="btn-primary">Link post</button>
                    <button type="submit" asp-page-handler="PreviewLink">Preview render</button>
                </div>
            </form>
            @if (Model.PreviewLinkId == 0 && Model.LinkPreview is not null)
            {
                <partial name="_WordPressRenderPreview" model="Model.LinkPreview" />
            }
        </details>
    </div>
}
