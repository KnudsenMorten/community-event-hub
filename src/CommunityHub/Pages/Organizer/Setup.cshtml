@page
@model CommunityHub.Pages.Organizer.SetupModel
@{
    ViewData["Title"] = Localizer["OrgSetup.Title"].Value;
}

<div class="card">
    <h1>@Localizer["OrgSetup.Title"]</h1>
    @if (Model.AccessDenied)
    {
        <p class="error">@Localizer["Common.OrganizersOnly"]</p>
        <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    }
    else
    {
        <p>@Localizer["OrgSetup.Intro"]</p>
        <p><a asp-page="/Organizer/Index">&larr; @Localizer["Common.BackToOrganizerArea"]</a></p>
    }
</div>

@if (!Model.AccessDenied)
{
    var tiles = new List<CommunityHub.Pages.Shared.HubTile>
    {
        new("/Organizer/CalendarSettings", Localizer["Nav.OrgCalendarSettings"].Value, Localizer["OrgSetup.Calendar"].Value),
        new("/Organizer/SessionizeEndpointSettings", Localizer["Nav.OrgSessionizeEndpoint"].Value, Localizer["OrgSetup.Sessionize"].Value),
        new("/Organizer/SoMeSettings", Localizer["Nav.OrgSoMeSettings"].Value, Localizer["OrgSetup.SoMe"].Value),
        new("/Organizer/Settings", Localizer["Nav.OrgSettings"].Value, Localizer["OrgSetup.Settings"].Value),
        new("/Organizer/AuditTrail", "Audit trail", "Every user action + backend event (emails, calendar syncs) for troubleshooting and usage — filter, count, export."),
        // §327: the verified inventory of every background job + the per-job run limit.
        new("/Organizer/Jobs", "Background jobs", "Every job the hub runs: what it does, its schedule, when it last ran, its health — and a run limit you can change without a deploy."),
        // §392: the diagnostics view. Named PlatformHealth, NOT Telemetry — /Organizer/Telemetry is
        // ATTENDEE telemetry (who is coming), a different question entirely, and two pages called
        // "Telemetry" would cost a support round-trip every time someone is asked to open one.
        new("/Organizer/PlatformHealth", "Platform health", "Traffic, response times, outbound calls and failures from Application Insights — the page to open when someone says it hangs."),
        new("/Organizer/TestDataCleanup", Localizer["Nav.OrgTestDataCleanup"].Value, Localizer["OrgSetup.TestData"].Value, "test-data-cleanup"),
    };
    <partial name="_HubGrid" model="@tiles" />
}
