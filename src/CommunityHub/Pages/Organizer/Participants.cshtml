@page
@using CommunityHub.Core.Domain
@model CommunityHub.Pages.Organizer.ParticipantsModel
@{
    ViewData["Title"] = "Participants";
}

<style>
    /* Per-persona flag badges + the per-row Action dropdown (operator 2026-06-24). */
    .pflag { display:inline-block; margin:1px 2px; padding:1px 7px; font-size:11px; font-weight:600;
        border-radius:9px; background:#eef2f7; color:#334155; border:1px solid #d3dbe6; white-space:nowrap; }
    .pflag-test { background:#fef3c7; color:#92560a; border-color:#f0d27a; }
    /* §185: Ring 2 "Design" chip — same shape as the amber Test chip, in green. */
    .pflag-design { background:#dcfce7; color:#166534; border-color:#86efac; }
    details.row-actions > summary { cursor:pointer; list-style:none; display:inline-block;
        padding:6px 12px; border:1px solid #c4c8d4; border-radius:6px; font-weight:600;
        color:var(--el-darkblue,#1D3380); white-space:nowrap; }
    details.row-actions > summary::-webkit-details-marker { display:none; }
    details.row-actions[open] > summary { background:var(--el-grey,#eef1f6); }
    details.row-actions > div { margin-top:8px; }
</style>

@* data-ceh-grid: while a filter/sort/page navigation is in flight the shared
   _Layout script lays an animated skeleton over this data-heavy grid (see
   REQUIREMENTS §21). Pure progressive enhancement. *@
<div class="card ceh-grid" data-ceh-grid data-ceh-grid-loading="@Localizer["OrgGrid.Loading"]">
    @* 🔑 §941 — "NEW" LIVES IN THE PAGE HEADER, ABOVE BOTH LAYOUTS. Operator 2026-08-07:
       "in the participant view, I would like to have a NEW button, which is used to prestage a
       person". Putting it here rather than in the table toolbar means it renders once and appears
       in the desktop table view AND the mobile card view — a toolbar button would have had to be
       duplicated into both, and the duplicate is the one that gets forgotten (§945's lesson: two
       copies of one thing agree only by coincidence).

       It goes to the create form that already existed at /Organizer/EditParticipant with no id —
       what was missing was never the form, only a way to reach it. *@
    <div style="display:flex;flex-wrap:wrap;gap:12px;align-items:center;justify-content:space-between;">
        <h1 style="margin:0;">Participants</h1>
        <a asp-page="/Organizer/EditParticipant"
           style="background:var(--el-darkblue,#1b2a63);color:#fff;padding:10px 18px;border-radius:7px;
                  text-decoration:none;font-size:15px;font-weight:600;white-space:nowrap;">
            + New participant
        </a>
    </div>
    @* 🔒 §707.37 (operator 2026-07-30: "Participants (Active People who can login to hub - 1-day
       attendees are excluded)") — this page lists LOGINS, not ticket holders, and the difference
       was invisible: he bought a 1-day ticket, saw it on /Organizer/Attendees, and reasonably
       expected the person here too.

       The 1-day clause is rendered from the LIVE feature state, not hard-coded. `attendee-1day-access`
       is SUSPENDED by default (§242) — while it is off, 1-day holders get no login at all; the moment
       it is switched on they are provisioned and DO appear here. A fixed sentence would then be a page
       telling the reader something untrue, which is the §326bx defect in words. *@
    <p class="set-deps" style="margin:-6px 0 14px;color:#334155;">
        <strong>Active people who can sign in to the hub.</strong>
        @if (Model.OneDayAccessEnabled)
        {
            <text>1-day attendees are <strong>included</strong> — 1-day hub access is currently
            switched <strong>ON</strong>, so they have logins too.</text>
        }
        else
        {
            <text><strong>1-day attendees are excluded.</strong>
            @* 🔒 §707.38 — operator 2026-07-30: "make a note that it is by design that 1-day ticket
               holders have their state as inactive as they dont require access to hub". Said HERE,
               where the number is read, so an inactive 1-day holder is never mistaken for a defect
               and "repaired" by switching them on. *@
            This is <strong>by design, not a fault</strong>: a 1-day holder attends the main event
            only and does not need the hub, so they are provisioned no login and show as
            <em>inactive</em>. The hub exists for Master&nbsp;Class selection, tasks and onboarding —
            none of which apply to them. They are all listed under
            <a asp-page="/Organizer/Attendees">Attendees</a>, and the
            <strong>&ldquo;Active + 1-day attendees&rdquo;</strong> status filter below shows everyone
            who is really coming.</text>
        }
    </p>

    @if (Model.AccessDenied)
    {
        <p class="error" role="alert">This area is for organizers only.</p>
    }
    else
    {
        @if (!string.IsNullOrEmpty(Model.ActionMessage))
        {
            <p class="@(Model.ActionIsError ? "error" : "info")" role="status">@Model.ActionMessage</p>
        }

        <!-- Filters: search, status (active default + show inactive/all), persona, sponsor company -->
        <form method="get" class="ceh-filterbar">
            @* §1129 — WIDER than the dropdowns on purpose: this one box holds an id, a name OR an
               e-mail address, so it is the field most likely to be truncated mid-value. *@
            <span class="ceh-filterbar__field ceh-filterbar__field--wide">
                <label for="Search">@Localizer["OrgGrid.Search"]</label>
                @* §769.10 — the CEH id is searchable here too: type 73 to find participant 73. *@
                <input type="search" id="Search" name="Search" value="@Model.Search"
                       placeholder="ID / @Localizer["OrgGrid.Col.Name"] / @Localizer["OrgGrid.Col.Email"]" />
            </span>
            <span class="ceh-filterbar__field">
                <label for="ActiveFilter">Status</label>
                <select id="ActiveFilter" name="ActiveFilter">
                    @* §707.38 — the DEFAULT (operator 2026-07-30: "set the new dropdown as default").
                       "Active only" hid every 1-day holder, and "Inactive only" mixed them in with
                       genuinely withdrawn people, so neither answered "who is actually coming". *@
                    <option value="active+1day" selected="@(Model.ActiveFilter == "active+1day")">Active + 1-day attendees</option>
                    <option value="active" selected="@(Model.ActiveFilter == "active")">Active only</option>
                    <option value="inactive" selected="@(Model.ActiveFilter == "inactive")">Inactive only</option>
                    <option value="all" selected="@(Model.ActiveFilter == "all")">Show inactive too (all)</option>
                </select>
            </span>
            <span class="ceh-filterbar__field">
                <label for="RoleFilter">Persona</label>
                <select id="RoleFilter" name="RoleFilter">
                    <option value="">All personas</option>
                    @foreach (var role in Enum.GetValues<ParticipantRole>())
                    {
                        <option value="@role" selected="@(Model.RoleFilter == role)">@role</option>
                    }
                </select>
            </span>
            <span class="ceh-filterbar__field">
                <label for="SponsorCompanyFilter">Sponsor company</label>
                <select id="SponsorCompanyFilter" name="SponsorCompanyFilter">
                    <option value="">All companies</option>
                    @foreach (var cid in Model.SponsorCompanyIds)
                    {
                        <option value="@cid" selected="@(Model.SponsorCompanyFilter == cid)">
                            @Model.CompanyDisplayName(cid)
                        </option>
                    }
                </select>
            </span>
            <span class="ceh-filterbar__field">
                <label for="FlagFilter">Flag</label>
                <select id="FlagFilter" name="FlagFilter">
                    <option value="">Any flag</option>
                    <option value="speaker"     selected="@(Model.FlagFilter == "speaker")">Speakers</option>
                    <option value="booth"       selected="@(Model.FlagFilter == "booth")">Booth members</option>
                    <option value="test"        selected="@(Model.FlagFilter == "test")">Test users</option>
                    <option value="signer"      selected="@(Model.FlagFilter == "signer")">Signers</option>
                    <option value="coordinator" selected="@(Model.FlagFilter == "coordinator")">Event coordinators</option>
                </select>
            </span>
            @* §735 (operator 2026-07-31: "add ability to filter on ring here") — the page already
               had a BULK "change ring to" and no way to SEE who is in a ring, so an organizer
               assigning rings could act but never check the result. Labels come from Rings.Label,
               the same source the bulk control and the e-mail Settings page use, so the three
               places can never name a ring differently. *@
            <span class="ceh-filterbar__field">
                <label for="RingFilter">Ring</label>
                <select id="RingFilter" name="RingFilter">
                    <option value="">Any ring</option>
                    @foreach (var r in Enum.GetValues<CommunityHub.Core.Settings.Ring>())
                    {
                        <option value="@r" selected="@(Model.RingFilter == r)">@CommunityHub.Core.Settings.Rings.Label(r)</option>
                    }
                </select>
            </span>
            <!-- Keep the active sort when re-filtering; a new search starts at page 1
                 (PageNo is intentionally not carried over by the filter form). -->
            <input type="hidden" name="Sort" value="@Model.Sort" />
            <input type="hidden" name="Desc" value="@Model.Desc" />
            <button type="submit">@Localizer["OrgGrid.Apply"]</button>
        </form>

        @* §769.11 — export EVERY participant (operator: "i need ability to export all participants
           and sessions to excel file … i need id,name,email,role").
           🔒 These download ALL participants, deliberately ignoring the filters above — a button
           that says "all" and quietly honours a filter hands you a short file you have no reason
           to distrust. Inactive people are included for the same reason. *@
        @* §1131 (operator 2026-08-25: *"i also need this as a button"*) — the export was a text
           link in 13px grey prose, so the page's most useful ACTION looked like a footnote about
           the page. It is a thing you DO, and it now reads like one.

           🔒 The caveat stays as prose beside the buttons, not inside them: "every participant, not
           the current filter" is the surprising part (§ above), and a button label cannot carry it.
           Moving it into a tooltip would hide exactly the sentence that prevents a wrong export. *@
        <p class="ceh-actionrow" style="margin:-6px 0 16px;">
            <a asp-page-handler="ExportXlsx" class="ceh-btn">⬇ Export all participants (Excel)</a>
            <a asp-page-handler="Export" class="ceh-btn ceh-btn--secondary">⬇ CSV</a>
            <span style="color:#6b7280;font-size:13px;">ID, name, email, role, active — every participant, <strong>not</strong> the current filter.</span>
        </p>

        @if (Model.Participants.Count == 0)
        {
            <p>@Localizer["OrgGrid.NoMatch"]</p>
        }
        else
        {
            <p role="status">@Localizer["OrgGrid.ShowingRange", Model.Paging.FirstRowNumber, Model.Paging.LastRowNumber, Model.Paging.TotalItems]</p>

            <!-- One form wraps the whole grid so ticked rows post together for a
                 bulk action; per-row buttons target their own handler via
                 asp-page-handler, so there are no (invalid) nested forms. -->
            <form method="post" id="bulkForm">
                @Html.AntiForgeryToken()
                <input type="hidden" name="ActiveFilter" value="@Model.ActiveFilter" />
                <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
                <input type="hidden" name="SponsorCompanyFilter" value="@Model.SponsorCompanyFilter" />
                <input type="hidden" name="Search" value="@Model.Search" />
                <input type="hidden" name="Sort" value="@Model.Sort" />
                <input type="hidden" name="Desc" value="@Model.Desc" />
                <input type="hidden" name="PageNo" value="@Model.Paging.Page" />

                <!-- Bulk action bar: stacks on a phone, goes inline on wider screens.
                     The buttons are type=button: they open the shared confirm modal
                     (which shows the live selected-row COUNT) and only then submit the
                     form to the named handler. No destructive bulk op on a single click. -->
                <div class="bulk-bar"
                     style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;
                            padding:10px;margin-bottom:12px;border:1px solid #ddd;border-radius:8px;">
                    <button type="button" class="secondary js-bulk" data-handler="BulkDeactivate">Deactivate selected</button>
                    <button type="button" class="secondary js-bulk" data-handler="BulkReactivate">Activate selected</button>
                    <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                        <label for="BulkRole" style="margin:0;">Change persona to</label>
                        <select id="BulkRole" name="BulkRole">
                            @foreach (var role in Enum.GetValues<ParticipantRole>())
                            {
                                <option value="@role">@role</option>
                            }
                        </select>
                        <button type="button" class="secondary js-bulk" data-handler="BulkChangeRole">Apply persona</button>
                    </span>
                    <span style="display:flex;gap:6px;align-items:center;flex-wrap:wrap;">
                        <label for="BulkRing" style="margin:0;">Change ring to</label>
                        <select id="BulkRing" name="BulkRing">
                            @foreach (var r in CommunityHub.Core.Settings.Rings.All)
                            {
                                <option value="@r">@CommunityHub.Core.Settings.Rings.Label(r)</option>
                            }
                        </select>
                        <button type="button" class="secondary js-bulk" data-handler="BulkSetRing">Apply ring</button>
                    </span>
                </div>

                <div style="overflow-x:auto;">
                <table style="width:100%;border-collapse:collapse;min-width:600px;">
                    <caption class="sr-only">Participants with per-row organizer actions</caption>
                    <tr style="text-align:left;border-bottom:2px solid #ddd;">
                        <th scope="col" style="width:32px;">
                            <input type="checkbox" id="selectAll" aria-label="@Localizer["OrgGrid.SelectAll"]"
                                   onclick="for(const c of document.querySelectorAll('.rowChk'))c.checked=this.checked;" />
                        </th>
                        @* §769.10 — the CEH participant id. It is the key that names this person's
                           photo in the document library (speaker-photo-{id}, volunteer-photo-{id}),
                           so it is how you get from a file back to a person. Searchable. *@
                        <th scope="col" style="width:56px;" title="CEH participant id — the key in photo file names. Type it in the search box to find this person.">ID</th>
                        <th scope="col" aria-sort="@Model.AriaSort("name")">
                            <a asp-page="/Organizer/Participants"
                               asp-route-ActiveFilter="@Model.ActiveFilter" asp-route-RoleFilter="@Model.RoleFilter"
                               asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter" asp-route-Search="@Model.Search"
                               asp-route-Sort="name" asp-route-Desc="@Model.NextDescFor("name")" asp-route-PageNo="1">@Localizer["OrgGrid.Col.Name"]@Model.SortIndicator("name")</a>
                        </th>
                        @* §830 (operator 2026-08-05: "in participants view, i need the email to be
                           listen as a column before company") — the Email column is BACK, and it sits
                           immediately before Company, where he asked for it.

                           ⚠️ §186 removed this column for a REAL defect, not a preference: long
                           addresses widened the row until the Actions dropdown was pushed out of
                           reach. Re-adding it plainly would reproduce that. So the column is width-
                           capped and ellipsised (see the cell below) — the full address stays
                           readable via the title tooltip, and it is still searchable and still in
                           the Excel/CSV export. *@
                        <th scope="col" aria-sort="@Model.AriaSort("persona")">
                            <a asp-page="/Organizer/Participants"
                               asp-route-ActiveFilter="@Model.ActiveFilter" asp-route-RoleFilter="@Model.RoleFilter"
                               asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter" asp-route-Search="@Model.Search"
                               asp-route-Sort="persona" asp-route-Desc="@Model.NextDescFor("persona")" asp-route-PageNo="1">@Localizer["OrgGrid.Col.Persona"]@Model.SortIndicator("persona")</a>
                        </th>
                        <th scope="col" style="width:200px;">@Localizer["OrgGrid.Col.Email"]</th>
                        <th scope="col">Company</th>
                        <th scope="col" aria-sort="@Model.AriaSort("status")">
                            <a asp-page="/Organizer/Participants"
                               asp-route-ActiveFilter="@Model.ActiveFilter" asp-route-RoleFilter="@Model.RoleFilter"
                               asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter" asp-route-Search="@Model.Search"
                               asp-route-Sort="status" asp-route-Desc="@Model.NextDescFor("status")" asp-route-PageNo="1">@Localizer["OrgGrid.Col.Status"]@Model.SortIndicator("status")</a>
                        </th>
                        <th scope="col">Ring</th>
                        <th scope="col">Flags</th>
                        <th scope="col">Actions</th>
                    </tr>
                    @foreach (var p in Model.Participants)
                    {
                        <tr style="border-bottom:1px solid #eee;">
                            <td>
                                <input class="rowChk" type="checkbox" name="SelectedIds" value="@p.Id"
                                       aria-label="Select @p.FullName" />
                            </td>
                            @* §769.10 — monospace so ids line up and read easily against a file
                               name in the document library. *@
                            <td style="font-family:ui-monospace,Consolas,monospace;font-size:13px;color:#374151;">@p.Id</td>
                            <td>@p.FullName</td>
                            @* §186: Email cell removed — email stays searchable + in the export. *@
                            <td>
                                @p.Role
                                @* §707.50 (operator 2026-07-30: "it would be nice to have flag like
                                   (2-day or 1-day here)") — the ticket kind beside the persona, so
                                   "Attendee" stops meaning two materially different things: a 2-day
                                   holder has a Master Class and a hub login, a 1-day holder has
                                   neither (§707.38). Decided by the ticket CLASS ID, not its
                                   editable display name (§707.35b). *@
                                @{ var ticketKind = Model.AttendeeTicketKindFor(p.Email); }
                                @if (ticketKind.Length > 0)
                                {
                                    <span class="set-tag @(ticketKind == "2-day" ? "on" : "opt")"
                                          title="@(ticketKind == "2-day"
                                              ? "2-day ticket — includes the pre-day Master Class, and a hub login."
                                              : "1-day ticket — main event only. No Master Class and no hub login, by design.")">@ticketKind</span>
                                }
                            </td>
                            @* §830 — the address itself. Capped + ellipsised rather than free-flowing:
                               that is the §186 defect (a long address widened the row and pushed the
                               Actions dropdown out of reach) and the cap is what keeps it fixed. The
                               full value is in the tooltip, and selectable by widening nothing. *@
                            <td style="max-width:200px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;"
                                title="@p.Email">@p.Email</td>
                            <td>
                                @* §591 (operator 2026-07-28, flagged low prio): "if a speaker fills
                                   out the company field, it could be nice to show it here under
                                   partcipants". The column resolved only the SPONSOR company, so a
                                   speaker's row was blank even when CEH held their employer — e.g.
                                   Per Larsen is "Microsoft" on SpeakerProfile.CompanyName (§578).
                                   The sponsor chain is UNCHANGED (a locked rule — always the Company
                                   Manager public name); the speaker value is only a FALLBACK for
                                   rows the sponsor chain does not cover. *@
                                @if (p.Role == ParticipantRole.Sponsor && !string.IsNullOrWhiteSpace(p.SponsorCompanyId))
                                {
                                    @Model.CompanyDisplayName(p.SponsorCompanyId)
                                }
                                else if (Model.SpeakerCompanyFor(p.Id) is { Length: > 0 } speakerCompany)
                                {
                                    @speakerCompany
                                }
                                @* §707.27 D (operator 2026-07-30) — an ATTENDEE's company comes from
                                   their WINNING active mirror row (§707.22a: newest LastSyncedAt,
                                   then Id). Zoho keeps that value current, so it is read, never
                                   copied onto the Participant. LAST in the chain: the sponsor rule is
                                   locked (always the Company Manager public name) and a speaker's own
                                   profile beats a ticket's billing company. *@
                                else if (Model.AttendeeCompanyFor(p.Email) is { Length: > 0 } attendeeCompany)
                                {
                                    @attendeeCompany
                                }
                            </td>
                            <td>
                                @if (CommunityHub.Pages.Organizer.ParticipantsModel.IsActive(p))
                                {
                                    <span class="info">Active</span>
                                }
                                else
                                {
                                    <span class="error">Inactive</span>
                                }
                            </td>
                            @* §185: show ONLY the ring number ("0".."3"), not the parenthetical label. *@
                            <td>@CommunityHub.Core.Settings.Rings.Number(p.Ring)</td>
                            <td>
                                @* §185: ring-derived flags — Ring 1 → amber "Test", Ring 2 → green
                                   "Design". The explicit IsTestUser flag already renders an amber
                                   "Test" chip, so suppress the ring-derived one for those rows to
                                   avoid a duplicate; every other Ring 1 row still gets it. *@
                                @{ var ringFlag = CommunityHub.Core.Settings.Rings.RingFlagLabel(p.Ring); }
                                @if (p.IsTestUser) { <span class="pflag pflag-test">Test</span> }
                                else if (ringFlag == "Test") { <span class="pflag pflag-test">Test</span> }
                                @if (ringFlag == "Design") { <span class="pflag pflag-design">Design</span> }
                                @if (p.IsBoothMember) { <span class="pflag">Booth member</span> }
                                @if (p.IsSigner) { <span class="pflag">Signer</span> }
                                @if (p.IsEventCoordinator) { <span class="pflag">Coordinator</span> }
                            </td>
                            <td>
                                <details class="row-actions">
                                    <summary>Actions ▾</summary>
                                <div style="display:flex;flex-wrap:wrap;gap:6px;">
                                    <!-- REAL edit: open the full participant editor (name, email,
                                         persona, active state, sponsor company). -->
                                    <a class="secondary" style="text-decoration:none;padding:6px 10px;border:1px solid #c4c8d4;border-radius:6px;"
                                       asp-page="/Organizer/EditParticipant" asp-route-id="@p.Id"
                                       title="Edit this person's name, email, persona and status">
                                        Edit / Modify
                                    </a>
                                    <button type="submit" class="secondary"
                                            asp-page-handler="ToggleActive"
                                            asp-route-participantId="@p.Id"
                                            asp-route-ActiveFilter="@Model.ActiveFilter"
                                            asp-route-RoleFilter="@Model.RoleFilter"
                                            asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter">
                                        @(CommunityHub.Pages.Organizer.ParticipantsModel.IsActive(p) ? "Deactivate" : "Activate")
                                    </button>
                                    <!-- PRIMARY action: full impersonation. Re-issues the
                                         session AS this person and lands on their own hub, so
                                         the organizer sees the WHOLE app from their seat.
                                         §303b (operator 2026-07-24): this is THE one act-as
                                         feature — "Modify on behalf" was DELETED ("modify on
                                         behalf is equal to switch user - it is just bad
                                         wording. i prefer to have switch user only"). -->
                                    <button type="submit"
                                            asp-page-handler="SwitchToUser"
                                            asp-route-participantId="@p.Id"
                                            title="Switch into this person — see and do everything as them, then Return to organizer">
                                        Switch to user
                                    </button>
                                    <a class="secondary" style="text-decoration:none;padding:6px 10px;border:1px solid #c4c8d4;border-radius:6px;"
                                       asp-page="/Organizer/SecureLink" asp-route-participantId="@p.Id">
                                        Secure link
                                    </a>
                                    <!-- See this person's email history (operator 2026-06-24). -->
                                    <a class="secondary" style="text-decoration:none;padding:6px 10px;border:1px solid #c4c8d4;border-radius:6px;"
                                       asp-page="/Organizer/EmailLog" asp-route-Filter="@p.Email"
                                       title="See this person's email history">
                                        Email log
                                    </a>
                                    <!-- Resend the welcome email to THIS participant (per-row, production-safe).
                                         Forces past the once-ever ledger; ring gate + allowlist still apply.
                                         §304b BUGFIX (operator 2026-07-24, the bulk-ring HTTP 400): this was a
                                         NESTED <form> inside #bulkForm — the HTML parser closed the outer form
                                         at the FIRST row's </form>, detaching every later row's checkbox and
                                         breaking the bulk POST (missing fields/token ⇒ 400). Now a formaction
                                         submit button like its ToggleActive/SwitchToUser siblings. -->
                                    <button type="submit" class="secondary"
                                            asp-page-handler="ResendWelcome"
                                            asp-route-participantId="@p.Id"
                                            asp-route-ActiveFilter="@Model.ActiveFilter" asp-route-RoleFilter="@Model.RoleFilter"
                                            asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter" asp-route-Search="@Model.Search"
                                            asp-route-Sort="@Model.Sort" asp-route-Desc="@Model.Desc" asp-route-PageNo="@Model.PageNo"
                                            style="text-decoration:none;padding:6px 10px;border:1px solid #c4c8d4;border-radius:6px;background:#fff;cursor:pointer;"
                                            title="Resend the welcome email to @p.FullName">
                                        Resend welcome
                                    </button>
                                    @* §355/§379 (operator 2026-07-26: "where is the reset feature as
                                       organizer … i dont see ability to reset all steps/tasks also").
                                       The reset itself lives on Edit / Modify — but this grid is where
                                       he went looking for it, and a feature nobody can find is a
                                       feature that is not there. A LINK (not a second copy of the
                                       control): one implementation, discoverable from both places. *@
                                    <a class="secondary" style="text-decoration:none;padding:6px 10px;border:1px solid #c4c8d4;border-radius:6px;"
                                       asp-page="/Organizer/EditParticipant" asp-route-Id="@p.Id"
                                       title="Reset @p.FullName's Get Started — per step, or all of them">
                                        Reset Get Started
                                    </a>
                                    <!-- Per-row Delete. Opens an accessible confirmation modal
                                         first (no destructive action on a single click). The modal
                                         hosts the real submit button, which posts the Delete handler:
                                         safe semantics (hard-delete only when un-engaged, else a
                                         soft-delete fallback) live server-side. -->
                                    <button type="button" class="js-delete-participant"
                                            data-pid="@p.Id" data-pname="@p.FullName"
                                            style="background:none;border:1px solid #e0b4b4;color:#b91c1c;cursor:pointer;padding:6px 10px;border-radius:6px;"
                                            aria-haspopup="dialog">
                                        Deactivate
                                    </button>
                                </div>
                                </details>
                            </td>
                        </tr>
                    }
                </table>
                </div>
            </form>

            @if (Model.Paging.TotalPages > 1)
            {
                <nav aria-label="Pagination" style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px;">
                    @if (Model.Paging.HasPrevious)
                    {
                        <a asp-page="/Organizer/Participants"
                           asp-route-ActiveFilter="@Model.ActiveFilter" asp-route-RoleFilter="@Model.RoleFilter"
                           asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter" asp-route-Search="@Model.Search"
                           asp-route-Sort="@Model.Sort" asp-route-Desc="@Model.Desc" asp-route-PageNo="@(Model.Paging.Page - 1)" rel="prev"
                           style="padding:6px 12px;border:1px solid #c4c8d4;border-radius:6px;text-decoration:none;">@Localizer["OrgGrid.Prev"]</a>
                    }
                    <span>@Localizer["OrgGrid.PageOf", Model.Paging.Page, Model.Paging.TotalPages]</span>
                    @if (Model.Paging.HasNext)
                    {
                        <a asp-page="/Organizer/Participants"
                           asp-route-ActiveFilter="@Model.ActiveFilter" asp-route-RoleFilter="@Model.RoleFilter"
                           asp-route-SponsorCompanyFilter="@Model.SponsorCompanyFilter" asp-route-Search="@Model.Search"
                           asp-route-Sort="@Model.Sort" asp-route-Desc="@Model.Desc" asp-route-PageNo="@(Model.Paging.Page + 1)" rel="next"
                           style="padding:6px 12px;border:1px solid #c4c8d4;border-radius:6px;text-decoration:none;">@Localizer["OrgGrid.Next"]</a>
                    }
                </nav>
            }
        }
    }
    <p>
        <a asp-page="/Organizer/Index">Back to organizer area</a>
        &nbsp;·&nbsp;
        <a asp-page="/Organizer/ImpersonationLog">Acting-as audit log</a>
    </p>
</div>

@if (!Model.AccessDenied)
{
    <!-- Delete confirmation modal (one shared dialog, reused for every row).
         Its own form (outside the grid form) posts the Delete handler with the
         chosen participant id. Soft vs hard delete is decided server-side. -->
    @* hidden + display:none keep the fixed-position backdrop from covering the
       page (and swallowing every grid click) while closed; openModal() switches
       it to display:flex. A bare display:flex here would override [hidden] and
       overlay the whole viewport at all times. *@
    <div id="deleteModal" class="modal-backdrop" role="dialog" aria-modal="true"
         aria-labelledby="deleteModalTitle" aria-describedby="deleteModalBody"
         hidden
         style="position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;
                align-items:center;justify-content:center;padding:16px;z-index:1000;">
        <div class="modal-card"
             style="background:#fff;border-radius:10px;max-width:440px;width:100%;
                    padding:20px;box-shadow:0 10px 30px rgba(0,0,0,.25);">
            <h3 id="deleteModalTitle" style="margin-top:0;">Delete participant?</h3>
            <p id="deleteModalBody">
                You are about to deactivate <strong id="deleteModalName"></strong>.
                They can no longer sign in and they leave every active list, but
                <strong>nothing is deleted</strong> — their answers, tasks and history
                are kept, and they can be reactivated.
            </p>
            <form method="post" asp-page-handler="Delete">
                <input type="hidden" name="ActiveFilter" value="@Model.ActiveFilter" />
                <input type="hidden" name="RoleFilter" value="@Model.RoleFilter" />
                <input type="hidden" name="SponsorCompanyFilter" value="@Model.SponsorCompanyFilter" />
                <input type="hidden" name="participantId" id="deleteModalPid" value="" />
                @* §334: the real guard is the SERVER check in OnPostDeleteAsync — this box is
                   only how a human supplies the phrase. *@
                <partial name="_TypedConfirm" model="@(new CommunityHub.Pages.Shared.TypedConfirmField(
                    CommunityHub.Core.Organizer.TypedConfirmation.DeletePhrase,
                    "Deactivates the person. Nothing is deleted — their rows are kept and they can be reactivated.",
                    InputId: "deleteModalPhrase"))" />
                <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end;margin-top:16px;">
                    <button type="button" id="deleteModalCancel" class="secondary"
                            style="padding:8px 14px;border:1px solid #c4c8d4;border-radius:6px;background:#fff;cursor:pointer;">
                        Cancel
                    </button>
                    <button type="submit"
                            style="padding:8px 14px;border:none;border-radius:6px;background:#b91c1c;color:#fff;cursor:pointer;">
                        Deactivate
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
            (function () {
                var modal = document.getElementById('deleteModal');
                if (!modal) return;
                var nameEl = document.getElementById('deleteModalName');
                var pidEl = document.getElementById('deleteModalPid');
                var cancelBtn = document.getElementById('deleteModalCancel');
                var lastFocused = null;

                function openModal(pid, pname) {
                    pidEl.value = pid;
                    nameEl.textContent = pname || ('participant #' + pid);
                    modal.hidden = false;
                    modal.style.display = 'flex';
                    lastFocused = document.activeElement;
                    cancelBtn.focus();
                }
                function closeModal() {
                    modal.hidden = true;
                    modal.style.display = 'none';
                    if (lastFocused && lastFocused.focus) lastFocused.focus();
                }

                document.querySelectorAll('.js-delete-participant').forEach(function (b) {
                    b.addEventListener('click', function () {
                        openModal(b.getAttribute('data-pid'), b.getAttribute('data-pname'));
                    });
                });
                cancelBtn.addEventListener('click', closeModal);
                modal.addEventListener('click', function (e) {
                    if (e.target === modal) closeModal();
                });
                document.addEventListener('keydown', function (e) {
                    if (e.key === 'Escape' && !modal.hidden) closeModal();
                });
            })();
        </script>

    <!-- Bulk confirmation modal: shared by every bulk action on this grid. Shows
         the COUNT of selected rows before deactivate/reactivate/change-persona runs,
         then submits the grid form to the chosen handler. Accessible (role=dialog,
         focus move, Esc/backdrop close). The server still re-validates the selection. -->
    @* hidden + display:none keep this fixed-position backdrop from covering the
       page (and swallowing every grid click — it intercepted "Switch to user"
       on the ~360px layout) while closed; openModal() switches it to display:flex,
       exactly like deleteModal above. A bare inline display:flex would override
       [hidden] and overlay the whole viewport at all times. The global
       .modal-backdrop[hidden] rule in _Layout.cshtml is the belt-and-braces guard. *@
    <div id="bulkModal" class="modal-backdrop" role="dialog" aria-modal="true"
         aria-labelledby="bulkModalTitle" aria-describedby="bulkModalBody"
         hidden
         style="position:fixed;inset:0;background:rgba(0,0,0,.45);display:none;
                align-items:center;justify-content:center;padding:16px;z-index:1000;">
        <div class="modal-card"
             style="background:#fff;border-radius:10px;max-width:440px;width:100%;
                    padding:20px;box-shadow:0 10px 30px rgba(0,0,0,.25);">
            <h3 id="bulkModalTitle" style="margin-top:0;">@Localizer["OrgGrid.BulkConfirmTitle"]</h3>
            <p id="bulkModalBody"></p>
            <div style="display:flex;flex-wrap:wrap;gap:10px;justify-content:flex-end;margin-top:16px;">
                <button type="button" id="bulkModalCancel" class="secondary"
                        style="padding:8px 14px;border:1px solid #c4c8d4;border-radius:6px;background:#fff;cursor:pointer;">
                    @Localizer["OrgGrid.Cancel"]
                </button>
                <button type="button" id="bulkModalConfirm"
                        style="padding:8px 14px;border:none;border-radius:6px;background:#1f6feb;color:#fff;cursor:pointer;">
                    @Localizer["OrgGrid.Continue"]
                </button>
            </div>
        </div>
    </div>

    <script>
        (function () {
            var modal = document.getElementById('bulkModal');
            var form = document.getElementById('bulkForm');
            if (!modal || !form) return;
            var bodyEl = document.getElementById('bulkModalBody');
            var cancelBtn = document.getElementById('bulkModalCancel');
            var confirmBtn = document.getElementById('bulkModalConfirm');
            // "...{0} selected row(s)..." with a placeholder we substitute the live count into.
            var bodyTemplate = @Html.Raw(Json.Serialize(Localizer["OrgGrid.BulkConfirmBody", "{0}"].Value));
            var pickFirst = @Html.Raw(Json.Serialize(Localizer["OrgGrid.BulkPickFirst"].Value));
            var pendingHandler = null;
            var lastFocused = null;

            function selectedCount() {
                return document.querySelectorAll('.rowChk:checked').length;
            }
            function openModal(count) {
                bodyEl.textContent = bodyTemplate.replace('{0}', count);
                modal.hidden = false;
                modal.style.display = 'flex';
                lastFocused = document.activeElement;
                confirmBtn.focus();
            }
            function closeModal() {
                modal.hidden = true;
                modal.style.display = 'none';
                pendingHandler = null;
                if (lastFocused && lastFocused.focus) lastFocused.focus();
            }

            document.querySelectorAll('.js-bulk').forEach(function (b) {
                b.addEventListener('click', function () {
                    var count = selectedCount();
                    if (count === 0) { alert(pickFirst); return; }
                    pendingHandler = b.getAttribute('data-handler');
                    openModal(count);
                });
            });
            confirmBtn.addEventListener('click', function () {
                if (!pendingHandler) { closeModal(); return; }
                // Razor Pages handler selection: post ?handler=<name>.
                form.setAttribute('action', '?handler=' + encodeURIComponent(pendingHandler));
                form.submit();
            });
            cancelBtn.addEventListener('click', closeModal);
            modal.addEventListener('click', function (e) { if (e.target === modal) closeModal(); });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !modal.hidden) closeModal();
            });
        })();
    </script>
}
