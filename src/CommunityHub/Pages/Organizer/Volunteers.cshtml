@page
@model CommunityHub.Pages.Organizer.VolunteersModel
@{
    ViewData["Title"] = Localizer["OrgVolunteers.Title"].Value;
}

<div class="card">
    <h1>@Localizer["OrgVolunteers.Title"]</h1>
    @if (Model.AccessDenied)
    {
        <p class="error">@Localizer["Common.OrganizersOnly"]</p>
        <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    }
    else
    {
        <p>@Localizer["OrgVolunteers.Intro"]</p>
        <p><a asp-page="/Organizer/Index">&larr; @Localizer["Common.BackToOrganizerArea"]</a></p>
    }
</div>

@if (!Model.AccessDenied)
{
    var tiles = new List<CommunityHub.Pages.Shared.HubTile>
    {
        // §1146b (operator 2026-08-28) — the Pre-Selection Queue, which lived only on the People
        // hub. It is a VOLUNTEER surface (§756 made the queue volunteers-only), so its absence
        // here meant the one page you preselect volunteers from was not reachable from the
        // volunteer hub. Same page, second door — not a copy.
        new("/Organizer/PreselectionQueue", "Pre-Selection Queue",
            "Prospective volunteers waiting for review. Validate the data, then preselect or onboard — with their availability, contact details and public-profile consent on the page.",
            "volunteer-allocation"),
        // §1146e (operator 2026-08-28) — the availability overview is a DESTINATION, not hub
        // furniture. Printed under the tiles it made the page you scan to choose where to go into
        // the longest page in the area; it gets a door like everything else.
        new("/Organizer/VolunteerAvailability", "Volunteer availability",
            "Every volunteer's half-day availability, green/red per morning and afternoon, with a head-count per shift.",
            "volunteer-allocation"),
        // §1297 — the worker roster. It belongs next to the availability overview: that page says
        // what everybody answered, this one says who the planner may act on it for.
        // §1380 — renamed: "worker roster" was not understood (Leth 2026-11-02). Same page, plain words.
        new("/Organizer/VolunteerWorkerRoster", "Full-day workers",
            "Mark the volunteers who work all day and do not attend sessions. Auto-assign plans every volunteer: full-day workers all day, everyone else up to 50% of the hours they said they can work.",
            "volunteer-allocation"),
        // §1380 (Leth 2026-11-01) — the overview of how short we are, and the task calendar.
        new("/Organizer/VolunteerCoverage", "Coverage & shortage",
            "How many places the tasks need, how many are filled, and how many volunteers we are short — per day and per hour. No auto-assign needed.",
            "volunteer-allocation"),
        new("/Organizer/VolunteerCalendar", "Task calendar",
            "Every task on a timeline per day, one column per bucket — like a schedule builder. Click a task for its notes and who is on it.",
            "volunteer-tasks"),
        new("/Organizer/VolunteerStructure", Localizer["Nav.OrgVolunteerStructure"].Value, Localizer["OrgVolunteers.Structure"].Value, "volunteer-tasks"),
        new("/Organizer/BucketAllocation", Localizer["Nav.OrgBucketAllocation"].Value, Localizer["OrgVolunteers.Buckets"].Value, "volunteer-allocation"),
        new("/Organizer/AllocationScenarios", "Allocation scenarios", "Stage a bulk reshuffle, simulate the coverage impact, then commit it — or auto-seed a drop-out backfill.", "volunteer-allocation"),
        // §150 allocation queue — previously unreachable (no nav entry, no hub tile).
        new("/Organizer/OrganizerAllocation", "Allocation queue", "Review the availability-routed queue: silently draft assignments per person, then commit them as one batch.", "organizer-allocation"),
        // §234 (2026-07-07): the §23/§151 Excel round-trip page + the shared task editor
        // were built but unreachable (no nav entry, no hub tile) — surfaced here.
        new("/Organizer/VolunteerTasksExcel", "Tasks — Excel", "Export every volunteer task to .xlsx for bulk editing, then import the edited sheet back (rows upsert by task id).", "volunteer-tasks"),
        new("/Organizer/EditVolunteerTask", "Edit task definitions", "Open any task and edit its shared definition — title, description, criticality, team, resources, instructions, lead, time window, due date.", "volunteer-tasks"),
    };
    <partial name="_HubGrid" model="@tiles" />
}
