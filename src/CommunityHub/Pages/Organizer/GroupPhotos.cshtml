@page
@model CommunityHub.Pages.Organizer.GroupPhotosModel
@{
    ViewData["Title"] = "Group photos";
}

<div class="card">
    <h1>Group photos</h1>

    @if (Model.AccessDenied)
    {
        <p class="error">This area is for organizers only.</p>
    }
    else
    {
        <p>Register each company's group photo session, schedule the slot,
           and send a calendar invite to the <strong>appointed company lead</strong>.
           The group photo is a perk for the volume packages: companies with
           <strong>@CommunityHub.Core.Domain.GroupPhotoRegistration.QualifyingTicketThreshold tickets or more</strong>
           qualify. Companies tracked on the
           <a asp-page="/Organizer/VolumePackage">Volume Package</a> page fill their ticket count in
           automatically. Re-sending after a slot move <strong>updates</strong> the lead's existing
           calendar entry (stable invite id).</p>

        @if (!string.IsNullOrEmpty(Model.Notice))
        {
            <p class="info">@Model.Notice</p>
        }

        @* ================= §1077 stage 5 — slots, plan, publish ================= *@
        <div style="margin:16px 0;padding:12px 14px;border:1px solid #cfe6fb;background:#f4faff;border-radius:8px;">
            <h2 style="margin:0 0 6px;font-size:17px;">Timeslots and planning</h2>
            <p class="muted" style="margin:0 0 10px;font-size:13.5px;">
                Enter the slots you have available; the planner fits companies into them.
                <strong>Companies whose people all hold 1-day tickets can only take a main-day
                slot</strong> — they are not at the venue on the pre-day — so the planner puts the
                flexible companies on the pre-day first and keeps the main day for those who have
                nowhere else to go. <strong>A published time is never moved.</strong>
            </p>

            <p style="margin:0 0 10px;font-size:13.5px;">
                <strong>@Model.Slots.Count</strong> slot(s) defined
                (@Model.Slots.Count(s => s.IsPreDay) pre-day · @Model.Slots.Count(s => !s.IsPreDay) main day).
            </p>

            <form method="post" asp-page-handler="AddSlots" style="margin:0 0 10px;">
                <label style="display:block;font-size:13px;">
                    <strong>Paste your timeslots</strong> — one per line, <code>2027-02-09 11:30</code>
                    <textarea asp-for="SlotText" rows="4" placeholder="2027-02-09 11:30&#10;2027-02-09 11:45&#10;2027-02-10 09:45"
                              style="display:block;width:100%;max-width:520px;box-sizing:border-box;padding:8px 10px;border:1px solid #c4c8d4;border-radius:6px;margin-top:4px;font-family:inherit;"></textarea>
                </label>
                <button type="submit" style="margin-top:8px;padding:7px 14px;border:0;border-radius:6px;background:#008BD2;color:#fff;font-weight:600;cursor:pointer;">Add slots</button>
            </form>

            <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px;">
                @* A starter set for testing — it refuses to run once real slots exist, so it can
                   never double a live schedule. *@
                <form method="post" asp-page-handler="StarterSlots">
                    <button type="submit" style="border:1px solid #c4c8d4;background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12.5px;">Add a starter set (25, for testing)</button>
                </form>
                <form method="post" asp-page-handler="Propose">
                    <button type="submit" style="border:1px solid #c4c8d4;background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12.5px;">Propose a plan</button>
                </form>
                <form method="post" asp-page-handler="Publish"
                      onsubmit="return confirm('Publish the planned times? Each company then sees its time on its own page.');">
                    <button type="submit" style="border:1px solid #c4c8d4;background:#fff;border-radius:6px;padding:6px 12px;cursor:pointer;font-size:12.5px;">Publish the plan</button>
                </form>
                @* For the partner who coordinates the photos from our side. *@
                <a asp-page-handler="PartnerExcel" download
                   style="border:1px solid #c4c8d4;background:#fff;border-radius:6px;padding:6px 12px;font-size:12.5px;text-decoration:none;">Excel for the event partner</a>
                <a asp-page-handler="PartnerCalendar" download
                   style="border:1px solid #c4c8d4;background:#fff;border-radius:6px;padding:6px 12px;font-size:12.5px;text-decoration:none;">Calendar (all slots) for the partner</a>
            </div>

            @if (Model.Plan is { } plan)
            {
                <div style="font-size:13px;">
                    <strong>Proposal</strong> — @plan.Assignments.Count placed, @plan.UnusedSlots.Count slot(s) spare.
                    <ul style="margin:6px 0 0;padding-left:20px;">
                        @foreach (var a in plan.Assignments)
                        {
                            <li>
                                @a.StartUtc.UtcDateTime.ToString("ddd d MMM HH:mm") UTC — @a.CompanyName
                                @if (a.WasAlreadyPublished) { <em> (already published — left alone)</em> }
                            </li>
                        }
                    </ul>
                    @if (plan.Unplaced.Count > 0)
                    {
                        <p class="error" style="margin:8px 0 0;">
                            No slot for: @string.Join(" · ", plan.Unplaced.Select(u => $"{u.CompanyName} — {u.Reason}"))
                        </p>
                    }
                </div>
            }

            @if (Model.Slots.Count > 0)
            {
                <details style="margin-top:10px;">
                    <summary style="cursor:pointer;font-size:12.5px;color:#1565c0;">Show the slots</summary>
                    <ul style="margin:8px 0 0;padding-left:20px;font-size:12.5px;">
                        @foreach (var s in Model.Slots)
                        {
                            <li style="margin:2px 0;">
                                @s.StartUtc.UtcDateTime.ToString("ddd d MMM HH:mm") UTC
                                — @(s.IsPreDay ? "pre-day" : "main day"), @s.DurationMinutes min
                                @if (!string.IsNullOrWhiteSpace(s.Label)) { <text> · @s.Label</text> }
                                <form method="post" asp-page-handler="DeleteSlot" asp-route-id="@s.Id" style="display:inline;">
                                    <button type="submit" style="border:0;background:none;color:#b00;cursor:pointer;font-size:12px;">remove</button>
                                </form>
                            </li>
                        }
                    </ul>
                </details>
            }
        </div>

        <details style="margin:10px 0;padding:8px 12px;border:1px solid #d0d7de;border-radius:6px;">
            <summary><strong>+ Register a company</strong></summary>
            <form method="post" asp-page-handler="Create" style="margin-top:10px;max-width:480px;">
                <label>Company name</label>
                <input type="text" name="companyName" required />
                <label>Lead contact name</label>
                <input type="text" name="contactName" />
                <label>Lead contact email</label>
                <input type="email" name="contactEmail" required />
                <label>Tickets (volume package) &mdash; more than @CommunityHub.Core.Domain.GroupPhotoRegistration.QualifyingTicketThreshold qualifies</label>
                <input type="number" name="ticketCount" min="0" value="0" />
                <label>Internal participants (comma-separated emails &mdash; reference only, NOT invited)</label>
                <input type="text" name="internalParticipants" />
                <label>Slot (Danish local time)</label>
                <input type="datetime-local" name="scheduledLocal" />
                <label>Location</label>
                <input type="text" name="location" placeholder="e.g. main stage backdrop" />
                <label>Notes</label>
                <input type="text" name="notes" />
                <button type="submit">Register</button>
            </form>
        </details>

        @if (Model.Registrations.Count == 0)
        {
            <p class="info">No registrations yet.</p>
        }
        else
        {
            @foreach (var r in Model.Registrations)
            {
                <details style="margin:10px 0;padding:8px 12px;border:1px solid #d0d7de;border-radius:6px;@(r.ScheduledAtUtc is null ? "border-left:3px solid #f4b400;" : "")">
                    <summary>
                        <strong>@r.CompanyName</strong>
                        @if (r.ScheduledAtUtc is not null)
                        {
                            <span style="color:#6b7280;font-size:13px;">&mdash; @TimeZoneInfo.ConvertTimeFromUtc(r.ScheduledAtUtc.Value.UtcDateTime, TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen")).ToString("ddd d MMM HH:mm") (local)</span>
                        }
                        else
                        {
                            <span style="color:#b45309;font-size:13px;">&mdash; not scheduled</span>
                        }
                        @if (r.Qualifies)
                        {
                            <span class="info" style="font-size:13px;">&middot; @r.TicketCount tickets &#10003; qualifies</span>
                        }
                        else
                        {
                            <span style="color:#b45309;font-size:13px;">&middot; @r.TicketCount tickets &mdash; below volume threshold (not eligible)</span>
                        }
                        @if (r.InviteLastSentAt is not null)
                        {
                            <span class="info" style="font-size:13px;">&middot; invite sent @r.InviteLastSentAt.Value.UtcDateTime.ToString("dd MMM HH:mm") UTC</span>
                        }
                    </summary>
                    <form method="post" asp-page-handler="Update" style="margin-top:10px;max-width:480px;">
                        <input type="hidden" name="id" value="@r.Id" />
                        <label>Lead contact name</label>
                        <input type="text" name="contactName" value="@r.ContactName" />
                        <label>Lead contact email</label>
                        <input type="email" name="contactEmail" value="@r.ContactEmail" required />
                        <label>Tickets (volume package) &mdash; more than @CommunityHub.Core.Domain.GroupPhotoRegistration.QualifyingTicketThreshold qualifies</label>
                        <input type="number" name="ticketCount" min="0" value="@r.TicketCount" />
                        <label>Internal participants (reference only, NOT invited)</label>
                        <input type="text" name="internalParticipants" value="@r.InternalParticipants" />
                        <label>Slot (Danish local time)</label>
                        <input type="datetime-local" name="scheduledLocal"
                               value="@(r.ScheduledAtUtc is null ? "" : TimeZoneInfo.ConvertTimeFromUtc(r.ScheduledAtUtc.Value.UtcDateTime, TimeZoneInfo.FindSystemTimeZoneById("Europe/Copenhagen")).ToString("yyyy-MM-ddTHH:mm"))" />
                        <label>Location</label>
                        <input type="text" name="location" value="@r.Location" />
                        <label>Notes</label>
                        <input type="text" name="notes" value="@r.Notes" />
                        <div style="display:flex;flex-wrap:wrap;gap:8px;">
                            <button type="submit">Save</button>
                            <button type="submit" asp-page-handler="SendInvite" formnovalidate>Send / update calendar invite</button>
                            <button type="submit" asp-page-handler="Delete" class="secondary" formnovalidate
                                    onclick="return confirm('Remove the @r.CompanyName registration?');">Remove</button>
                        </div>
                    </form>
                </details>
            }
        }
    }
    <p><a asp-page="/Organizer/Index">Back to organizer area</a></p>
</div>
