@page
@model CommunityHub.Pages.Organizer.HotelAllotmentsModel
@{
    ViewData["Title"] = "Hotel allotments";
}
@* §1386 — the board moved to /Organizer/HotelOverview (_HotelNightsEditor). A GET redirects there; this view
   only renders the refusal for a non-organizer. *@
<div class="card">
    <h1>Hotel allotments</h1>
    @if (Model.AccessDenied)
    {
        <p class="error" role="alert">This area is for organizers only.</p>
    }
    else
    {
        <p><a asp-page="/Organizer/HotelOverview">Open the hotel overview</a></p>
    }
</div>
