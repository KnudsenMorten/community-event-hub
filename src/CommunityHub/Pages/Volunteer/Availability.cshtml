@page "/volunteer/availability"
@model CommunityHub.Pages.Volunteer.AvailabilityModel
@{
    ViewData["Title"] = "My Availability";
}

<div class="card">
    <h1 style="margin-top:0;">My Availability</h1>

    @if (!string.IsNullOrEmpty(Model.Notice))
    {
        @* §234 UX: a rejected save (NoticeKind == "error") renders red with role=alert —
           never as the green saved-note. *@
        @if (string.Equals(Model.NoticeKind, "error", StringComparison.OrdinalIgnoreCase))
        {
            <div class="av-note-saved" role="alert"
                 style="background:#fdecec;border-left-color:#b3261e;color:#b3261e;">@Model.Notice</div>
        }
        else
        {
            <div class="av-note-saved" role="status">@Model.Notice</div>
        }
    }

    @if (Model.Form.Days.Count == 0)
    {
        @* No event days yet → the shared partial renders the intro + "check back later". *@
        <partial name="_AvailabilityFields" model="Model.Form" />
    }
    else
    {
        <form method="post">
            @* The per-day availability fields are the SAME partial the inline wizard step renders. *@
            <partial name="_AvailabilityFields" model="Model.Form" />
            <div class="av-actions">
                <button type="submit">Save my availability</button>
                <partial name="_LastSaved" model="Model.Form.LastSavedAt" />
            </div>
        </form>
    }

    <p style="margin-top:18px;">
        <a asp-page="/Volunteer/MySchedule">&larr; Back to My schedule</a>
    </p>
</div>
