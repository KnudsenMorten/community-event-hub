@page
@model CommunityHub.Pages.Sponsor.AnnouncementsModel
@{
    ViewData["Title"] = "Social Media Announcements (managed by ELDK)";
    // 🔴 §1032 — drop the "Mentions the organizers by name…" line here. Operator 2026-08-10:
    // *"not relevant"*. It is internal LinkedIn mechanics about the ORGANIZERS, printed on every
    // row of a page a SPONSOR reads about themselves. The speaker page keeps it (§824.14c), where
    // the sentence is about the people the post names.
    // 🔑 Set on ViewData rather than forked into a second partial: two renderers for "how a post is
    // previewed" is the drift _AnnouncementList exists to prevent, and the copy that drifted would
    // be the one an external audience reads.
    ViewData["HideMentionLine"] = true;
}

<div class="card">
    <h1>Social Media Announcements (managed by ELDK)</h1>
    @* §916 — the medium and the ownership, both said plainly. See the speaker page for why
       "(managed by ELDK)" is in the title: a sponsor also has their own social material here, and
       two menu entries called "social media" is how the two get confused. *@
    <p class="muted">
        Posts <strong>we</strong> publish about you on the event's <strong>LinkedIn</strong> company
        page — what they say and when they run. These are written and scheduled by the organizers.
    </p>

    @if (Model.AccessDenied)
    {
        <p class="error">This page is for sponsors.</p>
    }
    else if (Model.NoCompanyLink)
    {
        <p class="error">Your account is not linked to a sponsor company yet, so we cannot show your posts.</p>
    }
    else if (Model.Announcements is { } a)
    {
        @if (a.Total == 0)
        {
            @* 🔒 §834.1 — approved-only. "Nothing approved YET" is the honest phrasing: posts may
               well be planned already, and telling a sponsor "there are none" would be wrong. *@
            <p class="muted">
                Nothing is scheduled for you yet. Posts appear here once the organizers have approved
                them — check back closer to the event.
            </p>
        }
        else
        {
            <p><strong>@a.Total post(s)</strong> scheduled about you.</p>
        }
    }
</div>

@if (Model.Announcements is { } ann && ann.Total > 0)
{
    <div class="card">
        <h2>Your company</h2>
        <p class="muted">Posts about your company on its own.</p>
        <partial name="_AnnouncementList" model="ann.Company" />
    </div>

    <div class="card">
        <h2>Your sponsor category</h2>
        <p class="muted">Posts about your tier, naming every sponsor in it.</p>
        <partial name="_AnnouncementList" model="ann.Category" />
    </div>

    <div class="card">
        <h2>Your sessions</h2>
        <p class="muted">Posts about sessions your people are speaking at.</p>
        <partial name="_AnnouncementList" model="ann.Sessions" />

        @if (ann.HasPurchasedSessions && ann.Sessions.Count == 0)
        {
            @* ⚠️ §837 — a §292 purchased session has NO foreign key to the agenda's Sessions table,
               and matching them by title would be the §767 guess. So when a sponsor has bought a
               session but no announcement is linked, say so plainly rather than showing an empty
               box that reads as "you get nothing". *@
            <p class="muted">
                You have booked a sponsor session. Its announcement is scheduled once the session is
                published in the agenda — talk to the organizers if you expected it by now.
            </p>
        }
    </div>
}
