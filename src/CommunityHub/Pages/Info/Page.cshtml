@* Absolute route so the URL is /Info/{slug} (not /Info/Page/{slug}, the
   default for a file named Page.cshtml). Nav links: asp-page="/Info/Page"
   asp-route-slug="wayfinding". *@
@page "/Info/{slug}"
@model CommunityHub.Pages.Info.InfoPageModel
@{
    ViewData["Title"] = Model.PageTitle;
}

@* §348 — the markdown styling lives in ONE shared partial (`_ContentPageStyles`), rendered by this
   page AND the public /About. It used to be duplicated per page and the copies drifted: the §348
   table/heading fixes landed here only, leaving the public copy on the old unruled tables. Only
   PAGE-SPECIFIC CSS belongs below. *@
<partial name="_ContentPageStyles" />
<style>
    /* §351 (operator 2026-07-26): the ELDK26 photo gallery on /Info/last-event-videos —
       a thumbnail grid whose tiles link to the full-size photo. Mobile-first: 2 across on a
       phone, more as the viewport grows. Fixed tile height + object-fit:cover so a mixed set of
       portrait/landscape photos still forms an even grid instead of a ragged one. */
    .photo-gallery {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
        margin: 14px 0 26px;
    }
    .photo-gallery a { display: block; line-height: 0; }
    .photo-gallery img {
        width: 100%;
        height: 130px;
        object-fit: cover;
        border-radius: 8px;
        margin: 0;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .photo-gallery a:hover img { transform: scale(1.03); box-shadow: 0 3px 12px rgba(0,0,0,.22); }
    @@media (min-width: 560px) { .photo-gallery { grid-template-columns: repeat(3, 1fr); } .photo-gallery img { height: 150px; } }
    @@media (min-width: 860px) { .photo-gallery { grid-template-columns: repeat(4, 1fr); } .photo-gallery img { height: 160px; } }

    /* §146 venue gallery: single column on phones, multi-column from ~560px up. */
    .venue-gallery { display: grid; grid-template-columns: 1fr; gap: 12px; margin: 10px 0; }
    .venue-gallery figure { margin: 0; }
    .venue-gallery img { width: 100%; height: auto; border-radius: 8px; display: block; }
    @@media (min-width: 560px) { .venue-gallery { grid-template-columns: repeat(2, 1fr); } }
</style>

<div class="card content-page">
    @if (Model.ContentMissing)
    {
        <h2>@Model.PageTitle</h2>
        <p class="info" style="background:#eef6ff;padding:10px 14px;border-radius:6px;">
            This content is not available yet &mdash; the organizers will add it
            closer to the event. Please check back soon.
        </p>
    }
    else
    {
        @* Trusted, in-repo operator markdown rendered to HTML by ContentMarkdownRenderer.
           The leading H1 in each .md file serves as the page heading. *@
        @Model.BodyHtml
        @* Speaker-only supplement (e.g. the speaker hotel on the all-roles Addresses page):
           rendered only for Speakers/Organizers, hidden from everyone else. *@
        @Model.SpeakerSupplementHtml
    }

    @* §146: LIVE SharePoint venue images (server-proxied via /venue-image/{folder}/{name};
       never a SharePoint link), appended below the markdown for slugs with a mapped folder.
       Falls back to the committed wwwroot images, or renders nothing when there are none. *@
    @if (Model.Gallery.Count > 0)
    {
        <h2>Venue images</h2>
        <div class="venue-gallery">
            @foreach (var img in Model.Gallery)
            {
                <figure><img src="@img.Url" alt="@img.Alt" loading="lazy" /></figure>
            }
        </div>
    }

    <p><a asp-page="/Index">Back to hub</a></p>
</div>

@*
    §974 (operator 2026-08-09): *"when i expand all or expand screenshts for fx speakers, then sub
    items must be expanded, here i have to expand them as well so the expand speaker screenshots
    becomes dead"*.

    🔴 TWO FAULTS, and the first is the embarrassing one: §954 asked for expand-all buttons, the
    markdown got `<button class="ceh-xall">` — and NOTHING EVER IMPLEMENTED THEM. There is no
    handler anywhere in the repo, so every one of those buttons has been inert since the day it
    shipped. A control that does nothing is worse than a missing one: it is tried, and then trusted
    to mean "there is nothing more to see".

    🔴 The second is what he actually describes: opening "Screenshots — Speaker" reveals three MORE
    collapsed <details>, so the parent open is a dead end — you get a list of titles and still have
    to click each one.

    🔑 Kept in the PAGE, not the markdown: the .md is operator content, and behaviour belongs in
    code. Progressive enhancement — with JS off, every <details> still opens by itself.
*@
<script>
    (function () {
        var root = document.querySelector('.content-page');
        if (!root) return;

        // Opening a group opens what is INSIDE it. Only groups that directly contain other
        // <details> qualify — that is exactly the "Screenshots — <role>" wrappers, and it leaves
        // a <details> holding a table (the table of contents) alone.
        root.querySelectorAll('details').forEach(function (d) {
            d.addEventListener('toggle', function () {
                if (!d.open) return;
                d.querySelectorAll('details').forEach(function (kid) { kid.open = true; });
            });
        });

        // The scope a button acts on: "page" = everything; "role" = this section only, i.e. the
        // siblings after the button up to the next heading or the next expand-all button.
        function scopeOf(btn) {
            if (btn.getAttribute('data-ceh-scope') === 'page') {
                return Array.prototype.slice.call(root.querySelectorAll('details'));
            }
            var found = [], node = (btn.closest('p') || btn).nextElementSibling;
            while (node) {
                if (/^H[1-3]$/.test(node.tagName) || node.querySelector('.ceh-xall')) break;
                if (node.tagName === 'DETAILS') found.push(node);
                Array.prototype.push.apply(found, node.querySelectorAll('details'));
                node = node.nextElementSibling;
            }
            return found;
        }

        root.querySelectorAll('.ceh-xall').forEach(function (btn) {
            var label = btn.textContent;
            btn.addEventListener('click', function () {
                var targets = scopeOf(btn);
                // Toggle on the button's own state, so a second click collapses again — the label
                // and aria-expanded then describe what the NEXT click will do.
                var expand = btn.getAttribute('aria-expanded') !== 'true';
                targets.forEach(function (d) { d.open = expand; });
                btn.setAttribute('aria-expanded', expand ? 'true' : 'false');
                btn.textContent = expand ? label.replace(/^Expand/, 'Collapse') : label;
            });
        });
    })();
</script>
