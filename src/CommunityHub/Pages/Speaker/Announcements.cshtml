@page
@model CommunityHub.Pages.Speaker.AnnouncementsModel
@{
    ViewData["Title"] = "Social Media Announcements (managed by ELDK)";
}

<div class="card">
    <h1>Social Media Announcements (managed by ELDK)</h1>
    @* §916 — "(managed by ELDK)" in the title, and said again here in plain words. Operator
       2026-08-06: the menu item had to be renamed *"to not confuse with fx speaker some"* — a
       speaker also has their OWN social-media material in CEH (their graphics and share drafts),
       and two menu entries both called "social media" is how someone comes here expecting the
       posts they publish themselves. *@
    <p class="muted">
        Posts <strong>we</strong> publish about your sessions on the event's
        <strong>LinkedIn</strong> company page — what they say and when they run. Handy if you want
        to share or comment on them on the day.
    </p>
    <p class="muted">
        These are written and scheduled by the organizers. For material <em>you</em> post yourself,
        see <a asp-page="/Speaker/Graphics">your speaker graphics</a>.
    </p>

    @* §1060(e)/(f) — shown ABOVE the list, and to everyone including a speaker with no posts yet:
       following is what makes tagging possible LATER, so the invitation is most useful before there
       is anything to tag. *@
    <partial name="_LinkedInFollowCard" model="Model.LinkedInStatus" />

    @if (Model.AccessDenied)
    {
        <p class="error">This page is for speakers.</p>
    }
    else if (Model.Announcements is { } a)
    {
        @if (a.Total == 0)
        {
            @* 🔒 §834.1 — approved-only, so "yet" is the honest word: posts may already be planned. *@
            <p class="muted">
                Nothing is scheduled for you yet. Posts appear here once the organizers have approved
                them.
            </p>
        }
        else
        {
            <p><strong>@a.Total post(s)</strong> scheduled about your sessions.</p>
        }
    }
</div>

@if (Model.Announcements is { } ann && ann.Total > 0)
{
    <div class="card">
        <h2>Your sessions</h2>
        <p class="muted">One post per session you are speaking at.</p>
        <partial name="_AnnouncementList" model="ann.Sessions" />
    </div>

    <div class="card">
        <h2>Your track</h2>
        <p class="muted">Posts about the track your session sits in, naming its speakers.</p>
        <partial name="_AnnouncementList" model="ann.Tracks" />
    </div>
}
