@page
@model CommunityHub.Pages.Speaker.IndexModel
@{
    ViewData["Title"] = Localizer["Speaker.Title"].Value;

    // Friendly TYPE + LENGTH labels — the SAME labels the public Sessions overview uses, so the
    // speaker sees the kind of EVERY session (not just master classes). MasterClass + Technical
    // keep their localized keys; the remaining standardized types share the back-office display.
    Func<SessionType, string> typeLabel = t => t switch
    {
        SessionType.MasterClass => Localizer["SessOv.TypeMasterClass"].Value,
        SessionType.TechnicalSession => Localizer["SessOv.TypeTechSession"].Value,
        _ => CommunityHub.Pages.Sessions.IndexModel.Display(t),
    };
    Func<SessionLength, string> lengthLabel = l => l switch
    {
        SessionLength.FullDay => Localizer["SessOv.LenFullDay"].Value,
        SessionLength.TwentyMin => Localizer["SessOv.Len20"].Value,
        SessionLength.FiftyMin => Localizer["SessOv.Len50"].Value,
        SessionLength.SixtyMin => Localizer["SessOv.Len60"].Value,
        _ => l.ToString(),
    };
}

@if (Model.AccessDenied)
{
    <div class="card">
        <h1>@Localizer["Speaker.Title"]</h1>
        <p class="error">
            @Localizer["Speaker.AccessDenied"]
            (<strong>@CommunityHub.Branding.RoleDisplay.Name(Model.Role)</strong>)
        </p>
        <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    </div>
    return;
}

<style>
    /* Mobile-first: single-column cards stack and stay readable at ~360px. */
    .sp-progress-wrap { background:#eef0f4; border-radius:999px; height:14px; overflow:hidden; margin:10px 0 6px; }
    .sp-progress-bar  { height:100%; border-radius:999px; transition:width .3s ease; }
    .sp-progress-meta { display:flex; flex-wrap:wrap; gap:8px 16px; font-size:13px; color:#374151; }
    .sp-progress-meta strong { color:var(--el-darkblue); }

    .ms-list { list-style:none; padding:0; margin:0; }
    .ms-item {
        border:1px solid #e5e7eb; border-radius:10px;
        padding:14px; margin:10px 0;
        display:flex; flex-wrap:wrap; gap:10px 14px; align-items:flex-start;
    }
    .ms-item.done    { background:#f3fbf6; border-color:#c7ead7; }
    .ms-item.overdue { background:#fdf3f2; border-color:#f1c4bf; }
    .ms-main { flex:1 1 220px; min-width:0; }
    .ms-title { font-weight:700; color:var(--el-darkblue); font-size:16px; }
    .ms-item.done .ms-title { color:#0a6; }
    .ms-desc { color:#4b5563; font-size:13px; margin-top:4px; white-space:pre-line; overflow-wrap:anywhere; }
    .ms-due  { color:#6b7280; font-size:12px; margin-top:6px; }
    .ms-badge {
        display:inline-block; border-radius:999px; padding:2px 10px;
        font-size:12px; font-weight:700; white-space:nowrap;
        /* nowrap keeps the SHORT tags ("Session", "45 min") from breaking mid-word.
           A badge whose text is a sentence must opt out — see .ms-badge-long. */
        max-width:100%;
    }
    /* 🔒 §466 made the slides badge a full sentence ("...opened N times by attendees")
       because "Slides opened: 0" named neither the deck nor who opened it. That wording
       is an operator decision and is NOT to be shortened to fit a phone — so the badge
       wraps instead. With nowrap it measured 364px and pushed /Speaker to a 415px
       scroll width on a 320px viewport, which the release gate reports as a failure. */
    .ms-badge-long {
        white-space:normal; overflow-wrap:anywhere;
        border-radius:10px; line-height:1.35; text-align:left;
    }
    .ms-badge.due    { background:#fff3cd; color:#856404; border:1px solid #ffe69c; }
    .ms-badge.soon   { background:#e6f3fb; color:#055f86; border:1px solid #bfe2f4; }
    .ms-badge.late   { background:#fdecea; color:#9b261a; border:1px solid #f3b6ae; }
    .ms-badge.ok     { background:#0a6; color:#fff; }
    .ms-action { flex:0 0 auto; }
    /* The action column drops below the text on a narrow phone so the button
       gets a full-width tap target instead of squeezing the title. */
    .ms-action form { margin:0; }
    @@media (max-width: 460px) {
        .ms-action { flex-basis:100%; }
        .ms-action button { width:100%; }
    }
</style>

@* Speaker "journey" + Milestones cards removed (operator 2026-06-24): they duplicated
   the speaker deadline tasks shown on the "My tasks" page. This page is now just the
   speaker's sessions. *@

@if (!string.IsNullOrEmpty(Model.CalendarInviteMessage))
{
    <div class="card" style="border-left:4px solid #0a6;background:#f0fdf4;">
        <p style="margin:0;color:#0a6;font-weight:600;">&#10003; @Model.CalendarInviteMessage</p>
    </div>
}

@* §322i: flash from the on-card slide upload. *@
@if (!string.IsNullOrEmpty(Model.SlideUploadMessage))
{
    <div class="card" style="border-left:4px solid @(Model.SlideUploadIsError ? "#c0392b" : "#0a6");background:@(Model.SlideUploadIsError ? "#fef2f2" : "#f0fdf4");">
        <p style="margin:0;color:@(Model.SlideUploadIsError ? "#991b1b" : "#0a6");font-weight:600;">@Model.SlideUploadMessage</p>
    </div>
}

@if (Model.MySessions.Count == 0 && Model.MasterClasses.Count == 0)
{
    @* §234 UX: with zero linked sessions the hub used to render nearly blank (just the
       back-link card). Friendly empty state: explain why it's empty + the useful next steps. *@
    <div class="card">
        <h1>@Localizer["Speaker.MySessions"]</h1>
        <p style="color:#4b5563;margin:0 0 8px;">
            No sessions are linked to you yet. Your sessions appear here automatically once
            the session catalogue is synced and you're attached as a speaker — no action
            needed from you.
        </p>
        <p style="color:#4b5563;margin:0 0 12px;">
            In the meantime you can complete your speaker details and check your tasks —
            and if you think a session of yours is missing, just contact the organizers.
        </p>
        <p style="display:flex;gap:10px;flex-wrap:wrap;margin:0;">
            <a class="task-link-btn" asp-page="/Speaker/Details">@Localizer["Nav.SpeakerDetails"]</a>
            <a class="task-link-btn" asp-page="/Speaker/Tasks">@Localizer["Speaker.AllMyTasks"]</a>
            <a class="task-link-btn" asp-page="/Contact">@Localizer["Nav.ContactOrganizers"]</a>
        </p>
    </div>
}

@if (Model.MySessions.Count > 0)
{
    <div class="card">
        <h1>@Localizer["Speaker.MySessions"]</h1>
        <p style="font-size:13.5px;color:#555;margin-top:0;">@Localizer["Speaker.MySessionsIntro"]</p>
        @* §322h: the edition-wide "motion number" — attendees opening slides across ALL
           sessions on the public Session slides page. *@
        @if (Model.SlideStatsTotal > 0)
        {
            <p style="background:#eef6ff;border:1px solid #bfdbfe;color:#1e40af;border-radius:8px;padding:8px 12px;font-size:13.5px;">
                📊 Attendees have opened session slides <strong>@Model.SlideStatsTotal</strong> times so far
                across all sessions — your per-session numbers are on the cards below.
            </p>
        }
        @* §461: the ELDK speaker template is part of the speaker programme a SPONSOR-category
           speaker does not run — hidden for them, matching the menu (§457). *@
        @if (!Model.IsSponsorCategorySpeaker)
        {
            <p style="margin:0 0 12px;">
                @* §153: DIRECT download of the .potx (streamed from SharePoint via /speaker-template/download),
                   not a link to the SharePoint site. Includes the load-bearing reminder that sponsor slides
                   are mandatory (a speaker hitting the bare button would otherwise miss it). *@
                <a class="task-link-btn" href="/speaker-template/download">&#128196; @Localizer["Speaker.SessionTemplate"]</a>
                <span style="display:block;font-size:12px;color:#6b7280;margin-top:4px;">The template includes white &amp; dark layouts — and the sponsor slides, which are mandatory in every presentation.</span>
            </p>
        }
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;">
            @foreach (var s in Model.MySessions)
            {
                <li style="border:1px solid #e5e7eb;border-radius:10px;padding:14px;">
                    <div style="font-weight:700;color:var(--el-darkblue);font-size:16px;">
                        @s.Title
                    </div>
                    @* Type + length tags on EVERY session (operator 2026-06-28 §153) — a master class
                       keeps its highlighted badge, every other type now shows its kind too, instead of
                       only master classes being labelled. *@
                    <div style="display:flex;flex-wrap:wrap;gap:6px;margin-top:6px;">
                        <span class="ms-badge @(s.IsMasterClass ? "soon" : "")"
                              style="@(s.IsMasterClass ? "" : "background:#eef2f7;color:#374151;border:1px solid #d8dee9;")">
                            @typeLabel(s.Type)
                        </span>
                        <span class="ms-badge" style="background:#f3f4f6;color:#4b5563;border:1px solid #e5e7eb;">
                            @lengthLabel(s.Length)
                        </span>
                        @* §322h: how often this session's slides were viewed/downloaded on the
                           public /Sessions/Slides page (one combined number). *@
                        @* §466 (operator 2026-07-27): "Slides opened: 0" did not say WHOSE slides,
                           WHICH deck, or who opened them. The badge now names all three. *@
                        <span class="ms-badge ms-badge-long" style="background:#eef6ff;color:#1e40af;border:1px solid #bfdbfe;"
                              title="Views + downloads of your slides on the public Session slides page">
                            📊 Preview/Final presentations opened @(Model.SlideStats.TryGetValue(s.SessionId, out var hits) ? hits : 0) times by attendees
                        </span>
                    </div>

                    <div style="color:#4b5563;font-size:13px;margin-top:6px;display:flex;flex-wrap:wrap;gap:4px 16px;">
                        @* §88: the TIME is always READ from CEH (StartsAt). When it is set, show
                           the full date + time. When it is NOT yet synced, show the KNOWN day
                           (Master Classes on the 9th, sessions on the 10th — FallbackDate) with
                           a "TBD" time, so the speaker still sees WHEN their session is. *@
                        @if (s.StartsAt is { } start)
                        {
                            <span>
                                &#128197;
                                @start.ToString("ddd dd MMM, HH:mm")@(s.EndsAt is { } end ? "–" + end.ToString("HH:mm") : "")
                            </span>
                        }
                        else if (s.FallbackDate is { } day)
                        {
                            <span>
                                &#128197;
                                @day.ToString("ddd dd MMM"), <span style="color:#6b7280;">@Localizer["Speaker.TimeTbd"]</span>
                            </span>
                        }
                        else
                        {
                            <span style="color:#6b7280;">@Localizer["Speaker.TimeTbd"]</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(s.Room))
                        {
                            <span>&#128205; @s.Room</span>
                        }
                        else if (s.IsScheduled)
                        {
                            <span style="color:#6b7280;">@Localizer["Speaker.RoomTbd"]</span>
                        }
                    </div>

                    @if (s.CoSpeakerNames.Count > 0)
                    {
                        <div style="color:#6b7280;font-size:12.5px;margin-top:6px;">
                            @Localizer["Speaker.WithCoSpeakers", string.Join(", ", s.CoSpeakerNames)]
                        </div>
                    }

                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:10px;">
                        @* §52: "View public session page" links to the public ZOHO BACKSTAGE
                           session page when this session carries a Backstage agenda id
                           (Session.BackstageSessionId, captured by the §38e flow); else it
                           keeps the internal /Sessions/{id} page. The Backstage URL is built
                           from per-edition config (ZohoOptions.BackstagePublicBaseUrl) — never
                           fabricated for a session with no Backstage id. *@
                        @{ var backstageUrl = Model.BackstagePublicSessionUrl(s); }
                        @if (!string.IsNullOrEmpty(backstageUrl))
                        {
                            <a class="task-link-btn" href="@backstageUrl" target="_blank" rel="noopener">@Localizer["Speaker.ViewPublicSession"]<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
                        }
                        else if (Model.PubliclyViewableSessionIds.Contains(s.SessionId))
                        {
                            <a class="task-link-btn" href="/Sessions/@s.SessionId">@Localizer["Speaker.ViewPublicSession"]</a>
                        }
                        else
                        {
                            <span style="color:#6b7280;font-size:13px;align-self:center;">@Localizer["Speaker.SessionNotPublicYet"]</span>
                        }
                        @* §138 (operator 2026-06-27): the per-Master-Class Group Q&A button
                           shows ONLY for a session whose Type == MasterClass. A non-master-class
                           session (e.g. a TechnicalSession / Keynote / panel) has no Group Q&A
                           board, so the button would be a dead-end there. (One separate, labelled
                           board per master class — read attendee questions, reply, and edit the
                           attendee landing page. 1:1 questions are disabled.) *@
                        @if (s.IsMasterClass)
                        {
                            <a class="task-link-btn" asp-page="/Speaker/Questions">&#128172; @Localizer["Speaker.AttendeeQuestions"]</a>
                        }
                        @* §461: SoMe promote belongs to the speaker programme — hidden for a
                           SPONSOR-category speaker (their promotion is the sponsor's own). *@
                        @if (!Model.IsSponsorCategorySpeaker)
                        {
                            <a class="task-link-btn" asp-page="/Speaker/Graphics">&#128241; @Localizer["Speaker.SoMePromote"]</a>
                        }
                        <form method="post" asp-page-handler="SendSessionInvite" style="display:inline;margin:0;">
                            <input type="hidden" name="sessionId" value="@s.SessionId" />
                            <button type="submit" class="task-link-btn" style="border:none;cursor:pointer;">&#128197; @Localizer["Speaker.CalendarSync"]</button>
                        </form>
                        @* §192d/§234: TWO per-session evaluation downloads — the Score PDF and
                           the Open-feedback PDF, EACH rendered only when its file actually
                           exists for this session (an always-on Score button 404'd until the
                           post-event PDF was uploaded). Both stream through the hub proxy,
                           never a SharePoint URL. *@
                        @{
                            var kinds = Model.EvalKinds.TryGetValue(s.SessionId, out var k) ? k : null;
                            var hasScore = kinds is not null && kinds.Contains(EvaluationPdfKind.Score);
                            var hasOpenFeedback = kinds is not null && kinds.Contains(EvaluationPdfKind.Open);
                        }
                        @if (hasScore)
                        {
                            <a class="task-link-btn"
                               href="@CommunityHub.Core.Integrations.Graphics.SessionEvalPdfService.ProxyUrlFor(s.SessionId, EvaluationPdfKind.Score)"
                               target="_blank" rel="noopener">&#128202; @Localizer["Speaker.EvaluationsScore"]<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
                        }
                        @if (hasOpenFeedback)
                        {
                            <a class="task-link-btn"
                               href="@CommunityHub.Core.Integrations.Graphics.SessionEvalPdfService.ProxyUrlFor(s.SessionId, EvaluationPdfKind.Open)"
                               target="_blank" rel="noopener">&#128221; @Localizer["Speaker.EvaluationsOpenFeedback"]<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
                        }
                        @* §124: download this session's ROOM session-evaluation QR (served by the Evaluations page handler). *@
                        @if (Model.RoomQr.TryGetValue(s.SessionId, out var roomQr))
                        {
                            <a class="task-link-btn" asp-page="/Speaker/Evaluations" asp-page-handler="Qr"
                               asp-route-sessionId="@s.SessionId" download="@roomQr.FileName">&#128241; Evaluation QR</a>
                        }
                    </div>

                    @* §322i (operator 2026-07-24): the PREVIEW/FINAL slide upload lives ON the
                       session card — per session, with the latest file name/link. Versioned
                       automatically (§68-style); the newest version is what attendees see on
                       the public Session slides page. *@
                    @if (Model.SlideUploadsConfigured)
                    {
                        var slot = Model.SlideFiles.TryGetValue(s.SessionId, out var sf) ? sf : null;
                        @* §322o (operator): the fold-out toggle reads as a BUTTON like the
                           card's other actions — plain text was too easy to miss. *@
                        <details style="margin-top:10px;">
                            <summary style="display:inline-block;background:var(--el-blue);color:#fff;padding:8px 18px;border-radius:6px;font-size:14px;font-weight:600;cursor:pointer;list-style:none;">
                                ⬆️ Upload slides (preview / final)
                                @if (slot?.FinalFileName is not null) { <span style="font-weight:700;"> · final uploaded ✓</span> }
                                else if (slot?.PreviewFileName is not null) { <span style="font-weight:700;"> · preview uploaded ✓</span> }
                            </summary>
                            <div style="margin-top:8px;background:#f8fafc;border:1px solid #e5e7eb;border-radius:8px;padding:8px 12px;">
                            <p style="font-size:12.5px;color:#4b5563;margin:8px 0 4px;">
                                @* §465 (operator 2026-07-27) — his exact wording. *@
                                PDF, PPTX or ZIP (max 1 GB). 💡 Upload a newer version at any time —
                                Versions are assigned automatically; the system always uses the latest one.
                            </p>
                            @* §461/§456: a SPONSOR-category speaker owns the FINAL deck only, so the
                               preview row is dropped for them (the handler refuses it too). *@
                            @{
                                var uploadKinds = Model.IsSponsorCategorySpeaker
                                    ? new[] { ("final", "Final", slot?.FinalFileName) }
                                    : new[]
                                    {
                                        ("preview", "Preview", slot?.PreviewFileName),
                                        ("final", "Final", slot?.FinalFileName),
                                    };
                            }
                            @foreach (var (slug, label, existing) in uploadKinds)
                            {
                                <div style="border-top:1px solid #eef1f5;padding:8px 0 2px;">
                                    <span style="font-weight:600;font-size:13px;">@label:</span>
                                    @if (existing is not null)
                                    {
                                        <a href="/session-slides/@s.SessionId/@slug/download" style="font-size:13px;">📄 @CommunityHub.Core.Integrations.Graphics.SpeakerPresentationService.DisplayName(existing)</a>
                                    }
                                    else
                                    {
                                        <span style="color:#9ca3af;font-size:13px;">not uploaded yet</span>
                                    }
                                    @* §421 (operator 2026-07-27: "as some files are big, is it possible
                                       to show a turning something showing that things are happening
                                       or write upload in progress"). A 1 GB PPTX can take minutes and
                                       the page gave NO feedback at all — the button just sat there,
                                       so the natural reaction is to press it again and start a
                                       second upload of the same file.

                                       PROGRESSIVE ENHANCEMENT (§21): the form posts normally with
                                       JavaScript off; the script only relabels and disables the
                                       button. Deliberately a spinner and not a percentage — a real
                                       progress bar needs an XHR rewrite of a working upload path
                                       for what is a reassurance problem, not a measurement one. *@
                                    <form method="post" asp-page-handler="UploadSlides" enctype="multipart/form-data"
                                          onsubmit="var b=this.querySelector('button[type=submit]');
                                                    if(b){b.disabled=true;b.style.opacity='0.75';
                                                          b.innerHTML='<span class=&quot;ceh-spin&quot;></span> Uploading… please keep this page open';}
                                                    return true;"
                                          style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:4px;">
                                        <input type="hidden" name="kind" value="@slug" />
                                        <input type="hidden" name="sessionId" value="@s.SessionId" />
                                        <input type="file" name="file" accept=".pdf,.pptx,.zip" required style="max-width:340px;font-size:13px;" />
                                        <button type="submit" class="task-link-btn" style="border:none;cursor:pointer;">⬆️ Upload @label.ToLowerInvariant()</button>
                                    </form>
                                </div>
                            }
                            </div>
                        </details>
                    }
                </li>
            }
        </ul>
    </div>
}

@* §192d: the "My session ratings" card was removed — per-session evaluations (the Score +
   Open-feedback PDFs on each session row above) supersede it. *@

@* Removed (operator 2026-06-25, redundant): "Your public profile", "Add my deadlines
   to my calendar", and "Speaker details" cards — Speaker Details is its own page, and
   per-session calendar sync covers the dates. *@

@if (Model.MasterClasses.Count > 0)
{
    <div class="card">
        <h2>My master classes</h2>
        <p style="font-size:13.5px;color:#555;margin-top:0;">
            Each master class has a <strong>public logistics page</strong> where you (or an organizer)
            publish setup instructions for attendees (e.g. "bring your laptop charged"). Share the
            public link or reference it from the Backstage session description.
        </p>
        <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:12px;">
            @foreach (var mc in Model.MasterClasses)
            {
                <li style="border:1px solid #e5e7eb;border-radius:8px;padding:12px;">
                    <strong>@mc.Title</strong>
                    <div style="display:flex;gap:10px;flex-wrap:wrap;margin-top:8px;">
                        <a class="task-link-btn" asp-page="/MasterClass/Index" asp-route-slug="@mc.Slug">Edit / view logistics</a>
                        <a class="task-link-btn" asp-page="/Speaker/MasterClassPrep" asp-route-sessionId="@mc.SessionId">Edit prep notes</a>
                        <a class="task-link-btn" asp-page="/MasterClassPage" asp-route-sessionId="@mc.SessionId">Attendee page &amp; Q&amp;A</a>
                    </div>
                    <label for="mc-link-@mc.SessionId" style="display:block;font-size:12.5px;color:#6b7280;margin-top:10px;">Public link (share with attendees)</label>
                    <input id="mc-link-@mc.SessionId" type="text" readonly value="@mc.PublicLink"
                           onclick="this.select()" style="width:100%;font-size:12.5px;background:#f3f4f6;box-sizing:border-box;" />
                </li>
            }
        </ul>
    </div>
}

<div class="card">
    @* §234 UX: speaker task links point at /Speaker/Tasks everywhere (the nav's "My tasks"
       target) — the generic /Tasks entry point diverged from it. *@
    <p><a asp-page="/Index">&larr; @Localizer["Common.BackToHub"]</a> &middot; <a asp-page="/Speaker/Tasks">@Localizer["Speaker.AllMyTasks"]</a></p>
</div>
