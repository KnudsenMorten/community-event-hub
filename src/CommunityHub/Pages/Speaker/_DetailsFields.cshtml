@model CommunityHub.Forms.Steps.SpeakerDetailsFormModel
@*
    Fields-ONLY partial for the Speaker Details step (REQUIREMENTS §148, §26c). Contains NO
    <form>, no validation summary, no flash, no Save buttons, no last-saved, no Back-to-hub link
    — the HOST (the standalone /Speaker/Details page OR the generic /Forms/Wizard shell) owns
    those and places this partial inside its single <form method="post">. Mobile-first. Bound to
    CommunityHub.Forms.Steps.SpeakerDetailsFormModel; input names stay flat (FirstName /
    Biography / SelectedAccreditations / …) so model binding is identical between the standalone
    page and the inline wizard step. The field markup is preserved byte-for-byte from the
    standalone page (deep-linked from My Tasks / emails), so its rendering is unchanged.
*@

<label>Sign-in email</label>
<input type="text" value="@Model.Email" readonly />
<p style="color:#6b7280;font-size:12px;margin:-8px 0 14px;">This is your identity + Sessionize match key — it can't be changed here.</p>

@* §309 (operator 2026-07-24): stacked, not a flex row — on wide screens the flex
   pushed Last name to the far right edge, miles from First name. *@
<h3 style="color:var(--el-darkblue);margin-top:20px;">Name</h3>
<label asp-for="FirstName">First name</label>
<input type="text" asp-for="FirstName" style="max-width:420px;" />
<span asp-validation-for="FirstName" class="error"></span>

<label asp-for="LastName">Last name</label>
<input type="text" asp-for="LastName" style="max-width:420px;" />
<span asp-validation-for="LastName" class="error"></span>

@* §302b (operator 2026-07-24): company is optional in Zoho and absent from Sessionize —
   the hub collects it here; when filled it is pushed to the speaker's "Company Name". *@
<label asp-for="CompanyName">Company (optional)</label>
<input type="text" asp-for="CompanyName" placeholder="Your company / employer" />
<span asp-validation-for="CompanyName" class="error"></span>

<h3 style="color:var(--el-darkblue);margin-top:20px;">Bio &amp; links</h3>
@* §309c: taglines are long one-liners — full bio width so they don't clip. *@
<label asp-for="Tagline">Tagline</label>
<input type="text" asp-for="Tagline" placeholder="One line that sums you up" style="max-width:960px;" />
<span asp-validation-for="Tagline" class="error"></span>

@* §309: the bio deserves ROOM — full card width (up to 960px) and 14 rows,
   overriding the global mobile-first textarea cap. *@
<label asp-for="Biography">Biography</label>
<textarea asp-for="Biography" rows="14" maxlength="4000" style="max-width:960px;"></textarea>
<span asp-validation-for="Biography" class="error"></span>

<label asp-for="LinkedIn">LinkedIn</label>
<input type="url" inputmode="url" asp-for="LinkedIn" placeholder="https://www.linkedin.com/in/you" style="max-width:640px;" />
<span asp-validation-for="LinkedIn" class="error"></span>

<label asp-for="Twitter">X / Twitter</label>
<input type="url" inputmode="url" asp-for="Twitter" placeholder="https://x.com/you" style="max-width:640px;" />
<span asp-validation-for="Twitter" class="error"></span>

<label asp-for="Blog">Blog / website</label>
<input type="url" inputmode="url" asp-for="Blog" placeholder="https://yourblog.example" style="max-width:640px;" />
<span asp-validation-for="Blog" class="error"></span>

<h3 style="color:var(--el-darkblue);margin-top:20px;">Photo</h3>
<label asp-for="PhotoUrl">Photo URL</label>
<input type="url" inputmode="url" asp-for="PhotoUrl" placeholder="https://…/your-photo.jpg" />
<span asp-validation-for="PhotoUrl" class="error"></span>
@* 🔴 §993 — RENDER THE HUB'S OWN COPY, NOT THE TYPED URL. This img used to take the raw
   PhotoUrl, so a sponsor-uploaded photo — whose PhotoUrl is a SharePoint DOCUMENT
   url — rendered as a broken-image icon directly above the line saying a copy had been saved.
   §665's SpeakerPhotoUrl.Resolve is the one rule for this and prefers the stored copy; the
   sponsor-session form has used it since it was written, and these preview sites never did. *@
@{
    var shownPhoto = CommunityHub.Core.Integrations.Graphics.SpeakerPhotoUrl.Resolve(
        Model.PhotoUrl, Model.PhotoStoredPath);
}
@if (!string.IsNullOrWhiteSpace(shownPhoto))
{
    <img src="@shownPhoto" alt="Your speaker photo" style="max-width:160px;border-radius:10px;margin-top:8px;" />
}
@if (!string.IsNullOrWhiteSpace(Model.PhotoStoredPath))
{
    <p style="color:#6b7280;font-size:12px;margin-top:6px;">A copy of your photo has been saved for the event programme.</p>
}
else if (string.IsNullOrWhiteSpace(shownPhoto) && !string.IsNullOrWhiteSpace(Model.PhotoUrl))
{
    @* ⚠️ Says the true thing instead of showing a broken icon. Resolve returns null only when the
       link needs a Microsoft sign-in AND no copy was saved — so the hub has nothing usable, and
       the speaker is the only person who can fix it. A broken icon reads as a fault in the hub. *@
    <p style="color:#b45309;font-size:12px;margin-top:6px;">
        We can&rsquo;t show this photo: the link points somewhere that needs a Microsoft sign-in,
        so it won&rsquo;t open for the programme either. Please paste a public image link.
    </p>
}

<h3 style="color:var(--el-darkblue);margin-top:20px;">Microsoft accreditation <span style="color:#c0392b;">*</span></h3>
<p style="color:#6b7280;font-size:12px;margin-top:0;">Tick all that apply (at least one is required).</p>
<span asp-validation-for="SelectedAccreditations" class="error"></span>
<div style="display:flex;flex-direction:column;gap:6px;margin:4px 0 6px;">
    @foreach (var opt in CommunityHub.Pages.Speaker.DetailsModel.AccreditationOptions)
    {
        <label style="display:flex;gap:8px;align-items:center;font-weight:400;">
            <input type="checkbox" name="SelectedAccreditations" value="@opt" @(Model.SelectedAccreditations.Contains(opt) ? "checked" : "") />
            @opt
        </label>
    }
</div>

<h3 style="color:var(--el-darkblue);margin-top:20px;">Details</h3>
<label asp-for="Country">Country <span style="color:#c0392b;">*</span></label>
<select asp-for="Country">
    <option value="">— select —</option>
    @foreach (var c in CommunityHub.Core.Domain.Countries.All)
    {
        <option value="@c.Code">@c.Code - @c.Name</option>
    }
</select>
<span asp-validation-for="Country" class="error"></span>

@* §306: Gender is required — "Prefer not to say" is the explicit opt-out choice,
   so the placeholder is a plain "— select —" that fails validation. *@
<label asp-for="Gender">Gender <span style="color:#c0392b;">*</span></label>
<select asp-for="Gender">
    <option value="">— select —</option>
    @foreach (var opt in CommunityHub.Pages.Speaker.DetailsModel.GenderOptions)
    {
        <option value="@opt">@opt</option>
    }
</select>

<label style="display:flex;gap:8px;align-items:center;margin-top:10px;">
    @* Manual checkbox: asp-for can't bind a bool? checkbox. *@
    <input type="checkbox" name="IsFirstTimeSpeaker" value="true" @(Model.IsFirstTimeSpeaker == true ? "checked" : "") />
    This is my first time speaking at Experts Live Denmark
</label>
@* Preferred contact email removed here (operator 2026-06-28): the get-started Step 1
   "Calendar email (optional)" is the single place to set an alternate email, so this
   duplicate-looking field is gone. Any previously-saved ContactEmailOverride is preserved
   (this step no longer reads or writes that column). *@

@if (Model.LastSessionizeImportAt is not null)
{
    <p style="color:#6b7280;font-size:12px;margin-top:14px;">Last Sessionize import: @Model.LastSessionizeImportAt?.ToString("d MMM yyyy HH:mm 'UTC'")</p>
}
