@page "/sponsor-registration"
@model CommunityHub.Pages.SponsorRegistrationModel
@using CommunityHub.Pages
@{
    // §27 — anonymous public page: the public layout never shows internal/auth chrome.
    Layout = "_PublicLayout";
    ViewData["Title"] = "Register as a sponsor";
}

<div class="card" style="max-width:960px;margin:0 auto;">
    @* Two lines: the event name on its own line reads better than a heading that wraps mid-name (operator 2026-09-26). *@
    <h1 style="margin-bottom:4px;">Register as a sponsor</h1>
    @if (Model.EventName is not null) { <p style="font-size:20px;font-weight:600;color:#374151;margin:0 0 16px;">@Model.EventName</p> }

    @if (Model.Closed)
    {
        <p class="info">Sponsor registration is not open here yet. Please contact the organizers.</p>
    }
    else
    {
        @if (Model.IsPreview)
        {
            <p class="info" style="border-left:4px solid #b45309;"><strong>Preview</strong> — registration is switched off; only organizers can see this page.</p>
        }
        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p class="@(Model.MessageIsError ? "error" : "info")" role="status">@Model.Message</p>
        }
        @if (Model.Problems.Count > 0)
        {
            <div class="error" role="alert"><p>Please fix:</p><ul>@foreach (var p in Model.Problems) { <li>@p</li> }</ul></div>
        }

        @if (Model.Current == SponsorRegistrationModel.Step.Email)
        {
            <p>Registering is free and is not an order. It creates your company and its contacts so you can shop, reserve and
               sign a contract. First we check your e-mail address with a one-time code.</p>
            <form method="post" asp-page-handler="Email" class="reg-form">
                <input type="hidden" name="Next" value="@Model.Next" />
                <label>Your work e-mail <span class="req" aria-hidden="true">*</span> <input name="Email" type="email" required autocomplete="email" value="@Model.Email" /></label>
                <div class="hp" aria-hidden="true"><label>Leave this empty <input name="Website2" tabindex="-1" autocomplete="off" /></label></div>
                @if (Model.UsesTurnstile)
                {
                    <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey"></div>
                    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
                }
                else if (Model.Challenge is not null)
                {
                    <input type="hidden" name="CaptchaToken" value="@Model.Challenge.Token" />
                    <label>@Model.Challenge.Question <span class="req" aria-hidden="true">*</span> <input name="CaptchaAnswer" inputmode="numeric" required autocomplete="off" style="max-width:120px;" /></label>
                }
                <button type="submit">Send me a code</button>
            </form>
            <p style="font-size:13px;color:#4b5563;">Already a sponsor contact? Just enter your e-mail — after the code you go straight to the
               shop. (Or <a href="/Login">sign in</a> the usual way.)</p>
        }
        else if (Model.Current == SponsorRegistrationModel.Step.Code)
        {
            <form method="post" asp-page-handler="Code" class="reg-form">
                <input type="hidden" name="Next" value="@Model.Next" />
                <input type="hidden" name="Email" value="@Model.Email" />
                <label>The code we e-mailed to @Model.Email <span class="req" aria-hidden="true">*</span> <input name="Code" inputmode="numeric" autocomplete="one-time-code" required /></label>
                <button type="submit">Continue</button>
            </form>
        }
        else if (Model.Current == SponsorRegistrationModel.Step.Pending)
        {
            @* §1309 — matched only by CVR: the organizers decide; nothing typed is stored on the company. *@
            <p><a href="/">Back to the start page</a></p>
        }
        else if (Model.Current == SponsorRegistrationModel.Step.Join)
        {
            @* §1309 — the company already exists (matched by the verified e-mail's domain). Read-only: joining never changes it
               (operator 2026-09-27: "i dont want edit capability in the registration form, as then anyone cna change any company"). *@
            @if (Model.IsExistingContact)
            {
                <div class="reg-found">
                    <p style="margin:0 0 8px;">You are already a sponsor contact. Go straight to the shop, or join another company below.</p>
                    <form method="post" asp-page-handler="Shop">
                        <input type="hidden" name="Next" value="@Model.Next" />
                        <input type="hidden" name="Session" value="@Model.Session" />
                        <button type="submit">Go to the shop</button>
                    </form>
                </div>
            }
            @if (Model.Joining is null)
            {
                <p>We found more than one company for your e-mail address. Which one do you work for?</p>
                @foreach (var m in Model.Matches)
                {
                    <form method="post" asp-page-handler="Pick" style="margin:6px 0;">
                        <input type="hidden" name="Next" value="@Model.Next" />
                        <input type="hidden" name="Session" value="@Model.Session" />
                        <input type="hidden" name="JoinCompanyId" value="@m.SponsorCompanyId" />
                        <button type="submit">@m.Name@(string.IsNullOrWhiteSpace(m.City) ? "" : $" — {m.City}")</button>
                    </form>
                }
            }
            else
            {
                <div class="reg-found">
                    <p style="margin:0 0 4px;">Your company is already registered with us:</p>
                    <p style="font-size:20px;font-weight:700;margin:0;">@Model.Joining.Name</p>
                    @if (!string.IsNullOrWhiteSpace(Model.Joining.City)) { <p style="margin:0;color:#4b5563;">@Model.Joining.City</p> }
                    <p style="margin:8px 0 0;font-size:14px;color:#4b5563;">You join it as a contact. Company details can be checked and changed after you have
                       signed in, under Company details.</p>
                </div>
                <form method="post" asp-page-handler="Join" class="reg-form">
                    <input type="hidden" name="Next" value="@Model.Next" />
                    <input type="hidden" name="Session" value="@Model.Session" />
                    <input type="hidden" name="JoinCompanyId" value="@Model.JoinCompanyId" />
                    <div class="reg-row">
                        <label>Your first name <span class="req" aria-hidden="true">*</span> <input name="JoinFirst" value="@Model.JoinFirst" required /></label>
                        <label>Your last name <span class="req" aria-hidden="true">*</span> <input name="JoinLast" value="@Model.JoinLast" required /></label>
                    </div>
                    <label>Your phone <input name="JoinPhone" value="@Model.JoinPhone" /></label>
                    @if (Model.CanPickRoles)
                    {
                        @* Nobody of this company is in the hub yet: choose its signer and coordinator from the people we know, so no one
                           is registered twice. E-mails are masked. *@
                        <label>Who signs the contract?
                            <select name="SignerKey">
                                <option value="me">Me</option>
                                @foreach (var p in Model.People) { <option value="@p.Key" selected="@p.IsSigner">@p.Name (@p.MaskedEmail)</option> }
                            </select>
                        </label>
                        <label>Who is the event coordinator?
                            <select name="CoordKey">
                                <option value="me">Me</option>
                                @foreach (var p in Model.People) { <option value="@p.Key" selected="@p.IsEventCoordinator">@p.Name (@p.MaskedEmail)</option> }
                            </select>
                        </label>
                    }
                    else if (Model.People.Count > 0)
                    {
                        <p style="font-size:14px;">Already with us for this company:</p>
                        <ul style="font-size:14px;margin:0;">
                            @foreach (var p in Model.People.Where(p => p.Key.StartsWith("p:")))
                            {
                                <li>@p.Name (@p.MaskedEmail)@(p.IsSigner ? " — signer" : "")@(p.IsEventCoordinator ? " — event coordinator" : "")</li>
                            }
                        </ul>
                    }
                    @if (!Model.CanPickRoles)
                    {
                        @* §1312 — operator 2026-09-27: "i am missing the role here, either signer or event coordinator or both - tick
                           off". Adds the role to the person joining; colleagues keep theirs. *@
                        <fieldset style="border:0;padding:0;margin:8px 0;">
                            <legend style="font-weight:600;font-size:14px;">Your role for this company</legend>
                            <label style="display:flex;gap:8px;align-items:center;font-weight:normal;"><input type="checkbox" name="JoinAsSigner" value="true" style="width:auto;" /> I sign the contract (signer)</label>
                            <label style="display:flex;gap:8px;align-items:center;font-weight:normal;"><input type="checkbox" name="JoinAsCoordinator" value="true" style="width:auto;" /> I coordinate the event (event coordinator)</label>
                        </fieldset>
                    }
                    <button type="submit">Join @Model.Joining.Name</button>
                </form>
                <form method="post" asp-page-handler="NotMine" style="margin-top:10px;">
                    <input type="hidden" name="Next" value="@Model.Next" />
                    <input type="hidden" name="Session" value="@Model.Session" />
                    <button type="submit" class="secondary">This is not my company — register a new company</button>
                </form>
            }
        }
        else
        {
            <form method="post" asp-page-handler="Complete" class="reg-form" id="reg-wizard">
                <input type="hidden" name="Next" value="@Model.Next" />
                <input type="hidden" name="Session" value="@Model.Session" />
                <input type="hidden" name="Email" value="@Model.Email" />
                <p class="reg-hint">Fields marked <span class="req">*</span> are required.</p>

                <fieldset data-step="1">
                    <legend>1 · Company</legend>
                    <label>Company name (legal) <span class="req" aria-hidden="true">*</span> <input name="CompanyName" value="@Model.CompanyName" required /></label>                    <label>CVR / VAT number <span class="req" aria-hidden="true">*</span> <input name="Cvr" id="reg-vat" value="@Model.Cvr" required /></label>
                    <label>Country <span class="req" aria-hidden="true">*</span>
                        <select name="Country" id="reg-country"
                                data-vies="@string.Join(",", SponsorRegistrationModel.Countries.Select(c => c.Code).Where(c => CommunityHub.Core.Integrations.Webshop.ShopVatChecker.NeedsVies(c)))">
                            @foreach (var c in SponsorRegistrationModel.Countries)
                            {
                                <option value="@c.Code" selected="@(c.Code == Model.Country)">@c.Name</option>
                            }
                        </select>
                    </label>
                    @* §1312 — "a verify vat number button … a prereq of a green verification before registration can complete for
                       european companies covered by the service … not relevant for fx usa companies". *@
                    <div class="reg-vat">
                        <button type="button" id="reg-verify" class="secondary">Verify VAT number</button>
                        <span id="reg-vat-state" role="status" aria-live="polite"></span>
                    </div>
                    <label>Address <span class="req" aria-hidden="true">*</span> <input name="Address" value="@Model.Address" required /></label>
                    <div class="reg-row">
                        <label>Postcode <span class="req" aria-hidden="true">*</span> <input name="Postcode" value="@Model.Postcode" required /></label>
                        <label>City <span class="req" aria-hidden="true">*</span> <input name="City" value="@Model.City" required /></label>
                    </div>
                    <label>Invoice currency <span class="req" aria-hidden="true">*</span>
                        <select name="Currency">@foreach (var cur in new[] { "DKK", "EUR", "USD" }) { <option selected="@(cur == Model.Currency)">@cur</option> }</select>
                    </label>
                    <label>Company / invoice e-mail <span class="req" aria-hidden="true">*</span> <input name="CompanyEmail" type="email" value="@Model.CompanyEmail" required /></label>
                    <label>Phone <input name="Phone" value="@Model.Phone" /></label>
                    @* §1312 — website + LinkedIn required; https only ("it must be clear if people must add https:// or not in urls.
                       it should block if http:// is used, as zoho does not support non-secure url"). *@
                    @* Operator 2026-09-27: "confusing message - do they need to add it or not" — one instruction: start with https://.
                       (The server still adds https:// when it is left out, silently, so nobody gets stuck.) *@
                    <p class="reg-hint">Enter each web address starting with <strong>https://</strong> — addresses starting with http:// are not accepted.</p>
                    <label>Website <span class="req" aria-hidden="true">*</span> <input name="WebsiteUrl" inputmode="url" autocomplete="url" value="@Model.WebsiteUrl" required
                           placeholder="https://www.your-company.com" pattern="^(?![Hh][Tt][Tt][Pp]://).+$" title="Start with https:// — http:// is not accepted." /></label>
                    <label>LinkedIn URL <span class="req" aria-hidden="true">*</span> <input name="LinkedIn" inputmode="url" value="@Model.LinkedIn" required
                           placeholder="https://www.linkedin.com/company/your-company" pattern="^(?![Hh][Tt][Tt][Pp]://).+$" title="Start with https:// — http:// is not accepted." /></label>
                    <label>X / Twitter URL <input name="Twitter" inputmode="url" value="@Model.Twitter"
                           placeholder="https://x.com/your-company" pattern="^(?![Hh][Tt][Tt][Pp]://).+$" title="Start with https:// — http:// is not accepted." /></label>
                </fieldset>

                <fieldset data-step="2">
                    <legend>2 · Default signer (signs the contract)</legend>
                    <div class="reg-row">
                        <label>First name <span class="req" aria-hidden="true">*</span> <input name="SignerFirst" value="@Model.SignerFirst" required /></label>
                        <label>Last name <span class="req" aria-hidden="true">*</span> <input name="SignerLast" value="@Model.SignerLast" required /></label>
                    </div>
                    <label>E-mail (used to sign in) <span class="req" aria-hidden="true">*</span> <input name="SignerEmail" type="email" value="@Model.SignerEmail" required /></label>
                    <label>Phone <input name="SignerPhone" value="@Model.SignerPhone" /></label>
                    <label style="display:flex;gap:8px;align-items:center;">
                        <input type="checkbox" name="SeparateCoordinator" value="true" id="sep" @(Model.SeparateCoordinator ? "checked" : "") />
                        The event coordinator is a different person
                    </label>
                </fieldset>

                <fieldset data-step="3" id="coord">
                    <legend>3 · Default event coordinator</legend>
                    <div class="reg-row">
                        <label>First name <span class="req" aria-hidden="true">*</span> <input name="CoordFirst" value="@Model.CoordFirst" /></label>
                        <label>Last name <span class="req" aria-hidden="true">*</span> <input name="CoordLast" value="@Model.CoordLast" /></label>
                    </div>
                    <label>E-mail (used to sign in) <span class="req" aria-hidden="true">*</span> <input name="CoordEmail" type="email" value="@Model.CoordEmail" /></label>
                    <label>Phone <input name="CoordPhone" value="@Model.CoordPhone" /></label>
                </fieldset>

                <div class="reg-nav">
                    <button type="button" id="reg-back">Back</button>
                    <button type="button" id="reg-next">Next</button>
                    <button type="submit" id="reg-submit">Register</button>
                </div>
            </form>
            <script>
            (function () {
                const steps = Array.from(document.querySelectorAll('#reg-wizard fieldset'));
                const sep = document.getElementById('sep');
                let i = 0;
                function visible() { return steps.filter(s => s.id !== 'coord' || sep.checked); }
                function show() {
                    // The coordinator's name and e-mail are required exactly when "a different person" is ticked.
                    document.querySelectorAll('#coord input[name=CoordFirst], #coord input[name=CoordLast], #coord input[name=CoordEmail]')
                        .forEach(el => el.required = sep.checked);
                    const v = visible();
                    if (i >= v.length) i = v.length - 1;
                    steps.forEach(s => s.hidden = !v.includes(s) || v.indexOf(s) !== i);
                    document.getElementById('reg-back').hidden = i === 0;
                    document.getElementById('reg-next').hidden = i === v.length - 1;
                    document.getElementById('reg-submit').hidden = i !== v.length - 1;
                }
                // §1312 — VAT verification: an EU (VIES) country must be GREEN before step 1 can be left; Denmark is checked
                // by checksum on Verify; other countries need nothing. Changing the number or the country re-locks it.
                const vat = document.getElementById('reg-vat'), country = document.getElementById('reg-country');
                const stateEl = document.getElementById('reg-vat-state'), verifyBtn = document.getElementById('reg-verify');
                const vies = (country.dataset.vies || '').split(',');
                let vatGreen = false;
                // §1312 — Northern Ireland: United Kingdom + a VAT number with the XI prefix is checked in VIES (under XI).
                function northernIrish() { return country.value === 'GB' && /^\W*XI/i.test(vat.value); }
                function needsGreen() { return vies.includes(country.value) || country.value === 'DK' || northernIrish(); }
                function setState(cls, text) { stateEl.className = 'reg-vat-' + cls; stateEl.textContent = text; }
                function reset() {
                    vatGreen = false;
                    // Operator 2026-09-27: "so verify button is only for countries from europe" — shown only where it applies.
                    verifyBtn.hidden = !needsGreen();
                    if (needsGreen()) setState('todo', 'Press Verify before you continue.');
                    else setState('none', '');
                }
                vat.addEventListener('input', reset);
                country.addEventListener('change', reset);
                verifyBtn.addEventListener('click', async () => {
                    if (!vat.value.trim()) { vat.reportValidity(); return; }
                    verifyBtn.disabled = true; setState('todo', 'Checking…');
                    try {
                        const r = await fetch('?handler=VerifyVat', { method: 'POST', body: new FormData(document.getElementById('reg-wizard')) });
                        const j = await r.json();
                        if (j.number) vat.value = j.number;   // the number as it is used, country code stripped
                        vatGreen = j.state === 'green' || j.state === 'notneeded';
                        const text = j.state === 'green' ? '✓ Verified' + (j.name ? ' — ' + j.name : '')
                            : j.state === 'red' ? '✗ ' + j.note
                            : j.state === 'unavailable' ? '⚠ ' + j.note
                            : j.note;
                        setState(j.state === 'green' ? 'green' : j.state === 'notneeded' ? 'none' : j.state === 'red' ? 'red' : 'warn', text);
                    } catch (e) { setState('warn', 'The check did not answer. Please try again.'); }
                    verifyBtn.disabled = false;
                });
                reset();

                document.getElementById('reg-next').addEventListener('click', () => {
                    const cur = visible()[i];
                    const bad = Array.from(cur.querySelectorAll('input,select')).find(el => !el.checkValidity());
                    if (bad) { bad.reportValidity(); return; }
                    if (cur.contains(vat) && needsGreen() && !vatGreen) { setState('red', 'Please verify your VAT number (green) before you continue.'); verifyBtn.focus(); return; }
                    i++; show();
                });
                document.getElementById('reg-back').addEventListener('click', () => { i = Math.max(0, i - 1); show(); });
                sep.addEventListener('change', show);
                show();
            })();
            </script>
        }
    }
</div>
<style>
    /* Roomy, readable fields (operator 2026-09-26: "all boxes … looks very cramped and small"). 16px stops phones zooming in. */
    .card input:not([type=checkbox]):not([type=radio]):not([type=hidden]), .card select, .card textarea {
        width:100%; box-sizing:border-box; padding:11px 12px; font-size:16px; line-height:1.3;
        border:1px solid #9ca3af; border-radius:8px; background:#fff; }
    .card input:focus, .card select:focus, .card textarea:focus { outline:3px solid #bcd3ee; border-color:#1565c0; }
    .card label { display:block; margin:10px 0 4px; font-weight:600; }
    .card button[type=submit] { padding:12px 18px; font-size:17px; border-radius:8px; }
    .reg-form { display:grid; gap:12px; }
    .reg-form fieldset { border:1px solid #e5e7eb; border-radius:8px; padding:12px 14px; display:grid; gap:10px; }
    /* §1312 — display:grid above overrode the [hidden] attribute, so every wizard step showed at once — including the event
       coordinator step while "The event coordinator is a different person" was NOT ticked (operator 2026-09-27: "logic is
       wrong, if not selected then signer and coordinator is the same"). */
    .reg-form fieldset[hidden], .reg-form [hidden] { display:none !important; }
    .reg-form label { display:grid; gap:4px; font-size:14px; }
    .reg-row { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
    .reg-nav { display:flex; gap:8px; }
    .reg-hint { font-size:13px; color:#4b5563; margin:4px 0 0; }
    /* §1312 — operator 2026-09-27: "* for mandatory, and nothing for optional". */
    .req { color:#b91c1c; font-weight:700; }
    .reg-vat { display:flex; flex-wrap:wrap; gap:10px; align-items:center; }
    .reg-vat-green { color:#166534; font-weight:700; }
    .reg-vat-red { color:#b91c1c; font-weight:700; }
    .reg-vat-warn { color:#b45309; font-weight:600; }
    .reg-vat-todo, .reg-vat-none { color:#4b5563; }
    .reg-found { border:2px solid #1565c0; background:#eef4fb; border-radius:10px; padding:12px 14px; margin:0 0 12px; }
    .hp { position:absolute; left:-10000px; width:1px; height:1px; overflow:hidden; }
    @@media (max-width:480px) { .reg-row { grid-template-columns:1fr; } }
</style>
