@page
@model CommunityHub.Pages.Forms.WizardModel
@{
    ViewData["Title"] = Localizer["Wizard.Title"].Value;

    // Step label/description per key (prefix differs per wizard service: SpeakerWiz / RoleWiz / SponsorWiz).
    string StepTitle(string key) => Model.Plan is null ? key : Localizer[Model.Plan.ResxPrefix + ".Step." + key].Value;
    string StepDesc(string key) => Model.Plan is null ? "" : Localizer[Model.Plan.ResxPrefix + ".Step." + key + ".Desc"].Value;
}

@* ============================================================================
   §285/§293: the shared Get-Started wizard SHELL. One smooth, mobile-first
   stepper for EVERY role (speaker / sponsor / role) — the forms are replicated
   INLINE (each step's handler renders its fields partial), with a progress bar,
   a tappable step rail, and a sticky Previous / Save & continue bar. Onboarding
   steps only. Styles are SCOPED to .ceh-wiz so the shared field partials keep
   the global form styling and nothing leaks out to the rest of the app.
   ========================================================================== *@
<style>
    .ceh-wiz { max-width: 600px; margin: 0 auto; }
    /* §301d/§309 (operator 2026-07-24): let the wizard breathe on desktop — the 600px
       column forced needless scrolling on big screens. Phones untouched. Breakpoint at
       1000px so Windows display scaling still qualifies.

       §715 (operator 2026-07-31: "on windows desktops, you are welcome to extend the width of
       fx get started and tasks and other place relevant. most of us have large external
       displays"). The 1000px cap was the LAST one left: `main` has been fluid since §301d/§308b
       (min(94vw, 1700px) at ≥1000px), and /Tasks and the hub already fill it — measured at a
       1920px viewport, main = 1732 and their cards = 1700, while Get Started stopped at 1000
       and left ~700px of grey on either side.

       `none`, not a bigger number: the wizard then simply FILLS the column `main` already
       defines, so the app has ONE width to change and this cannot drift out of step with it
       the way a second hard-coded 1000/1700 would. The most visible win is the step rail —
       it scrolls horizontally, so the extra width shows more steps at once instead of hiding
       them behind a swipe. Phones and tablets are untouched: this is a min-width rule only. */
    @@media (min-width: 1000px) { .ceh-wiz { max-width: none; } }
    .ceh-wiz__title-lead { font-size: 26px; font-weight: 700; color: var(--el-darkblue); margin: 0 0 14px; }

    /* Progress */
    .ceh-wiz__progress { margin: 0 0 12px; }
    .ceh-wiz__progress-meta { display: flex; justify-content: space-between; font-size: 13px;
        color: #4b5563; font-weight: 600; margin-bottom: 6px; }
    .ceh-wiz__bar { height: 10px; background: #e6eaf2; border-radius: 999px; overflow: hidden; }
    .ceh-wiz__bar-fill { height: 100%; border-radius: 999px;
        background: linear-gradient(90deg, var(--el-blue, #008BD2), #00a7e6); transition: width .45s ease; }

    /* Tappable step rail (revisit completed steps) */
    .ceh-wiz__rail { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px; margin: 0 -2px;
        -webkit-overflow-scrolling: touch; scrollbar-width: thin; }
    .ceh-wiz__chip { flex: 0 0 auto; display: inline-flex; align-items: center; gap: 5px;
        font-size: 12.5px; font-weight: 600; padding: 6px 12px; border-radius: 999px;
        text-decoration: none; white-space: nowrap; border: 1px solid transparent;
        transition: background .15s ease, color .15s ease, box-shadow .15s ease; }
    .ceh-wiz__chip--todo { background: #eef2f7; color: #4b5563; }
    .ceh-wiz__chip--todo:hover { background: #dbe3ee; color: var(--el-darkblue); }
    .ceh-wiz__chip--done { background: #e7f6ec; color: #1b5e34; }
    .ceh-wiz__chip--done:hover { background: #d3efdc; }
    .ceh-wiz__chip--current { background: var(--el-blue, #008BD2); color: #fff;
        box-shadow: 0 2px 7px rgba(0,139,210,.4); }
    .ceh-wiz__chip--current:hover { color: #fff; }

    /* The step card */
    .ceh-wiz__card { background: #fff; border-radius: 14px; padding: 22px;
        box-shadow: 0 2px 16px rgba(15,18,40,.09); animation: ceh-wiz-in .28s ease both; }
    @@keyframes ceh-wiz-in { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
    .ceh-wiz__stepno { font-size: 12px; font-weight: 700; letter-spacing: .05em; text-transform: uppercase;
        color: var(--el-blue, #008BD2); margin: 0 0 4px; }
    .ceh-wiz__step-title { font-size: 22px; font-weight: 700; color: var(--el-darkblue); margin: 0 0 4px; }
    /* §397 (operator 2026-07-26: "make this text easier to read - it is gray"). #6b7280 on white
       is ~4.8:1 — it passes AA for body text but reads as disabled, and on the Lunch step this is a
       long instruction people must actually follow, not a caption. #374151 is ~10:1 and still
       clearly secondary to the heading. */
    .ceh-wiz__step-desc { font-size: 14.5px; color: #374151; line-height: 1.55; margin: 0 0 18px; }

    /* Handler-less fallback: a proper button-styled section link (.btn-primary is undefined app-wide). */
    .ceh-wiz__open { display: inline-block; background: var(--el-blue, #008BD2); color: #fff !important;
        padding: 10px 18px; border-radius: 8px; text-decoration: none; font-weight: 600; font-size: 15px; }
    .ceh-wiz__open:hover { background: var(--el-darkblue); color: #fff !important; }
    .ceh-wiz__open-wrap { background: #eef6ff; border: 1px solid #d3e6fb; padding: 14px;
        border-radius: 10px; font-size: 14px; color: #1f3f6b; }

    /* Sticky Previous / Save-continue bar */
    .ceh-wiz__nav { position: sticky; bottom: 0; display: flex; gap: 12px; align-items: center;
        justify-content: space-between; padding: 14px 0 max(6px, env(safe-area-inset-bottom));
        margin-top: 20px; background: linear-gradient(180deg, rgba(255,255,255,0), #fff 26%); }
    .ceh-wiz__nav .btn-prev { background: #eef2f7; color: var(--el-darkblue); }
    .ceh-wiz__nav .btn-prev:hover { background: #dbe3ee; }
    .ceh-wiz__nav .btn-next { min-width: 168px; display: inline-flex; align-items: center; gap: 8px;
        justify-content: center; font-weight: 600; }
    .ceh-wiz__nav-spacer { flex: 1; }

    /* §713 (found while verifying §680, operator: "fix 713") — a button LABEL must never split.
       At 360px the three actions (Previous · Save & exit · Save & next) need ~382px and the card
       gives ~292px, so the browser broke the words instead: "Save & exit" rendered as three
       stacked lines inside its own button. It read as a rendering fault rather than a control.
       Two rules, in order of importance:
         1. nowrap — a label is never a place to wrap, at ANY width. This alone fixes the report.
         2. below 480px the primary takes its own full-width row, so the two secondary actions have
            the whole line to themselves instead of being squeezed. 480px is where the three stop
            fitting (card inner ≈ viewport − 68px, and the row needs ~382px).
       DOM order already puts the primary last, so it lands at the BOTTOM of the sticky bar —
       the biggest target, nearest the thumb. */
    .ceh-wiz__nav button { white-space: nowrap; }
    @@media (max-width: 480px) {
        .ceh-wiz__nav { flex-wrap: wrap; row-gap: 10px; }
        .ceh-wiz__nav .btn-next { flex: 1 0 100%; min-width: 0; }
    }

    /* §714 (operator: "fix 714") — the Community Helper must not sit ON the action bar.
       The helper is `position: fixed; bottom: 16px; z-index: 1200` and the nav is sticky at the
       bottom of the same viewport, so on any wizard step long enough to scroll they collide by
       construction. Measured at 360px: the launcher covered the right edge of BOTH "Save & exit"
       and "Save & next".

       It never blocked a tap (the button stayed the top element at its own centre), but "a control
       with a robot sitting on it" is not something to leave on the screen someone is trying to
       complete.

       🔒 The helper YIELDS; it is not hidden. The wizard is precisely where a confused person
       reaches for help, so removing it here would answer a cosmetic problem by deleting the
       feature. It is lifted to clear the bar and stays one tap away.

       Restyling a global widget from a page's own <style> is deliberate: this block loads ONLY on
       /Forms/Wizard, so it is page-scoped without a body class or a layout flag, and the wizard is
       the ONLY page in the app with a sticky bottom bar (verified — no other `position: sticky`
       with `bottom: 0` exists).

       The offsets are the bar's real height plus a gap, and they are PINNED by the "gui 714" test,
       which fails if the bar grows past them (do NOT write an @@-tag in here: Razor parses it as
       C# even inside a CSS comment, and the build dies with "The name 'gui' does not exist"):
         narrow (2 rows): 14 top + 35 + 10 gap + 35 + 6 bottom = 100  -> 112
         wide   (1 row):  14 top + 35 + 6 bottom               =  55  ->  68            */
       ⚠️ `body .ai-helper-widget`, not `.ai-helper-widget`. The widget ships its OWN
       `<style>` (_AiHelperWidget.cshtml) and _Layout renders it AFTER the page body, so at equal
       specificity the widget's `bottom: 16px` wins on source order and the page rule does nothing.
       The first attempt at this fix looked correct and changed nothing on screen; the extra
       `body ` (0-1-1 vs 0-1-0) makes it win regardless of order.                           */
    body .ai-helper-widget { bottom: 68px; }
    @@media (max-width: 480px) { body .ai-helper-widget { bottom: 112px; } }

    .ceh-wiz__alldone { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between;
        gap: 10px; background: #e7f6ec; border: 1px solid #b6e0c4; color: #1b5e34;
        padding: 12px 14px; border-radius: 10px; margin: 0 0 16px; font-size: 14px; line-height: 1.45; }
    .ceh-wiz__back { text-align: center; margin-top: 16px; font-size: 13.5px; }

    /* Slightly roomier field rhythm INSIDE the wizard only (partials keep global styling elsewhere). */
    .ceh-wiz__card label { margin-top: 14px; }

    @@media (prefers-reduced-motion: reduce) {
        .ceh-wiz__card { animation: none; }
        .ceh-wiz__bar-fill { transition: none; }
    }
</style>

<div class="ceh-wiz">
    <h1 class="ceh-wiz__title-lead">@Localizer["Wizard.Title"]</h1>

    @if (Model.AccessDenied)
    {
        <div class="ceh-wiz__card">
            <p class="error">@Localizer["SpeakerForm.AccessDenied", Model.FullName]</p>
            <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
        </div>
    }
    else if (Model.NothingToDo)
    {
        <div class="ceh-wiz__card">
            <p class="info">@Localizer["Wizard.Nothing"]</p>
            <p><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
        </div>
    }
    else if (Model.ShowAllDone || Model.Plan is null || Model.CurrentStep is null)
    {
        var donePlan = Model.Plan;
        <div class="ceh-wiz__card">
            @if (donePlan is not null)
            {
                <div class="ceh-wiz__progress">
                    <div class="ceh-wiz__progress-meta">
                        <span>@Localizer["SpeakerWiz.Progress", donePlan.DoneCount, donePlan.EntitledCount]</span>
                        <span>100%</span>
                    </div>
                    <div class="ceh-wiz__bar"><div class="ceh-wiz__bar-fill" style="width:100%;"></div></div>
                </div>
            }
            <p class="success" style="font-size:17px;margin-top:14px;">🎉 @Localizer["Wizard.AllDone"]</p>
            <p style="margin-top:12px;"><a asp-page="/Index" class="ceh-wiz__open">@Localizer["Wizard.GoToHub"]</a></p>
        </div>
    }
    else
    {
        var plan = Model.Plan;
        var step = Model.CurrentStep!;

        <div class="ceh-wiz__progress">
            <div class="ceh-wiz__progress-meta">
                <span>@Localizer["SpeakerWiz.Progress", plan.DoneCount, plan.EntitledCount]</span>
                <span>@plan.Percent%</span>
            </div>
            <div class="ceh-wiz__bar" role="progressbar"
                 aria-valuenow="@plan.Percent" aria-valuemin="0" aria-valuemax="100">
                <div class="ceh-wiz__bar-fill" style="width:@(plan.Percent)%;"></div>
            </div>
        </div>

        @* Tappable step rail — completed steps are revisitable. *@
        <nav class="ceh-wiz__rail" aria-label="@Localizer["Wizard.Title"]">
            @{ var i = 0; }
            @foreach (var s in plan.Steps)
            {
                var isCurrent = i == Model.CurrentIndex;
                var cls = isCurrent ? "ceh-wiz__chip--current" : (s.Done ? "ceh-wiz__chip--done" : "ceh-wiz__chip--todo");
                <a asp-page="/Forms/Wizard" asp-route-step="@s.Key" title="@StepTitle(s.Key)"
                   class="ceh-wiz__chip @cls" aria-current="@(isCurrent ? "step" : null)">
                    @(s.Done && !isCurrent ? "✓ " : "")@StepTitle(s.Key)
                </a>
                i++;
            }
        </nav>

        <div class="ceh-wiz__card">
            @if (Model.AllComplete)
            {
                @* §297: at 100% we still show the editable wizard (not a dead-end) — this banner
                   makes it obvious you can review/change any answer, then leave. *@
                <div class="ceh-wiz__alldone">
                    <div>🎉 <strong>@Localizer["Wizard.AllDone"]</strong> @Localizer["Wizard.AllDoneEdit"]</div>
                    <a asp-page="/Index" class="ceh-wiz__open" style="flex:0 0 auto;">@Localizer["Wizard.GoToHub"]</a>
                </div>
            }
            <p class="ceh-wiz__stepno">@Localizer["Wizard.StepXofN", Model.CurrentStepNumber, plan.EntitledCount]</p>
            <h2 class="ceh-wiz__step-title">@StepTitle(step.Key)</h2>
            <p class="ceh-wiz__step-desc">@StepDesc(step.Key)</p>

            @* Multipart so file-upload steps (e.g. the sponsor Logos step) can post files;
               harmless for the text/radio steps. *@
            <form method="post" enctype="multipart/form-data">
                <div asp-validation-summary="All" class="ceh-validation-summary"></div>

                @if (Model.CurrentHandler is not null)
                {
                    <partial name="@Model.CurrentHandler.PartialName" model="@Model.CurrentHandler.Model" />
                }
                else
                {
                    @* No inline handler for this step yet → open its section. href (not asp-page)
                       so a route with a #fragment (e.g. /Sponsor/CompanyDetails#logos) lands right. *@
                    <div class="ceh-wiz__open-wrap">
                        <p style="margin:0 0 10px;">@StepDesc(step.Key)</p>
                        <a href="@step.Route" class="ceh-wiz__open">@Localizer["Wizard.OpenStep", StepTitle(step.Key)]</a>
                    </div>
                }

                <input type="hidden" name="__step" value="@step.Key" />
                @* §783.4/§783.5 — a step's own "save and stay" button writes what it just did here,
                   so the confirmation names the ACTION ("Your logos were uploaded") rather than a
                   generic "Saved". Empty for the ordinary Next/Finish path. *@
                <input type="hidden" name="__stayMsg" value="" />

                <div class="ceh-wiz__nav">
                    @if (!Model.IsFirstStep)
                    {
                        <button type="submit" name="__dir" value="prev" formnovalidate class="btn-prev">
                            @Localizer["Wizard.Previous"]
                        </button>
                    }
                    else
                    {
                        <span class="ceh-wiz__nav-spacer"></span>
                    }

                    @* §393 SAVE & EXIT — for the person who arrived from a MENU ITEM wanting ONE
                       step, not the whole tour. Saves exactly like "next" and then returns to the
                       hub. Secondary styling on purpose: first-run onboarding should still read
                       left-to-right through the flow, so this must not compete with the primary.
                       Hidden on the LAST step, where "Finish" already lands on the hub. *@
                    @if (Model.CurrentHandler is not null && !Model.IsLastStep)
                    {
                        @* §713: the inline margin-right is gone — the nav is a flex row with its
                           own gap, and an inline style is exactly what a media query cannot beat. *@
                        <button type="submit" name="__dir" value="exit" class="secondary"
                                title="Save this step and go back to the hub">
                            Save &amp; exit
                        </button>
                    }

                    @if (Model.CurrentHandler is null)
                    {
                        <button type="submit" name="__dir" value="next" class="btn-next">@Localizer["Wizard.Skip"]</button>
                    }
                    else if (Model.IsLastStep)
                    {
                        <button type="submit" name="__dir" value="next" class="btn-next">@Localizer["Wizard.Finish"] →</button>
                    }
                    else
                    {
                        <button type="submit" name="__dir" value="next" class="btn-next">@Localizer["Wizard.Next"] →</button>
                    }
                </div>
            </form>
        </div>

        <p class="ceh-wiz__back"><a asp-page="/Index">@Localizer["Common.BackToHub"]</a></p>
    }
</div>
