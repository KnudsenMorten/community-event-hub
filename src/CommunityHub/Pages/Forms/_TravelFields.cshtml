@model CommunityHub.Forms.Steps.TravelFormModel
@*
    Fields-ONLY partial for the Travel-reimbursement step (REQUIREMENTS §148, §48).
    Contains NO <form>, no validation summary, no page chrome, no Back-to-hub link — the
    HOST (the standalone /Forms/Travel page OR the generic /Forms/Wizard shell) owns those
    and places this partial inside its single <form method="post">. Mobile-first.

    TWO-STEP form: Step 1 = upload/delete receipt files (named in-step sub-actions posted as
    __action=uploadReceipt / __action=deleteReceipt:{id}); Step 2 = the reimbursement claim,
    gated until ≥1 receipt exists. Input names stay flat (RequestReimbursement / AmountChoice /
    …) so model binding (empty prefix) is identical in both hosts. The upload button carries
    formenctype="multipart/form-data" so the file posts even though the generic host form is
    not multipart; the sub-action + Previous buttons carry formnovalidate so they never trip
    the Step-2 client validation.
*@

@* §205: the former dense intro paragraph, split into headed BULLET sections so it
   reads clearly on mobile. Exact figures unchanged. (Intro merges the former
   "Covered cost" and "Not covered" sections — operator §54.) *@
<div style="background:#eef6ff;padding:14px 16px;border-radius:8px;font-size:14px;line-height:1.55;">
    <p style="margin:0 0 8px;"><strong>Travel reimbursement — flights only.</strong>
        Here is what we cover and how it works.</p>

    <ul style="margin:0 0 10px;padding-left:20px;">
        <li><strong>We cover economy flights only.</strong></li>
        <li><strong>European air travel</strong> — <strong>EUR 400</strong> for a
            single-speaker session (round trip), or <strong>EUR 300</strong> per person for
            co-speaking sessions.</li>
        <li><strong>Intercontinental air travel</strong> — <strong>EUR 800</strong> for a
            single-speaker session (round trip), or <strong>EUR 600</strong> per person for
            co-speaking sessions (round trip).</li>
        <li>If you cannot get flights within these boundaries, let us know and we will work
            with you on this.</li>
        <li>Flights must be booked <strong>at least 6 weeks before the event</strong>. Booked
            later, they are reimbursed up to the economy price available at the 6-week mark,
            unless a documented exception is pre-approved by an organizer.</li>
    </ul>

    <p style="margin:0 0 6px;"><strong>Not covered:</strong></p>
    <ul style="margin:0 0 10px;padding-left:20px;">
        <li>Taxi, Uber, public transportation, or own car in Denmark.</li>
        <li>Seat upgrades / business class.</li>
        <li>Ground transport / parking.</li>
        <li>Meals / incidentals.</li>
    </ul>

    <p style="margin:0;">You will get the reimbursement <strong>after the event</strong> — we
        will give you the instructions via the hub.</p>
</div>

<h3>Eligibility</h3>
<p style="font-size:14px;">Reimbursement is available to <strong>international speakers only</strong>
    — defined as speakers travelling from outside Denmark.</p>

<h3 id="requirements">Booking requirements</h3>
<ul style="font-size:14px;">
    <li><strong>Economy class</strong> — all flights must be booked in economy class. Upgrades,
        premium economy and business class are not reimbursable.</li>
    <li><strong>Advance booking</strong> — tickets must be booked at least six weeks before the
        event date. Tickets booked later will only be reimbursed up to the equivalent economy
        price available at the six-week mark, unless a documented exception has been approved in
        advance by the organizers.</li>
    <li><strong>Original receipts or payment confirmations</strong> (PDF, JPG or PNG) showing
        name, route, dates and total amount paid are required. Booking confirmations without
        payment details are not sufficient.</li>
</ul>

<h3>Submission process</h3>
<ul style="font-size:14px;">
    <li>Submit all reimbursement documents by this form no later than
        <strong>10 January 2027</strong>. Late submissions will not be processed.</li>
    <li>A receipt alone is not sufficient. You must also submit either:
        <ul>
            <li><strong>Company invoice</strong> — if you have a registered company, an invoice
                must be issued to Experts Live Denmark. The invoice must include sender details,
                recipient details, a description (e.g. &ldquo;Speaker travel reimbursement —
                Experts Live DK 2027&rdquo;) and the total amount.</li>
            <li><strong>Personal declaration</strong> — if you do not have a company, a personal
                declaration is acceptable. This must include your full name, address, a valid
                identification number (passport or national ID), the recipient entity, a
                description of the costs and the total amount claimed.</li>
        </ul>
    </li>
</ul>

<h3>Billing details</h3>
<p style="font-size:14px;background:#f6f8fb;border-radius:8px;padding:12px 14px;margin:0 0 10px;">
    <strong>Experts Live Denmark</strong><br>
    Strandvejen 21A<br>
    6000 Kolding<br>
    Denmark<br>
    VAT Number: DK44197588
</p>
<p style="font-size:14px;">Your bank account details on the invoice must include:
    <strong>Bank name, IBAN, BIC/SWIFT, Account Holder Name</strong>.</p>

@* Shared success/error toasts (REQUIREMENTS §21): role=status, auto-dismiss, dismissable.
   Live in the partial so upload/delete feedback shows in BOTH the standalone page and the wizard. *@
<partial name="_Flash" model='new CommunityHub.Pages.Shared.FlashModel(Model.Message, "success")' />
@if (!string.IsNullOrEmpty(Model.Error))
{
    <partial name="_Flash" model='new CommunityHub.Pages.Shared.FlashModel(Model.Error, "error")' />
}

@* ============================ STEP 1 ============================ *@
@* Upload receipts/invoice. This MUST be completed (≥1 file) before the Step-2 reimbursement
   request unlocks (REQUIREMENTS §48). Files are stored in the hub and attached to the
   bookkeeping email on Step-2 submit. *@
<h3 style="margin-top:8px;">Step 1: Upload receipts</h3>
<p style="font-size:14px;">Upload your flight receipt(s) and invoice / personal
    declaration here (PDF, JPG or PNG, max 15&nbsp;MB each). You must upload at
    least one file before you can request reimbursement in Step 2.</p>

@* §1387 — the organizers' review: what happened to the claim, in the speaker's own page. *@
@if (Model.ReviewState == CommunityHub.Core.Domain.TravelReviewState.SentBack)
{
    <div role="status" style="background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:10px 12px;margin:0 0 14px;font-size:14px;">
        <strong>Thank you for sending your claim 🙂 We had a look and need a little more from you.</strong>
        Just add the documents below and submit again — your earlier files are still here.
        @if (!string.IsNullOrWhiteSpace(Model.ReviewNote)) { <br /><span>@Model.ReviewNote</span> }
        @if (Model.MissingItems.Count > 0)
        {
            <ul style="margin:6px 0 0;">
                @foreach (var m in Model.MissingItems)
                {
                    <li style="margin:0 0 4px;">@(string.IsNullOrWhiteSpace(m.SpeakerNote) ? m.Requirement + (string.IsNullOrWhiteSpace(m.Note) ? "" : " — " + m.Note) : m.SpeakerNote)</li>
                }
            </ul>
        }
        <br /><span style="color:#6b7280;">Questions, or think we got it wrong? Just reply to our mail — we're happy to help.</span>
    </div>
}
else if (Model.ReviewState == CommunityHub.Core.Domain.TravelReviewState.UnderReview)
{
    <p role="status" style="background:#f3f6fb;border:1px solid #dde4ee;border-radius:8px;padding:10px 12px;margin:0 0 14px;font-size:14px;">
        Thank you! 🙂 Your claim is with us for a quick document check. If we need anything else, we'll let you know.
    </p>
}
else if (Model.ReviewState == CommunityHub.Core.Domain.TravelReviewState.Accepted)
{
    <p role="status" style="background:#dcfce7;color:#166534;border-radius:8px;padding:10px 12px;margin:0 0 14px;font-size:14px;">
        All good — thank you! 🎉 Your documents are accepted and the claim has been passed on for payment.
    </p>
}

<div style="margin:0 0 14px;">
    @* §1387 — say what the file is, so the check knows the ticket from the invoice. *@
    <label for="ReceiptKind" style="display:block;font-size:14px;">This file is</label>
    <select asp-for="ReceiptKind" id="ReceiptKind" style="margin-bottom:6px;">
        <option value="@CommunityHub.Core.Domain.TravelDocumentKind.TicketReceipt">Flight ticket / receipt / payment confirmation</option>
        <option value="@CommunityHub.Core.Domain.TravelDocumentKind.Invoice">Company invoice</option>
        <option value="@CommunityHub.Core.Domain.TravelDocumentKind.PersonalDeclaration">Personal declaration</option>
        <option value="@CommunityHub.Core.Domain.TravelDocumentKind.Other">Other</option>
    </select>
    <input type="file" asp-for="ReceiptFile" accept=".pdf,.jpg,.jpeg,.png" />
    <button type="submit" name="__action" value="uploadReceipt"
            formenctype="multipart/form-data" formnovalidate>Step 1: Upload Receipt</button>
</div>

@if (Model.Receipts.Count > 0)
{
    <p style="font-size:14px;font-weight:600;margin:6px 0 4px;">Uploaded so far:</p>
    <ul style="font-size:14px;list-style:none;padding:0;margin:0 0 16px;">
        @foreach (var r in Model.Receipts)
        {
            <li style="margin:4px 0;">
                <div style="display:flex;align-items:center;gap:10px;">
                    <span>&#128206; @r.FileName <span style="color:#6b7280;">(@(((r.SizeBytes + 1023) / 1024)) KB@(r.Kind == CommunityHub.Core.Domain.TravelDocumentKind.Unknown ? "" : " · " + CommunityHub.Core.Travel.TravelDocumentValidator.KindText(r.Kind)))</span></span>
                    <button type="submit" name="__action" value="deleteReceipt:@r.Id" formnovalidate
                            style="background:none;border:0;color:#b91c1c;cursor:pointer;text-decoration:underline;padding:0;font-size:13px;">remove</button>
                </div>
                @* §68 — when the receipt was uploaded, so a returning speaker sees it's already on file. *@
                <span style="color:#6b7280;font-size:12px;">Uploaded @r.UploadedAt.ToUniversalTime().ToString("dd MMM yyyy HH:mm") UTC</span>
            </li>
        }
    </ul>
}
else
{
    <p style="font-size:14px;color:#92400e;background:#fff7ed;border:1px solid #fed7aa;border-radius:8px;padding:10px 12px;margin:0 0 16px;">
        No receipts uploaded yet. Step 2 (Request Travel Reimbursement) is locked
        until you upload at least one receipt above.
    </p>
}

@* ============================ STEP 2 ============================ *@
<h3 style="margin-top:4px;">Step 2: Request Travel Reimbursement
    @if (!Model.HasReceipt)
    {
        <span style="font-size:13px;font-weight:600;color:#92400e;">&#128274; locked — complete Step 1 first</span>
    }
</h3>

<fieldset id="Step2Fieldset" @(Model.HasReceipt ? "" : "disabled") style="border:0;padding:0;margin:0;@(Model.HasReceipt ? "" : "opacity:0.55;")">
    @* §326i: read-only Name/Email removed — authenticated session, the claim is keyed
       to the signed-in participant. *@
    <fieldset style="border:0;padding:0;margin:0;">
        <legend style="font-weight:600;font-size:14px;margin-top:10px;">@Localizer["Travel.ClaimLegend"]</legend>
        <div style="display:flex; gap:18px; margin:6px 0 14px;">
            <label style="font-weight:normal;">
                <input type="radio" asp-for="RequestReimbursement" value="false" id="ReqNo" />
                @Localizer["Travel.ClaimNo"]
            </label>
            <label style="font-weight:normal;">
                <input type="radio" asp-for="RequestReimbursement" value="true" id="ReqYes" />
                @Localizer["Common.Yes"]
            </label>
        </div>
    </fieldset>

    <div id="ClaimBlock" style="@(Model.RequestReimbursement ? "" : "display:none;")">

        <label for="OriginCity">@Localizer["Travel.OriginCity"]</label>
        <input type="text" asp-for="OriginCity" placeholder="@Localizer["Travel.OriginPlaceholder"]" />

        @* Operator 2026-11-09: "the dropdown should be a custom amount and not predefined amounts 400, 800 etc".
           A speaker claims what they actually paid, up to the cap for their route — so the amount is typed, and the
           caps are shown as the maximums. (A pick of "EUR 300" for a EUR 268.24 ticket failed the AI's
           "claim not above paid" check.) AmountChoice is always "other" now; the amount lives in OtherAmountEur. *@
        <input type="hidden" name="AmountChoice" value="@CommunityHub.Forms.Steps.TravelFormModel.ChoiceOther" />
        <label for="OtherAmountEur">@Localizer["Travel.AmountLabel"]</label>
        <input type="number" asp-for="OtherAmountEur" id="OtherAmountEur" min="0.01" step="0.01" inputmode="decimal"
               placeholder="e.g. 268.24" style="max-width:200px;" />
        <span asp-validation-for="OtherAmountEur" class="ceh-field-error"></span>
        <span asp-validation-for="AmountChoice" class="ceh-field-error"></span>
        <div class="muted" style="font-size:13px;margin:4px 0 10px;">
            Claim what you actually paid, in EUR — at most:
            <ul style="margin:4px 0 0 18px;padding:0;">
                <li>@Localizer["Travel.AmountSingle", CommunityHub.Forms.Steps.TravelFormModel.Cap400]</li>
                <li>@Localizer["Travel.AmountCo", CommunityHub.Forms.Steps.TravelFormModel.Cap300]</li>
                <li>@Localizer["Travel.AmountIntercontinental", CommunityHub.Forms.Steps.TravelFormModel.Cap800]</li>
                <li>@Localizer["Travel.AmountIntercontinentalCo", CommunityHub.Forms.Steps.TravelFormModel.Cap600]</li>
            </ul>
        </div>

        @* §1387 — decides which second document the check expects: invoice or personal declaration. *@
        <fieldset style="border:0;padding:0;margin:10px 0 6px;">
            <legend style="font-weight:600;font-size:14px;">Do you invoice through a registered company?</legend>
            <label style="font-weight:normal;margin-right:18px;"><input type="radio" asp-for="HasCompany" value="true" /> Yes — I attach a company invoice</label>
            <label style="font-weight:normal;"><input type="radio" asp-for="HasCompany" value="false" /> No — I attach a personal declaration</label>
        </fieldset>
        <span asp-validation-for="HasCompany" class="ceh-field-error"></span>

        <label for="Explanation">@Localizer["Travel.Explanation"]</label>
        <textarea asp-for="Explanation" rows="3"
                  placeholder="@Localizer["Travel.ExplanationPlaceholder"]"></textarea>
        <span asp-validation-for="Explanation" class="ceh-field-error"></span>
    </div>
</fieldset>

<script>
    (function () {
        var reqYes = document.getElementById('ReqYes');
        var reqNo  = document.getElementById('ReqNo');
        var claim  = document.getElementById('ClaimBlock');
        var amount = document.getElementById('OtherAmountEur');
        if (!reqYes || !reqNo || !claim || !amount) return;
        var form   = amount.closest('form');
        function syncClaim() { claim.style.display = reqYes.checked ? '' : 'none'; }
        reqYes.addEventListener('change', syncClaim);
        reqNo.addEventListener('change', syncClaim);
        syncClaim();

        // Client-side mirror of the server field validation (shared pattern). HTML5 custom
        // validity gives an inline message without leaving the page; the server re-checks
        // regardless, so JS-off users are still safe. Only runs for the MAIN save — upload /
        // delete / Previous buttons carry formnovalidate, so we skip them via e.submitter.
        if (form) {
            form.addEventListener('submit', function (e) {
                if (e.submitter && e.submitter.formNoValidate) return;  // sub-action / prev: skip
                if (!reqYes.checked) return;                            // not claiming: skip
                var v = parseFloat(amount.value);
                if (!(v > 0)) {
                    amount.setCustomValidity(
                        '@Html.Raw(Localizer["Travel.ErrOtherAmount"].Value.Replace("'", "\'"))');
                    amount.reportValidity();
                    amount.classList.add('ceh-input-invalid');
                    e.preventDefault();
                }
            });
            amount.addEventListener('input', function () {
                amount.setCustomValidity('');
                amount.classList.remove('ceh-input-invalid');
            });
        }
    })();
</script>
