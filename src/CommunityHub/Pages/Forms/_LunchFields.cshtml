@model CommunityHub.Forms.Steps.LunchFormModel
@*
    Fields-ONLY partial for the Lunch step (REQUIREMENTS §148).
    Contains NO <form>, no validation summary, no flash, no Save button, no
    Back-to-hub link — the HOST (the standalone /Forms/Lunch page OR the generic
    /Forms/Wizard shell) owns those and places this partial inside its single
    <form method="post">. Mobile-first. Bound to CommunityHub.Forms.Steps.LunchFormModel;
    input names stay flat (LunchEarlySetupDay / LunchSetupDay / LunchPreDay / Notes) so
    model binding (empty prefix) is unchanged between the page and the wizard.
*@

@* §326i: read-only Name/Email removed — authenticated session, answers keyed to the
   signed-in participant. *@

@*
    §178b: a day the person is marked UNAVAILABLE on is rendered disabled + dimmed
    with a short hint — you can't have lunch on a day you're not on site. A disabled
    checkbox is never submitted, and the service force-unchecks + server-guards it, so
    the value can't round-trip true. A local helper keeps the three days consistent.
*@
<fieldset style="border:0;padding:0;margin:0;">
    <legend style="font-weight:600;font-size:14px;margin-top:10px;">@Localizer["Lunch.WhichLegend"]</legend>
    @if (Model.ShowSetupDay)
    {
        @* §178c: every lunch day is the SAME checkbox select/unselect style. *@
        <label style="font-weight:normal; display:flex; align-items:flex-start; gap:8px; margin-top:8px;@(Model.EarlySetupDayUnavailable ? "opacity:.55;" : "")">
            <input type="checkbox" asp-for="LunchEarlySetupDay" style="width:auto;margin:5px 0 0;" disabled="@(Model.EarlySetupDayUnavailable ? "disabled" : null)" />
            <span>
                <strong>@Localizer["Lunch.SetupDay", Model.EarlySetupDayLabel]</strong>
                @if (Model.EarlySetupDayUnavailable)
                {
                    <span style="display:block;font-size:12px;color:#6b7280;">@Localizer["Lunch.NotAvailableHint"]</span>
                }
            </span>
        </label>
        <label style="font-weight:normal; display:flex; align-items:flex-start; gap:8px; margin-top:8px;@(Model.SetupDayUnavailable ? "opacity:.55;" : "")">
            <input type="checkbox" asp-for="LunchSetupDay" style="width:auto;margin:5px 0 0;" disabled="@(Model.SetupDayUnavailable ? "disabled" : null)" />
            <span>
                <strong>@Localizer["Lunch.SetupDay", Model.SetupDayLabel]</strong>
                @if (Model.SetupDayUnavailable)
                {
                    <span style="display:block;font-size:12px;color:#6b7280;">@Localizer["Lunch.NotAvailableHint"]</span>
                }
            </span>
        </label>
    }

    @if (Model.ShowPreDay)
    {
        @* §178c: the pre-day lunch is a CHECKBOX like the others now (operator wants ONE
           select/unselect style) — checked = yes, unchecked = no. *@
        <label style="font-weight:normal; display:flex; align-items:flex-start; gap:8px; margin-top:8px;@(Model.PreDayUnavailable ? "opacity:.55;" : "")">
            <input type="checkbox" asp-for="LunchPreDay" style="width:auto;margin:5px 0 0;" disabled="@(Model.PreDayUnavailable ? "disabled" : null)" />
            <span>
                <strong>@Localizer["Lunch.SetupDay", Model.PreDayLabel]</strong>
                @if (Model.PreDayUnavailable)
                {
                    <span style="display:block;font-size:12px;color:#6b7280;">@Localizer["Lunch.NotAvailableHint"]</span>
                }
            </span>
        </label>
    }
    @* §979 (operator 2026-08-09): *"remove this text, as it doesnt show that so no reason to
       mention it - not relevant"*. The note explained why a pre-day lunch tick is absent — but the
       form does not show a pre-day row at all, so it answered a question the reader never had and
       introduced a concept ("Master Class lunch") the page otherwise never mentions.
       PreDayAutoCounted is left on the model: it still drives the branch above. *@
</fieldset>

<label for="Notes">@Localizer["Lunch.NotesLabel"]</label>
<textarea asp-for="Notes" rows="3"></textarea>
