@page "/MasterClassPage/{sessionId:int}"
@model CommunityHub.Pages.MasterClassPageModel
@{
    ViewData["Title"] = Model.View?.Title ?? "Master Class";
    string Stamp(DateTimeOffset at) => at.UtcDateTime.ToString("d MMM yyyy HH:mm 'UTC'");

    // §383 (operator 2026-07-26): "can we restucture the text into 3 boxes (instead of 1
    // paragraph)". One shared card style so the three boxes read as siblings rather than three
    // hand-styled sections that drift apart the next time one of them is edited.
    const string Box = "background:#fff;border:1px solid #dde4ee;border-radius:12px;"
                     + "padding:16px 18px;margin:18px 0;box-shadow:0 1px 2px rgba(16,24,40,.04);";
}

@* §383b (operator 2026-07-26: "it seems as the width of the page is limited") — this page set its
   OWN 760px cap, half of what §309 gives the rest of the hub, so it wasted most of a desktop screen
   while every other page had already been widened. Raised to the §309 field-form width (1100px)
   rather than removed entirely: the layout's main column goes to min(94vw, 1700px), and prose set
   that wide is genuinely hard to read. Still fluid below 1100px, so phones are unchanged. *@
<div style="max-width:1100px;margin:0 auto;padding:16px;box-sizing:border-box;overflow-wrap:anywhere;">
    @if (Model.NotFoundState)
    {
        <h1>Master Class not found</h1>
        <p>This Master Class page is not available. The link may be out of date.</p>
    }
    else if (Model.AccessDenied)
    {
        <h1>Master Class</h1>
        <p role="status">
            This Master Class page is only available to attendees with a confirmed seat,
            and to the Master Class speakers. If you have a confirmed seat, please open the
            page from the link in your confirmation email.
        </p>
    }
    else if (Model.View is not null)
    {
        <h1 style="margin:0 0 4px;">@Model.View.Title</h1>
        @* §451 (operator 2026-07-27): bold the VALUES, not the labels — the speaker name and the
           room are the two facts someone scans this header for. *@
        @if (Model.View.Speakers.Count > 0)
        {
            <p style="color:#555;margin:0 0 4px;">Presented by <strong>@string.Join(", ", Model.View.Speakers)</strong></p>
        }
        @if (!string.IsNullOrWhiteSpace(Model.View.Room))
        {
            <p style="color:#555;margin:0 0 12px;">Room: <strong>@Model.View.Room</strong></p>
        }

        @if (!string.IsNullOrEmpty(Model.Message))
        {
            <p role="status" style="background:#e6f4ea;border:1px solid #1c6b35;border-radius:6px;padding:10px 12px;">@Model.Message</p>
        }
        @if (!string.IsNullOrEmpty(Model.Error))
        {
            <p role="alert" style="background:#fdecea;border:1px solid #b3261e;border-radius:6px;padding:10px 12px;">@Model.Error</p>
        }

        <!-- ============ Orientation: what is a Master Class (standard copy) ============ -->
        @* Consolidated here (operator 2026-06-24): the "Master Class info & what to bring"
           details now live ON this Q&A page so attendees find everything in one place. *@
        <!-- ============ BOX 1 — generic intro (§383: copy unchanged, now its own card) ======= -->
        <section aria-labelledby="mc-about-h" style="@Box">
            <h2 id="mc-about-h" style="font-size:1.25rem;margin-top:0;">What is an Experts Live Master Class?</h2>
            <p>An Experts Live Master Class is a full-day, in-person learning event where people with a shared interest in a topic come together to learn from experienced professionals—mainly Microsoft MVPs and sometimes Microsoft itself.</p>
            <p>There isn't a strict definition of what makes up a master class. Our main goal is to create a room of peers and provide honest, practical insight — the "no filter" version of what works and what doesn't.</p>
            <p><strong>Key points:</strong></p>
            <ul style="margin:0 0 10px 18px;line-height:1.6;">
                <li>Open dialogue is encouraged — you can ask questions and challenge features.</li>
                <li>Speakers choose their own format.</li>
                <li>Some sessions include hands-on labs; others mix presentations and discussions.</li>
                <li>It's not meant to feel like traditional school despite the word "class."</li>
                <li>Asking questions is strongly encouraged, since much of the value comes from interaction.</li>
            </ul>
            <h3 style="font-size:1.05rem;margin:14px 0 4px;">Do I need to bring my laptop?</h3>
            <p>Many attendees bring a laptop to take notes and follow along. Your master class may require you to bring your laptop as outlined in the "Before you arrive" notes below.</p>
            <h3 style="font-size:1.05rem;margin:14px 0 4px;">Can I charge my laptop during the master class?</h3>
            <p>Due to Danish fire safety regulations, we cannot run charging cables along the classroom table rows. Each room has a charging table (up to 15 devices at once) for laptops or phones. For the best start, please arrive with your laptop fully charged.</p>
        </section>

        @*
            §266: "what to bring" (LogisticsText) and "How to prepare" (PrepContent) are two
            SEPARATE fields with separate editors. A speaker who filled only one used to see the
            OTHER section's "nothing posted yet" placeholder — reading as "nothing was added" even
            though they clearly added text. Fix: show a section only when it HAS content; show the
            "check back soon" placeholder ONCE, and only when BOTH are empty.
        *@
        <!-- ============ BOX 2 — everything the SPEAKERS authored (§383) =====================
             Renamed from "How to prepare" at the operator's request, and the two speaker-edited
             fields (§266 PrepContent + LogisticsText) are now ONE box: they are both "instructions
             from the speakers", and splitting them into two top-level sections was what made the
             page read as a wall of paragraphs. The §266 rule still holds INSIDE the box — a field
             with no content renders nothing, and the "check back soon" line appears once, only when
             BOTH are empty, so a speaker who filled one never sees the other's placeholder. -->
        <section aria-labelledby="prep-h" style="@Box">
            <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:baseline;justify-content:space-between;">
                <h2 id="prep-h" style="font-size:1.25rem;margin:0;">
                    Instructions from Master Class Speakers | How to prepare?
                </h2>
                <partial name="_McSubscribeToggle" model='new CommunityHub.Pages.McSubscribeToggle(
                    Model.SessionId, Model.Token,
                    CommunityHub.Core.Domain.MasterClassNotificationKind.SpeakerInstructions,
                    Model.SubscribedInstructions,
                    "E-mail me when the speakers update this")' />
            </div>

            @if (!string.IsNullOrWhiteSpace(Model.View.PrepContent))
            {
                <div style="white-space:pre-wrap;line-height:1.55;overflow-wrap:anywhere;">@Model.View.PrepContent</div>
                @if (Model.View.PrepUpdatedAt is { } pu)
                {
                    <p style="color:#888;font-size:.85rem;margin-top:8px;">Last updated @Stamp(pu)</p>
                }
            }

            @if (!string.IsNullOrWhiteSpace(Model.View.LogisticsText))
            {
                <h3 style="font-size:1.05rem;margin:18px 0 4px;">Before you arrive &mdash; what to bring</h3>
                <div style="white-space:pre-wrap;line-height:1.55;overflow-wrap:anywhere;">@Model.View.LogisticsText</div>
                @if (Model.View.LogisticsUpdatedAt is { } lu)
                {
                    <p style="color:#888;font-size:.85rem;margin-top:8px;">Last updated @Stamp(lu)</p>
                }
            }

            @if (string.IsNullOrWhiteSpace(Model.View.LogisticsText) && string.IsNullOrWhiteSpace(Model.View.PrepContent))
            {
                <p style="color:#374151;margin:0;">The speakers haven't posted specifics for this class yet — check back soon.</p>
            }
        </section>

        @* §136 (operator 2026-06-27): the attendee 1:1 "Ask the speakers (private)"
           section is removed. Attendees use the Group Q&A below — which is unique to
           THIS Master Class — and (coming via §137) the AiHelper assistant to reach
           the organizers. The 1:1 SessionQuestion data/history is kept; only the
           ability to create new 1:1 questions is gone. *@

        <!-- ============ Group Q&A — unique to THIS Master Class ============ -->
        <section aria-labelledby="qa-h" style="@Box">
            <div style="display:flex;flex-wrap:wrap;gap:10px;align-items:baseline;justify-content:space-between;">
                <h2 id="qa-h" style="font-size:1.25rem;margin:0;">Master Class Q&amp;A</h2>
                <partial name="_McSubscribeToggle" model='new CommunityHub.Pages.McSubscribeToggle(
                    Model.SessionId, Model.Token,
                    CommunityHub.Core.Domain.MasterClassNotificationKind.QandA,
                    Model.SubscribedQandA,
                    "E-mail me about new questions")' />
            </div>
            @* §450 (operator 2026-07-27): these two paragraphs were 4px apart, so they read as one
               run-on block. A normal paragraph gap separates them. *@
            <p style="color:#374151;margin:8px 0 12px;">
                This is the question board for <strong>@Model.View.Title</strong> only — it is
                shared with everyone in this Master Class and its speakers. Each Master Class has
                its own separate board, so what you post here stays with this class.
            </p>
            <p style="color:#374151;margin:0 0 8px;">
                Post your questions here so the speakers and your fellow attendees can see and
                answer them. To reach the organizers privately, please
                <a href="/Contact">contact the organizers</a>.
            </p>

            <form method="post" asp-page-handler="Comment" asp-route-sessionId="@Model.SessionId" asp-route-t="@Model.Token">
                <label for="cbody" style="display:block;font-weight:600;margin-bottom:4px;">Add a question or comment</label>
                <textarea id="cbody" name="CommentBody" rows="2" required maxlength="2000"
                          style="width:100%;box-sizing:border-box;padding:8px;border:1px solid #ccc;border-radius:6px;"></textarea>
                <button type="submit" style="margin-top:8px;background:#34507a;color:#fff;border:0;border-radius:6px;padding:10px 18px;font-weight:600;">Post comment</button>
            </form>

            @if (Model.Comments.Count == 0)
            {
                <p style="color:#374151;margin-top:12px;">No comments yet — start the conversation.</p>
            }
            else
            {
                <ul style="list-style:none;padding:0;margin:14px 0 0;">
                    @foreach (var c in Model.Comments)
                    {
                        <li style="border:1px solid #e3e3e3;border-radius:8px;padding:10px 12px;margin-bottom:8px;@(c.ParentCommentId is null ? "" : "margin-left:20px;")">
                            @* §383: show the poster's ROLE after their name, so an answer from a
                               speaker is distinguishable from a fellow attendee's at a glance.
                               Derived from WHICH author column is set — the two are mutually
                               exclusive by construction (AddAttendeeCommentAsync vs
                               AddParticipantCommentAsync), so no extra column or join is needed. *@
                            <div style="font-weight:600;">
                                @c.AuthorDisplayName
                                <span style="font-weight:500;font-size:.8rem;color:#fff;background:@(c.AuthorAttendeeId is not null ? "#5b6b8c" : "#1c6b35");border-radius:999px;padding:1px 8px;margin-left:6px;vertical-align:middle;">
                                    @(c.AuthorAttendeeId is not null ? "Attendee" : "Speaker")
                                </span>
                            </div>
                            <div style="white-space:pre-wrap;">@c.Body</div>
                            <div style="color:#888;font-size:.8rem;margin-top:4px;">@Stamp(c.CreatedAt)</div>
                        </li>
                    }
                </ul>
            }
        </section>
    }
</div>
