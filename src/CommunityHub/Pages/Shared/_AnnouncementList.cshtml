@model IReadOnlyList<CommunityHub.Core.Integrations.SoMeAnnouncement>

@* §837/§838 — one renderer for a list of announcements, shared by the sponsor and speaker pages.
   Deliberately shared: two copies of "how a post is previewed" would drift, and the copy that
   drifted would be the one an external audience reads. *@

@if (Model.Count == 0)
{
    <p class="muted">Nothing scheduled here yet.</p>
}
else
{
    @foreach (var post in Model)
    {
        <div style="border-left:3px solid #ddd;padding:8px 0 8px 12px;margin-bottom:16px;">
            <div style="display:flex;gap:8px;align-items:baseline;flex-wrap:wrap;">
                @* §844.5 — Danish local time, Danish date order. Storage stays UTC. *@
                <strong>@CommunityHub.Core.Integrations.SoMeDisplayTime.DayHeading(post.ScheduledAtUtc)</strong>
                <span class="muted">@CommunityHub.Core.Integrations.SoMeDisplayTime.Time(post.ScheduledAtUtc)</span>
                <span class="set-tag opt">@post.KindLabel</span>
                @* §916 — the MEDIUM, stated on every row. Operator 2026-08-06: *"it must add a
                   preview of the post + date & time + media = LinkedIn"*. A speaker or sponsor
                   reading "we will publish this about you" has to know WHERE: the answer is the
                   event's LinkedIn company page, and it is the same for every post here. *@
                <span class="set-tag opt">in LinkedIn</span>
                @* §916 — the STATE, on every row. Operator 2026-08-06: *"also include the state of
                   the post (planned/scheduled)"*. Nothing is auto-approved (§824.8 Q2), so most of
                   these are "planned" and saying so is what stops the date reading as a promise. *@
                <span class="set-tag @(post.IsPublished ? "on" : post.IsApproved ? "on" : "opt")">@post.State</span>
            </div>

            <div style="margin-top:6px;white-space:pre-wrap;">@post.PreviewText</div>

            @* 🔴 §1032 — SHOW THE PICTURE, not its file name. Operator 2026-08-10: the card printed
               `sponsor-12.png` where the image belongs, which tells an external audience nothing
               about what we are about to publish about them — and a preview is the one thing this
               page exists to give them.
               🔒 The bytes come through /some-post-media, which re-checks that this post is on THIS
               participant's own page: their browser has no SharePoint permission, and the organizer
               proxy is organizer-only by design.
               ⚠️ onerror hides the frame rather than leaving a browser's broken-image glyph — an
               unreachable library must degrade to "no picture", not to visible breakage. *@
            @if (!string.IsNullOrWhiteSpace(post.ImageRef))
            {
                var mediaUrl = $"/some-post-media/{post.PostId}";
                <div style="margin-top:8px;">
                    @if (post.MediaKind == CommunityHub.Core.Domain.SoMePostMediaKind.Video)
                    {
                        <video src="@mediaUrl" controls preload="metadata"
                               style="max-width:100%;width:420px;border-radius:8px;border:1px solid #e5e7eb;"
                               onerror="this.parentElement.style.display='none';">
                        </video>
                    }
                    else
                    {
                        @* Mobile-first: full width on a phone, capped on a desktop. *@
                        <img src="@mediaUrl" alt="Preview of the picture for this post" loading="lazy"
                             style="max-width:100%;width:420px;height:auto;display:block;
                                    border-radius:8px;border:1px solid #e5e7eb;"
                             onerror="this.parentElement.style.display='none';" />
                    }
                </div>
            }

            @* 🔴 §916 — WHAT IT IS STILL WAITING FOR. Operator 2026-08-06: *"and any missing
               depencies (blockers)"*. The sentence comes from SoMeApprovalGate — the SAME one the
               organizer reads — so a sponsor is told "we are waiting for your logo" on their own
               page instead of wondering why their post is not scheduled. *@
            @if (!string.IsNullOrWhiteSpace(post.Blocker))
            {
                <div style="margin-top:6px;color:#92400e;background:#fffbeb;border:1px solid #fde68a;
                            border-radius:6px;padding:6px 8px;font-size:13px;" role="status">
                    ⏳ Waiting on: @post.Blocker
                </div>
            }

            @* 🔒 §824.14c — the honest line about tagging. CEH names people in the TEXT; it cannot
               @-mention an external speaker (no member URN is obtainable) and the sponsor company-id
               lookup is refused even for our own org. A preview implying a real LinkedIn mention
               would promise a notification that never arrives.
               🔴 §1032 — the SPONSOR page suppresses it. Operator 2026-08-10 called
               "Mentions the organizers by name…" *"not relevant"* there, and he is right: it is
               LinkedIn mechanics about the ORGANIZERS, on a page about the sponsor. The line stays
               for speakers, where it is about the people the post actually names. *@
            @if (ViewData["HideMentionLine"] as bool? != true)
            {
                <div class="muted" style="margin-top:4px;">@post.MentionLine</div>
            }
        </div>
    }
}
