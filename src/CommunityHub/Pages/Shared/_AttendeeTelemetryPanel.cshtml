@model CommunityHub.Pages.Shared.AttendeeTelemetryPanelModel
@*
    Shared attendee-telemetry panel (§55). Renders the SAME ranked breakdown tables
    + headline metrics + sales-over-time graph + segment / topic-filter dropdowns for
    all three hosts:
      • public anonymous  /attendee-telemetry
      • sponsor (in-area)  /Sponsor/Telemetry   (Sponsor role)
      • organizer          /Organizer/Telemetry  (Organizer role)
    Each host supplies an AttendeeTelemetry (from AttendeeTelemetryService) + the
    segment list; this partial owns the markup so the three never drift apart.

    The filter form is method="get" with no action, so it posts back to whatever
    page hosts the partial (the host page binds Segment/FilterKey/FilterValue from
    the query string and re-queries) — identical behaviour on all three routes.
*@
@functions {
    // A ranked table: # · full label (wraps, never truncated) · count · share bar.
    static string RankedTable(IReadOnlyList<CommunityHub.Core.Integrations.TelemetrySlice> s)
    {
        if (s is null || s.Count == 0) return "<p class=\"info\">No data yet.</p>";
        var total = System.Linq.Enumerable.Sum(s, x => x.Count);
        var max = System.Linq.Enumerable.Max(s, x => x.Count);
        var sb = new System.Text.StringBuilder("<table class=\"tl-table\"><tbody>");
        // §162: no rank column — it read as a duplicate count (rank "1" next to count "1").
        // One count per row: label + share bar, then the count and %.
        foreach (var x in s)
        {
            var barPct = max > 0 ? (int)System.Math.Round(100.0 * x.Count / max) : 0;
            var sharePct = total > 0 ? System.Math.Round(100.0 * x.Count / total, 1) : 0;
            sb.Append($"<tr>"
                + $"<td class=\"tl-lbl\">{System.Net.WebUtility.HtmlEncode(x.Label)}"
                + $"<span class=\"tl-bar\"><span class=\"tl-fill\" style=\"width:{barPct}%\"></span></span></td>"
                + $"<td class=\"tl-num\">{x.Count}</td>"
                + $"<td class=\"tl-pct\">{sharePct}%</td></tr>");
        }
        sb.Append("</tbody></table>");
        return sb.ToString();
    }
}

<style>
    .tl-wrap { max-width:960px; margin:0 auto; }
    .tl-controls { display:flex; flex-wrap:wrap; gap:10px; align-items:center; justify-content:center; margin:6px 0 14px; }
    .tl-print-title { display:none; }   /* shown only in print (see global @@media print) */
    .tl-controls select { padding:8px 10px; border:1px solid #c4c8d4; border-radius:8px; font-size:14px; min-width:260px; }
    .tl-metrics { display:grid; grid-template-columns:1fr; gap:12px; margin:0 0 18px; }
    @@media (min-width:620px) { .tl-metrics { grid-template-columns:repeat(3,1fr); } }
    .tl-metric { background:#f7f9fc; border:1px solid #e6eaf2; border-radius:10px; padding:12px; text-align:center; }
    .tl-metric .v { font-size:30px; font-weight:800; color:var(--el-darkblue,#1D3380); line-height:1; }
    .tl-metric .k { color:#6b7280; font-size:12.5px; margin-top:4px; }
    /* §1067 — the headline count. Mobile-first: 46px at ~360px so it still fits one line, stepping
       up on a wider screen. Deliberately larger and darker than the three percentage cards — it is
       the number he is watching during a sale, and the one the other three are proportions of. */
    .tl-headline { background:#f7f9fc; border:1px solid #e6eaf2; border-radius:10px;
                   padding:16px 12px; text-align:center; margin:0 0 12px; }
    .tl-headline .v { font-size:46px; font-weight:800; color:var(--el-darkblue,#1D3380);
                      line-height:1; letter-spacing:-1px; }
    .tl-headline .k { color:#6b7280; font-size:13.5px; margin-top:6px; text-transform:uppercase;
                      letter-spacing:.06em; font-weight:600; }
    @@media (min-width:620px) { .tl-headline .v { font-size:62px; } }
    .tl-graph { display:flex; align-items:flex-end; gap:2px; height:120px; padding:8px 0; border-bottom:1px solid #e6eaf2; overflow-x:auto; }
    .tl-gbar { flex:0 0 8px; background:var(--el-blue,#008BD2); border-radius:2px 2px 0 0; min-height:2px; }
    /* 🔴 §1052 — EACH TOPIC IS ITS OWN BLOCK. Operator 2026-08-10: "make more space after each
       topic, as it is hard to separate them apart - or make - like does this belong to text
       above?". With a flat 16px gap and no boundary, a heading in the left column sat closer to
       the PRECEDING card's last row than to its own table, so the eye grouped them wrongly — and
       a page whose whole job is reading numbers off labels cannot afford that ambiguity.
       ⇒ A framed card plus a bigger ROW gap (row > column, because the columns are already
       separated by the fold between them). */
    .tl-grid { display:grid; gap:22px 18px; grid-template-columns:1fr; margin-top:18px; }
    @@media (min-width:760px) { .tl-grid { grid-template-columns:1fr 1fr; } }
    .tl-card { border:1px solid #e6eaf2; border-radius:10px; padding:12px 14px; background:#fff; }
    .tl-card h3 { margin:0 0 10px; font-size:15.5px; color:var(--el-darkblue,#1D3380);
                  padding-bottom:8px; border-bottom:1px solid #eef1f6; }
    .tl-table { width:100%; border-collapse:collapse; font-size:13.5px; }
    .tl-table td { padding:5px 6px; vertical-align:top; border-bottom:1px solid #f0f2f6; }
    .tl-rank { color:#9aa0aa; width:1%; white-space:nowrap; font-variant-numeric:tabular-nums; }
    .tl-lbl { color:#374151; word-break:break-word; }   /* full text, wraps, never cut off */
    .tl-bar { display:block; height:6px; margin-top:4px; background:#eef2f7; border-radius:999px; overflow:hidden; }
    .tl-fill { display:block; height:100%; background:var(--el-blue,#008BD2); border-radius:999px; }
    .tl-num { font-weight:700; color:#1f2430; text-align:right; white-space:nowrap; width:1%; font-variant-numeric:tabular-nums; }
    .tl-pct { color:#6b7280; text-align:right; white-space:nowrap; width:1%; font-variant-numeric:tabular-nums; }
    .tl-foot { color:#9aa0aa; font-size:12px; text-align:center; margin-top:18px; }
</style>

@if (Model.Data is null)
{
    <p class="info" style="text-align:center;">Live attendee numbers aren't available right now — please check back shortly.</p>
}
else
{
    var dims = Model.Data.FilterDimensions ?? new List<CommunityHub.Core.Integrations.TelemetryFilterDimension>();
    var sel = dims.FirstOrDefault(d => d.Key == Model.Data.FilterKey);
    @* §298: "Save as PDF" — opens the browser print dialog on a print-styled view (chrome hidden by
       the global @@media print rules), so the current status can be saved/shared as a PDF. *@
    <div class="tl-actions no-print" style="text-align:center;margin:2px 0 12px;">
        <button type="button" onclick="window.print()"
                style="background:var(--el-blue);color:#fff;border:0;padding:9px 18px;border-radius:8px;font-size:14px;cursor:pointer;">
            &#128196; Save as PDF
        </button>
    </div>
    <p class="tl-print-title">Attendee telemetry — current status</p>
    <form method="get" class="tl-controls">
        <label for="segment" style="font-size:13px;color:#4b5563;">Segment:</label>
        <select id="segment" name="segment" onchange="this.form.submit()">
            @foreach (var s in Model.Segments)
            {
                <option value="@s.Key" selected="@(s.Key == Model.Data.SegmentKey)">@s.Label</option>
            }
        </select>

        @* The topic "Filter by" dropdown was removed (operator 2026-06-28): segment selection
           stays; the per-dimension topic filter is gone. *@
        <noscript><button type="submit">Apply</button></noscript>
    </form>

    @* §181: EVERY headline stat card shows a PERCENTAGE (of all attendees), never a raw count.
       With no attendees the denominator is 0, so we render "—" instead of "0%". *@
    var hasAttendees = Model.Data.TotalAll > 0;
    Func<int, string> pctCard = p => hasAttendees ? $"{p}%" : "—";
    @* 🔴 §1067 — THE COUNT ITSELF, and bigger than the rest. Operator 2026-08-11: *"extra big number
       here - attendee count"*.
       ⚠️ This RELAXES §181 ("every headline card is a PERCENTAGE, never a raw count") — deliberately,
       and it costs nothing that rule was protecting: the breakdown tables below already print raw
       counts (30, 18, …) on the public and sponsor pages, so the absolute figure was never secret.
       What §181 actually prevented was a row of bare numbers with no denominator; that still holds,
       because this card IS the denominator the other three are percentages OF. Showing it makes the
       row easier to read, not looser. *@
    <div class="tl-headline">
        <div class="v">@(hasAttendees ? Model.Data.TotalAll.ToString() : "—")</div>
        <div class="k">attendees registered</div>
    </div>

    <div class="tl-metrics">
        <div class="tl-metric"><div class="v">@pctCard(Model.Data.Pct2DayAll)</div><div class="k">bought a 2-day ticket</div></div>
        <div class="tl-metric"><div class="v">@pctCard(Model.Data.WordOfMouthPct)</div><div class="k">heard via word of mouth</div></div>
        <div class="tl-metric"><div class="v">@pctCard(Model.Data.FirstTimerPct)</div><div class="k">first-timers (ELDK27 is their first)</div></div>
    </div>

    <div class="tl-grid">
        @* §69 — organizer-only tables (e.g. "Top companies") never render on the
           public / sponsor surfaces. *@
        @foreach (var table in Model.Data.Tables.Where(t => Model.IsOrganizer || !t.OrganizerOnly))
        {
            <div class="tl-card">
                <h3>@table.Title</h3>
                @Html.Raw(RankedTable(table.Slices))
            </div>
        }
    </div>

    @* §162: the "Tickets sold per day" timeline moved to the BOTTOM (below the breakdown tables). *@
    @if (Model.Data.Daily.Count > 0)
    {
        var gmax = System.Linq.Enumerable.Max(Model.Data.Daily, d => d.Count);
        <h3 style="font-size:15px;color:var(--el-darkblue);margin:18px 0 4px;">Tickets sold per day</h3>
        <div class="tl-graph">
            @foreach (var d in Model.Data.Daily)
            {
                var h = gmax > 0 ? (int)System.Math.Round(100.0 * d.Count / gmax) : 0;
                <span class="tl-gbar" style="height:@(h)%" title="@d.Day.ToString("d MMM yyyy"): @d.Count (running @d.Cumulative)"></span>
            }
        </div>
        <p style="font-size:12px;color:#6b7280;margin:4px 0 0;">@Model.Data.Daily[0].Day.ToString("d MMM yyyy") – @Model.Data.Daily[^1].Day.ToString("d MMM yyyy") · running total @Model.Data.Daily[^1].Cumulative.ToString("N0")</p>
    }

    @* §69 — drop the "Aggregate figures from Zoho Backstage ·" prefix (don't expose the source system).
       §127 — "Updated" is the last-successful-SYNC time (when the mirror was refreshed), not the
       wall-clock the page rendered; fall back to render time only if the edition was never synced. *@
    @* §1063 — say WHEN THE NEXT ONE IS DUE, not just when the last one was. Operator 2026-08-11:
       *"we need to show that in the footer, so people can see next refresh time - it shows only
       Updated 11 Aug 2026 06:14 UTC"*. A lone "Updated" timestamp leaves the reader to guess whether
       a number is stale or simply unchanged.
       🔒 The cadence is READ from the job's configuration (see AttendeeTelemetry.RefreshEveryMinutes),
       never typed here — a hard-coded "10 minutes" becomes a lie the moment he changes the interval.
       ⚠️ "next ≈" with a tilde on purpose: the run is a timer the host may serve a little late, so an
       exact-looking time would be a promise the system cannot keep. *@
    var updatedAt = Model.Data.LastSyncAtUtc ?? Model.Data.GeneratedAtUtc;
    var every = Model.Data.RefreshEveryMinutes;
    <p class="tl-foot">
        Updated @updatedAt.ToString("d MMM yyyy HH:mm 'UTC'")
        @if (every is int m && m > 0)
        {
            @:· refreshes every @m minute@(m == 1 ? "" : "s") · next ≈ @updatedAt.AddMinutes(m).ToString("HH:mm 'UTC'")
        }
    </p>
}
