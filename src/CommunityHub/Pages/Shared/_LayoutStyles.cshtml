    <style>
        /* Experts Live brand palette:
             --el-darkblue #1D3380  -- header background, headings
             --el-blue     #008BD2  -- accent, buttons, links
             --el-grey     #E3E3E3  -- page background / dividers   */
        :root {
            color-scheme: light;
            --el-darkblue: #1D3380;
            --el-blue:     #008BD2;
            --el-grey:     #E3E3E3;
        }
        body {
            font-family: system-ui, -apple-system, "Segoe UI", sans-serif;
            margin: 0; background: var(--el-grey); color: #1a1a2e;
            line-height: 1.5;
        }
        /* Visible keyboard focus on every interactive element (WCAG 2.4.7).
           :focus-visible keeps the ring for keyboard users without drawing it
           on mouse clicks, so the existing look is untouched for pointer use. */
        a:focus-visible, button:focus-visible, input:focus-visible,
        select:focus-visible, textarea:focus-visible, summary:focus-visible,
        [tabindex]:focus-visible {
            outline: 3px solid var(--el-blue);
            outline-offset: 2px;
            border-radius: 4px;
        }
        /* Skip-to-content link: off-screen until focused, then pinned top-left
           so a keyboard/screen-reader user can jump past the header + nav. */
        .skip-link {
            position: absolute; left: 8px; top: -48px;
            background: var(--el-darkblue); color: #fff;
            padding: 10px 16px; border-radius: 0 0 8px 8px;
            text-decoration: none; font-weight: 600; z-index: 1000;
            transition: top .15s ease;
        }
        .skip-link:focus { top: 0; color: #fff; }
        /* Screen-reader-only text: present in the accessibility tree, not on screen. */
        .visually-hidden {
            position: absolute !important; width: 1px; height: 1px;
            padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0);
            white-space: nowrap; border: 0;
        }
        /* §354 (operator 2026-07-26): "it would be nice to show an indicator in the menu for any
           page that opens up a SEPARATE page … this should reflect for ALL roles / all pages".
           ↗ is the conventional glyph for "opens elsewhere". Rendered aria-hidden BESIDE the
           existing screen-reader-only "opens in a new tab" text, so the meaning reaches sighted
           and assistive users without being announced twice. Driven purely by NavItem.External,
           so every role — and every future external leaf — gets it automatically. */
        .ext-ico {
            font-size: .78em; line-height: 1; margin-left: .32em;
            opacity: .72; vertical-align: baseline;
        }
        header {
            background: var(--el-darkblue); color: #fff;
            padding: 14px 20px;
            display: flex; align-items: center; gap: 20px;
            flex-wrap: wrap;
            border-bottom: 4px solid var(--el-blue);
            justify-content: center;     /* center the logo pair */
            position: relative;          /* user-tools floats right via abs pos */
        }
        /* Thin announcement bar above the logo header -- ticket-sale info
           + event-site button, visible to everyone (anonymous + logged-in). */
        .topbar {
            background: var(--el-blue); color: #fff;
            padding: 8px 20px;
            font-size: 13px;
            display: flex; align-items: center; justify-content: center;
            gap: 16px; flex-wrap: wrap; text-align: center;
        }
        .topbar .ticket-info { font-weight: 600; }

        /* §1003 — the segmented event countdown ("183 DAYS | 22 HOURS | …"), his mock-up.
           Mobile-first: the segments wrap on ~360px rather than shrinking the digits, and the
           whole block sits in the existing flex topbar which already wraps. */
        .ceh-countdown { display:flex; align-items:center; gap:10px; flex-wrap:wrap; font-weight:600; }
        .ceh-countdown .cd-label { white-space:nowrap; }
        .ceh-countdown .cd-seg {
            display:flex; flex-direction:column; align-items:center; line-height:1.05;
            padding:0 10px; border-left:1px solid rgba(255,255,255,.35);
        }
        /* The first segment has no divider — a leading rule reads as a cut-off column. */
        .ceh-countdown .cd-seg:first-of-type { border-left:0; padding-left:0; }
        .ceh-countdown .cd-seg b { font-size:1.15rem; font-variant-numeric:tabular-nums; }
        /* tabular-nums stops the row jittering every second as digit widths change. */
        .ceh-countdown .cd-seg i {
            font-style:normal; font-size:.62rem; letter-spacing:.08em; opacity:.85;
        }
        @@media (max-width: 480px) {
            .ceh-countdown { gap:6px; }
            .ceh-countdown .cd-seg { padding:0 6px; }
            .ceh-countdown .cd-seg b { font-size:1rem; }
        }
        /* When the ticket banner is a link (sale open + ticketUrl set) it uses
           the same .ticket-info class but is an <a>: keep it readable on the
           blue bar (white, underlined) instead of inheriting default link blue.
           No fixed height — the bar already wraps on ~360px via flex-wrap. */
        .topbar a.ticket-info { color: #fff; text-decoration: underline; }
        .topbar a.ticket-info:hover { text-decoration: none; }
        .topbar a.eventsite-btn {
            display: inline-block;
            background: #fff; color: var(--el-darkblue);
            padding: 4px 14px; border-radius: 999px;
            font-weight: 700; font-size: 12.5px;
            text-decoration: none; white-space: nowrap;
        }
        .topbar a.eventsite-btn:hover { background: var(--el-grey); }
        header .brand img { height: 56px; display: block; }
        header .product-mark {
            font-size: 30px; font-weight: 700; letter-spacing: .01em;
            color: #fff; white-space: nowrap;
        }
        header .titles { flex: 1 1 220px; min-width: 0; display: flex;
            align-items: baseline; gap: 16px; }
        header h1 { margin: 0; font-size: 22px; font-weight: 600;
            opacity: 1; white-space: nowrap; overflow: hidden;
            text-overflow: ellipsis; }
        header .user-tools { display: flex; align-items: center; gap: 10px;
            font-size: 13px; flex: 0 0 auto;
            position: absolute; right: 16px; top: 50%; transform: translateY(-50%); }
        header .user-tools .who { opacity: .85; white-space: nowrap; }
        @@media (max-width: 700px) {
            /* Stack the header on mobile and drop the user-tools out of absolute
               positioning (it otherwise floats OVER the centred logo and hides the
               Sign-out button). Put it in normal flow, centred below the logo. */
            header { flex-direction: column; gap: 10px; }
            header .user-tools {
                position: static; transform: none; right: auto; top: auto;
                width: 100%; flex-basis: 100%;
                justify-content: center; flex-wrap: wrap;
                margin: 4px 0 0; gap: 8px;
            }
        }
        header .user-tools form { margin: 0; }
        header .user-tools button.signout {
            background: transparent; color: #fff;
            border: 1px solid rgba(255,255,255,.6);
            padding: 6px 12px; border-radius: 6px; font-size: 13px;
        }
        header .user-tools button.signout:hover {
            background: rgba(255,255,255,.12);
        }
        /* §283: the signed-in NAME as a dropdown (My Hub Profile + Sign out). Native
           <details>/<summary>, no JS. Summary sits on the dark header; the panel is a light
           card floating under it (right-aligned so it never overflows the viewport edge). */
        details.user-menu { position: relative; display: inline-block; }
        details.user-menu > summary {
            list-style: none; cursor: pointer; user-select: none;
            display: inline-flex; align-items: center; gap: 8px;
            padding: 6px 12px; border-radius: 6px; font-size: 13px; color: #fff;
            border: 1px solid rgba(255,255,255,.6); background: transparent; white-space: nowrap;
        }
        details.user-menu > summary::-webkit-details-marker { display: none; }
        details.user-menu > summary:hover { background: rgba(255,255,255,.12); }
        details.user-menu[open] > summary { background: rgba(255,255,255,.15); }
        .user-menu-caret { font-size: 11px; opacity: .85; transition: transform .15s ease; }
        details.user-menu[open] .user-menu-caret { transform: rotate(180deg); }
        .user-menu-items {
            position: absolute; right: 0; top: calc(100% + 6px); z-index: 60;
            min-width: 210px; display: flex; flex-direction: column;
            background: #fff; border: 1px solid #c4c8d4; border-radius: 8px;
            padding: 6px; box-shadow: 0 6px 18px rgba(0,0,0,.2);
        }
        .user-menu-items a {
            display: block; padding: 9px 12px; border-radius: 6px;
            text-decoration: none; color: var(--el-darkblue); font-size: 14px; font-weight: 500;
        }
        .user-menu-items a:hover { background: var(--el-grey); }
        .user-menu-items form { margin: 4px 0 0; border-top: 1px solid #e6eaf2; padding-top: 4px; }
        /* §385 (operator 2026-07-26: "for all roles: i'm missing a logout feature here").
           Sign out was NOT missing — it was INVISIBLE. `header .user-tools button.signout` sets
           color:#fff, from when Sign out sat directly on the DARK header; §283 moved it into this
           dropdown, whose panel is WHITE, and that older rule OUT-SPECIFIES this one
           (0,2,2 beats 0,2,1) — so every role got white text on a white panel. Qualified with the
           header/user-tools ancestors so this wins (0,3,2), rather than reaching for !important,
           which would only move the collision somewhere harder to find. */
        header .user-tools .user-menu-items button.signout {
            width: 100%; text-align: left; background: transparent; color: var(--el-darkblue);
            border: 0; padding: 9px 12px; border-radius: 6px; font-size: 14px; font-weight: 500; cursor: pointer;
        }
        header .user-tools .user-menu-items button.signout:hover { background: var(--el-grey); }
        @@media (max-width: 700px) {
            /* Header is centred + stacked on phones; keep the panel from spilling off-screen. */
            details.user-menu { display: block; }
            .user-menu-items { right: auto; left: 50%; transform: translateX(-50%); }
        }
        nav.primary {
            background: #fff; border-bottom: 1px solid #d6d8e0;
            padding: 6px 24px; display: flex; flex-wrap: wrap; gap: 4px;
        }
        nav.primary a {
            display: inline-block; padding: 8px 14px; border-radius: 6px;
            text-decoration: none; color: var(--el-darkblue);
            font-size: 14px; font-weight: 500;
        }
        nav.primary a:hover { background: var(--el-grey); }
        nav.primary a.active,
        nav.primary a[aria-current="page"] { background: var(--el-darkblue); color: #fff; }
        /* Participant-nav named section (e.g. the speaker "Speaker" group): a
           native <details>/<summary> disclosure inside the primary bar so the
           long speaker nav is grouped, not one flat list. No JS, keyboard-
           operable. On desktop the panel floats under the toggle (like the
           organizer menu); on phone it flows inline full-width. */
        details.nav-section { position: relative; display: inline-block; }
        details.nav-section > summary {
            list-style: none; cursor: pointer; user-select: none;
            display: inline-flex; align-items: center; gap: 6px;
            padding: 8px 14px; border-radius: 6px;
            color: var(--el-darkblue); font-size: 14px; font-weight: 600;
        }
        details.nav-section > summary::-webkit-details-marker { display: none; }
        details.nav-section > summary:hover { background: var(--el-grey); }
        details.nav-section[open] > summary { background: var(--el-grey); }
        /* Current-section indicator on the CLOSED summary (the dropdown no longer
           auto-opens; it's an absolute overlay that would cover the page). */
        details.nav-section.is-active > summary { background: var(--el-grey); box-shadow: inset 0 -2px 0 var(--el-darkblue); }
        .nav-section-caret { transition: transform .15s ease; font-size: 11px; opacity: .7; }
        details.nav-section[open] .nav-section-caret { transform: rotate(180deg); }
        .nav-section-items {
            display: flex; flex-direction: column; gap: 2px;
            position: absolute; left: 0; top: calc(100% + 4px); z-index: 50;
            min-width: 220px; max-height: 70vh; overflow-y: auto;
            background: #fff; border: 1px solid #c4c8d4; border-radius: 8px;
            padding: 6px; box-shadow: 0 6px 18px rgba(0,0,0,.14);
        }
        .nav-section-items a {
            display: block; padding: 8px 12px; border-radius: 6px;
            text-decoration: none; color: var(--el-darkblue);
            font-size: 14px; font-weight: 500; white-space: nowrap;
        }
        .nav-section-items a:hover { background: var(--el-grey); }
        .nav-section-items a[aria-current="page"] { background: var(--el-darkblue); color: #fff; }
        /* §297: a NESTED sub-fold-out inside a nav section (e.g. Event Info -> Policies -> CoC + Privacy). */
        details.nav-subsection { display: block; margin-top: 2px; }
        details.nav-subsection > summary {
            list-style: none; cursor: pointer; user-select: none;
            display: flex; align-items: center; justify-content: space-between; gap: 6px;
            padding: 8px 12px; border-radius: 6px;
            color: var(--el-darkblue); font-size: 13.5px; font-weight: 600;
        }
        details.nav-subsection > summary::-webkit-details-marker { display: none; }
        details.nav-subsection > summary:hover { background: var(--el-grey); }
        details.nav-subsection[open] > summary { background: var(--el-grey); }
        details.nav-subsection[open] .nav-section-caret { transform: rotate(180deg); }
        .nav-subsection-items { display: flex; flex-direction: column; gap: 2px; padding-left: 10px; }
        .nav-subsection-items a {
            display: block; padding: 8px 12px; border-radius: 6px;
            text-decoration: none; color: var(--el-darkblue); font-size: 14px; font-weight: 500; white-space: nowrap;
        }
        .nav-subsection-items a:hover { background: var(--el-grey); }
        .nav-subsection-items a[aria-current="page"] { background: var(--el-darkblue); color: #fff; }

        /* §484 — Zoho Backstage interstitial. [hidden] must WIN over the flex display,
           or the dialog would render over every page on load. */
        .zoho-interstitial {
            position: fixed; inset: 0; z-index: 1000; display: flex;
            align-items: center; justify-content: center; padding: 16px;
            background: rgba(15, 23, 42, .55);
        }
        .zoho-interstitial[hidden] { display: none; }
        .zoho-interstitial-card {
            background: #fff; border-radius: 12px; padding: 22px 24px;
            max-width: 560px; width: 100%; max-height: 90vh; overflow-y: auto;
            box-shadow: 0 18px 48px rgba(15, 23, 42, .28);
        }
        .zoho-interstitial-card h2 { margin: 0 0 12px; font-size: 19px; color: var(--el-darkblue); }
        .zoho-interstitial-card p { margin: 0 0 12px; font-size: 14.5px; line-height: 1.6; color: #334155; }
        .zoho-interstitial-hide {
            display: flex; align-items: center; gap: 8px;
            margin: 14px 0 4px; font-size: 13.5px; color: #475569; cursor: pointer;
        }
        .zoho-interstitial-hide input { width: 16px; height: 16px; margin: 0; }
        .zoho-interstitial-actions {
            display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end; margin-top: 16px;
        }
        @@media (max-width: 700px) {
            details.nav-section { display: block; }
            details.nav-section > summary { display: flex; justify-content: space-between; }
            .nav-section-items {
                position: static; min-width: 0; width: 100%;
                box-shadow: none; margin-top: 4px; max-height: none;
            }
        }
        /* Second-level management bar: a distinct strip below the participant
           nav so organizer tools read as a separate group, not mixed in. */
        nav.manage-bar {
            background: #eef0f6; border-bottom: 1px solid #d6d8e0;
            padding: 6px 24px;
        }
        /* Organizer-area dropdown (native <details>/<summary> — no JS). */
        details.org-menu { position: relative; display: inline-block; }
        details.org-menu > summary {
            list-style: none; cursor: pointer; user-select: none;
            display: inline-flex; align-items: center; gap: 6px;
            padding: 7px 14px; border-radius: 6px;
            color: var(--el-darkblue); font-size: 14px; font-weight: 600;
            background: #fff; border: 1px solid #c4c8d4;
        }
        details.org-menu > summary::-webkit-details-marker { display: none; }
        details.org-menu > summary:hover { background: var(--el-grey); }
        details.org-menu[open] > summary {
            background: var(--el-darkblue); color: #fff; border-color: var(--el-darkblue);
        }
        .org-menu-caret { transition: transform .15s ease; font-size: 11px; }
        details.org-menu[open] .org-menu-caret { transform: rotate(180deg); }
        /* Desktop: float the items as a panel under the toggle. */
        .org-menu-items {
            display: flex; flex-direction: column; gap: 2px;
            position: absolute; left: 0; top: calc(100% + 4px); z-index: 50;
            min-width: 220px; max-height: 70vh; overflow-y: auto;
            background: #fff; border: 1px solid #c4c8d4; border-radius: 8px;
            padding: 6px; box-shadow: 0 6px 18px rgba(0,0,0,.14);
        }
        .org-menu-items a {
            display: block; padding: 8px 12px; border-radius: 6px;
            text-decoration: none; color: var(--el-darkblue);
            font-size: 14px; font-weight: 500; white-space: nowrap;
        }
        .org-menu-items a:hover { background: var(--el-grey); }
        .org-menu-items a[aria-current="page"] { background: var(--el-darkblue); color: #fff; }
        /* REQUIREMENTS §21 — nested, collapsible section sub-groups inside the
           organizer menu (People / Sessions / Comms / Sponsors / Volunteers /
           Logistics). Native <details>/<summary>: no JS, keyboard-operable, a
           labelled disclosure per group. The leading prominent links (Organizer
           home / Command center / Dashboard) render before the first section, so a
           thin divider above the first section separates them. */
        .org-section { display: block; }
        .org-section + .org-section { margin-top: 2px; }
        .org-menu-items > .org-section:first-of-type {
            margin-top: 6px; padding-top: 6px; border-top: 1px solid #e1e3ec;
        }
        .org-section > summary {
            list-style: none; cursor: pointer; user-select: none;
            display: flex; align-items: center; justify-content: space-between;
            gap: 8px; padding: 7px 12px; border-radius: 6px;
            color: var(--el-darkblue); font-size: 12.5px; font-weight: 700;
            text-transform: uppercase; letter-spacing: .03em;
        }
        .org-section > summary::-webkit-details-marker { display: none; }
        .org-section > summary:hover { background: var(--el-grey); }
        .org-section-caret { transition: transform .15s ease; font-size: 10px; opacity: .7; }
        .org-section[open] > summary > .org-section-caret { transform: rotate(180deg); }
        /* Section links sit slightly indented so they read as children of the
           group heading above them. */
        .org-section-items { display: flex; flex-direction: column; gap: 2px; padding-left: 8px; }
        .org-section-items a {
            display: block; padding: 8px 12px; border-radius: 6px;
            text-decoration: none; color: var(--el-darkblue);
            font-size: 14px; font-weight: 500; white-space: nowrap;
        }
        .org-section-items a:hover { background: var(--el-grey); }
        .org-section-items a[aria-current="page"] { background: var(--el-darkblue); color: #fff; }
        /* Mobile (~360px): the toggle spans the bar and the panel flows inline
           (static, full width) so the long admin list scrolls with the page
           instead of overflowing a fixed dropdown off the small viewport. */
        @@media (max-width: 700px) {
            details.org-menu { display: block; }
            details.org-menu > summary { display: flex; justify-content: space-between; }
            .org-menu-items {
                position: static; min-width: 0; width: 100%;
                box-shadow: none; margin-top: 4px; max-height: none;
            }
        }
        main { max-width: 880px; margin: 24px auto; padding: 0 16px; }
        /* §301d/§308b (operator 2026-07-24 ×2: "why is the menu still so small on windows
           devices? we waste so much space"): the column is now FLUID on desktop — 94% of
           the viewport up to 1700px — so big monitors actually get used. Form fields keep
           sane reading widths; phones/tablets are untouched. */
        /* §309: the fluid content column for desktop — field widths live in the BASE
           rules above (§309c), so only the column itself is breakpointed. */
        @@media (min-width: 1000px) {
            main, footer { max-width: min(94vw, 1700px); }
        }
        .card {
            background: #fff; border-radius: 10px;
            padding: 20px; margin-bottom: 16px;
            box-shadow: 0 1px 3px rgba(0,0,0,.08);
        }
        .card h2 { margin-top: 0; font-size: 22px; font-weight: 700; color: var(--el-darkblue); }
        /* Shared organizer hub button-grid (operator 2026-06-21): the hub landing
           pages fan out to their feature pages as a responsive grid of link-tiles,
           replacing the old one-per-feature card stacks. One definition, every hub. */
        .hub-grid { display: grid; grid-template-columns: 1fr; gap: 12px; margin: 4px 0 8px; }
        @@media (min-width: 560px) { .hub-grid { grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); } }
        a.hub-tile { display: flex; flex-direction: column; text-decoration: none; color: inherit;
            border: 1px solid #e6e8ee; background: #f7f8fa; border-radius: 10px; padding: 14px 16px;
            transition: box-shadow .12s ease, transform .12s ease, border-color .12s ease; }
        a.hub-tile:hover, a.hub-tile:focus-visible {
            box-shadow: 0 2px 10px rgba(0,0,0,.12); transform: translateY(-1px);
            border-color: var(--el-blue, #008BD2); outline: none; }
        a.hub-tile .hub-tile-title { font-size: 15.5px; font-weight: 700; color: var(--el-darkblue, #1D3380); }
        a.hub-tile .hub-tile-desc { font-size: 12.5px; color: #4b5563; margin-top: 4px; line-height: 1.4; }
        a.hub-tile .hub-tile-go { font-size: 12px; font-weight: 600; color: var(--el-blue, #008BD2); margin-top: 10px; }
        /* Ring badge — yellow "Ring N" pill next to a feature still in staged
           rollout (not yet Broad/GA). Promoted from /Organizer/Settings so nav +
           tiles render the identical marker. */
        .set-tag { display:inline-block; font-size:10.5px; line-height:1; padding:2px 6px;
            border-radius:999px; margin-left:6px; vertical-align:middle; }
        .set-tag.ring { background:#fef9c3; color:#854d0e; border:1px solid #fde047; font-weight:600; }
        .info { color: #1f2937; }  /* neutral dark slate — operator 2026-06-24: "don't use green, make it easier to read" (was #15803d green) */
        .error { color: #c0392b; }
        button, input[type=submit] {
            background: var(--el-blue); color: #fff; border: 0;
            padding: 9px 16px; border-radius: 7px;
            font-size: 15px; cursor: pointer;
        }
        button:hover, input[type=submit]:hover { background: var(--el-darkblue); }
        /* Secondary button is a darker grey than the page bg so it stays
           visible even on cards/pages that sit directly on the body. */
        button.secondary { background: #c4c8d4; color: var(--el-darkblue); }
        button.secondary:hover { background: #aab0c0; }
        /* §309c (operator caught PhotoUrl still narrow): the generous widths are the
           BASE rule, not a desktop media query — breakpoints kept failing on scaled
           Windows screens, and width:100% already caps fields at the container on
           phones, so a small base max-width never served any purpose. */
        /* 🔴 §1129 — search / datetime-local / time WERE MISSING FROM THIS LIST, and that is the
           whole reason the organizer filter rows looked broken (operator 2026-08-25: *"why does the
           layout look so wrng here all over the place"* · *"buttons and fields are all over the
           place. looks bad"*).

           🔑 The tell was the MARGIN, not the border. Every styled control carries
           `margin: 6px 0 14px`, so in a `align-items:end` filter row their margin-boxes end 14px
           BELOW the visible control — i.e. the selects sit 14px higher than a search box that had no
           margin at all. That 14px is exactly the offset in his screenshot, and it is why the Search
           field looked dropped while Status/Persona/Flag looked fine.

           ⚠️ It also explains "make the field wider": without `width:100%` the search box fell back
           to the browser's ~20-character default, so it was the narrowest control on the row.

           🔒 An OMISSION, not a decision — nothing anywhere opted these types out. A type-by-type
           allowlist silently drops every input type nobody remembered, which is why the three that
           happened to be added later (search, datetime-local, time) all render unstyled. */
        input[type=email], input[type=text], input[type=number],
        input[type=date], input[type=tel], input[type=url],
        input[type=search], input[type=datetime-local], input[type=time],
        select, textarea {
            display: block; width: 100%; max-width: 640px;
            padding: 8px; margin: 6px 0 14px;
            border: 1px solid #c4c8d4; border-radius: 6px;
            font-size: 15px; box-sizing: border-box;
        }

        /* ------------------------------------------------------------------
           §1129 — THE INLINE FILTER BAR used by the organizer grids.

           🔑 The stacked-form margin above (`6px 0 14px`) is right for a normal
           top-to-bottom form and WRONG for a horizontal row: it is a per-control
           bottom margin fighting `align-items:end`, so controls, labels and the
           submit button each land at a different height. The button has no such
           margin at all, which is why Apply sat lowest of the lot.

           ⇒ Inside a filter bar the vertical rhythm comes from ONE place — the
           row's own `gap` — and every control's margin is zeroed. Then
           `align-items:end` genuinely aligns the bottoms, because every item's
           margin-box bottom IS its visible bottom.

           Mobile-first: it wraps at any width and each field may shrink to its
           min-width, so it degrades to a stack at ~360px with no media query.
           ------------------------------------------------------------------ */
        .ceh-filterbar {
            display: flex; flex-wrap: wrap;
            gap: 12px 16px; align-items: end;
            margin-bottom: 16px;
        }
        .ceh-filterbar__field { display: flex; flex-direction: column; min-width: 170px; }
        /* Search earns more room than a dropdown: it holds an id, a name OR an e-mail.
           🔒 `flex-basis` sets the WANTED width while `min-width` stays small, so the field shrinks
           inside a narrow card instead of forcing the row wider than its container. A hard
           `min-width: 320px` here is the classic mobile-overflow bug: it cannot shrink, so at ~360px
           minus the card padding it pushes the page into a horizontal scroll. */
        .ceh-filterbar__field--wide { flex: 1 1 320px; min-width: 200px; max-width: 460px; }
        .ceh-filterbar label { display: block; margin: 0 0 4px; }
        .ceh-filterbar input,
        .ceh-filterbar select { margin: 0; width: 100%; max-width: 100%; }
        /* Sits on the row's baseline with the controls, not 14px below them. */
        .ceh-filterbar button { margin: 0; }
        /* 🔑 §1130 — ESCAPE THE 1100px READING-WIDTH CAP. `main .card form:not(:has(table))` below
           caps plain forms for readability, and a filter bar is not prose: at 1100px the last filter
           and the Apply button were pushed onto a second line on a 1700px card for no reason.
           Measured: the row ended at exactly 1100px and Ring + Apply wrapped beneath it.

           ⚠️ The selector must OUT-SPECIFY that rule, not merely follow it. A bare `.ceh-filterbar`
           (0,1,0) loses to `main .card form:not(:has(table))` (0,1,4) however late it appears —
           `:not()` and `:has()` contribute their argument's specificity. Two classes wins. */
        main .card form.ceh-filterbar { max-width: none; }

        /* ------------------------------------------------------------------
           §1130 — THE BULK-ACTION BAR, same disease as the filter row.

           Inside its flex row the global control rule stretched each <select>
           to its 640px max-width and gave it a 14px bottom margin, so the two
           dropdowns sprawled across the bar and their "Apply" buttons fell onto
           a second line — the "Change persona to … Change ring to" spread the
           operator's screenshot shows.

           ⇒ Same remedy: the row owns the spacing, the controls carry none, and
           a dropdown sizes to its content instead of grabbing 640px.
           ------------------------------------------------------------------ */
        .bulk-bar label { display: inline; margin: 0; white-space: nowrap; }
        .bulk-bar select {
            display: inline-block; width: auto; min-width: 150px;
            max-width: 100%; margin: 0;
        }
        .bulk-bar button { margin: 0; }

        /* ------------------------------------------------------------------
           §1131 — A LINK THAT IS REALLY AN ACTION, styled as a button.

           Operator 2026-08-25 on the participants export: *"i also need this as
           a button"*. It was a 13px text link inside grey explanatory prose, so
           the most useful ACTION on the page looked like a footnote about it.

           🔑 An <a> rather than a <button>: these are GET download handlers, so
           a link is the correct element (right-click, open in a new tab, and no
           form to submit). Only the appearance was wrong, so only the
           appearance changes — the semantics stay a link.
           ------------------------------------------------------------------ */
        .ceh-actionrow { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
        a.ceh-btn {
            display: inline-block;
            background: var(--el-blue); color: #fff !important;
            padding: 9px 16px; border-radius: 7px;
            font-size: 15px; font-weight: 600; line-height: 1.2;
            text-decoration: none; white-space: nowrap;
        }
        a.ceh-btn:hover { background: var(--el-darkblue); color: #fff !important; }
        a.ceh-btn--secondary { background: #c4c8d4; color: var(--el-darkblue) !important; }
        a.ceh-btn--secondary:hover { background: #aab0c0; color: var(--el-darkblue) !important; }
        textarea { max-width: 960px; }
        /* Plain FIELD forms stay readable; forms hosting a TABLE (admin grids) keep
           the full fluid width. */
        main .card form:not(:has(table)) { max-width: 1100px; }
        /* Each label sits on its own line so it labels the input BELOW it,
           not the input to the LEFT of it. Form-rows that want side-by-side
           (e.g. checkbox + text) override with their own display:flex.       */
        label { font-weight: 600; font-size: 14px;
            display: block; margin-top: 10px; }
        a { color: var(--el-blue); }
        a:hover { color: var(--el-darkblue); }
        /* URL / email auto-buttons rendered inside task descriptions.
           Sized to match the form action buttons (Mark complete, etc.) so
           the click target is the same and inline buttons read as primary
           actions rather than tiny inline pills. */
        a.task-link-btn {
            display: inline-block;
            background: var(--el-blue);
            color: #fff !important;
            padding: 8px 18px;
            border-radius: 6px;
            text-decoration: none;
            font-size: 14px;
            font-weight: 600;
            margin: 4px 4px;
            word-break: break-all;
            line-height: 1.2;
        }
        a.task-link-btn:hover {
            background: var(--el-darkblue);
            color: #fff !important;
        }

        /* ------------------------------------------------------------------
           REQUIREMENTS §684.8 — THE MIGRATED TASK BODY. Structure now comes
           from BLOCK TYPES, not from underline/caps conventions in the prose,
           so each block gets a real style instead of inheriting whatever the
           surrounding <p style="white-space:pre-line"> happened to be.

           §669 is the reason the section title is BOLD and sized rather than
           underlined: the operator's complaint was that the emphasis was
           INVERTED — "STEP 1 — ORDER" was only underlined while lesser details
           below it were bold, so the scannable structure was the quietest
           thing on the page.

           Mobile-first: every rule here holds at ~360px, and nothing uses a
           fixed width.
           ------------------------------------------------------------------ */
        .task-body { font-size: 15px; line-height: 1.55; }
        .task-body__p { margin: 8px 0; }
        .task-body__section { margin: 18px 0 8px; }
        .task-body__section-title {
            font-size: 16px;
            font-weight: 700;
            color: var(--el-darkblue);
            margin-bottom: 6px;
        }
        .task-body__list { margin: 8px 0; padding-left: 22px; }
        .task-body__list li { margin: 0 0 6px; }
        /* §677 — a button gets its OWN LINE. The sponsor-wall task rendered an
           empty "•" followed by a block button, because a button could be
           inferred from a bare URL inside a bullet. */
        .task-body__btn-row { margin: 10px 0; }
        /* 🔴 §688.4 — "i cannot see the specs link". This was WHITE TEXT ON NEAR-WHITE, and the
           cause is §673's lesson repeating: `a.task-link-btn` above sets `color:#fff !important`
           and is ANCHOR-QUALIFIED (specificity 0,1,1), so it outranks a bare class (0,1,0) even
           when both carry !important. The button worked and was completely unreadable.
           🔒 Qualified with `a.` + both classes so it can never lose that contest again. */
        a.task-link-btn.task-link-btn--secondary {
            background: #f3f4f6 !important;
            color: #334155 !important;
            border: 1px solid #cbd5e1;
        }
        a.task-link-btn.task-link-btn--secondary:hover {
            background: #e5e7eb !important;
            color: #334155 !important;
        }
        .task-body__callout {
            margin: 12px 0;
            padding: 10px 14px;
            border-radius: 6px;
            border: 1px solid;
        }
        .task-body__callout .task-body__p:first-child { margin-top: 0; }
        .task-body__callout .task-body__p:last-child { margin-bottom: 0; }
        .task-body__callout--info { background: #eef5fc; border-color: #c3d9ef; }
        /* 🔒 §555/§666 — "we could not check your orders" renders through this
           tone. It must never read as ordinary prose, because the alternative
           reading ("you have not booked a TV") pushes a sponsor into buying a
           second one. */
        .task-body__callout--warning { background: #fff8e6; border-color: #f0d878; }
        .task-body__address {
            margin: 12px 0;
            padding: 10px 14px;
            background: #f7f8fa;
            border: 1px solid #dfe3e8;
            border-radius: 6px;
        }
        .task-body__address-label { font-weight: 700; margin-bottom: 4px; }
        .task-body__address-marking { margin-top: 8px; }
        /* §688.12 / §671 — THE EMBEDDED BOOTH-MEMBERS EDITOR.
           Rows are a flex WRAP, not a table: §671 judges "if room permits" on the ~360px viewport,
           and a table of name/email/role/remove cannot hold there. At narrow widths each row
           becomes a stack; at desktop it reads as a line. */
        /* §688.15 — the panel. Operator: "make this in a table with different color so it is easier
           to read … the booth members is easy to not see". An interactive editor rendered at the
           same visual weight as the prose around it, so the one part of the task the sponsor must
           ACT on vanished into the paragraphs. Tinted + bordered so it reads as a component. */
        .booth-members {
            margin: 14px 0 6px;
            background: #f2f6fb;
            border: 1px solid #cfdcea;
            border-radius: 8px;
            padding: 12px 14px;
        }
        .booth-members__head {
            font-weight: 700;
            color: var(--el-darkblue);
            margin-bottom: 8px;
        }
        .booth-members__empty { margin: 4px 0 0; font-style: italic; color: #4a5568; }
        /* §690 — the contracted allowance. Stated plainly above the list so the extras block below
           reads as the exception it is. */
        .booth-members__allowance { margin: 0 0 10px; font-size: 14.5px; color: #33415a; }
        .booth-members__over { display: block; margin-top: 4px; color: #8a5a00; font-weight: 600; }
        .booth-members__table { width: 100%; border-collapse: collapse; background: #fff; }
        .booth-members__table th {
            text-align: left;
            font-size: 12.5px;
            text-transform: uppercase;
            letter-spacing: .03em;
            color: #5a6472;
            border-bottom: 2px solid #cfdcea;
            padding: 6px 8px;
        }
        .booth-members__table td { padding: 8px; border-bottom: 1px solid #e6ecf3; vertical-align: middle; }
        .booth-members__table tbody tr:nth-child(even) { background: #fafcfe; }
        .booth-members__actions { text-align: right; white-space: nowrap; }
        .booth-members__actions form { margin: 0; }
        .booth-members__email { font-size: 13px; color: #5a6472; word-break: break-all; }
        /* 🔒 Mobile: the table becomes STACKED CARDS rather than scrolling sideways. §671 judges
           "if room permits" at ~360px, and a 4-column table cannot hold there. Each cell carries
           its own label so the meaning survives losing the header row. */
        @@media (max-width: 640px) {
            .booth-members__table thead { display: none; }
            .booth-members__table, .booth-members__table tbody,
            .booth-members__table tr, .booth-members__table td { display: block; width: 100%; }
            .booth-members__table tr {
                border: 1px solid #e6ecf3;
                border-radius: 6px;
                margin-bottom: 8px;
                padding: 4px 0;
            }
            .booth-members__table td { border: 0; padding: 4px 10px; }
            .booth-members__table td[data-label]::before {
                content: attr(data-label) ": ";
                font-weight: 600;
                color: #5a6472;
            }
            .booth-members__actions { text-align: left; padding-top: 8px; }
        }
        .booth-members__role {
            font-size: 12.5px;
            font-weight: 600;
            padding: 2px 9px;
            border-radius: 9px;
            background: #eef2f7;
            color: #33415a;
        }
        .booth-members__remove { margin: 0; }
        .booth-members__add { margin: 12px 0 0; }
        .booth-members__add > summary {
            cursor: pointer;
            font-weight: 600;
            color: var(--el-blue);
            padding: 6px 0;
        }
        .booth-members__form { display: flex; flex-direction: column; gap: 4px; max-width: 460px; }
        .booth-members__form label { font-weight: 600; font-size: 14px; margin-top: 8px; }
        .booth-members__form input,
        .booth-members__form select { width: 100%; max-width: 100%; }
        .booth-members__form button { margin-top: 12px; align-self: flex-start; }

        .task-body__decision { display: flex; gap: 10px; flex-wrap: wrap; margin: 14px 0; }
        .task-body__decision-answered { flex-basis: 100%; margin-bottom: 4px; color: #1f6d3a; }

        /* ------------------------------------------------------------------
           §673 — THE TASK ACTION ROW. One rhythm for every button on it, for
           every role.

           The bug the operator saw ("it looks odd, that one is bld and the
           other is not"): "Mark complete" carried an inline font-weight:600,
           while "Send Reminder to My Calendar" was a <button class="task-link-btn">
           — and that class is declared above as `a.task-link-btn`, an
           ANCHOR-only selector. The button therefore matched NOTHING and fell
           back to the browser default button weight (400) and font-family.
           Side by side, one looked bold and one did not. It was never a
           per-task problem, which is why fixing it per task never worked.

           font-family and font-size are set explicitly because <button> does
           NOT inherit either from the page by default — that alone made the
           pair read as two different components.
           ------------------------------------------------------------------ */
        .task-act {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-family: inherit;
            font-size: 14px;
            font-weight: 600;
            line-height: 1.2;
            padding: 9px 18px;
            border-radius: 6px;
            border: 1px solid transparent;
            text-decoration: none;
            cursor: pointer;
            white-space: nowrap;
        }
        /* Long labels wrap rather than push the row wide at 360px. */
        @@media (max-width: 480px) {
            .task-act { white-space: normal; }
        }
        .task-act--complete { background: #198754; border-color: #198754; color: #fff; }
        .task-act--complete:hover { background: #146c45; color: #fff; }
        .task-act--primary  { background: #1565c0; border-color: #1565c0; color: #fff; }
        .task-act--primary:hover { background: #0f4c93; color: #fff; }
        .task-act--calendar { background: #15803d; border-color: #15803d; color: #fff; }
        .task-act--calendar:hover { background: #116530; color: #fff; }
        .task-act--secondary { background: #f3f4f6; border-color: #cbd5e1; color: #334155; }
        .task-act--secondary:hover { background: #e5e7eb; color: #334155; }
        /* §688.6 — the DECLINE half of a §670/§676 decision. Operator: "color button is missing for
           no interest. make it red like cancel master class for attendees." Same #c0392b the
           master-class cancel uses (.ceh-modal--danger), so "this is the negative choice" reads the
           same everywhere.
           🔒 Red here means "the declining option", NOT "danger" — declining is a legitimate,
           recorded answer (§670), so it is a normal-weight button beside the accept, never a
           warning. */
        .task-act--decline { background: #c0392b; border-color: #c0392b; color: #fff; }
        .task-act--decline:hover { background: #962d22; color: #fff; }

        /* §677 — the action row was a jumble: file picker + Upload + a long
           amber sentence + the calendar button all competing on ONE flex line
           at different heights and weights. Actions belong together on their
           own line; the explanatory note goes underneath, where it reads as a
           note instead of as another control. */
        .task-actions {
            display: flex;
            align-items: center;
            gap: 12px;
            flex-wrap: wrap;
            margin-top: 22px;
        }
        .task-actions form { margin: 0; display: inline-flex; align-items: center; gap: 10px; flex-wrap: wrap; }
        .task-actions input[type=file] { font-size: 14px; max-width: 100%; }
        .task-actions__note { margin-top: 10px; font-size: 14px; line-height: 1.45; }
        .task-actions__note--pending { color: #7a5b00; font-weight: 600; }
        .task-actions__note--done { color: #1f6d3a; font-weight: 600; }
        .task-actions__note--muted { color: #555; font-style: italic; font-size: 13px; }

        footer { max-width: 880px; margin: 24px auto; padding: 0 16px;
            font-size: 12px; color: #6b7280; }
        /* Visually hidden but available to screen readers. left:0 pins it to the
           nearest positioned ancestor's left edge so an absolutely-positioned
           .sr-only in a far-right table cell can't extend past the body and cause
           horizontal overflow (e.g. the Organizer /Comms tables at 360px). */
        .sr-only { position: absolute; left: 0; width: 1px; height: 1px; padding: 0;
            margin: -1px; overflow: hidden; clip: rect(0,0,0,0);
            white-space: nowrap; border: 0; }

        /* ============================================================
           SHARED UX COMPONENTS (REQUIREMENTS §21) — reusable repo-wide
           1. Flash toast  (_Flash.cshtml)
           2. Field validation  (asp-validation-for / .ceh-field-error)
           3. Confirmation modal  (_ConfirmModal.cshtml)
           ============================================================ */

        /* 1. Flash toast — success/error banner after a POST. Mobile-first:
              full-width, wraps at ~360px, large tap targets. */
        /* Result toast — FIXED at the bottom of the viewport so the outcome of a
           POST is visible wherever the user was on the page (combined with scroll
           restoration, the window no longer jumps to the top after an action). */
        .ceh-flash {
            display: flex; align-items: flex-start; gap: 10px;
            padding: 12px 14px; border-radius: 8px;
            font-size: 14.5px; line-height: 1.4; border: 1px solid transparent;
            position: fixed; left: 50%; bottom: 18px; transform: translateX(-50%);
            z-index: 1200; max-width: min(560px, 92vw); width: max-content;
            box-shadow: 0 6px 24px rgba(0,0,0,.18);
        }
        @@media (max-width: 460px) { .ceh-flash { width: 92vw; } }
        .ceh-flash--success {
            background: #e7f6ec; border-color: #b6e0c4; color: #1b5e34;
        }
        .ceh-flash--error {
            background: #fcebec; border-color: #f3c2c6; color: #8a1f28;
        }
        .ceh-flash--info {
            background: #eaf1fb; border-color: #c2d4f3; color: #1f3f6b;
        }
        .ceh-flash__icon { font-weight: 700; flex: 0 0 auto; font-size: 16px; line-height: 1.3; }
        .ceh-flash__text { flex: 1 1 auto; min-width: 0; }
        .ceh-flash__close {
            flex: 0 0 auto; background: transparent; color: inherit;
            border: 0; font-size: 22px; line-height: 1; cursor: pointer;
            padding: 0 4px; min-width: 32px; min-height: 32px; border-radius: 6px;
        }
        .ceh-flash__close:hover { background: rgba(0,0,0,.08); }

        /* 2. Inline form validation — field-level error message + an invalid
              field outline. Works with the tag helpers (asp-validation-for /
              asp-validation-summary) which emit .field-validation-error /
              .input-validation-error, and with manual .ceh-field-error spans. */
        .ceh-field-error,
        .field-validation-error {
            display: block;
            color: #8a1f28; font-size: 13px; font-weight: 600;
            margin: -8px 0 12px;
        }
        /* Show a field-error span ONLY when it actually carries an error. The static
           .ceh-field-error class is present on every field, so without this a fresh
           form rendered a stray "⚠" + reserved space under every input. MVC marks a
           valid span .field-validation-valid (and leaves it empty); a manual
           .ceh-field-error with no message is :empty -- hide both. */
        .ceh-field-error:empty,
        span.field-validation-valid { display: none; }
        .ceh-field-error::before,
        .field-validation-error::before { content: "⚠ "; }
        /* Red outline on the offending input (tag-helper adds the class). */
        input.input-validation-error, select.input-validation-error,
        textarea.input-validation-error, .ceh-input-invalid {
            border-color: #c0392b !important;
            outline-color: #c0392b;
        }
        /* Error summary box at the top of a form. */
        .ceh-validation-summary {
            background: #fcebec; border: 1px solid #f3c2c6; color: #8a1f28;
            padding: 10px 14px; border-radius: 8px; margin: 0 0 16px; font-size: 14px;
        }
        .ceh-validation-summary ul { margin: 6px 0 0; padding-left: 20px; }
        .ceh-validation-summary p { margin: 0; font-weight: 700; }
        /* Hide the summary when there is NOTHING to show. :empty alone is not enough --
           asp-validation-summary renders an empty inner <ul> when valid, so the div is
           never truly :empty and the red bar showed on a fresh form. MVC adds
           .validation-summary-valid when there are no errors -- key off that. */
        .ceh-validation-summary:empty,
        .ceh-validation-summary.validation-summary-valid { display: none; }

        /* 3. Confirmation modal — accessible dialog for destructive/bulk/send
              actions. Centred overlay, scrolls on small screens, focus-trapped
              by the shared JS. */
        .ceh-modal-backdrop {
            position: fixed; inset: 0; background: rgba(15,18,40,.55);
            display: none; align-items: center; justify-content: center;
            padding: 16px; z-index: 2000;
        }
        .ceh-modal-backdrop[data-open] { display: flex; }

        /* Page-level confirm/bulk dialogs (Participants grid etc.) mark their
           fixed-position backdrop with .modal-backdrop and toggle the [hidden]
           attribute to open/close. Those backdrops carry an inline display:flex,
           which on its own OVERRIDES the UA [hidden]{display:none} rule — so a
           "closed" backdrop stayed display:flex over the whole viewport and
           swallowed clicks behind it (it intercepted "Switch to user" on the
           ~360px iPhone SE layout). Force a hidden backdrop fully inert here so
           the fix is GLOBAL to every .modal-backdrop, not per-modal: !important
           beats the inline display, and pointer-events:none is a belt-and-braces
           guard. Desktop is unaffected — an OPEN modal has [hidden] removed. */
        .modal-backdrop[hidden] { display: none !important; pointer-events: none; }
        .ceh-modal {
            background: #fff; border-radius: 12px; max-width: 460px; width: 100%;
            max-height: calc(100vh - 32px); overflow-y: auto;
            box-shadow: 0 12px 40px rgba(0,0,0,.3); padding: 22px 22px 18px;
        }
        .ceh-modal h2 { margin: 0 0 10px; font-size: 19px; color: var(--el-darkblue); }
        .ceh-modal__body { font-size: 14.5px; line-height: 1.5; color: #1a1a2e; }
        .ceh-modal__count {
            display: inline-block; font-weight: 700; background: var(--el-grey);
            color: var(--el-darkblue); padding: 2px 10px; border-radius: 999px;
        }
        .ceh-modal__actions {
            display: flex; flex-wrap: wrap; gap: 10px; justify-content: flex-end;
            margin-top: 20px;
        }
        .ceh-modal__actions button { min-width: 110px; }
        .ceh-modal--danger .ceh-modal__confirm { background: #c0392b; }
        .ceh-modal--danger .ceh-modal__confirm:hover { background: #962d22; }
        @@media (max-width: 480px) {
            .ceh-modal__actions { flex-direction: column-reverse; }
            .ceh-modal__actions button { width: 100%; }
        }
        /* ---- Micro-polish (REQUIREMENTS §21 Participant [L]) -----------------
           Live character counter shown under a maxlength field; the "near limit"
           state warns before the cap is hit. A copy button's transient "copied"
           confirmation. A form whose submit is in flight dims + shows it is busy.
           Mobile-first: the counter is a small, wrapping block under the field. */
        .ceh-counter {
            display: block; margin-top: 4px; font-size: 12px; color: #6b7280;
            text-align: right;
        }
        .ceh-counter--near { color: #b45309; font-weight: 600; }
