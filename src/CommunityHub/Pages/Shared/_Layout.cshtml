@inject CommunityHub.Branding.ActiveEventNameProvider ActiveEvent
@inject CommunityHub.Auth.ICurrentParticipantAccessor CurrentParticipant
@inject System.TimeProvider Clock
@inject CommunityHub.Core.Config.EventEditionConfigLoader EventConfigLoader
@inject CommunityHub.Core.Config.EventConfigOptions EventConfigOptions
@inject CommunityHub.Core.Domain.VolunteerStructureService VolunteerStructure
@inject CommunityHub.Core.Settings.FeatureSettingsService FeatureSettings
@inject CommunityHub.Core.Settings.RingResolver RingResolver
@inject CommunityHub.Core.Data.CommunityHubDbContext Db
@{
    // Product / tool name shown in the graphics layout. This is the display
    // name only - the codebase, namespaces, and Azure resources stay
    // "CommunityHub" (a tool rename in code would be churn and "EventHub"
    // collides with the Azure Event Hubs service).
    const string ProductName = "Community Event Hub";
    const string ProductShortName = "CEH";

    // The community running this edition - data, from the active Event row,
    // cached via ActiveEventNameProvider. Pages may override via ViewData.
    var communityName = (ViewData["CommunityName"] as string)
                        ?? ActiveEvent.GetCommunityName();

    var me = CurrentParticipant.Current;
    var isLoggedIn = me is not null;
    var role = me?.Role;

    // i18n: the active UI culture drives both the <html lang> attribute and the
    // resource lookups behind @Localizer. It is negotiated per request from the
    // culture cookie / Accept-Language / the en default (Program.cs); the hub is
    // English-only, so this always resolves to "en".
    var uiCulture = System.Globalization.CultureInfo.CurrentUICulture;
    // BCP-47 tag for the lang attribute (e.g. "en").
    var langTag = uiCulture.Name;

    // Site-wide topbar ticket banner (REQUIREMENTS §10). Driven from the active
    // edition config (event.<edition>.json -> ticketSale) instead of the old
    // hardcoded Layout.TicketInfo resx literal, so the copy can't silently go
    // stale and auto-switches once the sale opens. Computed against the edition
    // timezone (dates.timezone) using the ambient TimeProvider so it's testable.
    // Defensive: a broken/missing config must never 500 the whole site, so any
    // failure falls back to the static literal.
    var ticketBanner = CommunityHub.Core.Config.TicketBannerBuilder.Fallback;
    try
    {
        var editionCfg = EventConfigLoader.Load(EventConfigOptions.EventConfigPath);
        ticketBanner = CommunityHub.Core.Config.TicketBannerBuilder.Build(
            editionCfg.TicketSale,
            editionCfg.Dates?.Timezone,
            Clock.GetUtcNow());
    }
    catch
    {
        // Keep the fallback — the static literal renders below.
    }

    // §1003 — the EVENT-start countdown target. Null once the event has begun (or when the
    // edition config is unreadable), and the topbar then falls back to the ticket banner.
    DateTimeOffset? eventStartsAt = null;
    var eventCode = "The event";
    try
    {
        var cfg = EventConfigLoader.Load(EventConfigOptions.EventConfigPath);
        if (!string.IsNullOrWhiteSpace(cfg.Code)) eventCode = cfg.Code;
        var starts = cfg.Dates?.EventStartsAt();
        if (starts is { } s && s > Clock.GetUtcNow()) eventStartsAt = s;
    }
    catch
    {
        // A broken config must never 500 the site — no countdown, ticket banner as before.
    }
}
<!DOCTYPE html>
@* lang reflects the negotiated UI culture (en) so a screen reader announces the
   copy with the correct pronunciation rules (WCAG 3.1.1). The date PICKER stays
   dd/mm/yyyy (Monday-first) via flatpickr; the value posted is ISO regardless. *@
<html lang="@langTag">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    @* §263: a short, identifiable browser-tab / bookmark title. With a page Title:
       "<Title> — ELDK27"; without one: just the edition CODE (never a dangling "- name"). *@
    @{
        var pageTitle = ViewData["Title"] as string;
        var titleCode = ActiveEvent.GetEventCode();
    }
    <title>@(string.IsNullOrWhiteSpace(pageTitle) ? titleCode : $"{pageTitle} — {titleCode}")</title>
    <partial name="_LayoutStyles" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.css">
    <script defer src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/flatpickr.min.js"></script>
    <script defer src="https://cdn.jsdelivr.net/npm/flatpickr@4.6.13/dist/l10n/da.js"></script>
    <script defer>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof flatpickr === 'undefined') return;
            flatpickr.localize(flatpickr.l10ns.da);

            // §849 — DATE-AND-TIME fields, same treatment as plain dates.
            //
            // 🔴 <input type="datetime-local"> is drawn by the BROWSER, which formats to the USER's
            // locale — so it showed "08/05/2026 01:00 PM" under a label promising Danish time, which
            // reads as a wrong VALUE rather than a wrong rendering. §844.5 converted everything CEH
            // renders itself and could not reach this one.
            //
            // altInput shows d/m/Y H:i (Danish, 24-hour) while the hidden original keeps the
            // ISO yyyy-MM-ddTHH:mm the model binder parses — the same split the date inputs use.
            document.querySelectorAll('input[type="datetime-local"]').forEach(function (el) {
                flatpickr(el, {
                    locale:     'da',
                    enableTime: true,
                    time_24hr:  true,
                    dateFormat: 'Y-m-d\\TH:i',   // value posted to the server (hidden)
                    altInput:   true,
                    altFormat:  'd/m/Y H:i',     // value shown to the user
                    allowInput: true
                });
            });

            document.querySelectorAll('input[type="date"]').forEach(function (el) {
                // altInput=true: flatpickr hides the original, shows a sibling
                // input formatted dd/mm/yyyy (Danish), while the hidden one
                // keeps the ISO yyyy-mm-dd value that DateOnly parses on POST.
                flatpickr(el, {
                    locale:     'da',
                    dateFormat: 'Y-m-d',   // value posted to server (hidden)
                    altInput:   true,
                    altFormat:  'd/m/Y',   // value shown to user (visible)
                    allowInput: true
                });
            });
        });
    </script>
    <script defer>
        // Nav dropdown UX (operator 2026-06-23): native <details> menus don't form
        // an accordion and don't close on an outside click. Improve it: opening one
        // top-level menu closes the others; a click outside, or Escape, closes any
        // open menu. Pure progressive enhancement — the menus still work with JS off.
        (function () {
            var menus = Array.prototype.slice.call(
                document.querySelectorAll('details.nav-section, details.org-menu'));
            if (!menus.length) return;
            menus.forEach(function (d) {
                d.addEventListener('toggle', function () {
                    if (d.open) menus.forEach(function (o) { if (o !== d) o.open = false; });
                });
            });
            document.addEventListener('click', function (e) {
                menus.forEach(function (d) { if (d.open && !d.contains(e.target)) d.open = false; });
            });
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' || e.key === 'Esc') menus.forEach(function (d) { d.open = false; });
            });
        })();
    </script>
    @* §839 (operator 2026-08-05: "bug when i share ceh intro which is anonymous, then icons
       defaults to signin which confuses people" … "same for other anonymous pages in ceh").

       🔴 THE CAUSE: CEH emitted OpenGraph meta on exactly ONE page (/Sessions/{id}, §172). Every
       other page — including the public intro he shares — had NONE, so LinkedIn/Teams/Slack fell
       back to scraping whatever they could find and produced a sign-in-flavoured card. People he
       sent the link to concluded they needed an account to read a PUBLIC page.

       🔒 The default belongs in the LAYOUT, not on each page: the failure mode was every page that
       did not opt IN, so a per-page fix would leave the next new page wrong in the same silent way
       (the §831 lesson). A page with richer data still wins — see OgHandledByPage below. *@
    @{
        var ogHandledByPage = ViewData["OgHandledByPage"] is true;
    }
    @if (!ogHandledByPage)
    {
        var ogReq = Context.Request;
        var ogOrigin = $"{ogReq.Scheme}://{ogReq.Host}";
        var ogUrl = $"{ogOrigin}{ogReq.Path}{ogReq.QueryString}";
        var ogSite = communityName;
        @* The page's own title when it has one, else the edition name — never the bare edition
           CODE, which is part of what made the card read as a system screen and not an event. *@
        var ogTitle = (ViewData["OgTitle"] as string)
                      ?? (string.IsNullOrWhiteSpace(pageTitle) ? ogSite : pageTitle);
        var ogDescription = (ViewData["OgDescription"] as string)
                            ?? $"{ogSite} — agenda, sessions, speakers and sponsors.";
        @* Absolute, and a real event image: a relative path is not resolved by a crawler. *@
        var ogImage = (ViewData["OgImage"] as string) ?? $"{ogOrigin}/img/logo-eldk27-event.png";

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content="@ogSite" />
        <meta property="og:title" content="@ogTitle" />
        <meta property="og:description" content="@ogDescription" />
        <meta property="og:url" content="@ogUrl" />
        <meta property="og:image" content="@ogImage" />
        <meta name="description" content="@ogDescription" />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content="@ogTitle" />
        <meta name="twitter:description" content="@ogDescription" />
        <meta name="twitter:image" content="@ogImage" />
    }
    @* §172: per-page <head> extras (e.g. the public session page's OpenGraph / Twitter-card
       meta so a shared link renders a rich preview). Optional — most pages render nothing.
       ⚠️ A page emitting its OWN og: tags MUST set ViewData["OgHandledByPage"] = true, or the card
       carries two og:title values and which one wins is the crawler's choice, not ours. *@
    @await RenderSectionAsync("Head", required: false)
</head>
<body>
    <a class="skip-link" href="#main">@Localizer["Layout.SkipToContent"]</a>
    <div class="topbar">
        @* Ticket banner: config-driven (event.<edition>.json -> ticketSale).
           - Suppressed  => render nothing (sale open + afterOpen=hide).
           - Visible+Href => a link to the public ticket page (sale open).
           - Visible      => plain config text (before the sale opens).
           - otherwise    => the static resx literal (config absent/disabled). *@
        @if (ticketBanner.Suppressed)
        {
            // Intentionally empty — only the event-site button shows.
        }
        else if (eventStartsAt is { } startsAt)
        {
            @* 🔴 §1003 — THE COUNTDOWN IS TO THE EVENT, NOT THE TICKET SALE. Operator 2026-08-09:
               *"it was a count down for the event start date 9th feb 2027 at 9:00 - like 'ELDK27
               starts in xxx'"*. §995 built it against ticketSale.opensAtLocal, which was the wrong
               target — it counted down to a date that passes months before the event and then
               stopped meaning anything. Segmented DAYS/HOURS/MINUTES/SECONDS per his mock-up.

               🔴 §1070 — AND IT NOW OUTRANKS THE "on sale" MESSAGE. Operator 2026-08-11, at 08:00
               when the sale opened: *"the header we introduced yesterday with the countdown is now
               gone and replaced with a tickets are now on sale … let me get the event countdown
               back"*.

               ⚠️ NOTHING WAS CHANGED — and that is the point worth keeping. This branch used to sit
               BELOW the on-sale link. Before the sale opened the banner had no Href, so that branch
               did not match and the countdown rendered; the moment the sale opened the banner gained
               one, the higher branch started matching, and it displaced the countdown. A precedence
               bug is invisible until the lower-priority condition finally becomes true — which here
               was a DATE, so it shipped fine and broke months later on a timer.

               🛑 THE COUNTDOWN AND NOTHING ELSE. Operator 2026-08-11, after I offered to keep the
               ticket link by making the countdown itself clickable: *"the event countdown must win -
               remove the tickets are now on sale, so we have only the countdown"*.
               ⇒ No link, no tooltip, no screen-reader echo of the on-sale wording — the topbar is a
               countdown while there is an event to count down to. "Visit event site →" beside it is
               how someone navigates; the bar does not need a second destination. *@
            <span class="ceh-countdown" data-event-countdown="@startsAt.ToString("o")" aria-live="off">
                <span class="cd-label">@eventCode starts in</span>
                <span class="cd-seg"><b data-cd="d">—</b><i>DAYS</i></span>
                <span class="cd-seg"><b data-cd="h">—</b><i>HOURS</i></span>
                <span class="cd-seg"><b data-cd="m">—</b><i>MINUTES</i></span>
                <span class="cd-seg"><b data-cd="s">—</b><i>SECONDS</i></span>
            </span>
        }
        else if (ticketBanner.Visible && !string.IsNullOrEmpty(ticketBanner.Href))
        {
            @* Reached only once the event has STARTED (no countdown target left). *@
            <a class="ticket-info" href="@ticketBanner.Href" target="_blank" rel="noopener">@ticketBanner.Message &rarr;<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
        }
        else if (ticketBanner.Visible && ticketBanner.OpensAt is { } opensAt)
        {
            @* §995 — the LIVE countdown. The server-rendered text is the no-JS answer and the
               first paint; the script below re-renders it every second from the machine-readable
               instant. 🔒 The INSTANT is what crosses to the browser, never a pre-rendered
               duration: this layout is long-lived and cacheable, so "in 2 days" would still say
               that tomorrow. `aria-live="off"` because a value that changes every second must not
               be announced every second. *@
            <span class="ticket-info" data-ticket-countdown="@opensAt.ToString("o")"
                  aria-live="off">@ticketBanner.Message</span>
        }
        else if (ticketBanner.Visible)
        {
            <span class="ticket-info">@ticketBanner.Message</span>
        }
        else
        {
            <span class="ticket-info">@Localizer["Layout.TicketInfo"]</span>
        }
        <a class="eventsite-btn" href="https://eldk27.expertslive.dk/" target="_blank" rel="noopener">@Localizer["Layout.VisitEventSite"] &rarr;<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
    </div>
    <header>
        <a class="brand" href="/" aria-label="@communityName">
            <img src="~/img/logo-experts-live-denmark-white.png" alt="Experts Live Denmark" style="height:48px; display:block;" />
        </a>
        @* Round ELDK27 event badge removed (operator 2026-06-25): on mobile it overlapped
           the Sign-out button; the wordmark above already brands the header. *@
        @* Hide the user identity + Sign-out on STANDALONE pages (HidePublicNav) — an
           anonymous survey / signup must show no internal chrome (operator 2026-06-24). *@
        @if (isLoggedIn && (ViewData["HidePublicNav"] as bool? ?? false) == false)
        {
            @* §283: the signed-in person's NAME is a dropdown holding "My Hub Profile" + Sign out,
               so those free up room on the main menu (native <details>, no JS, keyboard-operable). *@
            <div class="user-tools">
                <details class="user-menu">
                    <summary>
                        <span class="who">@me!.FullName &middot; @CommunityHub.Branding.RoleDisplay.Name(role!.Value)</span>
                        <span class="user-menu-caret" aria-hidden="true">▾</span>
                    </summary>
                    <div class="user-menu-items">
                        <a href="/Profile">@Localizer["Nav.MyProfile"]</a>
                        <form method="post" asp-page="/Logout">
                            <button type="submit" class="signout">@Localizer["Common.SignOut"]</button>
                        </form>
                    </div>
                </details>
            </div>
        }
    </header>
    @{
        // Mark the nav entry that matches the page being viewed so screen
        // readers announce "current page" (WCAG 2.4.8 / aria-current). Matched
        // on the request path; "/" only counts as current for the exact root.
        var currentPath = (Context.Request.Path.Value ?? "/").TrimEnd('/');
        if (string.IsNullOrEmpty(currentPath)) { currentPath = "/"; }
        Func<string, string?> ariaCurrent = href =>
        {
            var h = href.TrimEnd('/');
            if (string.IsNullOrEmpty(h)) { h = "/"; }
            var match = h == "/"
                ? currentPath == "/"
                : currentPath.Equals(h, StringComparison.OrdinalIgnoreCase);
            return match ? "page" : null;
        };
    }
    @{
        // Resolve a NavItem's visible label: a resx key when present (so the
        // i18n pass owns the copy), else the literal fallback. Keeps i18n in the
        // view while the route/grouping/gating decision lives in Core.NavBuilder.
        Func<NavItem, Microsoft.AspNetCore.Html.IHtmlContent> navLabel = item =>
            item.LabelKey is not null
                ? Localizer[item.LabelKey]
                : new Microsoft.AspNetCore.Html.HtmlString(
                      System.Net.WebUtility.HtmlEncode(item.FallbackLabel ?? item.Href));
        // §317 (operator 2026-07-24): fold-outs render in NavBuilder INSERTION order — the
        // §173d "alphabetize Event logistics" projection is retired (the operator specifies
        // the exact menu order; NavBuilder owns it).
        // Standalone pages (sign-in, magic-link, survey, etc.) opt OUT of the public
        // event nav bar via ViewData["HidePublicNav"]=true — that nav is for the public
        // SITE sections and does not belong on a bare auth/form page.
        var hidePublicNav = ViewData["HidePublicNav"] as bool? ?? false;
    }
    @* HidePublicNav makes a page fully STANDALONE (operator 2026-06-24): suppress BOTH
       the logged-in (participant + management) nav AND the public nav, so an anonymous
       form like /volunteer/signup or a survey shows no event/org chrome even when an
       organizer is signed in. *@
    @if (isLoggedIn && !hidePublicNav)
    {
        @* Two clearly separated, role-gated nav groups (REQUIREMENTS §11 nav/IA):
             1. the participant / "My event" group — always visible;
             2. the organizer / "Organizer area" group — emitted by NavBuilder
                ONLY for an Organizer, so a non-organizer never receives the
                management links at all (server-side gate, not a CSS hide).
           NavBuilder is unit-tested (NavBuilderTests). *@
        // Show the volunteer "Supervisor" dashboard item only to real supervisors
        // (a cheap indexed check, run for volunteers only).
        var isVolunteerSupervisor = false;
        if (role == CommunityHub.Core.Domain.ParticipantRole.Volunteer && me is not null)
        {
            isVolunteerSupervisor = await VolunteerStructure.IsSupervisorAsync(me.EventId, me.ParticipantId);
        }
        // Show the exhibitor booth/leads nav blocks only to sponsors who actually have a
        // physical booth (SponsorInfo.HasBooth, i.e. SponsorPackage >= Gold). A
        // digital-only sponsor would otherwise see Zoho booth/lead links that don't
        // apply to them. Resolved for sponsors only (cheap company lookup + AnyAsync).
        var isExhibitor = false;
        if (role == CommunityHub.Core.Domain.ParticipantRole.Sponsor && me is not null)
        {
            var sponsorCompanyId = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                .FirstOrDefaultAsync(Db.Participants
                    .Where(p => p.Id == me.ParticipantId)
                    .Select(p => p.SponsorCompanyId));
            if (sponsorCompanyId is not null)
            {
                isExhibitor = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                    .AnyAsync(Db.SponsorInfos, s => s.EventId == me.EventId
                        && s.SponsorCompanyId == sponsorCompanyId
                        && s.SponsorPackage >= CommunityHub.Core.Domain.SponsorPackage.Gold);
            }
        }
        // §138: the speaker "Master Class Q&A" nav item shows ONLY when the speaker
        // presents at least one master class (linked via SessionSpeaker to a
        // SessionType.MasterClass session in their edition). A speaker with zero master
        // classes has no Group Q&A board, so the menu item would be a dead-end (the page
        // stays reachable by direct URL and shows a friendly empty state). Resolved for
        // speakers only (cheap indexed AnyAsync).
        var speakerHasMasterClass = false;
        if (role == CommunityHub.Core.Domain.ParticipantRole.Speaker && me is not null)
        {
            speakerHasMasterClass = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                .AnyAsync(Db.SessionSpeakers, ss => ss.ParticipantId == me.ParticipantId
                    && ss.Session.EventId == me.EventId
                    && ss.Session.Type == CommunityHub.Core.Domain.SessionType.MasterClass);
        }
        // §457: a SPONSOR-category speaker does not run the ELDK speaker programme, so those
        // menu items are hidden for them. Resolved for speakers only (one indexed lookup).
        // Only an EXPLICIT Sponsor category hides anything — an uncategorised speaker keeps the
        // full menu rather than being quietly stripped of it.
        var speakerIsSponsorCategory = false;
        if (role == CommunityHub.Core.Domain.ParticipantRole.Speaker && me is not null)
        {
            speakerIsSponsorCategory = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                .AnyAsync(Db.SpeakerProfiles, sp => sp.ParticipantId == me.ParticipantId
                    && sp.EventId == me.EventId
                    && sp.Category == CommunityHub.Core.Domain.SpeakerCategory.Sponsor);
        }
        // §234 UX: the three attendee Master-Class nav entries (chooser / waitlist / Q&A)
        // show ONLY for a 2-day ticket holder — a 1-day attendee's ticket excludes Master
        // Classes, so all three would be dead ends. Resolved for attendees only (cheap
        // indexed AnyAsync on the normalized email, the same key /Attendee resolves by).
        var attendeeIsTwoDay = false;
        if (role == CommunityHub.Core.Domain.ParticipantRole.Attendee && me is not null)
        {
            var normEmail = (me.Email ?? string.Empty).Trim().ToLowerInvariant();
            // One email can hold several ticket rows (e.g. a soft-cancelled 2-day plus an
            // active 1-day) — entitlement is ≥1 ACTIVE 2-day row, so cancelled mirrors
            // never light the Master-Class menu up.
            attendeeIsTwoDay = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                .AnyAsync(Db.Attendees, a => a.EventId == me.EventId
                    && a.Email == normEmail
                    && a.TicketStatus == CommunityHub.Core.Domain.TicketStatus.TwoDay
                    && a.MirrorState == CommunityHub.Core.Domain.MirrorState.Active);
        }
        // §270: the attendee "fun IT games" is an on/off feature (default OFF) — read the
        // edition flag; a broken/missing config must never 500 the nav, so default false.
        var attendeeGamesEnabled = false;
        try { attendeeGamesEnabled = EventConfigLoader.Load(EventConfigOptions.EventConfigPath).AttendeeGamesEnabled; } catch { }
        var nav = NavBuilder.Build(role!.Value, isVolunteerSupervisor, isExhibitor, speakerHasMasterClass, attendeeIsTwoDay, attendeeGamesEnabled, speakerIsSponsorCategory);
        var participant = nav.Groups[0];
        var management = nav.ManagementGroup;

        // §163 (operator 2026-06-28): for ORGANIZERS, SWAP the two nav groups — the admin /
        // management menu becomes the prominent PRIMARY top bar, and the personal "My event" menu
        // moves into the dropdown. (An organizer's personal tasks are usually done, so the top bar
        // is better spent on the admin hubs.) Every other role is unchanged: personal-primary, and
        // no management dropdown. Both render-blocks below already handle a sectioned group, so the
        // swap is just feeding each block the other group + flipping the labels.
        var isOrganizerNav = role!.Value == CommunityHub.Core.Domain.ParticipantRole.Organizer && management is not null;
        var primaryGroup = isOrganizerNav ? management! : participant;
        var dropdownGroup = isOrganizerNav ? participant : management;
        var primaryAriaKey = isOrganizerNav ? "Nav.OrgAreaMenu" : "Nav.MyEvent";
        var dropdownLabelKey = isOrganizerNav ? "Nav.MyEvent" : "Nav.OrgAreaMenu";

        // Ring scope (org-managed via /Organizer/Settings): each feature carries an
        // Enabled flag + a released ring. For nav items tagged with a FeatureKey:
        //   • the ORG turns it OFF (Enabled=false) -> hidden for everyone;
        //   • the ORG assigns its ring -> impact is SCOPED to users at that ring AND
        //     LOWER (a user above the ring doesn't see it), and a yellow "Ring N"
        //     pill marks it while it is not yet Broad/GA so a ring tester sees what's
        //     scoped to them. Resolved once per request; best-effort (never 500 nav).
        var featureMap = new Dictionary<string, CommunityHub.Core.Settings.FeatureState>(StringComparer.Ordinal);
        var userRing = CommunityHub.Core.Settings.Rings.Default;
        if (me is not null)
        {
            try
            {
                userRing = await RingResolver.GetEffectiveRingAsync(me.ParticipantId);
                foreach (var fs in await FeatureSettings.GetAllAsync(me.EventId))
                    featureMap[fs.Key] = fs;
            }
            catch { /* badges/gating are best-effort; never 500 the nav */ }
        }
        // Share the resolved ring data with _HubGrid (organizer hub tiles) so it
        // badges + gates the SAME way without re-querying. Read back as
        // (Dictionary<string,FeatureState>, Ring) in the partial.
        ViewData["RingFeatureMap"] = featureMap;
        ViewData["RingUserRing"] = userRing;
        // Hidden when the org disabled the feature, OR the user's ring is above the
        // feature's released ring (out of scope).
        // Only RING-SCOPED surfaces (Queue + User-impact) are GUI ring-scoped; Engine
        // / EngineQueued (plumbing) are never hidden/badged in the nav even if tagged.
        Func<CommunityHub.Core.Navigation.NavItem, bool> ringHidden = it =>
            it.FeatureKey is not null
            && featureMap.TryGetValue(it.FeatureKey, out var fs)
            && fs.Descriptor.IsRingScoped
            && (!fs.Enabled
                || !CommunityHub.Core.Settings.Rings.IsActiveForRing(userRing, fs.ReleasedToRing));
        // Badge the feature's ring while enabled + not yet Broad/GA.
        Func<CommunityHub.Core.Navigation.NavItem, CommunityHub.Core.Settings.Ring?> ringBadgeOf = it =>
            it.FeatureKey is not null
            && featureMap.TryGetValue(it.FeatureKey, out var fs)
            && fs.Descriptor.IsRingScoped
            && fs.Enabled
            && fs.ReleasedToRing != CommunityHub.Core.Settings.Ring.Broad
                ? fs.ReleasedToRing : (CommunityHub.Core.Settings.Ring?)null;

        // FEATURE B: hide a self-service FORM link unless the participant is ENTITLED
        // to the matching OrderItem — the same entitlement rule the form's own gate
        // applies (OrderEntitlements as the single source of truth). Non-speaker roles
        // keep their historical links; only speakers are entitlement-gated, so a
        // sponsor-self-funded speaker loses Hotel/Travel/Swag but keeps Lunch/Dinner.
        // Resolved ONCE per request; best-effort (never 500 the nav).
        var entitledItems = new HashSet<CommunityHub.Core.Domain.OrderItem>();
        if (me is not null)
        {
            try
            {
                entitledItems = new HashSet<CommunityHub.Core.Domain.OrderItem>(
                    await CommunityHub.Forms.FormEntitlementGate.EffectiveItemsAsync(
                        Db, me.EventId, me.ParticipantId, default));
            }
            catch { /* entitlement gating is best-effort; never 500 the nav */ }
        }
        var isSpeakerRole = role == CommunityHub.Core.Domain.ParticipantRole.Speaker;
        // §399 (operator 2026-07-26): a speaker based in DENMARK cannot claim travel reimbursement,
        // so the menu entry must go too. Resolved here alongside the entitlements, best-effort and
        // never able to 500 the nav. The PAGE enforces the same rule independently — this only
        // stops us offering something we would then refuse.
        var travelBlockedByCountry = false;
        if (me is not null && isSpeakerRole)
        {
            try
            {
                var country = await Microsoft.EntityFrameworkCore.EntityFrameworkQueryableExtensions
                    .FirstOrDefaultAsync(
                        Db.SpeakerProfiles
                          .Where(p => p.EventId == me.EventId && p.ParticipantId == me.ParticipantId)
                          .Select(p => p.Country));
                travelBlockedByCountry =
                    CommunityHub.Core.Entitlements.TravelReimbursementPolicy.IsDenmark(country);
            }
            catch { /* same best-effort contract as the entitlement lookup above */ }
        }
        // Map a form href → the OrderItem(s) that entitle it. A link is hidden only
        // for SPEAKERS who lack the entitlement; every other role keeps its link.
        Func<CommunityHub.Core.Navigation.NavItem, bool> formEntitlementHidden = it =>
        {
            if (!isSpeakerRole) { return false; }
            var href = (it.Href ?? string.Empty).TrimEnd('/');
            bool Has(params CommunityHub.Core.Domain.OrderItem[] items) => items.Any(entitledItems.Contains);
            return href switch
            {
                "/Forms/Hotel"  => !Has(CommunityHub.Core.Domain.OrderItem.Hotel),
                // §399: entitled AND not based in Denmark.
                "/Forms/Travel" => !Has(CommunityHub.Core.Domain.OrderItem.TravelReimbursement)
                                   || travelBlockedByCountry,
                "/Forms/Swag"   => !Has(CommunityHub.Core.Domain.OrderItem.Swag, CommunityHub.Core.Domain.OrderItem.Polo),
                "/Forms/Lunch"  => !Has(CommunityHub.Core.Domain.OrderItem.LunchPreDay, CommunityHub.Core.Domain.OrderItem.LunchMainDay),
                "/Forms/Dinner" => !Has(CommunityHub.Core.Domain.OrderItem.AppreciationDinner),
                _ => false,
            };
        };
        // Combined nav-item hide: ring scope OR (Feature B) form entitlement.
        Func<CommunityHub.Core.Navigation.NavItem, bool> navHidden = it =>
            ringHidden(it) || formEntitlementHidden(it);
        // §175/§176: links that leave the hub for a third-party system needing its own
        // login carry a localized "you'll be redirected, here's how to log in" message,
        // emitted as data-confirm="…"; the shared nav-confirm.js handler shows a confirm()
        // before navigating (OK proceeds as today, Cancel stays). Internal/plain links
        // (Redirect=None) return null, so the attribute is simply omitted.
        Func<CommunityHub.Core.Navigation.NavItem, string?> confirmMsg = it => it.Redirect switch
        {
            CommunityHub.Core.Navigation.ExternalRedirectKind.Zoho    => Localizer["Nav.RedirectConfirmZoho"].Value,
            CommunityHub.Core.Navigation.ExternalRedirectKind.Webshop => Localizer["Nav.RedirectConfirmWebshop"].Value,
            _ => null,
        };
        <nav class="primary" aria-label="@Localizer[primaryAriaKey]">
            @* Render the participant group by SECTION (mirrors the management
               bar). Items with no SectionKey collapse into the leading
               null-heading bucket and render as plain links exactly as before —
               so non-speaker roles are visually unchanged. Speaker-specific items
               carry SectionKey "Nav.SectionSpeaker" (NavBuilder) and render under
               a named, collapsible "Speaker" disclosure so the long speaker nav is
               grouped, not one flat list. Pure IA; NavBuilder owns the grouping
               and NavBuilderTests assert no route is dropped. *@
            @* Contact Organizers is rendered LAST (furthest-right), after the
               section dropdowns — operator 2026-06-23. It is a leaf, so the
               null-heading bucket would otherwise render it among the leading
               links; pull it out here and emit it after the loop. *@
            @{ var contactItem = primaryGroup.Items.FirstOrDefault(i => i.LabelKey == "Nav.ContactOrganizers"); }
            @foreach (var section in primaryGroup.Sections())
            {
                if (section.HeadingKey is null)
                {
                    foreach (var item in section.Items)
                    {
                        if (navHidden(item)) { continue; }
                        if (item.LabelKey == "Nav.ContactOrganizers") { continue; } // rendered last
                        var rb = ringBadgeOf(item);
                        @* §486: an IMPLICIT @@expr is what Razor omits when null — an explicit
                           @@(cond ? "1" : null) writes an EMPTY attribute instead, which is how a
                           presence selector ended up matching every nav link. *@
                        var zohoAttr = item.Redirect == CommunityHub.Core.Navigation.ExternalRedirectKind.Zoho ? "1" : null;
                        var shopAttr = item.Redirect == CommunityHub.Core.Navigation.ExternalRedirectKind.Webshop ? "1" : null;
                        <a href="@item.Href" target="@(item.External ? "_blank" : null)" rel="@(item.External ? "noopener noreferrer" : null)" title="@confirmMsg(item)" data-zoho-interstitial="@zohoAttr" data-webshop-interstitial="@shopAttr" aria-current="@ariaCurrent(item.Href)">@navLabel(item)@if (rb is not null) {<span class="set-tag ring" title="@Localizer["Settings.RingBadgeTitle"]">@CommunityHub.Core.Settings.Rings.Label(rb.Value)</span>}@if (item.External) {<span class="ext-ico" aria-hidden="true">&#8599;</span><span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span>}</a>
                    }
                }
                else
                {
                    var visible = section.Items.Where(i => !navHidden(i)).ToList();
                    if (visible.Count == 0) { continue; }   // whole fold-out gated out
                    @* The dropdown is an absolute overlay on desktop, so NEVER auto-open it
                       on load — doing so covered the page form (operator bug 2026-06-23).
                       Highlight the summary instead to show which section you are in; the
                       user opens it with a click and it closes on navigation. *@
                    var sectionActive = visible.Any(i => ariaCurrent(i.Href) == "page");
                    <details class="nav-section@(sectionActive ? " is-active" : null)">
                        <summary>
                            <span class="nav-section-label">@Localizer[section.HeadingKey]</span>
                            <span class="nav-section-caret" aria-hidden="true">&#9662;</span>
                        </summary>
                        <div class="nav-section-items">
                            @* §297: direct leaves first, then any NESTED sub-fold-outs (SubSectionKey),
                               e.g. Event Info → Policies → (Code of Conduct + Privacy Policy). *@
                            @foreach (var item in visible.Where(i => i.SubSectionKey is null))
                            {
                                var rb = ringBadgeOf(item);
                        @* §486: an IMPLICIT @@expr is what Razor omits when null — an explicit
                           @@(cond ? "1" : null) writes an EMPTY attribute instead, which is how a
                           presence selector ended up matching every nav link. *@
                        var zohoAttr = item.Redirect == CommunityHub.Core.Navigation.ExternalRedirectKind.Zoho ? "1" : null;
                        var shopAttr = item.Redirect == CommunityHub.Core.Navigation.ExternalRedirectKind.Webshop ? "1" : null;
                                <a href="@item.Href" target="@(item.External ? "_blank" : null)" rel="@(item.External ? "noopener noreferrer" : null)" title="@confirmMsg(item)" data-zoho-interstitial="@zohoAttr" data-webshop-interstitial="@shopAttr" aria-current="@ariaCurrent(item.Href)">@navLabel(item)@if (rb is not null) {<span class="set-tag ring" title="@Localizer["Settings.RingBadgeTitle"]">@CommunityHub.Core.Settings.Rings.Label(rb.Value)</span>}@if (item.External) {<span class="ext-ico" aria-hidden="true">&#8599;</span><span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span>}</a>
                            }
                            @foreach (var sub in visible.Where(i => i.SubSectionKey is not null).GroupBy(i => i.SubSectionKey!))
                            {
                                var subActive = sub.Any(i => ariaCurrent(i.Href) == "page");
                                @* §317 (operator 2026-07-24): nested sub-fold-outs render OPEN by
                                   default — "let any submenu folder foldout automatically, so I
                                   don't have to click". The caret still collapses them. *@
                                <details class="nav-subsection@(subActive ? " is-active" : null)" open="open">
                                    <summary>
                                        <span class="nav-section-label">@Localizer[sub.Key]</span>
                                        <span class="nav-section-caret" aria-hidden="true">&#9662;</span>
                                    </summary>
                                    <div class="nav-subsection-items">
                                        @foreach (var item in sub)
                                        {
                                            var rb = ringBadgeOf(item);
                        @* §486: an IMPLICIT @@expr is what Razor omits when null — an explicit
                           @@(cond ? "1" : null) writes an EMPTY attribute instead, which is how a
                           presence selector ended up matching every nav link. *@
                        var zohoAttr = item.Redirect == CommunityHub.Core.Navigation.ExternalRedirectKind.Zoho ? "1" : null;
                        var shopAttr = item.Redirect == CommunityHub.Core.Navigation.ExternalRedirectKind.Webshop ? "1" : null;
                                            <a href="@item.Href" target="@(item.External ? "_blank" : null)" rel="@(item.External ? "noopener noreferrer" : null)" title="@confirmMsg(item)" data-zoho-interstitial="@zohoAttr" data-webshop-interstitial="@shopAttr" aria-current="@ariaCurrent(item.Href)">@navLabel(item)@if (rb is not null) {<span class="set-tag ring" title="@Localizer["Settings.RingBadgeTitle"]">@CommunityHub.Core.Settings.Rings.Label(rb.Value)</span>}@if (item.External) {<span class="ext-ico" aria-hidden="true">&#8599;</span><span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span>}</a>
                                        }
                                    </div>
                                </details>
                            }
                        </div>
                    </details>
                }
            }
            @if (contactItem is not null && !navHidden(contactItem))
            {
                <a href="@contactItem.Href" target="@(contactItem.External ? "_blank" : null)" rel="@(contactItem.External ? "noopener noreferrer" : null)" aria-current="@ariaCurrent(contactItem.Href)">@navLabel(contactItem)@if (contactItem.External) {<span class="ext-ico" aria-hidden="true">&#8599;</span><span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span>}</a>
            }
        </nav>
        @if (dropdownGroup is not null)
        {
            @* Organizer/management group as a collapsible disclosure. <details>/
               <summary> gives a working dropdown with NO JavaScript, native
               aria-expanded, and keyboard operability; it collapses to a single
               control on ~360px so the long admin list never floods the phone
               nav. A distinct second-level bar visually separates management
               tools from the participant nav above. *@
            <nav class="manage-bar" aria-label="@Localizer[dropdownLabelKey]">
                <details class="org-menu">
                    <summary aria-label="@Localizer[dropdownLabelKey]">
                        <span class="org-menu-label">@Localizer[dropdownLabelKey]</span>
                        <span class="org-menu-caret" aria-hidden="true">&#9662;</span>
                    </summary>
                    @* REQUIREMENTS §21 "Group the organizer nav": the management
                       hubs are bucketed into named, collapsible sub-groups
                       (People / Sessions / Comms / Sponsors / Volunteers /
                       Logistics) instead of one flat list, so the menu is
                       scannable. Each section is a nested native <details> (no JS,
                       keyboard-operable, aria via summary). The leading
                       null-heading section (Organizer home / Command center /
                       Dashboard) renders as plain prominent links with no
                       disclosure. Every existing route is still present — this is
                       pure information architecture (NavBuilder owns the grouping;
                       NavBuilderTests assert no link is dropped). A section that
                       contains the current page is rendered open so aria-current is
                       visible without a click. *@
                    <div class="org-menu-items">
                        @foreach (var section in dropdownGroup.Sections())
                        {
                            @* Apply the same ring/entitlement hide-filter as the primary bar — the
                               swapped dropdown can now carry the participant group, whose items may be
                               ring- or form-gated (management items never were). *@
                            var dvisible = section.Items.Where(i => !navHidden(i)).ToList();
                            if (dvisible.Count == 0) { continue; }
                            if (section.HeadingKey is null)
                            {
                                @* Prominent, ungrouped entries — no disclosure. *@
                                foreach (var item in dvisible)
                                {
                                    <a href="@item.Href" target="@(item.External ? "_blank" : null)" rel="@(item.External ? "noopener noreferrer" : null)" aria-current="@ariaCurrent(item.Href)">@navLabel(item)@if (item.External) {<span class="ext-ico" aria-hidden="true">&#8599;</span><span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span>}</a>
                                }
                            }
                            else
                            {
                                @* Render every section OPEN by default: opening the
                                   "Organizer area" dropdown then showed each section
                                   still collapsed, so reaching a link took TWO expands
                                   (dropdown + section). Open sections mean one expand
                                   reveals all links; the carets still collapse them.
                                   (operator 2026-06-20) *@
                                <details class="org-section" open="open">
                                    <summary>
                                        <span class="org-section-label">@Localizer[section.HeadingKey]</span>
                                        <span class="org-section-caret" aria-hidden="true">&#9662;</span>
                                    </summary>
                                    <div class="org-section-items">
                                        @foreach (var item in dvisible)
                                        {
                                            <a href="@item.Href" target="@(item.External ? "_blank" : null)" rel="@(item.External ? "noopener noreferrer" : null)" aria-current="@ariaCurrent(item.Href)">@navLabel(item)@if (item.External) {<span class="ext-ico" aria-hidden="true">&#8599;</span><span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span>}</a>
                                        }
                                    </div>
                                </details>
                            }
                        }
                    </div>
                </details>
            </nav>
        }
    }
    else if (!hidePublicNav)
    {
        @* Public nav for anonymous visitors — the public site sections are all
           reachable without signing in (next to the Login entry in the topbar).
           REQUIREMENTS §21: complete the public nav (Agenda + master classes +
           Contributors) so no public page is an orphan. "Master classes" deep-links
           to the Sessions list pre-filtered to the master-class type (a real,
           URL-persisted filter — no separate index page needed). *@
        <nav class="primary" aria-label="@Localizer["Nav.Primary"]">
            <a href="/Agenda" aria-current="@ariaCurrent("/Agenda")">@Localizer["Nav.Agenda"]</a>
            <a href="/Sessions" aria-current="@ariaCurrent("/Sessions")">@Localizer["Nav.Sessions"]</a>
            <a href="/Sessions?FilterType=MasterClass">@Localizer["Nav.MasterClasses"]</a>
            <a href="/Speakers" aria-current="@ariaCurrent("/Speakers")">@Localizer["Nav.Speakers"]</a>
            <a href="/Sponsors" aria-current="@ariaCurrent("/Sponsors")">@Localizer["Nav.Sponsors"]</a>
            <a href="/Contributors" aria-current="@ariaCurrent("/Contributors")">@Localizer["Nav.Contributors"]</a>
        </nav>
    }
    @if (me is not null && me.IsActingAs)
    {
        @* Acting-as banner: unmistakable that this is an organizer/secretary
           operating ON BEHALF of someone, with a one-click way back. role=alert
           so assistive tech announces the elevated context immediately. *@
        <div role="alert"
             style="background:#fde68a;color:#7c2d12;border-bottom:2px solid #b45309;
                    padding:10px 16px;display:flex;flex-wrap:wrap;gap:10px;align-items:center;
                    justify-content:space-between;font-weight:600;">
            <span>
                @if (me.ActingAs!.Kind == CommunityHub.Core.Domain.ImpersonationActorKind.SecretaryToken)
                {
                    <text>Secure-link mode — you are filling in tasks on behalf of <strong>@me.FullName</strong>. Your access is limited to this person.</text>
                }
                else
                {
                    <text>You are acting as <strong>@me.FullName</strong> (started by @me.ActingAs!.ActorLabel). Changes you make are on this person's behalf.</text>
                }
            </span>
            @if (me.ActingAs!.Kind == CommunityHub.Core.Domain.ImpersonationActorKind.Organizer)
            {
                <form method="post" asp-page="/Organizer/ReturnToOrganizer" style="margin:0;">
                    <button type="submit" class="secondary">Return to organizer</button>
                </form>
            }
        </div>
    }
    <main id="main" tabindex="-1">
        @* Organizer back-office breadcrumb trail (REQUIREMENTS §21). The partial
           renders nothing for non-organizer / root / unknown paths, so it is safe
           here for every page. *@
        <partial name="_Breadcrumb" />
        @RenderBody()
    </main>
    <footer style="text-align:center;">
        <div>
            @ProductName (@ProductShortName) &mdash; @Localizer["Layout.FooterBuiltBy"]
            <a href="https://aka.ms/morten" target="_blank" rel="noopener">Morten Knudsen<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
            &middot; @Localizer["Layout.FooterFree"]
        </div>
        <div style="margin-top:4px;">
            <a href="https://github.com/KnudsenMorten/community-event-hub" target="_blank" rel="noopener">@Localizer["Layout.GitHub"]<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
            &middot;
            <a href="https://github.com/KnudsenMorten/community-event-hub/issues" target="_blank" rel="noopener">@Localizer["Layout.SubmitBug"]<span class="visually-hidden">@Localizer["Common.OpensNewTab"]</span></a>
            &middot;
            <a asp-page="/Contributors">@Localizer["Layout.Contributors"]</a>
        </div>
    </footer>
    @* ----------------------------------------------------------------------
       Shared UX component behaviour (REQUIREMENTS §21). Progressive
       enhancement only: with JS disabled the flash stays visible and the
       confirm modal falls back to a native confirm() (see _ConfirmModal).
       ---------------------------------------------------------------------- *@
    @* §484 — interstitial shown before any (Zoho) nav link opens Zoho Backstage. Rendered
       hidden and inert; the handler in _LayoutClientScripts reveals it, and "Continue" is what
       opens the new tab (a real user gesture, so no popup blocker — the §464 lesson). With JS
       off the links simply navigate straight through as before. *@
    <div id="zoho-interstitial" class="zoho-interstitial" hidden role="dialog" aria-modal="true" aria-labelledby="zoho-interstitial-title">
        <div class="zoho-interstitial-card">
            <h2 id="zoho-interstitial-title">@Localizer["Nav.ZohoDialogTitle"]</h2>
            @* §487 — the copy carries **bold** markers and renders through the SHARED task
               renderer, which HTML-ENCODES first and only then substitutes <strong>. That keeps the
               emphasis in the resx (translatable, no markup split across keys) without opening a
               raw-HTML path into the layout. *@
            <p>@CommunityHub.Branding.TaskTextLinkifier.Render(Localizer["Nav.ZohoDialogBody1"].Value)</p>
            <p>@CommunityHub.Branding.TaskTextLinkifier.Render(Localizer["Nav.ZohoDialogBody2"].Value)</p>
            <p>@CommunityHub.Branding.TaskTextLinkifier.Render(Localizer["Nav.ZohoDialogBody3"].Value)</p>
            <label class="zoho-interstitial-hide">
                <input type="checkbox" id="zoho-interstitial-hide" />
                <span>@Localizer["Nav.ZohoDialogHide"]</span>
            </label>
            <div class="zoho-interstitial-actions">
                <button type="button" id="zoho-interstitial-cancel" class="secondary">@Localizer["Nav.ZohoDialogCancel"]</button>
                <button type="button" id="zoho-interstitial-continue">@Localizer["Nav.ZohoDialogContinue"]</button>
            </div>
        </div>
    </div>

    @* §653 — the SPONSOR WEBSHOP hand-off, same shape as the Zoho one above. Operator 2026-07-29:
       tell the sponsor they are being sent to the external webshop, to sign in with their own e-mail
       and password, to use "Lost your password?" if they cannot remember it, and that they may tick
       "Remember Me". The real confusion is NOT the new tab — it is that this is a DIFFERENT system
       with its own credentials, so a sponsor meeting a login screen assumes the hub signed them out.
       Reuses the zoho-interstitial CSS classes deliberately: one dialog style in the product, not two. *@
    <div id="webshop-interstitial" class="zoho-interstitial" hidden role="dialog" aria-modal="true" aria-labelledby="webshop-interstitial-title">
        <div class="zoho-interstitial-card">
            <h2 id="webshop-interstitial-title">@Localizer["Nav.WebshopDialogTitle"]</h2>
            <p>@CommunityHub.Branding.TaskTextLinkifier.Render(Localizer["Nav.WebshopDialogBody1"].Value)</p>
            <p>@CommunityHub.Branding.TaskTextLinkifier.Render(Localizer["Nav.WebshopDialogBody2"].Value)</p>
            <p>@CommunityHub.Branding.TaskTextLinkifier.Render(Localizer["Nav.WebshopDialogBody3"].Value)</p>
            <label class="zoho-interstitial-hide">
                <input type="checkbox" id="webshop-interstitial-hide" />
                <span>@Localizer["Nav.ZohoDialogHide"]</span>
            </label>
            <div class="zoho-interstitial-actions">
                <button type="button" id="webshop-interstitial-cancel" class="secondary">@Localizer["Nav.ZohoDialogCancel"]</button>
                <button type="button" id="webshop-interstitial-continue">@Localizer["Nav.ZohoDialogContinue"]</button>
            </div>
        </div>
    </div>
    <partial name="_LayoutClientScripts" />
    @* AI Community Helper widget (code-named AiHelper, configurable display name; REQUIREMENTS
       §129). AUTHENTICATED, non-standalone pages only — same gate as the logged-in nav, so an
       anonymous survey/signup/login (or any HidePublicNav page) shows NO helper, preserving the
       anon-vs-auth chrome isolation (§27). *@
    @if (isLoggedIn && !hidePublicNav)
    {
        <partial name="_AiHelperWidget" />
    }
    @* §995 — tick the topbar ticket countdown. Deliberately tiny, dependency-free and inline:
       it drives ONE span and must not wait on a bundle to stop showing a stale duration.
       🔒 It no-ops when the span is absent (every state except before-open), so this costs
       nothing on the pages that do not have one. *@
    <script defer>
        // §1003 — the EVENT countdown (segmented). Runs alongside the ticket one; only one of the
        // two elements is ever rendered, so each no-ops when its element is absent.
        (function () {
            var box = document.querySelector('[data-event-countdown]');
            if (!box) return;
            var target = Date.parse(box.getAttribute('data-event-countdown'));
            if (isNaN(target)) return;

            var cells = {
                d: box.querySelector('[data-cd="d"]'), h: box.querySelector('[data-cd="h"]'),
                m: box.querySelector('[data-cd="m"]'), s: box.querySelector('[data-cd="s"]')
            };
            var two = function (n) { return (n < 10 ? '0' : '') + n; };

            function tick() {
                var ms = target - Date.now();
                if (ms <= 0) { box.textContent = '@eventCode is live'; clearInterval(t); return; }
                var s = Math.floor(ms / 1000);
                var d = Math.floor(s / 86400); s -= d * 86400;
                var h = Math.floor(s / 3600);  s -= h * 3600;
                var m = Math.floor(s / 60);    s -= m * 60;
                cells.d.textContent = d;
                cells.h.textContent = two(h);
                cells.m.textContent = two(m);
                cells.s.textContent = two(s);
            }
            var t = setInterval(tick, 1000);
            tick();
        })();

        (function () {
            var el = document.querySelector('[data-ticket-countdown]');
            if (!el) return;
            var target = Date.parse(el.getAttribute('data-ticket-countdown'));
            if (isNaN(target)) return;   // unparseable => leave the server-rendered text alone

            var two = function (n) { return (n < 10 ? '0' : '') + n; };

            function tick() {
                var ms = target - Date.now();
                if (ms <= 0) {
                    // The sale just opened while the page was open. Say so rather than freezing at
                    // zero; the next real page load renders the proper on-sale state (with its
                    // link), which this cannot do because the URL is not in the DOM.
                    el.textContent = '@CommunityHub.Core.Config.TicketBannerBuilder.OnSaleMessage';
                    clearInterval(timer);
                    return;
                }
                var s = Math.floor(ms / 1000);
                var d = Math.floor(s / 86400); s -= d * 86400;
                var h = Math.floor(s / 3600);  s -= h * 3600;
                var m = Math.floor(s / 60);    s -= m * 60;
                var hms = two(h) + ':' + two(m) + ':' + two(s);
                el.textContent = 'Tickets on sale in ' + (d > 0 ? d + 'd ' + hms : hms);
            }

            var timer = setInterval(tick, 1000);
            tick();
        })();
    </script>
    @* Render any page-defined @@section Scripts. Without this, every page that defines one
       (e.g. Organizer/Hotels) 500s on render: "section 'Scripts' has not been rendered". *@
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
