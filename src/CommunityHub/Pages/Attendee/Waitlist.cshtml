@page
@model CommunityHub.Pages.Attendee.WaitlistModel
@{
    ViewData["Title"] = Localizer["Nav.Waitlist"].Value;
}

<div class="card">
    <h1>@Localizer["Nav.Waitlist"]</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <partial name="_Flash" model='new CommunityHub.Pages.Shared.FlashModel(Model.Message!, "success")' />
    }

    @if (!Model.HasAttendeeRecord)
    {
        <p class="error">We couldn't match your ticket yet. If you've just registered, please check back shortly.</p>
    }
    else if (!Model.Eligible)
    {
        <p>Master Classes are part of the <strong>2-day ticket</strong>. Your current ticket doesn't include one.</p>
    }
    else if (Model.Pending is null)
    {
        <p>You're not on any Master Class waitlist.</p>
        @* §275: rephrased into short, plain points (operator 2026-07-10). *@
        <p class="info"><strong>You can hold one Master Class at a time.</strong> Here's how the waitlist works:</p>
        <ul class="info" style="line-height:1.6;margin-top:0;">
            <li>If the Master Class you want is <strong>full</strong>, join its waitlist.</li>
            <li>When a seat opens, the <strong>first person in line gets it automatically</strong> — and we email them.</li>
            <li>Already confirmed in another Master Class? If you waitlist a different one, we <strong>switch you
                automatically</strong> when a seat opens: your old seat is released and you're moved into the new one.</li>
            <li>Joining a waitlist means you <strong>agree to that switch</strong> — so you always end up with exactly
                one Master Class.</li>
        </ul>
        @* §390 (operator 2026-07-26: "/attendee keeps coming again !!! i clicked this" →
           "it should go to step 2 in the wizard"). This button was the remaining route into the
           retired /Attendee chooser. The waitlist now has its OWN wizard step (§384), which is
           where joining one actually happens. *@
        <p><a class="task-link-btn" href="/Forms/Wizard?step=masterclass-waitlist">Add myself to master class waitlist</a></p>
    }
    else
    {
        <p class="info">You're on the waitlist for <strong>@Model.Pending.Title</strong>
           — position <strong>@Model.Pending.WaitlistPosition</strong>. We'll email you if a seat opens.</p>
        @if (Model.Confirmed is not null)
        {
            <p>Your confirmed Master Class is <strong>@Model.Confirmed.Title</strong>. If a waitlisted seat comes through,
               it replaces your current one (you never hold two).</p>
        }
        <form method="post" asp-page-handler="Leave" style="margin-top:10px;">
            <input type="hidden" name="sessionId" value="@Model.Pending.SessionId" />
            <button type="submit" class="secondary">Leave this waitlist</button>
        </form>
    }
</div>
