<Project Sdk="Microsoft.NET.Sdk">

  <!-- ======================================================================
       CommunityHub.Jobs - the Azure Functions app (timer-triggered scheduler).
       Hosts ReminderJob, WooCommercePullJob, and AttendeeReconcileJob. Shares
       the CommunityHub.Core data model, email, and integration clients.
       ====================================================================== -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AzureFunctionsVersion>v4</AzureFunctionsVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CommunityHub.Jobs</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Azure.Functions.Worker" Version="2.52.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Sdk" Version="2.0.7" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Timer" Version="4.3.1" />
    <!-- HTTP trigger for the §128 ZohoOrderWebhook (the first HttpTrigger in this
         otherwise timer-only worker). -->
    <PackageReference Include="Microsoft.Azure.Functions.Worker.Extensions.Http" Version="3.3.0" />
    <PackageReference Include="Microsoft.ApplicationInsights.WorkerService" Version="2.23.0" />
    <PackageReference Include="Microsoft.Azure.Functions.Worker.ApplicationInsights" Version="2.51.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.9" />
    <!-- Auto-login token minted by the attendee-welcome job is redeemed by the web
         /Login/Magic page; both must share the SAME persisted DataProtection key
         ring (PersistKeysToDbContext), so the Jobs worker needs this package too. -->
    <PackageReference Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.9" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CommunityHub.Core\CommunityHub.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="host.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- Ship the per-edition config (event.<ed>.json, sponsor.<ed>.json,
       integrations.<ed>.json, ...) into the published Functions bundle so
       SponsorOrderPullService / SponsorUploadWatchService can find them at
       runtime. Without this the watcher in Azure cannot resolve
       config/event.eldk27.json -> the sharepoint block -> site/drive/root. -->
  <ItemGroup>
    <None Include="..\..\config\*.json">
      <Link>config\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <!-- REQUIREMENTS §684.8/§684.14 - the authored TASK BODIES. The Functions host needs these as
         much as the web app does: TaskReminderBuilder renders a task's body into the chase mail
         (§684.12), so a bundle without them would send reminders with an EMPTY body while the hub
         page looked perfectly fine. 🔒 CLAUDE.md's standing warning applies here - a Core change
         that is only web-deployed is only half live. -->
    <None Include="..\..\config\tasks\**\*.md">
      <Link>config\tasks\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
    <!-- §303 per-integration field maps (layer 2 of the IntegrationFieldMap design):
         loaded fail-soft at startup over the code-default rows. -->
    <None Include="..\..\config\integrations\*.json">
      <Link>config\integrations\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- Ship the branded email templates (templates/emails/_layout.html +
       per-type content fragments). EmailTemplateProvider resolves the
       relative default "templates/emails" against the app root; before
       this Include the folder was simply absent from the published bundle,
       so EVERY templated reminder render threw FileNotFoundException in
       Azure (found 2026-06-12). -->
  <ItemGroup>
    <None Include="..\..\templates\emails\*.html">
      <Link>templates\emails\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- §6.5 - the survey DEFINITIONS. SurveySummaryFilesJob rebuilds the three post-event summaries
       daily, so this host must read the same JSON the web app serves the forms from.
       LINKED, not copied: one file in the repo, two build outputs. A second copy would be two files
       to edit, one of them would be forgotten, and the host reading the stale one would publish a
       summary for questions nobody was asked. Same warning as the task bodies above. -->
  <ItemGroup>
    <None Include="..\CommunityHub\App_Data\Surveys\*.json">
      <Link>App_Data\Surveys\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <!-- PRIVATE per-edition email templates (publish-safe layer): the edition's
       real, named copy, denylisted from the public mirror. EmailTemplateProvider
       resolves config/email-templates/{key}.html ahead of the shipped default. -->
  <ItemGroup>
    <None Include="..\..\config\email-templates\**\*.html">
      <Link>config\email-templates\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>Always</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>